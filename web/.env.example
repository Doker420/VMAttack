# Web/API
PORT=4173
# HTTPS URL of this same site, used by Telegram Web App button
WEB_APP_URL=https://poslaniya.example
DEMO_MODE=true
CORS_ORIGIN=https://your-domain.example

# Telegram bot
TELEGRAM_BOT_USERNAME=your_bot_username
TELEGRAM_BOT_TOKEN=123456:replace-me
TELEGRAM_WEBHOOK_SECRET=replace-with-random-secret

# VK community Callback API
VK_GROUP_ID=your_group_id_or_short_name
VK_GROUP_TOKEN=replace-me
VK_CONFIRMATION_TOKEN=replace-me

# CloudPayments server-side callback verification
CLOUDPAYMENTS_PUBLIC_ID=replace-me
CLOUDPAYMENTS_API_SECRET=replace-me

# Only for QA; production should keep the default 24 hours.
# RETENTION_INTERVAL_MS=60000
