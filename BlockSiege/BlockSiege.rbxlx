      <Item class="ModuleScript" referent="37">
        <Properties>
          <string name="Name">EventCatalog</string>
          <string name="Source"><![CDATA[-- BLOCKSIEGE // LIVE-OPS EVENT DEFINITIONS
-- Shared presentation data only. The server decides activation, rewards and damage.
local EventCatalog = {
	Schedule = {
		Period = 240,
		ActiveWindow = 45,
		CompletionCoins = 5,
		CompletionXP = 10,
		MinimumPresence = 10,
	},
	Order = { "SupplyStorm", "GoldRush", "RepairPulse", "MeteorMadness" },
}

EventCatalog.Events = {
	SupplyStorm = {
		Id = "SupplyStorm",
		Name = "ШТОРМ ПРИПАСОВ",
		ShortName = "SUPPLY STORM",
		Color = Color3.fromRGB(255, 199, 65),
		Duration = 45,
		Description = "Золотые ящики появляются в 3 раза чаще. Первая пара — сразу.",
		Announcement = "Снабжение уже падает на арену · ищи золотые лучи",
	},
	GoldRush = {
		Id = "GoldRush",
		Name = "ЗОЛОТАЯ ЛИХОРАДКА",
		ShortName = "GOLD RUSH ×2",
		Color = Color3.fromRGB(255, 102, 190),
		Duration = 45,
		Description = "×2 монеты и XP за бой, разрушения, 67 и бонусы. Итог матча не удваивается.",
		Announcement = "Сражайся, разрушай защиту, захватывай 67 и выполняй задания с ×2",
	},
	RepairPulse = {
		Id = "RepairPulse",
		Name = "ИМПУЛЬС ВОЗРОЖДЕНИЯ",
		ShortName = "REPAIR PULSE",
		Color = Color3.fromRGB(78, 239, 190),
		Duration = 45,
		Description = "Каждые 10 секунд обе команды получают лечение и ремонт построек.",
		Announcement = "Симметричный ремонт для Blue и Orange · уничтоженное не воскрешается",
	},
	MeteorMadness = {
		Id = "MeteorMadness",
		Name = "МЕТЕОРНЫЙ ХАОС",
		ShortName = "METEOR MADNESS",
		Color = Color3.fromRGB(163, 105, 255),
		Duration = 45,
		Description = "Телеграфируемые метеориты: уходи из круга. До 18 урона, минимум 1 HP.",
		Announcement = "Смотри на предупреждающие круги · ядра и постройки не повреждаются",
	},
}

function EventCatalog.Get(id)
	return type(id) == "string" and EventCatalog.Events[id] or nil
end

function EventCatalog.GetForSlot(slot)
	local index = math.floor(tonumber(slot) or 0) % #EventCatalog.Order + 1
	return EventCatalog.Events[EventCatalog.Order[index]]
end

return EventCatalog
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="40">
        <Properties>
          <string name="Name">SeasonCatalog</string>
          <string name="Source"><![CDATA[-- BLOCKSIEGE // Fixed seasonal themes. Only these IDs can cross the admin remote.
local SeasonCatalog = {}

SeasonCatalog.Default = "NewYear"
SeasonCatalog.Order = { "NewYear", "Halloween", "Defenders", "WomensDay", "Easter" }
SeasonCatalog.Items = {
	NewYear = {
		Id = "NewYear", Name = "НОВЫЙ ГОД", Subtitle = "Снежные огни · подарки · общий штурм",
		Color = Color3.fromRGB(107, 220, 255), Accent = Color3.fromRGB(255, 211, 93), Material = Enum.Material.Snow,
	},
	Halloween = {
		Id = "Halloween", Name = "ХЭЛЛУИН", Subtitle = "Тыквенные огни · неоновые тени · охота за ядром",
		Color = Color3.fromRGB(255, 137, 57), Accent = Color3.fromRGB(184, 106, 255), Material = Enum.Material.Slate,
	},
	Defenders = {
		Id = "Defenders", Name = "23 ФЕВРАЛЯ", Subtitle = "Знамёна защитников · командная дисциплина",
		Color = Color3.fromRGB(255, 92, 83), Accent = Color3.fromRGB(255, 211, 93), Material = Enum.Material.Metal,
	},
	WomensDay = {
		Id = "WomensDay", Name = "8 МАРТА", Subtitle = "Весенние цветы · тёплые огни · новый сезон",
		Color = Color3.fromRGB(255, 126, 193), Accent = Color3.fromRGB(255, 225, 119), Material = Enum.Material.Grass,
	},
	Easter = {
		Id = "Easter", Name = "ПАСХА", Subtitle = "Пастельные яйца · весенние огни · общий праздник",
		Color = Color3.fromRGB(175, 239, 157), Accent = Color3.fromRGB(196, 164, 255), Material = Enum.Material.SmoothPlastic,
	},
}

function SeasonCatalog.Get(id)
	return type(id) == "string" and SeasonCatalog.Items[id] or nil
end

return SeasonCatalog
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="41">
        <Properties>
          <string name="Name">ExpeditionCatalog</string>
          <string name="Source"><![CDATA[-- BLOCKSIEGE // Level/score-gated PvE locations, separate from the 6v6 objective.
local ExpeditionCatalog = {}

ExpeditionCatalog.Order = { "VerdantBastion", "FrostFoundry", "EmberCitadel", "VoidObservatory" }
ExpeditionCatalog.MaxWaves = 3
ExpeditionCatalog.Items = {
	VerdantBastion = {
		Id = "VerdantBastion", Name = "VERDANT BASTION", Subtitle = "Тихий форпост · первая экспедиция",
		RequiredLevel = 1, RequiredWins = 0, Center = Vector3.new(-900, 0, 650),
		Color = Color3.fromRGB(91, 220, 164), Accent = Color3.fromRGB(255, 220, 113),
		EnemyName = "THORNLING", EnemyHealth = 90, EnemyDamage = 8, EnemySpeed = 10,
		BaseEnemies = 3, KillCoins = 3, KillXP = 8, RewardCoins = 60, RewardXP = 100,
	},
	FrostFoundry = {
		Id = "FrostFoundry", Name = "FROST FOUNDRY", Subtitle = "Ледяной завод · бронированные волны",
		RequiredLevel = 3, RequiredWins = 1, Center = Vector3.new(0, 0, 650),
		Color = Color3.fromRGB(111, 211, 255), Accent = Color3.fromRGB(195, 240, 255),
		EnemyName = "FROST DRONE", EnemyHealth = 150, EnemyDamage = 12, EnemySpeed = 11,
		BaseEnemies = 4, KillCoins = 4, KillXP = 11, RewardCoins = 100, RewardXP = 160,
	},
	EmberCitadel = {
		Id = "EmberCitadel", Name = "EMBER CITADEL", Subtitle = "Огненная цитадель · тяжёлые стражи",
		RequiredLevel = 5, RequiredWins = 2, Center = Vector3.new(900, 0, 650),
		Color = Color3.fromRGB(255, 133, 73), Accent = Color3.fromRGB(255, 216, 100),
		EnemyName = "EMBER GUARD", EnemyHealth = 230, EnemyDamage = 17, EnemySpeed = 12,
		BaseEnemies = 5, KillCoins = 5, KillXP = 15, RewardCoins = 150, RewardXP = 240,
	},
	VoidObservatory = {
		Id = "VoidObservatory", Name = "VOID OBSERVATORY", Subtitle = "Обсерватория · финальный PvE рейд",
		RequiredLevel = 8, RequiredWins = 4, Center = Vector3.new(0, 0, 1100),
		Color = Color3.fromRGB(190, 133, 255), Accent = Color3.fromRGB(102, 231, 255),
		EnemyName = "VOID WARDEN", EnemyHealth = 340, EnemyDamage = 23, EnemySpeed = 13,
		BaseEnemies = 6, KillCoins = 7, KillXP = 20, RewardCoins = 220, RewardXP = 360,
	},
}

function ExpeditionCatalog.Get(id)
	return type(id) == "string" and ExpeditionCatalog.Items[id] or nil
end

function ExpeditionCatalog.IsUnlocked(id, level, wins)
	local definition = ExpeditionCatalog.Get(id)
	return definition ~= nil and (tonumber(level) or 1) >= definition.RequiredLevel and (tonumber(wins) or 0) >= definition.RequiredWins
end

return ExpeditionCatalog
]]></string>
        </Properties>
      </Item>



      <Item class="ModuleScript" referent="6">
        <Properties>
          <string name="Name">WeaponModels</string>
          <string name="Source"><![CDATA[-- BLOCKSIEGE // SCULPTED V2 WEAPONS
-- New rounded/cylindrical/wedge silhouettes, not recolors of the old voxel set.
-- The same procedural assembly is used in a character's hand, lobby showcases
-- and the isolated ViewportFrame. Gameplay IDs/stats remain in Catalog.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("BlockSiege")
local Catalog = require(Shared:WaitForChild("Catalog"))

local WeaponModels = {}
local DARK = Color3.fromRGB(32, 39, 48)
local GRAPHITE = Color3.fromRGB(20, 27, 38)
local METAL = Color3.fromRGB(111, 130, 143)
local SILVER = Color3.fromRGB(198, 220, 229)
local WOOD = Color3.fromRGB(133, 83, 49)
local LIGHT = Color3.fromRGB(232, 246, 249)
local GOLD = Color3.fromRGB(235, 177, 50)
local GOLD_LIGHT = Color3.fromRGB(255, 226, 137)

local TEXTURES = {
	[Enum.Material.WoodPlanks] = { Asset = "rbxassetid://9439658515", Tile = 1.2, Transparency = 0.06 },
	[Enum.Material.Metal] = { Asset = "rbxassetid://9920574687", Tile = 1.4, Transparency = 0.1 },
	[Enum.Material.DiamondPlate] = { Asset = "rbxassetid://10237720195", Tile = 1.3, Transparency = 0.08 },
}
local TEXTURED = { Handle = true, Stock = true, Body = true, HeavyBody = true, RailBody = true, PrismReceiver = true, TeslaBody = true, GauntletPalm = true, Armor = true }

local function texture(part, name, material)
	local style = TEXTURES[material]
	if not style or not TEXTURED[name] then
		return
	end
	local surface = Instance.new("Texture")
	surface.Name = "WeaponSurfaceTexture"
	surface.Texture = style.Asset
	surface.Face = Enum.NormalId.Front
	surface.StudsPerTileU = style.Tile
	surface.StudsPerTileV = style.Tile
	surface.Transparency = style.Transparency
	surface.Parent = part
	part:SetAttribute("SurfaceTextured", true)
end

local function part(model, name, size, cframe, color, material, shape)
	local object = Instance.new(shape == "Wedge" and "WedgePart" or "Part")
	object.Name = name
	object.Size = size
	object.CFrame = cframe
	object.Color = color
	object.Material = material or Enum.Material.SmoothPlastic
	if shape == "Ball" then
		object.Shape = Enum.PartType.Ball
	elseif shape == "Cylinder" then
		object.Shape = Enum.PartType.Cylinder
	end
	object.Reflectance = object.Material == Enum.Material.Metal and 0.1 or 0
	object.Anchored = true -- safe by default for lobby/viewport; Equip unwelds this into a hand assembly
	object.CanCollide = false
	object.CanTouch = false
	object.CanQuery = false
	object.Transparency = 0
	object.CastShadow = true
	object.Massless = true
	object.TopSurface = Enum.SurfaceType.Smooth
	object.BottomSurface = Enum.SurfaceType.Smooth
	object.Parent = model
	texture(object, name, object.Material)
	return object
end

-- Roblox cylinder primitives use the X axis. These helpers explicitly rotate
-- that axis instead of relying on a visually ambiguous cube approximation.
local function cylinderZ(model, name, length, diameter, cframe, color, material)
	return part(model, name, Vector3.new(length, diameter, diameter), cframe * CFrame.Angles(0, math.rad(90), 0), color, material, "Cylinder")
end

local function cylinderX(model, name, length, diameter, cframe, color, material)
	return part(model, name, Vector3.new(length, diameter, diameter), cframe, color, material, "Cylinder")
end

local function cylinderY(model, name, height, diameter, cframe, color, material)
	return part(model, name, Vector3.new(height, diameter, diameter), cframe * CFrame.Angles(0, 0, math.rad(90)), color, material, "Cylinder")
end

local function ringZ(model, name, center, radius, depth, color, material)
	for index = 0, 7 do
		local angle = index * math.pi / 4
		local segment = center * CFrame.new(math.cos(angle) * radius, math.sin(angle) * radius, 0) * CFrame.Angles(0, 0, angle + math.pi / 2)
		part(model, name, Vector3.new(radius * 0.72, 0.2, depth), segment, color, material or Enum.Material.Metal)
	end
end

local function gripGrooves(model, handle, color)
	for index = 0, 3 do
		part(model, "GripGroove", Vector3.new(handle.Size.X * 1.05, 0.07, handle.Size.Z * 1.05), handle.CFrame * CFrame.new(0, -0.42 + index * 0.24, 0), color or GRAPHITE, Enum.Material.Metal)
	end
end

local function baseModel(weaponId)
	local weapon = Catalog.GetWeapon(weaponId) or Catalog.Weapons.Carbine
	local model = Instance.new("Model")
	model.Name = "Weapon_" .. weapon.Id
	model:SetAttribute("WeaponId", weapon.Id)
	model:SetAttribute("WeaponRarity", weapon.Rarity)
	model:SetAttribute("ModelGeneration", "SculptedV2")
	model:SetAttribute("VisualRevision", 2)
	local handle = part(model, "Handle", Vector3.new(0.68, 1.3, 0.72), CFrame.new(0, -0.25, 0.35), WOOD, Enum.Material.WoodPlanks)
	model.PrimaryPart = handle
	return model, weapon, handle
end

function WeaponModels.Build(weaponId)
	local model, weapon, handle = baseModel(weaponId)
	local accent = weapon.Color

	if weapon.Model == "SMG" then
		part(model, "Body", Vector3.new(1.15, 0.82, 1.8), CFrame.new(0, 0.35, -0.65), accent, Enum.Material.Metal)
		cylinderZ(model, "Barrel", 2.2, 0.42, CFrame.new(0, 0.42, -2.45), SILVER, Enum.Material.Metal)
		cylinderZ(model, "MuzzleBrake", 0.55, 0.68, CFrame.new(0, 0.42, -3.75), GRAPHITE, Enum.Material.DiamondPlate)
		ringZ(model, "MuzzleGlow", CFrame.new(0, 0.42, -4.05), 0.42, 0.16, accent, Enum.Material.Neon)
		part(model, "Magazine", Vector3.new(0.62, 1.35, 0.72), CFrame.new(0, -0.48, -0.75) * CFrame.Angles(math.rad(-12), 0, 0), GRAPHITE, Enum.Material.Metal, "Wedge")
		for _, side in ipairs({ -1, 1 }) do
			part(model, "StockFork", Vector3.new(0.18, 0.25, 1.35), CFrame.new(side * 0.42, 0.38, 0.95), DARK, Enum.Material.Metal)
		end
		part(model, "Stock", Vector3.new(1.05, 0.65, 0.3), CFrame.new(0, 0.38, 1.65), DARK, Enum.Material.Metal)
		cylinderZ(model, "Sight", 0.75, 0.38, CFrame.new(0, 0.98, -0.65), LIGHT, Enum.Material.Metal)
	elseif weapon.Model == "Scatter" then
		part(model, "Body", Vector3.new(1.55, 0.92, 1.85), CFrame.new(0, 0.35, -0.7), accent, Enum.Material.Metal, "Ball")
		for _, side in ipairs({ -1, 1 }) do
			cylinderZ(model, "TwinBarrel", 3.15, 0.5, CFrame.new(side * 0.38, 0.52, -2.85), SILVER, Enum.Material.Metal)
			cylinderZ(model, "Muzzle", 0.42, 0.7, CFrame.new(side * 0.38, 0.52, -4.55), GRAPHITE, Enum.Material.DiamondPlate)
		end
		cylinderX(model, "DrumMagazine", 0.85, 1.35, CFrame.new(0, -0.42, -0.95), DARK, Enum.Material.DiamondPlate)
		part(model, "Pump", Vector3.new(1.35, 0.55, 1.05), CFrame.new(0, 0.05, -2.25), WOOD, Enum.Material.WoodPlanks, "Ball")
		part(model, "Stock", Vector3.new(1.1, 0.82, 1.5), CFrame.new(0, 0.18, 1.05) * CFrame.Angles(math.rad(8), 0, 0), WOOD, Enum.Material.WoodPlanks, "Wedge")
	elseif weapon.Model == "Marksman" then
		part(model, "Body", Vector3.new(1.05, 0.78, 2.75), CFrame.new(0, 0.35, -1.15), accent, Enum.Material.Metal)
		cylinderZ(model, "LongBarrel", 4.25, 0.32, CFrame.new(0, 0.46, -4.4), SILVER, Enum.Material.Metal)
		cylinderZ(model, "MuzzleBrake", 0.75, 0.58, CFrame.new(0, 0.46, -6.85), GRAPHITE, Enum.Material.DiamondPlate)
		cylinderZ(model, "Scope", 2.15, 0.62, CFrame.new(0, 1.12, -1.35), DARK, Enum.Material.Metal)
		cylinderZ(model, "ScopeGlass", 0.16, 0.72, CFrame.new(0, 1.12, -2.52), LIGHT, Enum.Material.Glass)
		for _, z in ipairs({ -0.65, -2.05 }) do
			ringZ(model, "ScopeRing", CFrame.new(0, 1.12, z), 0.43, 0.18, METAL, Enum.Material.Metal)
		end
		for _, side in ipairs({ -1, 1 }) do
			part(model, "Bipod", Vector3.new(0.18, 1.5, 0.22), CFrame.new(side * 0.55, -0.4, -3.6) * CFrame.Angles(0, 0, math.rad(side * 28)), DARK, Enum.Material.Metal)
		end
		part(model, "Stock", Vector3.new(1, 0.9, 1.55), CFrame.new(0, 0.12, 1.15), WOOD, Enum.Material.WoodPlanks, "Wedge")
	elseif weapon.Model == "Demolisher" then
		part(model, "HeavyBody", Vector3.new(2, 1.45, 2.35), CFrame.new(0, 0.45, -0.9), accent, Enum.Material.DiamondPlate, "Ball")
		for _, x in ipairs({ -0.55, 0.55 }) do
			for _, y in ipairs({ 0.1, 0.85 }) do
				cylinderZ(model, "QuadBarrel", 2.8, 0.58, CFrame.new(x, y, -3.25), GRAPHITE, Enum.Material.Metal)
				cylinderZ(model, "MuzzleGlow", 0.18, 0.42, CFrame.new(x, y, -4.75), accent, Enum.Material.Neon)
			end
		end
		part(model, "Armor", Vector3.new(2.25, 0.48, 1.9), CFrame.new(0, 1.4, -0.85) * CFrame.Angles(math.rad(-8), 0, 0), METAL, Enum.Material.DiamondPlate, "Wedge")
		part(model, "Counterweight", Vector3.new(1.55, 1.15, 1.2), CFrame.new(0, 0.3, 0.95), DARK, Enum.Material.Metal, "Ball")
	elseif weapon.Model == "Rail" then
		part(model, "RailBody", Vector3.new(1.25, 0.9, 3.1), CFrame.new(0, 0.4, -1.2), accent, Enum.Material.Metal, "Wedge")
		cylinderZ(model, "RailEnergy", 5.8, 0.26, CFrame.new(0, 0.48, -4.6), LIGHT, Enum.Material.Neon)
		for _, side in ipairs({ -1, 1 }) do
			part(model, "RailSide", Vector3.new(0.22, 0.35, 5.5), CFrame.new(side * 0.62, 0.48, -4.25), GRAPHITE, Enum.Material.Metal)
		end
		for index = 0, 4 do
			ringZ(model, "EnergyRing", CFrame.new(0, 0.48, -2.2 - index * 0.95), 0.74, 0.22, index % 2 == 0 and accent or SILVER, index % 2 == 0 and Enum.Material.Neon or Enum.Material.Metal)
		end
		cylinderZ(model, "RailSight", 1.25, 0.48, CFrame.new(0, 1.18, -1.2), LIGHT, Enum.Material.Metal)
		part(model, "Stock", Vector3.new(1.1, 0.9, 1.35), CFrame.new(0, 0.2, 1), GRAPHITE, Enum.Material.Metal, "Wedge")
	elseif weapon.Model == "Vortex" then
		part(model, "VortexBody", Vector3.new(1.5, 1.1, 2.25), CFrame.new(0, 0.4, -0.85), accent, Enum.Material.Metal, "Ball")
		cylinderZ(model, "VortexCore", 3.3, 0.58, CFrame.new(0, 0.45, -3.15), LIGHT, Enum.Material.Neon)
		for index = 0, 2 do
			ringZ(model, "EnergyRing", CFrame.new(0, 0.45, -2.15 - index * 0.9), 0.95 - index * 0.12, 0.25, accent, Enum.Material.Neon)
		end
		for _, side in ipairs({ -1, 1 }) do
			part(model, "VortexFin", Vector3.new(0.35, 1.35, 1.85), CFrame.new(side * 0.95, 0.55, -1.05) * CFrame.Angles(0, 0, math.rad(side * 24)), accent, Enum.Material.Metal, "Wedge")
		end
		part(model, "VortexStock", Vector3.new(1.15, 0.85, 1.25), CFrame.new(0, 0.2, 0.9), GRAPHITE, Enum.Material.Metal, "Wedge")
	elseif weapon.Model == "Gauntlet" then
		handle.Color = GOLD
		handle.Material = Enum.Material.Metal
		cylinderY(model, "GauntletCuff", 1.65, 2.45, CFrame.new(0, 0.05, 0.3), accent, Enum.Material.DiamondPlate)
		part(model, "GauntletPalm", Vector3.new(2.35, 1.85, 2.1), CFrame.new(0, 0.6, -1.15), accent, Enum.Material.Metal, "Ball")
		part(model, "PalmPlate", Vector3.new(1.75, 0.38, 1.55), CFrame.new(0, 1.55, -1.15), GOLD_LIGHT, Enum.Material.DiamondPlate, "Wedge")
		for index = 0, 3 do
			local x = -0.78 + index * 0.52
			cylinderZ(model, "GauntletFinger", 1.65, 0.46, CFrame.new(x, 0.82, -2.75), accent, Enum.Material.Metal)
			part(model, "GauntletKnuckle", Vector3.new(0.56, 0.68, 0.65), CFrame.new(x, 1.02, -3.65), GOLD_LIGHT, Enum.Material.Metal, "Ball")
		end
		cylinderZ(model, "GauntletThumb", 1.45, 0.68, CFrame.new(1.35, 0.3, -1.65) * CFrame.Angles(0, math.rad(-24), 0), accent, Enum.Material.Metal)
		local gemColors = { Color3.fromRGB(255,80,70), Color3.fromRGB(70,160,255), Color3.fromRGB(105,240,130), Color3.fromRGB(190,95,255), Color3.fromRGB(255,205,60), Color3.fromRGB(255,125,45) }
		for index, gemColor in ipairs(gemColors) do
			local x = -0.65 + ((index - 1) % 3) * 0.65
			local z = index <= 3 and -0.85 or -1.65
			part(model, "InfinityGem", Vector3.new(0.44, 0.3, 0.44), CFrame.new(x, 1.8, z), gemColor, Enum.Material.Neon, "Ball")
		end
		cylinderZ(model, "InfinityScope", 2.65, 0.52, CFrame.new(0, 2.08, -1.75), Color3.fromRGB(188,104,255), Enum.Material.Neon)
		ringZ(model, "InfinityEmitter", CFrame.new(0, 0.58, -4.35), 0.65, 0.3, Color3.fromRGB(222,173,255), Enum.Material.Neon)
	elseif weapon.Model == "PrismLance" then
		handle.Color = GRAPHITE
		handle.Material = Enum.Material.Metal
		part(model, "PrismReceiver", Vector3.new(1.45, 1, 2.9), CFrame.new(0, 0.35, -1.05), GRAPHITE, Enum.Material.Metal, "Wedge")
		cylinderZ(model, "PrismBarrel", 4.6, 0.38, CFrame.new(0, 0.52, -4.4), accent, Enum.Material.Neon)
		part(model, "PrismTip", Vector3.new(0.75, 0.75, 1.6), CFrame.new(0, 0.52, -7.15), LIGHT, Enum.Material.Glass, "Wedge")
		cylinderZ(model, "PrismScope", 2.1, 0.58, CFrame.new(0, 1.15, -1.35), METAL, Enum.Material.Metal)
		cylinderZ(model, "PrismLens", 0.18, 0.72, CFrame.new(0, 1.15, -2.52), LIGHT, Enum.Material.Glass)
		for index = 0, 4 do
			local shardColor = index % 2 == 0 and accent or Color3.fromRGB(206,119,255)
			part(model, "PrismShard", Vector3.new(0.68, 0.68, 1.25), CFrame.new(0, 0.58, -2.25 - index * 0.82) * CFrame.Angles(math.rad(45), math.rad(index * 23), math.rad(45)), shardColor, Enum.Material.Neon, "Wedge")
		end
		for _, side in ipairs({ -1, 1 }) do
			part(model, "PrismFin", Vector3.new(0.3, 1.2, 2.2), CFrame.new(side * 0.9, 0.45, -1.1) * CFrame.Angles(0, 0, math.rad(side * 25)), accent, Enum.Material.Metal, "Wedge")
		end
	elseif weapon.Model == "TeslaCarbine" then
		handle.Color = GRAPHITE
		part(model, "TeslaBody", Vector3.new(1.55, 1.1, 2.45), CFrame.new(0, 0.4, -0.9), accent, Enum.Material.DiamondPlate, "Ball")
		for _, side in ipairs({ -1, 1 }) do
			cylinderZ(model, "TeslaRail", 3.3, 0.28, CFrame.new(side * 0.48, 0.48, -3.45), SILVER, Enum.Material.Metal)
			cylinderZ(model, "TeslaElectrode", 1.65, 0.34, CFrame.new(side * 0.55, 0.75, -5.25) * CFrame.Angles(0, math.rad(side * 8), 0), LIGHT, Enum.Material.Metal)
			part(model, "TeslaArc", Vector3.new(0.18, 0.18, 2.1), CFrame.new(side * 0.42, 1.12, -3.85) * CFrame.Angles(0, math.rad(side * 30), 0), accent, Enum.Material.Neon, "Wedge")
		end
		for index = 0, 3 do
			ringZ(model, "TeslaGlow", CFrame.new(0, 0.5, -1.75 - index * 0.75), 0.85, 0.25, index % 2 == 0 and accent or SILVER, index % 2 == 0 and Enum.Material.Neon or Enum.Material.Metal)
		end
		part(model, "TeslaCapacitor", Vector3.new(1, 1.45, 1), CFrame.new(0, -0.42, -0.75), Color3.fromRGB(48,104,137), Enum.Material.DiamondPlate, "Ball")
		cylinderZ(model, "TeslaSight", 0.9, 0.45, CFrame.new(0, 1.2, -0.8), LIGHT, Enum.Material.Neon)
	elseif weapon.Model == "MeteorMaul" then
		handle.Size = Vector3.new(0.72, 3.5, 0.72)
		handle.CFrame = CFrame.new(0, 0.1, 0.55)
		handle.Color = GRAPHITE
		handle.Material = Enum.Material.WoodPlanks
		cylinderY(model, "MaulGrip", 1.2, 0.9, CFrame.new(0, -0.9, 0.55), accent, Enum.Material.Fabric)
		for _, chunk in ipairs({
			{ Vector3.new(0,1.65,-1.35), Vector3.new(3.3,2.2,2.3) },
			{ Vector3.new(-1.25,1.85,-1.2), Vector3.new(1.5,1.5,1.6) },
			{ Vector3.new(1.2,1.45,-1.5), Vector3.new(1.6,1.7,1.5) },
			{ Vector3.new(0.2,2.65,-1.25), Vector3.new(1.8,1.2,1.5) },
		}) do
			part(model, "MeteorHead", chunk[2], CFrame.new(chunk[1]) * CFrame.Angles(math.rad(12), math.rad(18), math.rad(8)), DARK, Enum.Material.Cobblestone, "Ball")
		end
		part(model, "MeteorCore", Vector3.new(1.65, 1.65, 0.55), CFrame.new(0, 1.65, -2.65), accent, Enum.Material.Neon, "Ball")
		cylinderX(model, "MeteorBand", 3.8, 0.48, CFrame.new(0, 1.65, -1.35), METAL, Enum.Material.DiamondPlate)
		for _, side in ipairs({ -1, 1 }) do
			part(model, "MeteorSpike", Vector3.new(0.85, 0.85, 1.85), CFrame.new(side * 2, 1.65, -1.35) * CFrame.Angles(0, math.rad(side * 90), 0), accent, Enum.Material.Metal, "Wedge")
			part(model, "MeteorFragment", Vector3.new(0.85, 0.85, 0.85), CFrame.new(side * 1.2, 3.15, -1.2) * CFrame.Angles(math.rad(25), math.rad(35), 0), accent, Enum.Material.Neon, "Ball")
		end
	elseif weapon.Model == "VoidScythe" then
		handle.Size = Vector3.new(0.6, 3.9, 0.6)
		handle.CFrame = CFrame.new(0, 0.05, 0.5)
		handle.Color = GRAPHITE
		handle.Material = Enum.Material.Metal
		cylinderY(model, "VoidGrip", 1.25, 0.78, CFrame.new(0, -1.15, 0.5), accent, Enum.Material.Fabric)
		part(model, "VoidOrb", Vector3.new(1.35, 1.35, 1.35), CFrame.new(0, 1.85, -0.35), accent, Enum.Material.Neon, "Ball")
		ringZ(model, "VoidHalo", CFrame.new(0, 1.85, -0.35), 1.05, 0.18, SILVER, Enum.Material.Metal)
		for index = 0, 6 do
			local angle = math.rad(18 + index * 17)
			local x = math.cos(angle) * (1.25 + index * 0.23)
			local y = 1.8 + math.sin(angle) * (1.1 + index * 0.13)
			local z = -1.05 - index * 0.22
			part(model, "VoidBlade", Vector3.new(1.5, 0.32, 0.72), CFrame.new(x, y, z) * CFrame.Angles(math.rad(-12), math.rad(-20 - index * 8), angle), GRAPHITE, Enum.Material.Metal, "Wedge")
			part(model, "VoidEdge", Vector3.new(1.55, 0.12, 0.2), CFrame.new(x, y + 0.24, z - 0.28) * CFrame.Angles(math.rad(-12), math.rad(-20 - index * 8), angle), accent, Enum.Material.Neon, "Wedge")
		end
		part(model, "VoidCounterweight", Vector3.new(1, 1, 1), CFrame.new(0, -2.05, 0.5), accent, Enum.Material.Neon, "Ball")
	elseif weapon.Model == "Knife" or weapon.Model == "DualKnives" then
		handle.Color = GRAPHITE
		handle.Material = Enum.Material.Fabric
		local sides = weapon.Model == "DualKnives" and { -1, 1 } or { 1 }
		for _, side in ipairs(sides) do
			local x = weapon.Model == "DualKnives" and side * 0.72 or 0
			local rotation = weapon.Model == "DualKnives" and CFrame.Angles(0, math.rad(side * 12), math.rad(side * 8)) or CFrame.new()
			cylinderX(model, "KnifeGuard", 1.45, 0.32, CFrame.new(x, 0.15, -0.72) * rotation, accent, Enum.Material.Metal)
			part(model, "KnifeBlade", Vector3.new(0.72, 0.24, 3.45), CFrame.new(x, 0.35, -2.55) * rotation, SILVER, Enum.Material.Metal, "Wedge")
			part(model, "KnifeTip", Vector3.new(0.42, 0.18, 1.25), CFrame.new(x, 0.35, -4.85) * rotation, LIGHT, Enum.Material.Metal, "Wedge")
			part(model, "BladeEdge", Vector3.new(0.12, 0.12, 3.85), CFrame.new(x + 0.34, 0.24, -2.85) * rotation, accent, Enum.Material.Neon, "Wedge")
			part(model, "BladeFuller", Vector3.new(0.16, 0.08, 2.65), CFrame.new(x, 0.5, -2.45) * rotation, GRAPHITE, Enum.Material.DiamondPlate)
			part(model, "GuardGem", Vector3.new(0.42, 0.42, 0.42), CFrame.new(x, 0.42, -0.72) * rotation, accent, Enum.Material.Neon, "Ball")
			part(model, "Pommel", Vector3.new(0.82, 0.82, 0.82), CFrame.new(x, -1.05, 0.35) * rotation, accent, Enum.Material.Metal, "Ball")
		end
	else
		part(model, "Body", Vector3.new(1.25, 0.88, 2.35), CFrame.new(0, 0.35, -0.9), accent, Enum.Material.Metal, "Ball")
		cylinderZ(model, "Barrel", 2.75, 0.44, CFrame.new(0, 0.46, -3.25), SILVER, Enum.Material.Metal)
		cylinderZ(model, "MuzzleBrake", 0.62, 0.68, CFrame.new(0, 0.46, -4.85), GRAPHITE, Enum.Material.DiamondPlate)
		ringZ(model, "MuzzleGlow", CFrame.new(0, 0.46, -5.2), 0.4, 0.14, accent, Enum.Material.Neon)
		part(model, "Magazine", Vector3.new(0.7, 1.3, 0.82), CFrame.new(0, -0.45, -1) * CFrame.Angles(math.rad(-10), 0, 0), GRAPHITE, Enum.Material.Metal, "Wedge")
		part(model, "Stock", Vector3.new(1.05, 0.78, 1.45), CFrame.new(0, 0.2, 1.05), WOOD, Enum.Material.WoodPlanks, "Wedge")
		cylinderZ(model, "Sight", 0.85, 0.42, CFrame.new(0, 1.05, -1.05), LIGHT, Enum.Material.Metal)
		for _, side in ipairs({ -1, 1 }) do
			part(model, "AccentArmor", Vector3.new(0.16, 0.5, 1.4), CFrame.new(side * 0.67, 0.38, -0.85), accent, Enum.Material.DiamondPlate, "Wedge")
		end
	end
	gripGrooves(model, handle, GRAPHITE)
	model:SetAttribute("SurfaceDetail", "RoundedCylindricalWedgeAssembly")
	return model
end

function WeaponModels.ApplySkin(model, skinId)
	if not model then
		return
	end
	local celestial = skinId == "CelestialArsenal"
	if skinId ~= "GoldenArsenal" and not celestial then
		model:SetAttribute("CosmeticSkin", skinId or "Default")
		return
	end
	local baseFinish = celestial and Color3.fromRGB(79,65,145) or GOLD
	local energyFinish = celestial and Color3.fromRGB(105,233,255) or GOLD_LIGHT
	local bladeFinish = celestial and Color3.fromRGB(206,239,255) or Color3.fromRGB(255,239,184)
	local glowColor = celestial and Color3.fromRGB(142,112,255) or Color3.fromRGB(255,196,65)
	local energyNames = { Sight=true, ScopeGlass=true, ScopeLens=true, EnergyRing=true, MuzzleGlow=true, RailEnergy=true, VortexCore=true, BladeEdge=true, PrismShard=true, PrismBarrel=true, PrismTip=true, TeslaGlow=true, TeslaArc=true, MeteorCore=true, MeteorFragment=true, VoidOrb=true, VoidEdge=true, VoidCounterweight=true, InfinityScope=true, InfinityEmitter=true }
	for _, object in ipairs(model:GetDescendants()) do
		if object:IsA("BasePart") then
			local name = object.Name
			local lowerName = string.lower(name)
			local originalColor = object.Color
			local isEnergy = energyNames[name] == true or object.Material == Enum.Material.Neon
			local isGrip = name == "Handle" or name == "Stock" or name == "Magazine" or name == "Pump" or string.find(lowerName,"grip",1,true) ~= nil or string.find(lowerName,"stock",1,true) ~= nil or name == "Counterweight" or name == "TeslaCapacitor"
			if name == "InfinityGem" then
				object.Material = Enum.Material.Neon
				object.Color = originalColor
				object.Reflectance = 0
			elseif isEnergy then
				object.Material = Enum.Material.Neon
				object.Color = originalColor:Lerp(energyFinish, celestial and 0.42 or 0.22)
				object.Reflectance = 0
			elseif isGrip then
				object.Material = name == "Handle" and Enum.Material.Fabric or Enum.Material.Metal
				object.Color = GRAPHITE
				object.Reflectance = 0.04
			elseif name == "KnifeBlade" or name == "KnifeTip" then
				object.Material = Enum.Material.Metal
				object.Color = bladeFinish
				object.Reflectance = 0.16
			else
				object.Material = Enum.Material.Metal
				object.Color = baseFinish
				object.Reflectance = celestial and 0.2 or 0.12
			end
		end
	end
	if model.PrimaryPart then
		for _, name in ipairs({ "GoldenWeaponGlow", "CelestialWeaponGlow" }) do
			local oldLight = model.PrimaryPart:FindFirstChild(name)
			if oldLight then oldLight:Destroy() end
		end
		local light = Instance.new("PointLight")
		light.Name = celestial and "CelestialWeaponGlow" or "GoldenWeaponGlow"
		light.Color = glowColor
		light.Brightness = celestial and 1.5 or 1.1
		light.Range = celestial and 8 or 6
		light.Parent = model.PrimaryPart
	end
	model:SetAttribute("CosmeticSkin", skinId)
	model:SetAttribute("Finish", celestial and "CelestialMetalEnergy" or "GoldGraphiteAccent")
end

function WeaponModels.Equip(character, weaponId, skinId)
	local old = character:FindFirstChild("EquippedWeapon")
	if old then old:Destroy() end
	local anchor = character:FindFirstChild("RightHand") or character:FindFirstChild("Right Arm") or character:FindFirstChild("HumanoidRootPart")
	if not anchor then return nil end
	local model = WeaponModels.Build(weaponId)
	model.Name = "EquippedWeapon"
	WeaponModels.ApplySkin(model, skinId)
	local offset = CFrame.new(0, -0.35, -0.75)
	for _, object in ipairs(model:GetChildren()) do
		if object:IsA("BasePart") then
			local localCFrame = object.CFrame
			object.Anchored = false
			object.Transparency = 0
			object.CFrame = anchor.CFrame * offset * localCFrame
			local weld = Instance.new("Weld")
			weld.Name = "WeaponWeld"
			weld.Part0 = anchor
			weld.Part1 = object
			weld.C0 = offset * localCFrame
			weld.C1 = CFrame.new()
			weld.Parent = object
		end
	end
	model.Parent = character
	local definition = Catalog.GetWeapon(weaponId)
	local outline = Instance.new("Highlight")
	outline.Name = "WeaponVisibilityOutline"
	outline.FillTransparency = 1
	outline.OutlineTransparency = 0.35
	outline.OutlineColor = definition and definition.Color or LIGHT
	outline.DepthMode = Enum.HighlightDepthMode.Occluded
	outline.Parent = model
	character:SetAttribute("WeaponId", weaponId)
	character:SetAttribute("WeaponSkin", skinId or "Default")
	character:SetAttribute("WeaponModelGeneration", "SculptedV2")
	character:SetAttribute("WeaponVisible", model.PrimaryPart ~= nil)
	return model
end

return WeaponModels
]]></string>
        </Properties>
      </Item>
<Item class="ModuleScript" referent="35">
        <Properties>
          <string name="Name">VisualModels</string>
          <string name="Source"><![CDATA[-- BLOCKSIEGE // COHESIVE FORTRESS VISUALS
-- Rounded prop assemblies share one warm stone/timber palette. Gameplay collision
-- stays in the services; these models are the visible layer and placement ghosts.
local VisualModels = {}

local INK = Color3.fromRGB(42, 46, 48)
local STONE = Color3.fromRGB(139, 145, 139)
local STONE_DARK = Color3.fromRGB(70, 77, 75)
local STONE_LIGHT = Color3.fromRGB(190, 187, 166)
local SNOW = Color3.fromRGB(235, 247, 250)
local GOLD = Color3.fromRGB(224, 166, 59)
local WOOD = Color3.fromRGB(119, 75, 43)
local BARK = Color3.fromRGB(76, 54, 38)
local LEAF = Color3.fromRGB(43, 111, 60)
local LEAF_LIGHT = Color3.fromRGB(75, 145, 72)
local LEAF_DARK = Color3.fromRGB(31, 80, 48)
local FIRE = Color3.fromRGB(255, 132, 46)

local TEXTURES = {
	Stone = "rbxassetid://9438459300",
	Wood = "rbxassetid://9439658515",
	Snow = "rbxassetid://9439632387",
	Grass = "rbxassetid://9438956437",
}

local function addTexture(object, asset, tile)
	if not asset then
		return
	end
	for _, face in ipairs({ Enum.NormalId.Top, Enum.NormalId.Front }) do
		local texture = Instance.new("Texture")
		texture.Name = "SculptedSurface"
		texture.Texture = asset
		texture.Face = face
		texture.StudsPerTileU = tile or 4
		texture.StudsPerTileV = tile or 4
		texture.Transparency = 0.08
		texture.Parent = object
	end
	object:SetAttribute("SurfaceTextured", true)
end

local function make(parent, name, size, cframe, color, material, options)
	options = options or {}
	local object = Instance.new(options.ClassName or "Part")
	object.Name = name
	object.Size = size
	object.CFrame = cframe or CFrame.new()
	object.Color = color or STONE
	object.Material = material or Enum.Material.SmoothPlastic
	object.Anchored = true
	object.CanCollide = options.Collide == true
	object.CanTouch = false
	object.CanQuery = options.Query == true
	-- Holiday decoration used to disable every shadow, including large fortress
	-- arches and lobby columns. Architecture can now explicitly keep soft shadows
	-- while small decorative pieces remain lightweight.
	object.CastShadow = options.CastShadow == true or (options.CastShadow ~= false and options.Holiday ~= true)
	if options.Transparency ~= nil then
		object.Transparency = options.Transparency
	end
	object.TopSurface = Enum.SurfaceType.Smooth
	object.BottomSurface = Enum.SurfaceType.Smooth
	if options.Shape then
		object.Shape = options.Shape
	end
	if options.Sphere then
		local mesh = Instance.new("SpecialMesh")
		mesh.Name = "SmoothSculpt"
		mesh.MeshType = Enum.MeshType.Sphere
		mesh.Scale = Vector3.one
		mesh.Parent = object
	end
	if options.Texture then
		addTexture(object, options.Texture, options.Tile)
	end
	if options.Holiday then
		object:SetAttribute("HolidayDecor", true)
	end
	object:SetAttribute("VisualModel", true)
	object.Parent = parent
	return object
end

local function sphere(parent, name, size, cframe, color, material, options)
	options = options or {}
	options.Sphere = true
	return make(parent, name, size, cframe, color, material, options)
end

-- Part cylinders are X-axis aligned. The supplied CFrame uses Y as the
-- authored axis, so rotate the primitive once instead of using square pillars.
local function cylinder(parent, name, radius, height, cframe, color, material, options)
	options = options or {}
	options.Shape = Enum.PartType.Cylinder
	return make(parent, name, Vector3.new(height, radius * 2, radius * 2), cframe * CFrame.Angles(0, 0, math.rad(90)), color, material, options)
end

local function beam(parent, name, from, to, radius, color, material, options)
	local delta = to - from
	if delta.Magnitude < 0.05 then
		return nil
	end
	options = options or {}
	options.Shape = Enum.PartType.Cylinder
	local cframe = CFrame.lookAt((from + to) * 0.5, to) * CFrame.Angles(0, math.rad(90), 0)
	return make(parent, name, Vector3.new(delta.Magnitude, radius * 2, radius * 2), cframe, color, material, options)
end

local function light(parent, name, color, range, brightness)
	local object = Instance.new("PointLight")
	object.Name = name
	object.Color = color
	object.Range = range or 12
	object.Brightness = brightness or 1
	object.Parent = parent
	return object
end

local function model(name, primary, parent, options)
	local object = Instance.new("Model")
	object.Name = name
	object.PrimaryPart = primary
	object:SetAttribute("VisualModel", true)
	if options and options.Holiday then
		object:SetAttribute("HolidayDecor", true)
	end
	object.Parent = parent
	return object
end

function VisualModels.Tree(parent, position, scale, options)
	options = options or {}
	scale = scale or 1
	local holiday = options.Holiday == true
	local trunk = cylinder(parent, "TreeTrunk", 0.82 * scale, 7.2 * scale, CFrame.new(position + Vector3.new(0, 3.6 * scale, 0)), BARK, Enum.Material.WoodPlanks, {
		Collide = options.Collide == true, Query = options.Query == true, Holiday = holiday, Texture = TEXTURES.Wood, Tile = 3,
	})
	local object = model(options.Name or "FortressPine", trunk, parent, { Holiday = holiday })
	trunk.Parent = object
	-- Root flare and five visible branches give the silhouette a natural profile.
	for index = 1, 4 do
		local angle = math.rad(index * 90 + 20)
		local from = position + Vector3.new(0, 0.55 * scale, 0)
		local to = position + Vector3.new(math.cos(angle) * 1.8 * scale, 0.25 * scale, math.sin(angle) * 1.8 * scale)
		beam(object, "RootFlare", from, to, 0.34 * scale, BARK, Enum.Material.WoodPlanks, { Holiday = holiday })
	end
	for index, offset in ipairs({
		Vector3.new(-1.5, 4.4, 0.3), Vector3.new(1.6, 5.3, -0.4), Vector3.new(-1.3, 6.2, -0.5),
		Vector3.new(1.2, 6.9, 0.4), Vector3.new(0, 7.7, 0),
	}) do
		local from = position + Vector3.new(0, (3.5 + index * 0.55) * scale, 0)
		local to = position + offset * scale
		beam(object, "PineBranch", from, to, 0.22 * scale, BARK, Enum.Material.WoodPlanks, { Holiday = holiday })
	end
	local clusters = {
		{ Vector3.new(0, 7.8, 0), Vector3.new(4.4, 3.5, 4.2), LEAF_DARK },
		{ Vector3.new(-1.7, 7.1, 0.5), Vector3.new(3.9, 3.1, 3.8), LEAF },
		{ Vector3.new(1.7, 7.2, -0.4), Vector3.new(4.1, 3.3, 3.9), LEAF },
		{ Vector3.new(0, 9.5, 0), Vector3.new(3.5, 3.2, 3.4), LEAF_LIGHT },
		{ Vector3.new(-1.1, 10.2, 0.2), Vector3.new(2.6, 2.7, 2.6), LEAF },
		{ Vector3.new(0.9, 10.8, -0.2), Vector3.new(2.3, 2.5, 2.3), LEAF_LIGHT },
		{ Vector3.new(0, 12, 0), Vector3.new(1.35, 2.1, 1.35), LEAF_DARK },
	}
	for index, cluster in ipairs(clusters) do
		local center = position + cluster[1] * scale
		sphere(object, holiday and "PineTier" or "Foliage", cluster[2] * scale, CFrame.new(center) * CFrame.Angles(0, math.rad(index * 17), 0), cluster[3], Enum.Material.Grass, {
			Holiday = holiday, Texture = TEXTURES.Grass, Tile = 5,
		})
		if options.Snow and index % 2 == 1 then
			sphere(object, "SnowCap", Vector3.new(cluster[2].X * 0.86, 0.42, cluster[2].Z * 0.86) * scale, CFrame.new(center + Vector3.new(0, cluster[2].Y * 0.38 * scale, 0)), SNOW, Enum.Material.Snow, {
				Holiday = holiday, Texture = TEXTURES.Snow, Tile = 4,
			})
		end
	end
	return object
end

function VisualModels.ChristmasTree(parent, position, scale)
	local object = VisualModels.Tree(parent, position, scale, { Name = "HolidayTree", Holiday = true, Snow = true })
	for tier, y in ipairs({ 6.7, 8.6, 10.4, 12.1 }) do
		local radius = (4.2 - tier * 0.65) * scale
		for index = 1, 5 do
			local angle = math.rad(index * 72 + tier * 21)
			local ornamentPosition = position + Vector3.new(math.cos(angle) * radius, y * scale, math.sin(angle) * radius)
			local color = index % 2 == 0 and GOLD or Color3.fromRGB(212, 55, 76)
			sphere(object, "TreeOrnament", Vector3.one * 0.58 * scale, CFrame.new(ornamentPosition), color, Enum.Material.Neon, { Holiday = true })
			if index == 1 then
				light(object:FindFirstChild("TreeOrnament"), "OrnamentGlow", color, 5 * scale, 0.45)
			end
		end
	end
	local starPosition = position + Vector3.new(0, 14.4 * scale, 0)
	local star = sphere(object, "StarCore", Vector3.one * 0.9 * scale, CFrame.new(starPosition), GOLD, Enum.Material.Neon, { Holiday = true })
	for index = 0, 3 do
		local angle = math.rad(index * 90)
		local ray = cylinder(object, "StarRay", 0.14 * scale, 1.8 * scale, CFrame.new(starPosition) * CFrame.Angles(0, 0, angle), GOLD, Enum.Material.Neon, { Holiday = true })
		ray.CFrame = CFrame.new(starPosition) * CFrame.Angles(0, 0, angle + math.rad(45)) * CFrame.Angles(0, 0, math.rad(90))
	end
	light(star, "StarGlow", GOLD, 16 * scale, 1.8)
	return object
end

function VisualModels.Cloud(parent, position, scale)
	scale = scale or 1
	local first = sphere(parent, "CloudPuff", Vector3.new(14, 5, 8) * scale, CFrame.new(position), SNOW, Enum.Material.SmoothPlastic, { Transparency = 0.12, CastShadow = false })
	local object = model("FortressCloud", first, parent)
	first.Parent = object
	for index, entry in ipairs({
		{ Vector3.new(-8, -0.8, 1), Vector3.new(9, 4, 7) },
		{ Vector3.new(8, -0.5, -1), Vector3.new(10, 4.5, 7) },
		{ Vector3.new(1, 2, 0), Vector3.new(8, 4, 6) },
		{ Vector3.new(-2, 1, -3), Vector3.new(7, 3.5, 5) },
	}) do
		sphere(object, "CloudPuff", entry[2] * scale, CFrame.new(position + entry[1] * scale), SNOW, Enum.Material.SmoothPlastic, { Transparency = 0.16, CastShadow = false })
	end
	return object
end

function VisualModels.Rock(parent, position, scale, options)
	options = options or {}
	scale = scale or 1
	local holiday = options.Holiday == true
	local first
	local object
	local pieces = {
		{ Vector3.new(0, 2.2, 0), Vector3.new(5.8, 4.4, 4.8), STONE_DARK, 12 },
		{ Vector3.new(-2.2, 1.4, 0.8), Vector3.new(3.8, 2.8, 3.4), STONE, -18 },
		{ Vector3.new(2.1, 1.1, -0.7), Vector3.new(3.5, 2.2, 3.1), STONE_LIGHT, 26 },
		{ Vector3.new(0.3, 3.5, -0.4), Vector3.new(3.4, 2.4, 2.8), STONE, 38 },
	}
	for index, piece in ipairs(pieces) do
		local part = sphere(parent, index == 1 and "RockMain" or "RockFragment", piece[2] * scale, CFrame.new(position + piece[1] * scale) * CFrame.Angles(0, math.rad(piece[4]), math.rad(index * 7)), piece[3], Enum.Material.Slate, {
			Query = options.Query == true, Holiday = holiday, Texture = TEXTURES.Stone, Tile = 4,
		})
		first = first or part
		if index == 1 then
			object = model(options.Name or "FortressRock", first, parent, { Holiday = holiday })
			part.Parent = object
		else
			part.Parent = object
		end
	end
	if options.Snow then
		sphere(object, "RockSnow", Vector3.new(3.7, 0.5, 2.8) * scale, CFrame.new(position + Vector3.new(0, 4.5 * scale, 0)), SNOW, Enum.Material.Snow, { Holiday = holiday, Texture = TEXTURES.Snow })
	end
	return object
end

function VisualModels.Tower(parent, prefix, position, scale, accent, options)
	options = options or {}
	scale = scale or 1
	accent = accent or GOLD
	local body = cylinder(parent, prefix .. "Body", 5.2 * scale, 13 * scale, CFrame.new(position + Vector3.new(0, 6.5 * scale, 0)), STONE, Enum.Material.Cobblestone, {
		Holiday = options.Holiday, Texture = TEXTURES.Stone, Tile = 5,
	})
	local object = model(prefix, body, parent, options)
	body.Parent = object
	cylinder(object, "TowerBase", 6.1 * scale, 1.2 * scale, CFrame.new(position + Vector3.new(0, 0.6 * scale, 0)), STONE_DARK, Enum.Material.Slate, { Holiday = options.Holiday, Texture = TEXTURES.Stone })
	cylinder(object, "TowerFootRing", 5.7 * scale, 0.65 * scale, CFrame.new(position + Vector3.new(0, 1.45 * scale, 0)), STONE_LIGHT, Enum.Material.Cobblestone, { Holiday = options.Holiday })
	for _, y in ipairs({ 4.2, 11.8, 13.4 }) do
		cylinder(object, "TowerBand", 5.45 * scale, 0.55 * scale, CFrame.new(position + Vector3.new(0, y * scale, 0)), accent, Enum.Material.Metal, { Holiday = options.Holiday })
	end
	-- A rounded dome and snow cap replace the old cube roof.
	sphere(object, "TowerDome", Vector3.new(11.4, 5.2, 11.4) * scale, CFrame.new(position + Vector3.new(0, 15.3 * scale, 0)), INK, Enum.Material.Slate, { Holiday = options.Holiday, Texture = TEXTURES.Stone })
	sphere(object, "TowerRoofSnow", Vector3.new(9.7, 1.1, 9.7) * scale, CFrame.new(position + Vector3.new(0, 17.2 * scale, 0)), SNOW, Enum.Material.Snow, { Holiday = options.Holiday, Texture = TEXTURES.Snow })
	cylinder(object, "TowerSpire", 0.42 * scale, 4.8 * scale, CFrame.new(position + Vector3.new(0, 19.3 * scale, 0)), GOLD, Enum.Material.Metal, { Holiday = options.Holiday })
	sphere(object, "TowerSpireGem", Vector3.one * 1.05 * scale, CFrame.new(position + Vector3.new(0, 21.9 * scale, 0)), accent, Enum.Material.Neon, { Holiday = options.Holiday })
	for index = 0, 7 do
		local angle = math.rad(index * 45)
		local merlonPosition = position + Vector3.new(math.cos(angle) * 4.55 * scale, 13.9 * scale, math.sin(angle) * 4.55 * scale)
		make(object, "TowerMerlon", Vector3.new(1.35, 1.8, 1.35) * scale, CFrame.new(merlonPosition) * CFrame.Angles(0, -angle, 0), STONE_LIGHT, Enum.Material.Cobblestone, { ClassName = "WedgePart", Holiday = options.Holiday })
	end
	for index = 0, 3 do
		local angle = math.rad(index * 90)
		local radial = Vector3.new(math.cos(angle) * 5.03 * scale, 0, math.sin(angle) * 5.03 * scale)
		local windowPosition = position + radial + Vector3.new(0, 8.1 * scale, 0)
		sphere(object, "TowerWindowFrame", Vector3.new(0.48, 3.1, 1.35) * scale, CFrame.new(windowPosition) * CFrame.Angles(0, -angle, 0), STONE_DARK, Enum.Material.Slate, { Holiday = options.Holiday })
		sphere(object, "TowerWindow", Vector3.new(0.52, 2.15, 0.78) * scale, CFrame.new(windowPosition + radial.Unit * 0.08 * scale) * CFrame.Angles(0, -angle, 0), accent, Enum.Material.Glass, { Holiday = options.Holiday })
	end
	local doorPosition = position + Vector3.new(0, 2.6 * scale, -5.05 * scale)
	sphere(object, "TowerDoorFrame", Vector3.new(3.5, 4.8, 0.65) * scale, CFrame.new(doorPosition), STONE_LIGHT, Enum.Material.Cobblestone, { Holiday = options.Holiday })
	sphere(object, "TowerDoor", Vector3.new(2.65, 4.05, 0.72) * scale, CFrame.new(doorPosition + Vector3.new(0, 0, -0.18 * scale)), INK, Enum.Material.WoodPlanks, { Holiday = options.Holiday, Texture = TEXTURES.Wood })
	cylinder(object, "TowerDoorHandle", 0.13 * scale, 0.35 * scale, CFrame.new(doorPosition + Vector3.new(0.65 * scale, 0, -0.6 * scale)), GOLD, Enum.Material.Metal, { Holiday = options.Holiday })
	cylinder(object, "TowerPole", 0.16 * scale, 6.5 * scale, CFrame.new(position + Vector3.new(0, 22 * scale, 0)), GOLD, Enum.Material.Metal, { Holiday = options.Holiday })
	make(object, "TowerFlag", Vector3.new(4.1, 2.2, 0.18) * scale, CFrame.new(position + Vector3.new(2 * scale, 23.2 * scale, 0)), accent, Enum.Material.Fabric, { ClassName = "WedgePart", Holiday = options.Holiday })
	local gem = sphere(object, "TowerLantern", Vector3.one * 0.8 * scale, CFrame.new(position + Vector3.new(0, 12.9 * scale, -5.1 * scale)), accent, Enum.Material.Neon, { Holiday = options.Holiday })
	light(gem, "TowerGlow", accent, 14 * scale, 1.1)
	return object
end

function VisualModels.Gate(parent, prefix, baseCFrame, width, height, accent, options)
	options = options or {}
	accent = accent or GOLD
	local radius = width * 0.5 - 1.8
	local first
	for _, side in ipairs({ -1, 1 }) do
		local pillarPosition = baseCFrame * CFrame.new(side * radius, height * 0.5, 0)
		local pillar = cylinder(parent, prefix .. "Pillar", 1.65, height, pillarPosition, STONE_LIGHT, Enum.Material.Cobblestone, { Holiday = options.Holiday, Texture = TEXTURES.Stone, Tile = 4 })
		first = first or pillar
		for _, y in ipairs({ 1.2, height * 0.55, height - 1.2 }) do
			cylinder(parent, prefix .. "PillarBand", 1.9, 0.5, baseCFrame * CFrame.new(side * radius, y, 0), accent, Enum.Material.Metal, { Holiday = options.Holiday })
		end
		sphere(parent, prefix .. "PillarCap", Vector3.new(4.1, 1.1, 4.1), baseCFrame * CFrame.new(side * radius, height + 0.3, 0), SNOW, Enum.Material.Snow, { Holiday = options.Holiday })
	end
	local archCenterY = height - 4.2
	local archRadius = math.max(3, radius - 0.4)
	for index = 0, 10 do
		local angle = math.pi - index * math.pi / 10
		local x = math.cos(angle) * archRadius
		local y = archCenterY + math.sin(angle) * 3.7
		local stone = make(parent, index == 5 and prefix .. "Lintel" or prefix .. "ArchStone", Vector3.new(2.9, 2.1, 3.8), baseCFrame * CFrame.new(x, y, 0) * CFrame.Angles(0, 0, angle - math.pi / 2), index % 2 == 0 and STONE_LIGHT or STONE, Enum.Material.Cobblestone, { ClassName = "WedgePart", Holiday = options.Holiday, Texture = TEXTURES.Stone })
		if index == 5 then
			first = first or stone
		end
	end
	for index = 0, 8 do
		local angle = math.pi - index * math.pi / 8
		local x = math.cos(angle) * (archRadius - 0.25)
		local y = archCenterY + math.sin(angle) * 3.25
		make(parent, prefix .. "GoldInset", Vector3.new(1.2, 0.32, 4), baseCFrame * CFrame.new(x, y - 0.95, -0.1) * CFrame.Angles(0, 0, angle - math.pi / 2), accent, Enum.Material.Metal, { Holiday = options.Holiday })
	end
	-- Keep the old names for compatibility, but use sloped sculpted pieces.
	make(parent, prefix .. "Roof", Vector3.new(width + 3, 2.2, 5.5), baseCFrame * CFrame.new(0, height + 1.5, 0), INK, Enum.Material.Slate, { ClassName = "WedgePart", Holiday = options.Holiday })
	make(parent, prefix .. "RoofSnow", Vector3.new(width + 3.3, 0.45, 5.8), baseCFrame * CFrame.new(0, height + 2.8, 0), SNOW, Enum.Material.Snow, { ClassName = "WedgePart", Holiday = options.Holiday, Texture = TEXTURES.Snow })
	return first
end

function VisualModels.Bridge(parent, position, width, depth, accent, options)
	options = options or {}
	accent = accent or GOLD
	width = width or 30
	depth = depth or 24
	local bridgeName = options.Name or "FrontierBridge"
	local object
	local first
	for index = -3, 3 do
		local alpha = index / 3
		local y = 0.45 + (1 - alpha * alpha) * 1.1
		local deck = make(parent, first and (bridgeName .. "Deck") or bridgeName, Vector3.new(width / 7 + 0.25, 0.7, depth), CFrame.new(position + Vector3.new(index * width / 7, y, 0)) * CFrame.Angles(0, 0, -alpha * 0.12), STONE_LIGHT, Enum.Material.Cobblestone, { Holiday = options.Holiday, Texture = TEXTURES.Stone })
		first = first or deck
		if not object then
			object = model(bridgeName .. "Model", deck, parent, options)
			deck.Parent = object
		else
			deck.Parent = object
		end
	end
	for _, side in ipairs({ -1, 1 }) do
		for _, index in ipairs({ -3, 0, 3 }) do
			local x = index * width / 7
			cylinder(object, "BridgePost", 0.24, 3.2, CFrame.new(position + Vector3.new(x, 2.1, side * (depth * 0.5 - 1))), accent, Enum.Material.Metal, { Holiday = options.Holiday })
			sphere(object, "BridgeLantern", Vector3.one * 0.65, CFrame.new(position + Vector3.new(x, 3.9, side * (depth * 0.5 - 1))), accent, Enum.Material.Neon, { Holiday = options.Holiday })
		end
		beam(object, "BridgeRail", position + Vector3.new(-width * 0.5, 3.1, side * (depth * 0.5 - 1)), position + Vector3.new(width * 0.5, 3.1, side * (depth * 0.5 - 1)), 0.18, accent, Enum.Material.Metal, { Holiday = options.Holiday })
	end
	return object
end

function VisualModels.Column(parent, position, height, accent, options)
	options = options or {}
	local body = cylinder(parent, "HallColumn", 1.35, height, CFrame.new(position + Vector3.new(0, height * 0.5, 0)), STONE_LIGHT, Enum.Material.Marble, { Holiday = options.Holiday, Texture = TEXTURES.Stone })
	local object = model("AuroraColumn", body, parent, options)
	body.Parent = object
	for _, y in ipairs({ 0.6, height - 0.6 }) do
		cylinder(object, "ColumnCapital", 1.85, 0.7, CFrame.new(position + Vector3.new(0, y, 0)), accent or GOLD, Enum.Material.Metal, { Holiday = options.Holiday })
	end
	for index = 0, 3 do
		local angle = math.rad(index * 90)
		cylinder(object, "ColumnFlute", 0.12, height - 1.5, CFrame.new(position + Vector3.new(math.cos(angle) * 1.25, height * 0.5, math.sin(angle) * 1.25)), STONE, Enum.Material.Marble, { Holiday = options.Holiday })
	end
	return object
end

function VisualModels.Fireplace(parent, position, scale, options)
	options = options or {}
	scale = scale or 1
	local base = cylinder(parent, "FireplaceBase", 3.8 * scale, 0.8 * scale, CFrame.new(position + Vector3.new(0, 0.4 * scale, 0)), STONE_DARK, Enum.Material.Slate, { Holiday = options.Holiday })
	local object = model("FortressFireplace", base, parent, options)
	base.Parent = object
	for index = 0, 7 do
		local angle = math.rad(index * 45)
		sphere(object, "HearthStone", Vector3.new(1.7, 1.25, 1.4) * scale, CFrame.new(position + Vector3.new(math.cos(angle) * 3 * scale, 0.9 * scale, math.sin(angle) * 3 * scale)), STONE, Enum.Material.Cobblestone, { Holiday = options.Holiday, Texture = TEXTURES.Stone })
	end
	beam(object, "FireLog", position + Vector3.new(-2 * scale, 1.25 * scale, -0.7 * scale), position + Vector3.new(2 * scale, 1.25 * scale, 0.7 * scale), 0.42 * scale, WOOD, Enum.Material.WoodPlanks, { Holiday = options.Holiday, Texture = TEXTURES.Wood })
	beam(object, "FireLog", position + Vector3.new(-2 * scale, 1.45 * scale, 0.7 * scale), position + Vector3.new(2 * scale, 1.45 * scale, -0.7 * scale), 0.38 * scale, WOOD, Enum.Material.WoodPlanks, { Holiday = options.Holiday, Texture = TEXTURES.Wood })
	for index, offset in ipairs({ Vector3.new(-0.8, 2.2, 0), Vector3.new(0.7, 2.6, 0.2), Vector3.new(0, 3.2, -0.2) }) do
		local flame = sphere(object, "FireFlame", Vector3.new(1.2, 2.1, 1.2) * scale, CFrame.new(position + offset * scale), index == 2 and GOLD or FIRE, Enum.Material.Neon, { Holiday = options.Holiday })
		if index == 2 then
			light(flame, "FireGlow", FIRE, 18 * scale, 2)
		end
	end
	return object
end

function VisualModels.Wall(parent, cframe, accent, options)
	options = options or {}
	accent = accent or GOLD
	local anchor = make(parent, "VisualAnchor", Vector3.new(12, 12, 2), cframe, INK, Enum.Material.SmoothPlastic, {
		Transparency = 1, Collide = false, Query = false, CastShadow = false,
	})
	local object = model("WallVisual", anchor, parent, options)
	anchor.Parent = object
	local function frame(x, y, z, rotation)
		return cframe * CFrame.new(x, y, z) * (rotation or CFrame.new())
	end
	sphere(object, "WallRoundedPanel", Vector3.new(10.8, 10.6, 1.85), frame(0, 0, 0), STONE, Enum.Material.Cobblestone, {
		Texture = TEXTURES.Stone, Tile = 5, Holiday = options.Holiday,
	})
	for _, x in ipairs({ -5.1, 5.1 }) do
		cylinder(object, "WallButtress", 0.88, 11.7, frame(x, 0, 0), STONE_DARK, Enum.Material.Cobblestone, {
			Texture = TEXTURES.Stone, Holiday = options.Holiday,
		})
		for _, y in ipairs({ -4.3, 0, 4.3 }) do
			cylinder(object, "WallIronBand", 1.02, 0.32, frame(x, y, 0), accent, Enum.Material.Metal, { Holiday = options.Holiday })
		end
	end
	for _, y in ipairs({ -3.8, 3.8 }) do
		cylinder(object, "WallCoping", 0.38, 10.8, frame(0, y, 0, CFrame.Angles(0, 0, math.rad(90))), STONE_LIGHT, Enum.Material.Cobblestone, { Holiday = options.Holiday })
	end
	for index = 0, 5 do
		local x = -4.5 + index * 1.8
		make(object, "WallMerlon", Vector3.new(1.25, 1.45, 1.9), frame(x, 6.15, 0), STONE_LIGHT, Enum.Material.Cobblestone, {
			ClassName = "WedgePart", Holiday = options.Holiday,
		})
	end
	beam(object, "WallSnowCap", (cframe * CFrame.new(-5.2, 5.75, 0)).Position, (cframe * CFrame.new(5.2, 5.75, 0)).Position, 0.2, SNOW, Enum.Material.Snow, {
		Texture = TEXTURES.Snow, Holiday = options.Holiday,
	})
	return object
end

local function crystalAssembly(parent, name, cframe, accent, options)
	options = options or {}
	accent = accent or GOLD
	local anchor = make(parent, "VisualAnchor", options.AnchorSize or Vector3.new(10, 12, 10), cframe, INK, Enum.Material.SmoothPlastic, {
		Transparency = 1, Collide = false, Query = false, CastShadow = false,
	})
	local object = model(name, anchor, parent, options)
	anchor.Parent = object
	local function point(x, y, z)
		return (cframe * CFrame.new(x, y, z)).Position
	end
	local function frame(x, y, z, rotation)
		return cframe * CFrame.new(x, y, z) * (rotation or CFrame.new())
	end
	cylinder(object, name .. "Base", options.BaseRadius or 9, 1.2, frame(0, options.BaseY or -6, 0), STONE_DARK, Enum.Material.Cobblestone, {
		Texture = TEXTURES.Stone, Tile = 5, Holiday = options.Holiday,
	})
	for _, y in ipairs({ (options.BaseY or -6) + 0.72, (options.BaseY or -6) + 1.15 }) do
		cylinder(object, name .. "BaseTrim", (options.BaseRadius or 9) + 0.25, 0.22, frame(0, y, 0), accent, Enum.Material.Metal, { Holiday = options.Holiday })
	end
	local crystalSize = options.CrystalSize or Vector3.new(7, 11, 7)
	sphere(object, name .. "CrystalShell", crystalSize, frame(0, 0, 0, CFrame.Angles(0, math.rad(45), 0)), accent, Enum.Material.Glass, {
		Transparency = 0.2, Holiday = options.Holiday,
	})
	sphere(object, options.CrystalHeartName or (name .. "CrystalHeart"), crystalSize * 0.55, frame(0, 0, 0), accent, Enum.Material.Neon, {
		Transparency = 0.04, Holiday = options.Holiday,
	})
	-- Faceted shards break up the smooth shell and create a premium silhouette.
	for index = 0, 5 do
		local angle = math.rad(index * 60 + 30)
		local radius = options.ShardRadius or 5.2
		local shardPosition = frame(math.cos(angle) * radius, math.sin(index * 1.7) * 1.2, math.sin(angle) * radius, CFrame.Angles(math.rad(12 * (index % 3)), angle, math.rad(18)))
		make(object, options.ShardName or "CoreOrbital", Vector3.new(1.1, 2.6, 1.1), shardPosition, accent, Enum.Material.Neon, {
			ClassName = "WedgePart", Transparency = 0.08, Holiday = options.Holiday,
		})
	end
	-- Two segmented energy rings, rather than flat square bands.
	for ringIndex = 1, 2 do
		local radius = (options.RingRadius or 5.8) + (ringIndex - 1) * 1.25
		local segments = 16
		for index = 0, segments - 1 do
			local a0 = index * math.pi * 2 / segments
			local a1 = (index + 1) * math.pi * 2 / segments
			local y0 = ringIndex == 1 and 0 or math.sin(a0 * 2) * 1.4
			local y1 = ringIndex == 1 and 0 or math.sin(a1 * 2) * 1.4
			beam(object, options.RingName or "CoreRing", point(math.cos(a0) * radius, y0, math.sin(a0) * radius), point(math.cos(a1) * radius, y1, math.sin(a1) * radius), 0.13, accent, Enum.Material.Neon, { Holiday = options.Holiday })
		end
	end
	for index = 0, 3 do
		local angle = math.rad(index * 90 + 45)
		local x = math.cos(angle) * (options.PylonRadius or 8)
		local z = math.sin(angle) * (options.PylonRadius or 8)
		local pylonHeight = options.PylonHeight or 10
		local pylonY = options.PylonY or -1
		cylinder(object, name .. "Pylon", 0.68, pylonHeight, frame(x, pylonY, z), STONE, Enum.Material.Cobblestone, {
			Texture = TEXTURES.Stone, Holiday = options.Holiday,
		})
		for _, bandY in ipairs({ pylonY - pylonHeight * 0.35, pylonY + pylonHeight * 0.35 }) do
			cylinder(object, name .. "PylonBand", 0.82, 0.3, frame(x, bandY, z), accent, Enum.Material.Metal, { Holiday = options.Holiday })
		end
		sphere(object, options.ShardName or "CoreOrbital", Vector3.one * 1.15, frame(x, pylonY + pylonHeight * 0.55, z), accent, Enum.Material.Neon, { Holiday = options.Holiday })
	end
	local glow = sphere(object, name .. "LightAnchor", Vector3.one * 0.5, frame(0, 0, 0), accent, Enum.Material.Neon, { Holiday = options.Holiday })
	light(glow, name .. "Glow", accent, options.LightRange or 26, 2.4)
	return object
end

function VisualModels.Core(parent, cframe, accent, options)
	options = options or {}
	options.BaseRadius = 9
	options.BaseY = -6
	options.PylonRadius = 8
	options.PylonHeight = 10
	options.PylonY = -1
	options.CrystalSize = Vector3.new(7, 11, 7)
	options.RingRadius = 5.8
	options.ShardRadius = 5.2
	options.ShardName = "CoreOrbital"
	options.RingName = "CoreRing"
	return crystalAssembly(parent, "CoreVisual", cframe, accent, options)
end

function VisualModels.Capture(parent, cframe, accent, options)
	options = options or {}
	options.AnchorSize = Vector3.new(7, 10, 7)
	options.BaseRadius = 14
	options.BaseY = -5.6
	options.PylonRadius = 11
	options.PylonHeight = 7
	options.PylonY = -2.5
	options.CrystalSize = Vector3.new(6, 9, 6)
	options.RingRadius = 6.4
	options.ShardRadius = 5.4
	options.ShardName = "CaptureGlow"
	options.CrystalHeartName = "CaptureGlow"
	options.RingName = "CaptureRing"
	return crystalAssembly(parent, "CaptureVisual", cframe, accent, options)
end

function VisualModels.Barricade(parent, cframe, accent, options)
	options = options or {}
	accent = accent or GOLD
	local anchor = make(parent, "VisualAnchor", Vector3.new(12, 5, 2), cframe, INK, Enum.Material.SmoothPlastic, {
		Transparency = 1, Collide = false, Query = false, CastShadow = false,
	})
	local object = model("BarricadeVisual", anchor, parent, options)
	anchor.Parent = object
	anchor:SetAttribute("PlacementLocked", true)
	local function point(x, y, z)
		return (cframe * CFrame.new(x, y, z)).Position
	end
	local function frame(x, y, z, rotation)
		return cframe * CFrame.new(x, y, z) * (rotation or CFrame.new())
	end
	-- Three rounded timbers establish a readable silhouette without a box root.
	for _, y in ipairs({ -1.25, 0, 1.25 }) do
		beam(object, "BarricadeLog", point(-5.55, y, 0), point(5.55, y, 0), 0.47, WOOD, Enum.Material.WoodPlanks, {
			Texture = TEXTURES.Wood, Tile = 3, Holiday = options.Holiday,
		})
	end
	for _, x in ipairs({ -4.8, 4.8 }) do
		cylinder(object, "BarricadePost", 0.46, 5.5, frame(x, 0, 0), BARK, Enum.Material.WoodPlanks, {
			Texture = TEXTURES.Wood, Tile = 3, Holiday = options.Holiday,
		})
		for _, y in ipairs({ -1.45, 1.45 }) do
			cylinder(object, "BarricadeIronBand", 0.57, 0.28, frame(x, y, 0), INK, Enum.Material.Metal, { Holiday = options.Holiday })
			sphere(object, "BarricadeBolt", Vector3.one * 0.28, frame(x, y, -0.57), GOLD, Enum.Material.Metal, { Holiday = options.Holiday })
		end
		sphere(object, "BarricadeFoot", Vector3.new(1.65, 0.72, 1.65), frame(x, -2.55, 0), STONE_DARK, Enum.Material.Slate, {
			Texture = TEXTURES.Stone, Holiday = options.Holiday,
		})
	end
	-- Crossed front and rear braces make the side/rotation legible at a glance.
	for _, z in ipairs({ -0.72, 0.72 }) do
		beam(object, "BarricadeCrossBrace", point(-4.9, -1.85, z), point(4.9, 1.85, z), 0.25, WOOD, Enum.Material.WoodPlanks, {
			Texture = TEXTURES.Wood, Tile = 3, Holiday = options.Holiday,
		})
		beam(object, "BarricadeCrossBrace", point(-4.9, 1.85, z), point(4.9, -1.85, z), 0.21, BARK, Enum.Material.WoodPlanks, {
			Texture = TEXTURES.Wood, Tile = 3, Holiday = options.Holiday,
		})
	end
	beam(object, "BarricadeRope", point(-5.1, 0.25, -1.02), point(5.1, 0.25, -1.02), 0.11, Color3.fromRGB(185, 145, 89), Enum.Material.Fabric, { Holiday = options.Holiday })
	beam(object, "BarricadeSnow", point(-5.35, 1.68, 0), point(5.35, 1.68, 0), 0.16, SNOW, Enum.Material.Snow, {
		Texture = TEXTURES.Snow, Holiday = options.Holiday,
	})
	for index = 0, 6 do
		local x = -4.5 + index * 1.5
		make(object, "BarricadeSpike", Vector3.new(0.62, 1.55, 0.62), frame(x, 3.05, 0, CFrame.Angles(0, 0, math.rad(index % 2 == 0 and -8 or 8))), STONE_LIGHT, Enum.Material.Metal, {
			ClassName = "WedgePart", Holiday = options.Holiday,
		})
	end
	sphere(object, "BarricadeTeamMarker", Vector3.new(1.1, 0.7, 0.18), frame(0, 1.65, -1.08), accent, Enum.Material.Neon, { Holiday = options.Holiday })
	object:SetAttribute("PlacementLocked", true)
	return object
end

return VisualModels
]]></string>
        </Properties>
      </Item>
<Item class="ModuleScript" referent="30">
        <Properties>
          <string name="Name">AbilityCatalog</string>
          <string name="Source"><![CDATA[-- BLOCKSIEGE // CLASS DRAFT
-- Server and client share this read-only content catalog. All numbers are
-- validated and executed by AbilityService; the client never applies effects.
local AbilityCatalog = {}

AbilityCatalog.ClassOrder = { "Medic", "Tank", "Striker", "Buffer", "Engineer" }

AbilityCatalog.Classes = {
	Medic = {
		Id = "Medic", Name = "ЛЕКАРЬ", Role = "HEALER",
		Color = Color3.fromRGB(93, 239, 174),
		Description = "Лечит отряд и вызывает дрона-санитара.",
		MaxHealthBonus = 10, ArmorBonus = 0, SpeedBonus = 0, DamageMultiplier = 1, BuildBonus = 0,
		Abilities = { "HealingPulse", "GuardianDrone" },
	},
	Tank = {
		Id = "Tank", Name = "ТАНК", Role = "DEFENDER",
		Color = Color3.fromRGB(103, 178, 255),
		Description = "Поглощает урон и разбивает строй противника.",
		MaxHealthBonus = 70, ArmorBonus = 0.12, SpeedBonus = 0, DamageMultiplier = 1, BuildBonus = 0,
		Abilities = { "AegisShield", "SeismicSlam" },
	},
	Striker = {
		Id = "Striker", Name = "ДАМАГЕР", Role = "ASSAULT",
		Color = Color3.fromRGB(255, 125, 104),
		Description = "Усиливает оружие и бросает кассетную бомбу.",
		MaxHealthBonus = 0, ArmorBonus = 0, SpeedBonus = 0, DamageMultiplier = 1.12, BuildBonus = 0,
		Abilities = { "Overdrive", "ClusterBomb" },
	},
	Buffer = {
		Id = "Buffer", Name = "БАФФЕР", Role = "SUPPORT",
		Color = Color3.fromRGB(206, 150, 255),
		Description = "Ускоряет союзников и чинит крепость.",
		MaxHealthBonus = 0, ArmorBonus = 0, SpeedBonus = 2, DamageMultiplier = 1, BuildBonus = 0,
		Abilities = { "RallyBanner", "RepairPulse" },
	},
	Engineer = {
		Id = "Engineer", Name = "ИНЖЕНЕР", Role = "ENGINEER",
		Color = Color3.fromRGB(255, 209, 99),
		Description = "Строит минные поля и автоматические турели.",
		MaxHealthBonus = 0, ArmorBonus = 0, SpeedBonus = 0, DamageMultiplier = 1, BuildBonus = 3,
		Abilities = { "Minefield", "SentryTurret" },
	},
}

AbilityCatalog.Abilities = {
	HealingPulse = {
		Id = "HealingPulse", Name = "ИСЦЕЛЯЮЩИЙ ПУЛЬС", ShortName = "ПУЛЬС",
		Description = "Восстанавливает 50 HP союзникам в радиусе 26.",
		Kind = "Heal", Cooldown = 12, Range = 48, Radius = 26, Amount = 50,
		Color = Color3.fromRGB(93, 239, 174), Hotkey = "F",
	},
	GuardianDrone = {
		Id = "GuardianDrone", Name = "ДРОН-САНИТАР", ShortName = "ДРОН",
		Description = "12 секунд сопровождает вас и лечит союзников рядом.",
		Kind = "Drone", Cooldown = 28, Duration = 12, Radius = 20, HealPerSecond = 8,
		Color = Color3.fromRGB(93, 239, 174), Hotkey = "G",
	},
	AegisShield = {
		Id = "AegisShield", Name = "ЭГИДА", ShortName = "ЩИТ",
		Description = "6 секунд уменьшает входящий урон до 42%.",
		Kind = "Shield", Cooldown = 18, Duration = 6, DamageTakenMultiplier = 0.42,
		Color = Color3.fromRGB(103, 178, 255), Hotkey = "F",
	},
	SeismicSlam = {
		Id = "SeismicSlam", Name = "СЕЙСМИЧЕСКИЙ УДАР", ShortName = "УДАР",
		Description = "Наносит 65 урона врагам в радиусе 18.",
		Kind = "Slam", Cooldown = 14, Range = 28, Radius = 18, Amount = 65,
		Color = Color3.fromRGB(103, 178, 255), Hotkey = "G",
	},
	Overdrive = {
		Id = "Overdrive", Name = "ОВЕРДРАЙВ", ShortName = "РАЗГОН",
		Description = "8 секунд увеличивает урон оружия и способностей на 45%.",
		Kind = "Overdrive", Cooldown = 22, Duration = 8, DamageMultiplier = 1.45,
		Color = Color3.fromRGB(255, 125, 104), Hotkey = "F",
	},
	ClusterBomb = {
		Id = "ClusterBomb", Name = "КАССЕТНАЯ БОМБА", ShortName = "БОМБА",
		Description = "Бросок по дуге: 100 урона в радиусе 16.",
		Kind = "Bomb", Cooldown = 18, Range = 95, Radius = 16, Amount = 100, FlightTime = 0.85,
		Color = Color3.fromRGB(255, 125, 104), Hotkey = "G",
	},
	RallyBanner = {
		Id = "RallyBanner", Name = "ЗНАМЯ РАЛЛИ", ShortName = "ЗНАМЯ",
		Description = "10 секунд: союзники рядом получают +20% урона и +5 скорости.",
		Kind = "Rally", Cooldown = 24, Range = 36, Radius = 32, Duration = 10,
		DamageMultiplier = 1.2, SpeedBonus = 5,
		Color = Color3.fromRGB(206, 150, 255), Hotkey = "F",
	},
	RepairPulse = {
		Id = "RepairPulse", Name = "РЕМОНТНЫЙ ПУЛЬС", ShortName = "РЕМОНТ",
		Description = "Лечит союзников и восстанавливает 240 HP постройкам.",
		Kind = "Repair", Cooldown = 16, Range = 55, Radius = 28, Amount = 35, StructureAmount = 240,
		Color = Color3.fromRGB(206, 150, 255), Hotkey = "G",
	},
	Minefield = {
		Id = "Minefield", Name = "МИННОЕ ПОЛЕ", ShortName = "МИНЫ",
		Description = "Устанавливает 3 мины: 85 урона, радиус взрыва 13.",
		Kind = "Minefield", Cooldown = 22, Range = 65, Radius = 13, TriggerRadius = 6,
		Amount = 85, Count = 3, Duration = 50,
		Color = Color3.fromRGB(255, 209, 99), Hotkey = "F",
	},
	SentryTurret = {
		Id = "SentryTurret", Name = "СТРАЖЕВАЯ ТУРЕЛЬ", ShortName = "ТУРЕЛЬ",
		Description = "35 секунд автоматически поражает врагов в радиусе 80.",
		Kind = "Turret", Cooldown = 34, Range = 70, Duration = 35, AttackRange = 80,
		Amount = 16, ShotCooldown = 1.1,
		Color = Color3.fromRGB(255, 209, 99), Hotkey = "G",
	},
}

function AbilityCatalog.GetClass(classId)
	return type(classId) == "string" and AbilityCatalog.Classes[classId] or nil
end

function AbilityCatalog.GetAbility(abilityId)
	return type(abilityId) == "string" and AbilityCatalog.Abilities[abilityId] or nil
end

function AbilityCatalog.GetAbilityForSlot(classId, slot)
	local definition = AbilityCatalog.GetClass(classId)
	local abilityId = definition and definition.Abilities[slot]
	return abilityId and AbilityCatalog.GetAbility(abilityId) or nil
end

function AbilityCatalog.GetClassForAbility(abilityId)
	for classId, definition in pairs(AbilityCatalog.Classes) do
		for _, id in ipairs(definition.Abilities) do
			if id == abilityId then
				return classId
			end
		end
	end
	return nil
end

return AbilityCatalog
]]></string>
        </Properties>
      </Item>
<Item class="ModuleScript" referent="31">
        <Properties>
          <string name="Name">CombatModels</string>
          <string name="Source"><![CDATA[-- BLOCKSIEGE // VISIBLE COMBAT EQUIPMENT
-- Anchored, non-colliding utility models are moved only by the server. Named
-- subassemblies are intentionally animated by AbilityService/FortressService.
local CombatModels = {}

local INK = Color3.fromRGB(24, 34, 47)
local METAL = Color3.fromRGB(83, 103, 119)
local LIGHT = Color3.fromRGB(222, 238, 244)
local GOLD = Color3.fromRGB(255, 204, 93)
local HOT = Color3.fromRGB(255, 110, 64)

local function part(parent, name, size, cframe, color, material, shape)
	local object = Instance.new("Part")
	object.Name = name
	object.Size = size
	object.CFrame = cframe or CFrame.new()
	object.Color = color or LIGHT
	object.Material = material or Enum.Material.Metal
	object.Anchored = true
	object.CanCollide = false
	object.CanTouch = false
	object.CanQuery = false
	object.CastShadow = true
	object.TopSurface = Enum.SurfaceType.Smooth
	object.BottomSurface = Enum.SurfaceType.Smooth
	if shape then
		object.Shape = shape
	end
	object.Parent = parent
	return object
end

local function light(parent, name, color, range, brightness)
	local object = Instance.new("PointLight")
	object.Name = name
	object.Color = color
	object.Range = range or 10
	object.Brightness = brightness or 1
	object.Parent = parent
	return object
end

local function model(name, primary)
	local object = Instance.new("Model")
	object.Name = name
	object.PrimaryPart = primary
	object:SetAttribute("CombatUtility", true)
	object:SetAttribute("AnimatedModel", true)
	return object
end

local function finish(object, utilityId, teamColor)
	object:SetAttribute("UtilityId", utilityId)
	object:SetAttribute("TeamColor", teamColor)
	for _, item in ipairs(object:GetDescendants()) do
		if item:IsA("BasePart") then
			item:SetAttribute("CombatUtilityPart", true)
		end
	end
	return object
end

function CombatModels.BuildMine(teamColor)
	local accent = teamColor or GOLD
	local root = part(nil, "MineBase", Vector3.new(4.8, 0.8, 4.8), CFrame.new(), INK, Enum.Material.DiamondPlate)
	local object = model("AbilityMine", root)
	root.Parent = object
	part(object, "MinePlate", Vector3.new(3.7, 0.35, 3.7), CFrame.new(0, 0.55, 0), METAL, Enum.Material.Metal)
	local core = part(object, "MineCore", Vector3.new(1.7, 1.2, 1.7), CFrame.new(0, 1.15, 0), accent, Enum.Material.Neon, Enum.PartType.Ball)
	light(core, "MineGlow", accent, 9, 1.5)
	for index = 1, 4 do
		local angle = math.rad(index * 90)
		local offset = Vector3.new(math.cos(angle) * 2.25, 0.1, math.sin(angle) * 2.25)
		part(object, "MineLeg", Vector3.new(0.55, 0.55, 1.8), CFrame.new(offset) * CFrame.Angles(0, -angle, 0), METAL, Enum.Material.Metal)
	end
	for index = 1, 2 do
		local ring = part(object, "MineRing", Vector3.new(5.6, 0.22, 0.45), CFrame.new(0, 0.78, 0) * CFrame.Angles(0, index * math.pi / 2, 0), accent, Enum.Material.Neon)
		ring:SetAttribute("Spin", index == 1 and 1 or -1)
	end
	local fuse = part(object, "MineFuse", Vector3.new(0.35, 0.7, 0.35), CFrame.new(0, 1.9, 0), HOT, Enum.Material.Neon)
	light(fuse, "FuseLight", HOT, 5, 0.8)
	return finish(object, "Minefield", accent)
end

function CombatModels.BuildBomb(teamColor)
	local accent = teamColor or HOT
	local root = part(nil, "BombBody", Vector3.new(3.2, 3.2, 3.2), CFrame.new(), INK, Enum.Material.DiamondPlate, Enum.PartType.Ball)
	local object = model("AbilityBomb", root)
	root.Parent = object
	part(object, "BombBand", Vector3.new(3.35, 0.42, 3.35), CFrame.new(), accent, Enum.Material.Metal)
	part(object, "BombBand", Vector3.new(0.42, 3.35, 3.35), CFrame.new(), accent, Enum.Material.Metal)
	for side = -1, 1, 2 do
		part(object, "BombFin", Vector3.new(0.35, 1.4, 2.2), CFrame.new(side * 1.8, 0, 0) * CFrame.Angles(0, 0, math.rad(side * 20)), METAL, Enum.Material.Metal)
	end
	local fuse = part(object, "BombFuse", Vector3.new(0.45, 1.25, 0.45), CFrame.new(0, 2, 0), GOLD, Enum.Material.WoodPlanks)
	local spark = part(object, "BombSpark", Vector3.new(0.8, 0.8, 0.8), CFrame.new(0, 2.75, 0), HOT, Enum.Material.Neon, Enum.PartType.Ball)
	light(spark, "BombSparkLight", HOT, 8, 2)
	light(fuse, "BombFuseLight", GOLD, 5, 0.7)
	return finish(object, "ClusterBomb", accent)
end

function CombatModels.BuildTurret(teamColor)
	local accent = teamColor or GOLD
	local root = part(nil, "TurretBase", Vector3.new(6, 1.2, 6), CFrame.new(), INK, Enum.Material.DiamondPlate)
	local object = model("AbilityTurret", root)
	root.Parent = object
	part(object, "TurretPedestal", Vector3.new(3.6, 3.2, 3.6), CFrame.new(0, 2, 0), METAL, Enum.Material.Metal)
	part(object, "TurretTeamRing", Vector3.new(4, 0.35, 4), CFrame.new(0, 3.55, 0), accent, Enum.Material.Neon)
	local headRoot = part(nil, "TurretHeadRoot", Vector3.new(3.8, 2.1, 3.8), CFrame.new(0, 5, 0), INK, Enum.Material.Metal)
	local head = Instance.new("Model")
	head.Name = "TurretHead"
	head.PrimaryPart = headRoot
	headRoot.Parent = head
	head.Parent = object
	part(head, "TurretArmor", Vector3.new(4.2, 1.2, 2.8), CFrame.new(0, 5.2, 0), METAL, Enum.Material.DiamondPlate)
	for side = -1, 1, 2 do
		part(head, "TurretBarrel", Vector3.new(0.65, 0.65, 5.2), CFrame.new(side * 1.05, 5, -3.2), LIGHT, Enum.Material.Metal)
		part(head, "TurretMuzzle", Vector3.new(0.9, 0.9, 0.65), CFrame.new(side * 1.05, 5, -5.8), accent, Enum.Material.Neon)
	end
	local eye = part(head, "TurretEye", Vector3.new(1.2, 0.45, 0.3), CFrame.new(0, 5.5, -1.95), accent, Enum.Material.Neon)
	light(eye, "TurretEyeLight", accent, 10, 1.4)
	return finish(object, "SentryTurret", accent)
end

function CombatModels.BuildDrone(teamColor)
	local accent = teamColor or Color3.fromRGB(93, 239, 174)
	local root = part(nil, "DroneCore", Vector3.new(2.8, 1.8, 2.8), CFrame.new(), LIGHT, Enum.Material.DiamondPlate, Enum.PartType.Ball)
	local object = model("GuardianDrone", root)
	root.Parent = object
	part(object, "DroneBand", Vector3.new(3, 0.35, 3), CFrame.new(), accent, Enum.Material.Neon)
	for index = 1, 4 do
		local angle = math.rad(index * 90)
		local offset = Vector3.new(math.cos(angle) * 2.5, 0, math.sin(angle) * 2.5)
		part(object, "DroneArm", Vector3.new(0.45, 0.45, 2.8), CFrame.new(offset * 0.5) * CFrame.Angles(0, -angle, 0), METAL, Enum.Material.Metal)
		local rotor = part(object, "DroneRotor", Vector3.new(3, 0.15, 0.35), CFrame.new(offset + Vector3.new(0, 0.6, 0)) * CFrame.Angles(0, angle, 0), accent, Enum.Material.Neon)
		rotor:SetAttribute("Spin", index % 2 == 0 and 1 or -1)
	end
	part(object, "MedicCross", Vector3.new(0.35, 1.25, 0.25), CFrame.new(0, 0, -1.45), accent, Enum.Material.Neon)
	part(object, "MedicCross", Vector3.new(1.25, 0.35, 0.25), CFrame.new(0, 0, -1.45), accent, Enum.Material.Neon)
	light(root, "DroneGlow", accent, 13, 1.8)
	return finish(object, "GuardianDrone", accent)
end

function CombatModels.BuildBanner(teamColor)
	local accent = teamColor or Color3.fromRGB(206, 150, 255)
	local root = part(nil, "BannerBase", Vector3.new(5.5, 0.8, 5.5), CFrame.new(), INK, Enum.Material.Cobblestone)
	local object = model("RallyBanner", root)
	root.Parent = object
	part(object, "BannerPole", Vector3.new(0.45, 12, 0.45), CFrame.new(0, 6, 0), GOLD, Enum.Material.Metal)
	part(object, "BannerCrown", Vector3.new(1.1, 1.1, 1.1), CFrame.new(0, 12.5, 0), accent, Enum.Material.Neon, Enum.PartType.Ball)
	part(object, "BannerFlag", Vector3.new(5.8, 3.8, 0.25), CFrame.new(3, 9.5, 0), accent, Enum.Material.Fabric)
	part(object, "BannerStripe", Vector3.new(0.45, 3.9, 0.3), CFrame.new(1.1, 9.5, 0), LIGHT, Enum.Material.Fabric)
	light(root, "BannerGlow", accent, 18, 1.5)
	return finish(object, "RallyBanner", accent)
end

-- Fortress traps use authored base CFrames so rotation never accumulates drift.
function CombatModels.RegisterStructureAnimation(entry)
	entry.AnimationParts = {}
	for _, item in ipairs(entry.Model:GetDescendants()) do
		if item:IsA("BasePart") and (item.Name == "MineRing" or item.Name == "MineCore" or item.Name == "Spike" or item.Name == "SpikeTip" or item.Name == "FlameCore") then
			table.insert(entry.AnimationParts, { Part = item, CFrame = item.CFrame, Size = item.Size, Name = item.Name })
		end
	end
end

function CombatModels.AnimateStructure(entry, clock)
	for _, visual in ipairs(entry.AnimationParts or {}) do
		local item = visual.Part
		if item.Parent then
			if visual.Name == "MineRing" then
				item.CFrame = visual.CFrame * CFrame.Angles(0, clock * 1.8, 0)
			elseif visual.Name == "MineCore" then
				local pulse = 1 + math.sin(clock * 6) * 0.12
				item.Size = visual.Size * pulse
				local glow = item:FindFirstChild("MineGlow")
				if glow then
					glow.Brightness = 1.2 + math.sin(clock * 6) * 0.6
				end
			elseif visual.Name == "Spike" or visual.Name == "SpikeTip" then
				local lift = entry.Model:GetAttribute("Triggered") == true and 0.8 or (0.15 + math.sin(clock * 2.5) * 0.15)
				item.CFrame = visual.CFrame * CFrame.new(0, lift, 0)
			elseif visual.Name == "FlameCore" then
				item.Size = Vector3.new(visual.Size.X, visual.Size.Y * (0.85 + math.sin(clock * 12) * 0.2), visual.Size.Z)
				item.Transparency = 0.08 + math.sin(clock * 9) * 0.05
			end
		end
	end
end

function CombatModels.AnimateUtility(object, clock, active)
	for _, item in ipairs(object:GetDescendants()) do
		if item:IsA("BasePart") then
			if item.Name == "MineRing" or item.Name == "DroneRotor" then
				local spin = tonumber(item:GetAttribute("Spin")) or 1
				item.CFrame = item.CFrame * CFrame.Angles(0, spin * 0.12, 0)
			elseif item.Name == "MineFuse" or item.Name == "BombSpark" then
				item.Transparency = active == false and 0.65 or (math.sin(clock * 14) > 0 and 0 or 0.35)
			end
		end
	end
end

function CombatModels.AnimateBanner(object, clock)
	local flag = object:FindFirstChild("BannerFlag")
	if flag then
		flag.Size = Vector3.new(5.8 + math.sin(clock * 4) * 0.25, 3.8, 0.25)
	end
end

return CombatModels
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="7">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="8">
      <Properties>
        <string name="Name">BlockSiegeServer</string>
      </Properties>
      <Item class="Script" referent="9">
        <Properties>
          <string name="Name">Main</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[-- BLOCKSIEGE server entry point.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("BlockSiege")
local services = script.Parent:WaitForChild("Services")
local WorldBuilder = require(services:WaitForChild("WorldBuilder"))
local DataService = require(services:WaitForChild("DataService"))
local FortressService = require(services:WaitForChild("FortressService"))
local GeodataService = require(services:WaitForChild("GeodataService"))
local CaptureService = require(services:WaitForChild("CaptureService"))
local NeutralService = require(services:WaitForChild("NeutralService"))
local WeaponService = require(services:WaitForChild("WeaponService"))
local BotService = require(services:WaitForChild("BotService"))
local AbilityService = require(services:WaitForChild("AbilityService"))
local BonusService = require(services:WaitForChild("BonusService"))
local EventService = require(services:WaitForChild("EventService"))
local SeasonService = require(services:WaitForChild("SeasonService"))
local ExpeditionService = require(services:WaitForChild("ExpeditionService"))
local LeaderboardService = require(services:WaitForChild("LeaderboardService"))
local CaseService = require(services:WaitForChild("CaseService"))
local ProgressionService = require(services:WaitForChild("ProgressionService"))
local ShopService = require(services:WaitForChild("ShopService"))
local MatchService = require(services:WaitForChild("MatchService"))

local remotes = Instance.new("Folder")
remotes.Name = "Remotes"
for _, name in ipairs({
	"Notify", "ProfileUpdate", "CaseOpened", "Results", "CombatFX", "BuildFX", "TrapFX", "CaptureFX", "ProgressionFX",
	"LobbyAction", "CaseAction", "FireRequest", "BuildRequest", "BuildPreviewRequest", "BuildPreview", "OpenPanel",
	"ProgressionAction", "ShopAction", "AbilityRequest", "AbilityFX", "AbilityState", "WeaponAction", "ReloadRequest", "BonusFX", "EventFX", "AdminEventRequest",
	"SeasonFX", "AdminSeasonRequest", "ExpeditionAction", "ExpeditionFX", "LeaderboardUpdate", "DeathFX",
}) do
	local remote = Instance.new("RemoteEvent")
	remote.Name = name
	remote.Parent = remotes
end
remotes.Parent = Shared

local state = Instance.new("Folder")
state.Name = "MatchState"
state.Parent = Shared

local world = WorldBuilder.Build()
DataService.Init({ Remotes = remotes })
ProgressionService.Init({ DataService = DataService, WeaponService = WeaponService, Remotes = remotes })
FortressService.Init({ World = world, Remotes = remotes, State = state })
GeodataService.Init({ World = world, FortressService = FortressService, State = state })
WeaponService.Init({ DataService = DataService, FortressService = FortressService, Remotes = remotes })
BotService.Init({
	World = world, FortressService = FortressService, WeaponService = WeaponService,
	GeodataService = GeodataService, CaptureService = CaptureService, AbilityService = AbilityService,
	SquadLevelProvider = function(team)
		local highest = 1
		for _, member in ipairs(Players:GetPlayers()) do
			if member:GetAttribute("Team") == team then
				highest = math.max(highest, DataService.GetSquadLevel(member))
			end
		end
		return highest
	end,
})
AbilityService.Init({ World = world, Remotes = remotes, State = state, FortressService = FortressService, BotService = BotService, WeaponService = WeaponService })
CaseService.Init({ DataService = DataService, Remotes = remotes })
ShopService.Init({ DataService = DataService, ProgressionService = ProgressionService, Remotes = remotes })
CaptureService.Init({ World = world, State = state, BotService = BotService, Remotes = remotes })
NeutralService.Init({ World = world, State = state, BotService = BotService, DataService = DataService, BonusService = BonusService, Remotes = remotes })
BonusService.Init({ World = world, Remotes = remotes, State = state })
EventService.Init({ World = world, Remotes = remotes, State = state, BonusService = BonusService, FortressService = FortressService, BotService = BotService })
SeasonService.Init({ World = world, Remotes = remotes, State = state, AdminService = EventService })
ExpeditionService.Init({ World = world, Remotes = remotes, State = state, DataService = DataService })
LeaderboardService.Init({ DataService = DataService, Remotes = remotes, State = state })
MatchService.Init({
	World = world,
	DataService = DataService,
	FortressService = FortressService,
	WeaponService = WeaponService,
	BotService = BotService,
	ProgressionService = ProgressionService,
	CaptureService = CaptureService,
	NeutralService = NeutralService,
	AbilityService = AbilityService,
	BonusService = BonusService,
	EventService = EventService,
	ExpeditionService = ExpeditionService,
	Remotes = remotes,
	State = state,
})
BonusService.SetProviders(MatchService.GetPhase, MatchService.GetTeam, MatchService.IsParticipant, MatchService.OnBonusReward)
EventService.SetProviders(MatchService.GetPhase, MatchService.GetTeam, MatchService.IsParticipant, MatchService.OnBonusReward)
ExpeditionService.SetProviders(MatchService.GetPhase, MatchService.GetTeam, MatchService.IsParticipant, MatchService.OnActionReward)
CaseService.SetEquipHandler(WeaponService.EquipPlayer)

local function onPlayerAdded(player)
	EventService.OnPlayerAdded(player)
	SeasonService.OnPlayerAdded(player)
	MatchService.OnPlayerAdded(player)
	task.spawn(function()
		DataService.Load(player)
		if player.Parent then
			MatchService.OnProfileLoaded(player)
			LeaderboardService.Broadcast(false)
		end
	end)
end

Players.PlayerAdded:Connect(onPlayerAdded)
Players.PlayerRemoving:Connect(function(player)
	ExpeditionService.OnPlayerRemoving(player)
	SeasonService.OnPlayerRemoving(player)
	EventService.OnPlayerRemoving(player)
	MatchService.OnPlayerRemoving(player)
	DataService.SaveAndClear(player)
end)

remotes.LobbyAction.OnServerEvent:Connect(function(player, action)
	MatchService.HandleLobbyAction(player, action)
end)
remotes.CaseAction.OnServerEvent:Connect(function(player, action, value)
	CaseService.HandleAction(player, action, value)
end)
remotes.FireRequest.OnServerEvent:Connect(function(player, targetPosition)
	WeaponService.FirePlayer(player, targetPosition)
end)
remotes.ReloadRequest.OnServerEvent:Connect(function(player)
	WeaponService.RequestReload(player)
end)
remotes.AbilityRequest.OnServerEvent:Connect(function(player, slot, targetPosition)
	local success = AbilityService.UsePlayerAbility(player, slot, targetPosition)
	if success and MatchService.GetPhase() == "Battle" and MatchService.IsParticipant(player) then
		BonusService.OnAction(player, "Ability")
	end
end)
remotes.AdminEventRequest.OnServerEvent:Connect(function(player, action, eventId)
	EventService.HandleAdminRequest(player, action, eventId)
end)
remotes.AdminSeasonRequest.OnServerEvent:Connect(function(player, seasonId)
	SeasonService.HandleAdminRequest(player, seasonId)
end)
remotes.ExpeditionAction.OnServerEvent:Connect(function(player, action, value)
	ExpeditionService.HandleAction(player, action, value)
end)
remotes.BuildRequest.OnServerEvent:Connect(function(player, kind, position, rotation)
	MatchService.HandleBuild(player, kind, position, rotation)
end)
remotes.BuildPreviewRequest.OnServerEvent:Connect(function(player, kind, position, rotation, requestId)
	MatchService.HandleBuildPreview(player, kind, position, rotation, requestId)
end)
remotes.ProgressionAction.OnServerEvent:Connect(function(player, action, value)
	ProgressionService.HandleAction(player, action, value)
end)
remotes.ShopAction.OnServerEvent:Connect(function(player, action, value)
	ShopService.HandleAction(player, action, value)
end)
world.LootPrompt.Triggered:Connect(function(player)
	remotes.OpenPanel:FireClient(player, "Cases")
end)
world.StartPrompt.Triggered:Connect(function(player)
	MatchService.HandleLobbyAction(player, "QuickStart")
end)
world.UpgradePrompt.Triggered:Connect(function(player)
	remotes.OpenPanel:FireClient(player, "Upgrades")
end)
world.DailyPrompt.Triggered:Connect(function(player)
	remotes.OpenPanel:FireClient(player, "Daily")
end)
world.ShopPrompt.Triggered:Connect(function(player)
	remotes.OpenPanel:FireClient(player, "Shop")
end)
world.DefensePrompt.Triggered:Connect(function(player)
	remotes.OpenPanel:FireClient(player, "Defense")
end)
if world.ExpeditionPrompt then
	world.ExpeditionPrompt.Triggered:Connect(function(player)
		remotes.OpenPanel:FireClient(player, "Expeditions")
	end)
end

local accumulator = 0
RunService.Heartbeat:Connect(function(deltaTime)
	accumulator = accumulator + math.min(deltaTime, 0.15)
	while accumulator >= 1 / 20 do
		MatchService.Step(1 / 20)
		EventService.Step(1 / 20)
		SeasonService.Step(1 / 20)
		ExpeditionService.Step(1 / 20)
		LeaderboardService.Step(1 / 20)
		GeodataService.Step(1 / 20)
		FortressService.Step(1 / 20)
		BotService.Step(1 / 20)
		AbilityService.Step(1 / 20)
		NeutralService.Step(1 / 20)
		WeaponService.Step(1 / 20)
		CaptureService.Step(1 / 20)
		DataService.Step(1 / 20)
		accumulator = accumulator - 1 / 20
	end
end)

for _, player in ipairs(Players:GetPlayers()) do
	onPlayerAdded(player)
end

print("[BLOCKSIEGE] 6x6 готов · классы, jungle, башни, мины, бомбы и разрушаемые крепости")
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="10">
        <Properties>
          <string name="Name">Services</string>
        </Properties>
        <Item class="ModuleScript" referent="36">
          <Properties>
            <string name="Name">BonusService</string>
            <string name="Source"><![CDATA[-- BLOCKSIEGE // MATCH BONUSES AND SUPPLY DROPS
-- Server-drafted missions, one-time rewards and tangible world pickups.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("BlockSiege")
local Catalog = require(Shared:WaitForChild("Catalog"))

local BonusService = {}
local world
local remotes
local state
local supplyFolder
local phaseProvider = function() return "Lobby" end
local teamProvider = function() return nil end
local participantProvider = function() return false end
local rewardHandler
local missions = {}
local supplies = {}
local battleClock = 0
local publishClock = 0
local nextSupplyAt = 8
local supplySerial = 0
local supplyEventBoost = 1

local GOLD = Color3.fromRGB(255, 196, 64)
local DARK = Color3.fromRGB(55, 46, 40)
local DROP_PAIRS = {
	{ Vector3.new(-105, 0, 48), Vector3.new(105, 0, -48) },
	{ Vector3.new(-55, 0, -42), Vector3.new(55, 0, 42) },
	{ Vector3.new(0, 0, 62), Vector3.new(0, 0, -62) },
}

local function activeSupplyCount()
	local count = 0
	for _, record in ipairs(supplies) do
		if not record.Collected and record.Model and record.Model.Parent then
			count = count + 1
		end
	end
	return count
end

local function publishSupplyState()
	if state then
		state:SetAttribute("SupplyActive", activeSupplyCount())
		state:SetAttribute("SupplyNext", math.max(0, math.ceil(nextSupplyAt - battleClock)))
	end
end

local function clearSupplies()
	for _, record in ipairs(supplies) do
		if record.Model then
			record.Model:Destroy()
		end
	end
	supplies = {}
	publishSupplyState()
end

local function clearPlayer(player)
	if not player then
		return
	end
	missions[player.UserId] = nil
	player:SetAttribute("BonusMissionCount", 0)
	player:SetAttribute("BonusCompleted", 0)
	player:SetAttribute("BonusSupplyCollected", 0)
	for index = 1, 3 do
		player:SetAttribute("BonusMission" .. index .. "Id", "")
		player:SetAttribute("BonusMission" .. index .. "Progress", 0)
		player:SetAttribute("BonusMission" .. index .. "Completed", false)
	end
end

local function shuffledMissionIds(userId, matchId)
	local ids = table.clone(Catalog.BonusMissionOrder)
	local random = Random.new((userId * 104729 + matchId * 7919) % 2000000000 + 1)
	for index = #ids, 2, -1 do
		local other = random:NextInteger(1, index)
		ids[index], ids[other] = ids[other], ids[index]
	end
	return { ids[1], ids[2], ids[3] }
end

local function assignMissions(player, matchId)
	local records = {}
	for index, id in ipairs(shuffledMissionIds(player.UserId, matchId)) do
		records[index] = { Id = id, Progress = 0, Completed = false }
		player:SetAttribute("BonusMission" .. index .. "Id", id)
		player:SetAttribute("BonusMission" .. index .. "Progress", 0)
		player:SetAttribute("BonusMission" .. index .. "Completed", false)
	end
	missions[player.UserId] = records
	player:SetAttribute("BonusMissionCount", #records)
	player:SetAttribute("BonusCompleted", 0)
	player:SetAttribute("BonusSupplyCollected", 0)
end

local function emitBonus(position, team, kind)
	if remotes and remotes.BonusFX and typeof(position) == typeof(Vector3.new()) then
		remotes.BonusFX:FireAllClients({ Kind = kind or "BonusMission", Position = position, Team = team, Color = GOLD })
	end
end

local function playerPosition(player)
	local character = player and player.Character or nil
	local root = character and (character:FindFirstChild("HumanoidRootPart") or character.PrimaryPart) or nil
	return root and root.Position or nil
end

function BonusService.Init(dependencies)
	world = dependencies.World
	remotes = dependencies.Remotes
	state = dependencies.State
	supplyFolder = world.Root:FindFirstChild("BonusDrops")
	if not supplyFolder then
		supplyFolder = Instance.new("Folder")
		supplyFolder.Name = "BonusDrops"
		supplyFolder.Parent = world.Root
	end
	if state then
		state:SetAttribute("BonusActive", false)
		state:SetAttribute("BonusMatchId", 0)
	end
	publishSupplyState()
end

function BonusService.SetProviders(phase, team, participant, reward)
	phaseProvider = phase or phaseProvider
	teamProvider = team or teamProvider
	participantProvider = participant or participantProvider
	rewardHandler = reward or rewardHandler
end

function BonusService.StartMatch(matchId, participants)
	clearSupplies()
	missions = {}
	battleClock = 0
	publishClock = 0
	nextSupplyAt = 8
	supplySerial = 0
	supplyEventBoost = 1
	for userId in pairs(participants) do
		local player = Players:GetPlayerByUserId(userId)
		if player then
			assignMissions(player, matchId)
		end
	end
	if state then
		state:SetAttribute("BonusActive", true)
		state:SetAttribute("BonusMatchId", matchId)
	end
	publishSupplyState()
end

function BonusService.OnAction(player, action, amount)
	if not player or not participantProvider(player) then
		return
	end
	local phase = phaseProvider()
	if phase ~= "Build" and phase ~= "Battle" then
		return
	end
	local records = missions[player.UserId]
	if not records then
		return
	end
	local increment = math.max(0, tonumber(amount) or 1)
	if increment <= 0 then
		return
	end
	for index, record in ipairs(records) do
		local definition = Catalog.GetBonusMission(record.Id)
		if definition and definition.Action == action and not record.Completed then
			record.Progress = math.min(definition.Target, record.Progress + increment)
			player:SetAttribute("BonusMission" .. index .. "Progress", record.Progress)
			if record.Progress >= definition.Target then
				record.Completed = true
				player:SetAttribute("BonusMission" .. index .. "Completed", true)
				player:SetAttribute("BonusCompleted", (player:GetAttribute("BonusCompleted") or 0) + 1)
				if rewardHandler then
					rewardHandler(player, definition.Coins, definition.XP, "БОНУС · " .. definition.Name)
				end
				emitBonus(playerPosition(player), teamProvider(player), "BonusMission")
			end
		end
	end
end

local collectSupply

local function createSupply(position)
	local model = Instance.new("Model")
	model.Name = "SupplyDrop"
	local function part(name, size, cframe, color, material)
		local object = Instance.new("Part")
		object.Name = name
		object.Size = size
		object.CFrame = cframe
		object.Color = color
		object.Material = material
		object.Anchored = true
		object.CanCollide = false
		object.CanTouch = false
		object.CanQuery = false
		object.CastShadow = true
		object.Parent = model
		return object
	end
	local root = part("SupplyRoot", Vector3.new(4.2, 2.8, 4.2), CFrame.new(position + Vector3.new(0, 3, 0)), GOLD, Enum.Material.Metal)
	root.CanTouch = true
	part("SupplyLid", Vector3.new(4.6, 0.65, 4.6), CFrame.new(position + Vector3.new(0, 4.65, 0)), DARK, Enum.Material.Metal)
	part("SupplyBandX", Vector3.new(0.48, 3.25, 4.5), CFrame.new(position + Vector3.new(0, 3.1, 0)), DARK, Enum.Material.Metal)
	part("SupplyBandZ", Vector3.new(4.5, 3.25, 0.48), CFrame.new(position + Vector3.new(0, 3.1, 0)), DARK, Enum.Material.Metal)
	local beacon = part("SupplyBeacon", Vector3.new(0.35, 18, 0.35), CFrame.new(position + Vector3.new(0, 12, 0)), GOLD, Enum.Material.Neon)
	beacon.Transparency = 0.72
	beacon.CastShadow = false
	local orb = part("SupplyOrb", Vector3.one * 1.25, CFrame.new(position + Vector3.new(0, 6.3, 0)), GOLD, Enum.Material.Neon)
	orb.Shape = Enum.PartType.Ball
	orb.CastShadow = false
	local light = Instance.new("PointLight")
	light.Color = GOLD
	light.Range = 20
	light.Brightness = 2.2
	light.Parent = orb
	local gui = Instance.new("BillboardGui")
	gui.Name = "SupplyLabel"
	gui.Size = UDim2.fromOffset(230, 68)
	gui.StudsOffset = Vector3.new(0, 5.5, 0)
	gui.AlwaysOnTop = true
	gui.MaxDistance = 180
	gui.Parent = root
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.Font = Enum.Font.GothamBold
	label.Text = "БОНУС\n+15 монет · +30 XP · +25 HP"
	label.TextColor3 = GOLD
	label.TextStrokeTransparency = 0.25
	label.TextScaled = true
	label.Parent = gui
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = "ПОДОБРАТЬ"
	prompt.ObjectText = "СНАБЖЕНИЕ"
	prompt.HoldDuration = 0.15
	prompt.MaxActivationDistance = 12
	prompt.RequiresLineOfSight = false
	prompt.Parent = root
	model.PrimaryPart = root
	local now = os.clock()
	local record = {
		Model = model,
		Root = root,
		Pivot = root.CFrame,
		Position = position,
		Born = now,
		Until = now + 30,
		Collected = false,
		Phase = math.random() * math.pi * 2,
	}
	root.Touched:Connect(function(hit)
		local character = hit and hit:FindFirstAncestorOfClass("Model") or nil
		local player = character and Players:GetPlayerFromCharacter(character) or nil
		if player and collectSupply then
			collectSupply(record, player)
		end
	end)
	prompt.Triggered:Connect(function(player)
		if collectSupply then
			collectSupply(record, player)
		end
	end)
	model.Parent = supplyFolder
	table.insert(supplies, record)
	return record
end

collectSupply = function(record, player)
	if not record or record.Collected or phaseProvider() ~= "Battle" or not participantProvider(player) then
		return false
	end
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid") or nil
	local root = character and character:FindFirstChild("HumanoidRootPart") or nil
	if not humanoid or humanoid.Health <= 0 or not root or not record.Root or not record.Root.Parent then
		return false
	end
	if (root.Position - record.Root.Position).Magnitude > 14 then
		return false
	end
	record.Collected = true
	humanoid.Health = math.min(humanoid.MaxHealth, humanoid.Health + 25)
	player:SetAttribute("BonusSupplyCollected", (player:GetAttribute("BonusSupplyCollected") or 0) + 1)
	if rewardHandler then
		rewardHandler(player, 15, 30, "СНАБЖЕНИЕ · +25 HP")
	end
	local position = record.Root.Position
	local team = teamProvider(player)
	record.Model:Destroy()
	emitBonus(position, team, "Supply")
	publishSupplyState()
	return true
end

local function spawnPair()
	supplySerial = supplySerial + 1
	local pair = DROP_PAIRS[(supplySerial - 1) % #DROP_PAIRS + 1]
	for _, position in ipairs(pair) do
		createSupply(position)
	end
	publishSupplyState()
end

function BonusService.SetEventBoost(multiplier)
	supplyEventBoost = math.clamp(tonumber(multiplier) or 1, 1, 3)
	if phaseProvider() == "Battle" then
		nextSupplyAt = math.min(nextSupplyAt, battleClock + 35 / supplyEventBoost)
	end
	publishSupplyState()
end

function BonusService.TriggerSupplyWave(pairCount)
	if phaseProvider() ~= "Battle" then
		return 0
	end
	local requested = math.clamp(math.floor(tonumber(pairCount) or 1), 1, 3)
	local spawned = 0
	for _ = 1, requested do
		if activeSupplyCount() > 4 then
			break
		end
		spawnPair()
		spawned = spawned + 1
	end
	return spawned
end

function BonusService.Step(deltaTime)
	if phaseProvider() ~= "Battle" then
		return
	end
	battleClock = battleClock + deltaTime
	publishClock = publishClock + deltaTime
	if battleClock >= nextSupplyAt then
		if activeSupplyCount() <= 4 then
			spawnPair()
		end
		nextSupplyAt = battleClock + 35 / supplyEventBoost
	end
	local now = os.clock()
	for index = #supplies, 1, -1 do
		local record = supplies[index]
		if record.Collected or not record.Model or not record.Model.Parent or now >= record.Until then
			if record.Model then
				record.Model:Destroy()
			end
			table.remove(supplies, index)
		else
			local bob = math.sin(now * 2.2 + record.Phase) * 0.45
			record.Model:PivotTo(record.Pivot * CFrame.new(0, bob, 0) * CFrame.Angles(0, now * 0.65, 0))
		end
	end
	if publishClock >= 0.2 then
		publishClock = 0
		publishSupplyState()
	end
end

function BonusService.EndMatch()
	clearSupplies()
	if state then
		state:SetAttribute("BonusActive", false)
	end
	battleClock = 0
	publishClock = 0
	nextSupplyAt = 8
	supplyEventBoost = 1
	publishSupplyState()
end

function BonusService.Reset()
	BonusService.EndMatch()
	missions = {}
	for _, player in ipairs(Players:GetPlayers()) do
		clearPlayer(player)
	end
end

function BonusService.OnPlayerRemoving(player)
	if player then
		clearPlayer(player)
	end
end

function BonusService.GetMissions(player)
	return player and missions[player.UserId] or nil
end

function BonusService.GetSupplyCount()
	return activeSupplyCount()
end

return BonusService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="38">
          <Properties>
            <string name="Name">EventService</string>
            <string name="Source"><![CDATA[-- BLOCKSIEGE // SERVER-AUTHORITATIVE LIVE EVENTS + ADMIN ABUSE
-- Scheduled UTC event windows and allowlisted owner/admin-triggered chaos.
-- No arbitrary commands, client-selected rewards or client-granted permissions.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("BlockSiege")
local Config = require(Shared:WaitForChild("Config"))
local EventCatalog = require(Shared:WaitForChild("EventCatalog"))

local EventService = {}
local world
local remotes
local state
local bonusService
local fortressService
local botService
local objectFolder
local phaseProvider = function() return "Lobby" end
local teamProvider = function() return nil end
local participantProvider = function() return false end
local rewardHandler
local timeProvider = os.time
local clockProvider = os.clock
local active
local suppressScheduleSlot = -1
local publishClock = 0
local meteorSerial = 0
local meteors = {}
local adminRequests = {}

local METEOR_POINTS = {
	Vector3.new(0, 0, 0),
	Vector3.new(-45, 0, 112),
	Vector3.new(45, 0, -112),
	Vector3.new(-90, 0, 0),
	Vector3.new(90, 0, 0),
	Vector3.new(0, 0, 105),
	Vector3.new(0, 0, -105),
	Vector3.new(-55, 0, -42),
}

local function scheduleNow()
	local timestamp = timeProvider()
	local period = EventCatalog.Schedule.Period
	local slot = math.floor(timestamp / period)
	return slot, timestamp % period
end

local function notify(player, message)
	if remotes and remotes.Notify and player and player.Parent then
		remotes.Notify:FireClient(player, message)
	end
end

local function emit(payload)
	if remotes and remotes.EventFX then
		remotes.EventFX:FireAllClients(payload)
	end
end

local function rootAndHumanoid(model)
	if not model or not model.Parent then
		return nil, nil
	end
	local root = model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart
	local humanoid = model:FindFirstChildOfClass("Humanoid")
	if not root or not humanoid or humanoid.Health <= 0 then
		return nil, nil
	end
	return root, humanoid
end

local function forEachCombatant(callback)
	for _, player in ipairs(Players:GetPlayers()) do
		if participantProvider(player) then
			callback(player.Character, teamProvider(player), player)
		end
	end
	if botService then
		for _, team in ipairs(Config.TeamOrder) do
			for _, model in ipairs(botService.GetModels(team)) do
				callback(model, team, nil)
			end
		end
	end
end

local function clearMeteors()
	for _, record in ipairs(meteors) do
		if record.Model then
			record.Model:Destroy()
		end
	end
	meteors = {}
end

local function repairPulse()
	if not active or active.Id ~= "RepairPulse" then
		return
	end
	for _, team in ipairs(Config.TeamOrder) do
		local position = fortressService and fortressService.GetCorePosition(team) or Config.BasePosition(team)
		if fortressService then
			fortressService.RepairStructures(team, position, 120, 60)
		end
		emit({ Kind = "RepairPulse", Position = position, Team = team, Color = active.Definition.Color, Radius = 18 })
	end
	forEachCombatant(function(model)
		local _, humanoid = rootAndHumanoid(model)
		if humanoid then
			humanoid.Health = math.min(humanoid.MaxHealth, humanoid.Health + 15)
		end
	end)
end

local function spawnMeteor()
	if not active or active.Id ~= "MeteorMadness" or not objectFolder then
		return
	end
	meteorSerial = meteorSerial + 1
	local position = METEOR_POINTS[(meteorSerial - 1) % #METEOR_POINTS + 1]
	local model = Instance.new("Model")
	model.Name = "AdminMeteor"
	local rock = Instance.new("Part")
	rock.Name = "MeteorRock"
	rock.Shape = Enum.PartType.Ball
	rock.Size = Vector3.one * 5
	rock.Color = Color3.fromRGB(255, 116, 55)
	rock.Material = Enum.Material.Slate
	rock.Anchored = true
	rock.CanCollide = false
	rock.CanTouch = false
	rock.CanQuery = false
	rock.CastShadow = true
	rock.Parent = model
	local fire = Instance.new("Fire")
	fire.Color = Color3.fromRGB(255, 93, 48)
	fire.SecondaryColor = Color3.fromRGB(255, 207, 87)
	fire.Heat = 8
	fire.Size = 8
	fire.Parent = rock
	local light = Instance.new("PointLight")
	light.Color = Color3.fromRGB(255, 112, 58)
	light.Brightness = 3
	light.Range = 22
	light.Parent = rock
	local warning = Instance.new("Part")
	warning.Name = "MeteorWarning"
	warning.Shape = Enum.PartType.Cylinder
	warning.Size = Vector3.new(0.22, 24, 24)
	warning.CFrame = CFrame.new(position + Vector3.new(0, 0.18, 0)) * CFrame.Angles(0, 0, math.rad(90))
	warning.Color = Color3.fromRGB(255, 68, 115)
	warning.Material = Enum.Material.Neon
	warning.Transparency = 0.42
	warning.Anchored = true
	warning.CanCollide = false
	warning.CanTouch = false
	warning.CanQuery = false
	warning.CastShadow = false
	warning.Parent = model
	local gui = Instance.new("BillboardGui")
	gui.Name = "MeteorCountdown"
	gui.Size = UDim2.fromOffset(250, 52)
	gui.StudsOffset = Vector3.new(0, 4, 0)
	gui.AlwaysOnTop = true
	gui.MaxDistance = 170
	gui.Parent = warning
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.Font = Enum.Font.GothamBold
	label.RichText = true
	label.Text = "<font color=\"#FF75B5\"><b>МЕТЕОР · УЙДИ С КРУГА</b></font>"
	label.TextColor3 = Color3.fromRGB(255, 225, 236)
	label.TextStrokeTransparency = 0.2
	label.TextScaled = true
	label.Parent = gui
	model.PrimaryPart = rock
	model.Parent = objectFolder
	local now = clockProvider()
	local start = position + Vector3.new(-28, 68, -24)
	rock.CFrame = CFrame.new(start)
	table.insert(meteors, {
		Model = model,
		Rock = rock,
		Warning = warning,
		Label = label,
		Position = position,
		Start = start,
		Finish = position + Vector3.new(0, 3, 0),
		Born = now,
		ImpactAt = now + 2.4,
	})
	emit({ Kind = "MeteorWarning", Position = position, Color = active.Definition.Color, Radius = 12 })
end

local function meteorImpact(record)
	forEachCombatant(function(model)
		local root, humanoid = rootAndHumanoid(model)
		if root and humanoid and humanoid.Health > 1 and (root.Position - record.Position).Magnitude <= 12 then
			-- Neutral, telegraphed and nonlethal: admin chaos cannot award a kill,
			-- delete a core or decide the match by itself.
			humanoid:TakeDamage(math.min(18, humanoid.Health - 1))
		end
	end)
	emit({ Kind = "MeteorImpact", Position = record.Position, Color = active and active.Definition.Color or Color3.fromRGB(163, 105, 255), Radius = 12 })
end

local function stepMeteors(deltaTime)
	if not active or active.Id ~= "MeteorMadness" then
		return
	end
	active.MeteorClock = active.MeteorClock + deltaTime
	if active.MeteorClock >= 5.5 then
		active.MeteorClock = 0
		spawnMeteor()
	end
	local now = clockProvider()
	for index = #meteors, 1, -1 do
		local record = meteors[index]
		if not record.Model or not record.Model.Parent then
			table.remove(meteors, index)
		elseif now >= record.ImpactAt then
			meteorImpact(record)
			record.Model:Destroy()
			table.remove(meteors, index)
		else
			local alpha = math.clamp((now - record.Born) / (record.ImpactAt - record.Born), 0, 1)
			record.Rock.CFrame = CFrame.new(record.Start:Lerp(record.Finish, alpha)) * CFrame.Angles(now * 2, now * 1.4, 0)
			record.Warning.Transparency = 0.3 + math.sin(now * 10) * 0.15
			record.Label.Text = string.format("<font color=\"#FF75B5\"><b>МЕТЕОР · %d · УЙДИ С КРУГА</b></font>", math.max(1, math.ceil(record.ImpactAt - now)))
		end
	end
end

local function awardCompletion(record)
	if not rewardHandler then
		return
	end
	for _, player in ipairs(Players:GetPlayers()) do
		local presence = participantProvider(player) and record.Presence[player.UserId] or 0
		if presence >= EventCatalog.Schedule.MinimumPresence then
			rewardHandler(player, EventCatalog.Schedule.CompletionCoins, EventCatalog.Schedule.CompletionXP, "ИВЕНТ ЗАВЕРШЁН · " .. record.Definition.Name)
		end
	end
end

local function publishState()
	local slot, within = scheduleNow()
	local inWindow = within < EventCatalog.Schedule.ActiveWindow
	local currentDefinition = EventCatalog.GetForSlot(slot)
	local nextDefinition = EventCatalog.GetForSlot(slot + 1)
	if state then
		if active then
			state:SetAttribute("EventActive", true)
			state:SetAttribute("EventId", active.Id)
			state:SetAttribute("EventName", active.Definition.Name)
			state:SetAttribute("EventDescription", active.Definition.Description)
			state:SetAttribute("EventColor", active.Definition.Color)
			state:SetAttribute("EventManual", active.Manual)
			state:SetAttribute("EventTime", math.max(0, math.ceil(active.Remaining)))
			state:SetAttribute("EventNextId", nextDefinition.Id)
			state:SetAttribute("EventNextName", nextDefinition.Name)
			state:SetAttribute("EventScheduledActive", inWindow)
			state:SetAttribute("EventScheduleWaiting", false)
		else
			local currentAvailable = inWindow and suppressScheduleSlot ~= slot
			local shown = currentAvailable and currentDefinition or nextDefinition
			state:SetAttribute("EventActive", false)
			state:SetAttribute("EventId", "")
			state:SetAttribute("EventName", "")
			state:SetAttribute("EventDescription", "")
			state:SetAttribute("EventManual", false)
			state:SetAttribute("EventColor", shown.Color)
			state:SetAttribute("EventNextId", shown.Id)
			state:SetAttribute("EventNextName", shown.Name)
			state:SetAttribute("EventScheduledActive", currentAvailable)
			state:SetAttribute("EventScheduleWaiting", currentAvailable and phaseProvider() ~= "Battle")
			state:SetAttribute("EventTime", currentAvailable and math.max(0, math.ceil(EventCatalog.Schedule.ActiveWindow - within)) or math.max(0, math.ceil(EventCatalog.Schedule.Period - within)))
		end
		state:SetAttribute("EventRewardMultiplier", EventService.GetRewardMultiplier())
	end
end

local stopActive

local function startEvent(id, manual, remaining, scheduleSlot)
	local definition = EventCatalog.Get(id)
	if not definition or phaseProvider() ~= "Battle" then
		return false
	end
	if active then
		stopActive("replace", false)
	end
	local slot = scheduleNow()
	active = {
		Id = id,
		Definition = definition,
		Manual = manual == true,
		Remaining = math.max(0.1, tonumber(remaining) or definition.Duration),
		Elapsed = 0,
		Presence = {},
		PulseClock = 0,
		MeteorClock = 0,
		ScheduleSlot = scheduleSlot,
	}
	if active.Manual then
		suppressScheduleSlot = slot
	end
	if state then
		state:SetAttribute("EventSequence", (state:GetAttribute("EventSequence") or 0) + 1)
	end
	emit({
		Kind = "Announcement",
		Title = active.Manual and "⚡ ADMIN ABUSE ⚡" or "LIVE EVENT",
		Subtitle = definition.Name .. "\n" .. definition.Announcement,
		Color = definition.Color,
		Duration = 4,
	})
	if id == "SupplyStorm" then
		if bonusService then
			bonusService.SetEventBoost(3)
			bonusService.TriggerSupplyWave(1)
		end
	elseif id == "RepairPulse" then
		repairPulse()
	elseif id == "MeteorMadness" then
		spawnMeteor()
	end
	publishState()
	return true
end

stopActive = function(reason, completed)
	local record = active
	if not record then
		return
	end
	-- Completion is a fixed participation grant, not a Gold Rush action reward.
	-- Clear active first so MatchService cannot multiply the 5/10 completion grant.
	active = nil
	if completed then
		awardCompletion(record)
		suppressScheduleSlot = record.ScheduleSlot or scheduleNow()
	end
	if bonusService then
		bonusService.SetEventBoost(1)
	end
	clearMeteors()
	if completed then
		emit({
			Kind = "Announcement",
			Title = "ИВЕНТ ЗАВЕРШЁН",
			Subtitle = record.Definition.Name .. "\nНаграда активным участникам · следующий ивент уже в расписании",
			Color = record.Definition.Color,
			Duration = 3,
		})
	end
	publishState()
end

function EventService.IsAdmin(player)
	if not player or not player.Parent then
		return false
	end
	local admin = Config.Admin or {}
	if admin.UserIds and admin.UserIds[player.UserId] == true then
		return true
	end
	if admin.StudioAdmin and RunService:IsStudio() then
		return true
	end
	if game.CreatorType == Enum.CreatorType.User and player.UserId == game.CreatorId then
		return true
	end
	if game.CreatorType == Enum.CreatorType.Group then
		local ok, rank = pcall(function()
			return player:GetRankInGroup(game.CreatorId)
		end)
		return ok and rank >= (admin.GroupMinimumRank or 200)
	end
	return false
end

function EventService.OnPlayerAdded(player)
	player:SetAttribute("EventAdmin", EventService.IsAdmin(player))
end

function EventService.OnPlayerRemoving(player)
	if player then
		adminRequests[player.UserId] = nil
	end
end

function EventService.HandleAdminRequest(player, action, eventId)
	if not EventService.IsAdmin(player) then
		notify(player, "ADMIN · недостаточно прав")
		return false, "not_admin"
	end
	local now = clockProvider()
	local previous = adminRequests[player.UserId] or -1000
	if now - previous < (Config.Admin.RequestCooldown or 0.75) then
		notify(player, "ADMIN · подожди перед следующей командой")
		return false, "cooldown"
	end
	adminRequests[player.UserId] = now
	if action == "Stop" then
		if not active then
			return false, "no_active_event"
		end
		suppressScheduleSlot = scheduleNow()
		stopActive("admin", false)
		notify(player, "ADMIN · ивент остановлен без награды за завершение")
		return true
	end
	if action ~= "Start" or not EventCatalog.Get(eventId) then
		return false, "invalid_request"
	end
	if phaseProvider() ~= "Battle" then
		notify(player, "ADMIN · запуск ивентов доступен во время Battle")
		return false, "wrong_phase"
	end
	return startEvent(eventId, true, EventCatalog.Get(eventId).Duration, nil)
end

function EventService.GetRewardMultiplier()
	return active and active.Id == "GoldRush" and phaseProvider() == "Battle" and 2 or 1
end

function EventService.GetActiveId()
	return active and active.Id or ""
end

function EventService.GetMeteorCount()
	return #meteors
end

function EventService.SetProviders(phase, team, participant, reward)
	phaseProvider = phase or phaseProvider
	teamProvider = team or teamProvider
	participantProvider = participant or participantProvider
	rewardHandler = reward or rewardHandler
end

function EventService.Step(deltaTime)
	local dt = math.clamp(tonumber(deltaTime) or 0, 0, 0.25)
	if active then
		if phaseProvider() ~= "Battle" then
			stopActive("phase", false)
		else
			active.Elapsed = active.Elapsed + dt
			active.Remaining = active.Remaining - dt
			for _, player in ipairs(Players:GetPlayers()) do
				if participantProvider(player) then
					active.Presence[player.UserId] = (active.Presence[player.UserId] or 0) + dt
				end
			end
			if active.Id == "RepairPulse" then
				active.PulseClock = active.PulseClock + dt
				if active.PulseClock >= 10 then
					active.PulseClock = 0
					repairPulse()
				end
			elseif active.Id == "MeteorMadness" then
				stepMeteors(dt)
			end
			if active and active.Remaining <= 0 then
				stopActive("complete", true)
			end
		end
	end
	local slot, within = scheduleNow()
	if active and not active.Manual and (slot ~= active.ScheduleSlot or within >= EventCatalog.Schedule.ActiveWindow) then
		stopActive("schedule", within >= EventCatalog.Schedule.ActiveWindow and phaseProvider() == "Battle")
	end
	if not active and phaseProvider() == "Battle" and within < EventCatalog.Schedule.ActiveWindow and suppressScheduleSlot ~= slot then
		startEvent(EventCatalog.GetForSlot(slot).Id, false, EventCatalog.Schedule.ActiveWindow - within, slot)
	end
	publishClock = publishClock + dt
	if publishClock >= 0.2 then
		publishClock = 0
		publishState()
	end
end

function EventService.Init(dependencies)
	world = dependencies.World
	remotes = dependencies.Remotes
	state = dependencies.State
	bonusService = dependencies.BonusService
	fortressService = dependencies.FortressService
	botService = dependencies.BotService
	timeProvider = dependencies.TimeProvider or os.time
	clockProvider = dependencies.ClockProvider or os.clock
	objectFolder = world.Root:FindFirstChild("EventObjects")
	if not objectFolder then
		objectFolder = Instance.new("Folder")
		objectFolder.Name = "EventObjects"
		objectFolder.Parent = world.Root
	end
	if state then
		state:SetAttribute("EventActive", false)
		state:SetAttribute("EventSequence", 0)
		state:SetAttribute("EventRewardMultiplier", 1)
	end
	publishState()
end

function EventService.Reset()
	stopActive("reset", false)
	suppressScheduleSlot = -1
	meteorSerial = 0
	publishState()
end

return EventService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="42">
          <Properties>
            <string name="Name">SeasonService</string>
            <string name="Source"><![CDATA[-- BLOCKSIEGE // Server-authoritative seasonal presentation layer.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("BlockSiege")
local SeasonCatalog = require(Shared:WaitForChild("SeasonCatalog"))
local VisualModels = require(Shared:WaitForChild("VisualModels"))

local SeasonService = {}
local world
local remotes
local state
local adminService
local folder
local currentId = SeasonCatalog.Default
local revision = 0
local requestClocks = {}
local animated = {}
local clock = 0

local function part(parent, name, size, cframe, color, material, shape)
	local object = Instance.new("Part")
	object.Name = name
	object.Size = size
	object.CFrame = cframe
	object.Color = color
	object.Material = material or Enum.Material.SmoothPlastic
	object.Shape = shape or Enum.PartType.Block
	object.Anchored = true
	object.CanCollide = false
	object.CanTouch = false
	object.CanQuery = false
	object.CastShadow = true
	object:SetAttribute("SeasonalDecor", true)
	object.Parent = parent
	return object
end

local function light(parent, color)
	local glow = Instance.new("PointLight")
	glow.Color = color
	glow.Brightness = 1.1
	glow.Range = 8
	glow.Parent = parent
end

local function floatPart(object, amount, speed)
	table.insert(animated, { Part = object, Base = object.CFrame, Amount = amount or 0.25, Speed = speed or 1, Phase = #animated * 0.7 })
	return object
end

local function pumpkin(parent, position, definition, scale)
	local body = part(parent, "HalloweenPumpkin", Vector3.new(3.4, 2.8, 3.1) * scale, CFrame.new(position + Vector3.new(0, 1.5 * scale, 0)), definition.Color, Enum.Material.SmoothPlastic, Enum.PartType.Ball)
	part(parent, "PumpkinStem", Vector3.new(0.45, 1.1, 0.45) * scale, CFrame.new(position + Vector3.new(0, 3.3 * scale, 0)), Color3.fromRGB(77, 142, 72), Enum.Material.Grass)
	for _, side in ipairs({ -1, 1 }) do
		part(parent, "PumpkinEye", Vector3.new(0.45, 0.35, 0.12) * scale, CFrame.new(position + Vector3.new(side * 0.65 * scale, 1.8 * scale, -1.45 * scale)), definition.Accent, Enum.Material.Neon)
	end
	light(body, definition.Accent)
	floatPart(body, 0.08, 1.4)
end

local function egg(parent, position, definition, scale)
	local body = part(parent, "EasterEgg", Vector3.new(2.3, 3.1, 2.3) * scale, CFrame.new(position + Vector3.new(0, 1.6 * scale, 0)), definition.Color, Enum.Material.SmoothPlastic, Enum.PartType.Ball)
	part(parent, "EggRibbon", Vector3.new(2.1, 0.35, 2.1) * scale, CFrame.new(position + Vector3.new(0, 1.6 * scale, 0)), definition.Accent, Enum.Material.Neon, Enum.PartType.Ball)
	light(body, definition.Accent)
	floatPart(body, 0.16, 1.2)
end

local function flower(parent, position, definition, scale)
	part(parent, "SpringStem", Vector3.new(0.22, 2.4, 0.22) * scale, CFrame.new(position + Vector3.new(0, 1.2 * scale, 0)), Color3.fromRGB(83, 181, 104), Enum.Material.Grass)
	for index = 1, 5 do
		local angle = (index - 1) * math.pi * 2 / 5
		local offset = Vector3.new(math.cos(angle) * 0.7, 2.5, math.sin(angle) * 0.7) * scale
		part(parent, "SpringPetal", Vector3.new(0.85, 0.45, 0.85) * scale, CFrame.new(position + offset), definition.Color, Enum.Material.SmoothPlastic, Enum.PartType.Ball)
	end
	local center = part(parent, "SpringCenter", Vector3.one * 0.65 * scale, CFrame.new(position + Vector3.new(0, 2.5 * scale, 0)), definition.Accent, Enum.Material.Neon, Enum.PartType.Ball)
	light(center, definition.Accent)
end

local function flag(parent, position, definition, scale)
	part(parent, "DefenderPole", Vector3.new(0.22, 7, 0.22) * scale, CFrame.new(position + Vector3.new(0, 3.5 * scale, 0)), definition.Accent, Enum.Material.Metal)
	local banner = part(parent, "DefenderBanner", Vector3.new(3.4, 2.1, 0.18) * scale, CFrame.new(position + Vector3.new(1.45 * scale, 5.6 * scale, 0)), definition.Color, Enum.Material.Fabric)
	part(parent, "DefenderStar", Vector3.one * 0.8 * scale, CFrame.new(position + Vector3.new(1.45 * scale, 5.6 * scale, -0.18)), definition.Accent, Enum.Material.Neon, Enum.PartType.Ball)
	floatPart(banner, 0.12, 1.6)
end

local function buildTheme(definition)
	animated = {}
	local model = Instance.new("Model")
	model.Name = "Season_" .. definition.Id
	model:SetAttribute("SeasonId", definition.Id)
	model.Parent = folder
	local positions = {
		Vector3.new(-76, 44.5, 280), Vector3.new(76, 44.5, 380),
		Vector3.new(-150, 0, -128), Vector3.new(150, 0, 128),
		Vector3.new(-105, 0, 118), Vector3.new(105, 0, -118),
	}
	for index, position in ipairs(positions) do
		local scale = index <= 2 and 1.1 or 0.85
		if definition.Id == "NewYear" and not (world and world.WinterDecor) then
			local tree = VisualModels.ChristmasTree(model, position, scale * 0.55)
			tree:SetAttribute("SeasonalDecor", true)
		elseif definition.Id == "Halloween" then
			pumpkin(model, position, definition, scale)
		elseif definition.Id == "Defenders" then
			flag(model, position, definition, scale)
		elseif definition.Id == "WomensDay" then
			flower(model, position, definition, scale)
		elseif definition.Id == "Easter" then
			egg(model, position, definition, scale)
		end
	end
	return model
end

function SeasonService.GetSnapshot()
	local definition = SeasonCatalog.Get(currentId)
	return { Id = currentId, Name = definition.Name, Subtitle = definition.Subtitle, Color = definition.Color, Revision = revision }
end

function SeasonService.Apply(id, force)
	local definition = SeasonCatalog.Get(id)
	if not definition then
		return false
	end
	if world and world.WinterDecor then
		world.WinterDecor.Parent = id == "NewYear" and world.Root or nil
	end
	if id == currentId and not force and folder and folder:FindFirstChild("Season_" .. id) then
		return false
	end
	if folder then
		folder:ClearAllChildren()
	end
	currentId = id
	revision = revision + 1
	buildTheme(definition)
	if state then
		state:SetAttribute("SeasonId", definition.Id)
		state:SetAttribute("SeasonName", definition.Name)
		state:SetAttribute("SeasonSubtitle", definition.Subtitle)
		state:SetAttribute("SeasonColor", definition.Color)
		state:SetAttribute("SeasonRevision", revision)
	end
	if remotes then
		remotes.SeasonFX:FireAllClients(SeasonService.GetSnapshot())
	end
	return true
end

function SeasonService.HandleAdminRequest(player, id)
	if not adminService or not adminService.IsAdmin(player) then
		return false
	end
	local now = os.clock()
	if now - (requestClocks[player.UserId] or -math.huge) < 0.75 then
		return false
	end
	requestClocks[player.UserId] = now
	return SeasonService.Apply(id, false)
end

function SeasonService.OnPlayerAdded(player)
	requestClocks[player.UserId] = nil
	if remotes and player.Parent then
		remotes.SeasonFX:FireClient(player, SeasonService.GetSnapshot())
	end
end

function SeasonService.OnPlayerRemoving(player)
	requestClocks[player.UserId] = nil
end

function SeasonService.Init(dependencies)
	world = dependencies.World
	remotes = dependencies.Remotes
	state = dependencies.State
	adminService = dependencies.AdminService
	folder = Instance.new("Folder")
	folder.Name = "SeasonalDecor"
	folder.Parent = world.Root
	world.Seasonal = folder
	SeasonService.Apply(SeasonCatalog.Default, true)
end

function SeasonService.Step(deltaTime)
	clock = clock + deltaTime
	for _, item in ipairs(animated) do
		if item.Part.Parent then
			item.Part.CFrame = item.Base * CFrame.new(0, math.sin(clock * item.Speed + item.Phase) * item.Amount, 0) * CFrame.Angles(0, math.sin(clock * 0.7 + item.Phase) * 0.08, 0)
		end
	end
end

return SeasonService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="43">
          <Properties>
            <string name="Name">ExpeditionService</string>
            <string name="Source"><![CDATA[-- BLOCKSIEGE // Shared level-gated PvE expeditions inside the fortress world.
-- The 6v6 match remains authoritative; an expedition is an optional side run
-- during Battle with its own enemies, waves, rewards and complete cleanup.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("BlockSiege")
local ExpeditionCatalog = require(Shared:WaitForChild("ExpeditionCatalog"))
local Catalog = require(Shared:WaitForChild("Catalog"))

local ExpeditionService = {}
local world
local remotes
local state
local dataService
local phaseProvider = function() return "Lobby" end
local teamProvider = function() return nil end
local participantProvider = function() return false end
local rewardHandler
local folder
local runs = {}
local playerRuns = {}
local requestClocks = {}
local nextRunId = 0

local function rootOf(model)
	return model and (model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart) or nil
end

local function living(model)
	local humanoid = model and model:FindFirstChildOfClass("Humanoid")
	local root = rootOf(model)
	return humanoid and humanoid.Health > 0 and root and humanoid or nil
end

local function notify(player, text)
	if remotes and player and player.Parent then
		remotes.Notify:FireClient(player, text)
	end
end

local function visualPart(parent, name, size, cframe, color, material, collide, query)
	local object = Instance.new("Part")
	object.Name = name
	object.Size = size
	object.CFrame = cframe
	object.Color = color
	object.Material = material or Enum.Material.SmoothPlastic
	object.Anchored = true
	object.CanCollide = collide == true
	object.CanTouch = false
	object.CanQuery = query == true
	object.CastShadow = true
	object.Parent = parent
	return object
end

local function tag(parent, title, color)
	local gui = Instance.new("BillboardGui")
	gui.Name = "ExpeditionTag"
	gui.Size = UDim2.fromOffset(230, 52)
	gui.StudsOffset = Vector3.new(0, 4, 0)
	gui.AlwaysOnTop = true
	gui.MaxDistance = 140
	gui.Parent = parent
	local text = Instance.new("TextLabel")
	text.Name = "Health"
	text.Size = UDim2.fromScale(1, 1)
	text.BackgroundTransparency = 1
	text.Font = Enum.Font.GothamBold
	text.TextScaled = true
	text.TextColor3 = color
	text.TextStrokeTransparency = 0.25
	text.Text = title
	text.Parent = gui
	return text
end

local function returnCFrame(player)
	local team = teamProvider(player)
	return team and world.TeamSpawns[team] or world.LobbySpawn
end

local function aliveEnemies(run)
	local count = 0
	for _, enemy in ipairs(run.Enemies) do
		if not enemy.Dead and living(enemy.Model) then
			count = count + 1
		end
	end
	return count
end

local function playerCount(run)
	local count = 0
	for _ in pairs(run.Players) do
		count = count + 1
	end
	return count
end

local function snapshot(run, player)
	local data = dataService and dataService.Get(player) or nil
	return {
		Type = "Snapshot",
		InExpedition = run ~= nil,
		LocationId = run and run.Definition.Id or (data and data.SelectedExpedition or player:GetAttribute("SelectedExpedition") or "VerdantBastion"),
		Wave = run and run.Wave or 0,
		MaxWaves = ExpeditionCatalog.MaxWaves,
		Enemies = run and aliveEnemies(run) or 0,
		Players = run and playerCount(run) or 0,
		Completed = run and run.Completed == true or false,
		BestWave = data and data.ExpeditionBestWave or player:GetAttribute("ExpeditionBestWave") or 0,
		SquadLevel = player:GetAttribute("SquadLevel") or 1,
	}
end

local function sendSnapshot(player, run)
	if remotes and player and player.Parent then
		remotes.ExpeditionFX:FireClient(player, snapshot(run, player))
	end
end

local function broadcast(run)
	for _, entry in pairs(run.Players) do
		sendSnapshot(entry.Player, run)
	end
end

local function buildStage(run)
	local definition = run.Definition
	local center = definition.Center
	run.Model = Instance.new("Folder")
	run.Model.Name = "Expedition_" .. definition.Id .. "_" .. run.Id
	run.Model:SetAttribute("ExpeditionId", definition.Id)
	run.Model.Parent = folder
	visualPart(run.Model, "ExpeditionPlatform", Vector3.new(150, 2, 110), CFrame.new(center + Vector3.new(0, -1, 0)), Color3.fromRGB(28, 43, 58), Enum.Material.Slate, true, false)
	visualPart(run.Model, "ExpeditionArena", Vector3.new(138, 0.35, 98), CFrame.new(center + Vector3.new(0, 0.2, 0)), definition.Color, Enum.Material.Ground, true, false)
	for _, side in ipairs({ -1, 1 }) do
		visualPart(run.Model, "ExpeditionBoundary", Vector3.new(2, 12, 110), CFrame.new(center + Vector3.new(side * 75, 6, 0)), definition.Accent, Enum.Material.Metal, true, false)
		visualPart(run.Model, "ExpeditionBoundary", Vector3.new(150, 12, 2), CFrame.new(center + Vector3.new(0, 6, side * 55)), definition.Accent, Enum.Material.Metal, true, false)
	end
	run.SpawnCFrame = CFrame.lookAt(center + Vector3.new(0, 4, 34), center + Vector3.new(0, 4, 0))
	visualPart(run.Model, "ExpeditionSpawnPad", Vector3.new(18, 0.4, 14), CFrame.new(center + Vector3.new(0, 0.5, 34)), definition.Accent, Enum.Material.Neon, false, false)
	for index = 1, 6 do
		local angle = (index - 1) * math.pi / 3
		local position = center + Vector3.new(math.cos(angle) * 57, 3, math.sin(angle) * 39)
		local crystal = visualPart(run.Model, "ExpeditionCrystal", Vector3.new(2.4, 6, 2.4), CFrame.new(position), definition.Accent, Enum.Material.Neon, false, false)
		local glow = Instance.new("PointLight")
		glow.Color = definition.Accent
		glow.Range = 12
		glow.Brightness = 1.5
		glow.Parent = crystal
		table.insert(run.Animated, { Part = crystal, Base = crystal.CFrame, Phase = index * 0.8 })
	end
	local sign = visualPart(run.Model, "ExpeditionSign", Vector3.one, CFrame.new(center + Vector3.new(0, 9, -48)), definition.Accent, Enum.Material.Neon, false, false)
	sign.Transparency = 1
	tag(sign, definition.Name .. " · PVE", definition.Accent)
end

local function createRun(definition)
	nextRunId = nextRunId + 1
	local run = {
		Id = nextRunId,
		Definition = definition,
		Players = {},
		Connections = {},
		Enemies = {},
		Animated = {},
		Wave = 0,
		Completed = false,
		Active = true,
		NextWaveAt = os.clock() + 1.5,
		NextSnapshot = 0,
		DestroyAt = 0,
	}
	buildStage(run)
	runs[definition.Id] = run
	return run
end

local function enemyDeath(enemy)
	if enemy.Dead then
		return
	end
	enemy.Dead = true
	local run = enemy.Run
	if not run.Active then
		return
	end
	local model = enemy.Model
	local lastDamage = tonumber(model:GetAttribute("LastDamageClock")) or -math.huge
	local attackerId = os.clock() - lastDamage <= 10 and model:GetAttribute("LastAttackerUserId") or nil
	local attacker = attackerId and Players:GetPlayerByUserId(attackerId) or nil
	if attacker and run.Players[attacker.UserId] and rewardHandler then
		rewardHandler(attacker, run.Definition.KillCoins, run.Definition.KillXP, "PvE · " .. run.Definition.EnemyName)
	end
	if remotes then
		remotes.CombatFX:FireAllClients({ Kind = "ExpeditionDefeated", Position = enemy.Root.Position, Color = run.Definition.Accent })
	end
	task.delay(1, function()
		if model.Parent then
			model:Destroy()
		end
	end)
	broadcast(run)
end

local function spawnEnemy(run, index, boss)
	local definition = run.Definition
	local center = definition.Center
	local row = math.floor((index - 1) / 3)
	local column = (index - 1) % 3 - 1
	local position = center + Vector3.new(column * 18, boss and 5 or 3.5, -20 - row * 15)
	if boss then
		position = center + Vector3.new(0, 6, -30)
	end
	local model = Instance.new("Model")
	model.Name = boss and "ExpeditionBoss" or "ExpeditionEnemy"
	model:SetAttribute("Team", "Neutral")
	model:SetAttribute("IsExpeditionEnemy", true)
	model:SetAttribute("ExpeditionId", definition.Id)
	model:SetAttribute("ExpeditionRun", run.Id)
	model:SetAttribute("Armor", boss and 0.18 or 0.05)
	model.Parent = run.Model
	local root = visualPart(model, "HumanoidRootPart", Vector3.new(3, 3, 3), CFrame.new(position), definition.Color, Enum.Material.Slate, false, false)
	root.Transparency = 1
	model.PrimaryPart = root
	local scale = boss and 1.65 or 1
	local body = visualPart(model, "Body", Vector3.new(4.4, 4.8, 4) * scale, CFrame.new(position), definition.Color, Enum.Material.DiamondPlate, false, true)
	local head = visualPart(model, "Head", Vector3.new(2.8, 2.4, 2.8) * scale, CFrame.new(position + Vector3.new(0, 3.5 * scale, 0)), Color3.fromRGB(30, 42, 61), Enum.Material.Slate, false, true)
	visualPart(model, "EnemyEye", Vector3.new(1.5, 0.4, 0.25) * scale, CFrame.new(position + Vector3.new(0, 3.6 * scale, -1.45 * scale)), definition.Accent, Enum.Material.Neon, false, false)
	for _, side in ipairs({ -1, 1 }) do
		visualPart(model, "EnemyHorn", Vector3.new(0.55, 2.3, 0.55) * scale, CFrame.new(position + Vector3.new(side * 1.2 * scale, 5.1 * scale, 0)) * CFrame.Angles(0, 0, math.rad(side * 18)), definition.Accent, Enum.Material.Metal, false, false)
	end
	local humanoid = Instance.new("Humanoid")
	humanoid.MaxHealth = definition.EnemyHealth * (1 + (run.Wave - 1) * 0.22) * (boss and 3 or 1)
	humanoid.Health = humanoid.MaxHealth
	humanoid.WalkSpeed = 0
	humanoid.RequiresNeck = false
	humanoid.BreakJointsOnDeath = false
	humanoid.Parent = model
	local enemy = {
		Run = run, Model = model, Root = root, Body = body, Humanoid = humanoid,
		Boss = boss == true, Dead = false, Speed = definition.EnemySpeed * (boss and 0.72 or 1),
		Damage = definition.EnemyDamage * (boss and 1.45 or 1), NextAttack = os.clock() + 1,
		NextSpecial = os.clock() + 5, Tag = tag(head, (boss and "BOSS · " or "") .. definition.EnemyName, definition.Accent),
	}
	humanoid.Died:Connect(function()
		enemyDeath(enemy)
	end)
	table.insert(run.Enemies, enemy)
	return enemy
end

local function spawnWave(run)
	if not run.Active or run.Completed then
		return
	end
	run.Wave = run.Wave + 1
	run.Enemies = {}
	local count = run.Definition.BaseEnemies + (run.Wave - 1) * 2
	for index = 1, count do
		spawnEnemy(run, index, false)
	end
	if run.Wave == ExpeditionCatalog.MaxWaves then
		spawnEnemy(run, count + 1, true)
	end
	run.NextWaveAt = 0
	broadcast(run)
end

local function completeRun(run)
	if run.Completed or not run.Active then
		return
	end
	run.Completed = true
	run.DestroyAt = os.clock() + 45
	for _, entry in pairs(run.Players) do
		local player = entry.Player
		if dataService then
			dataService.AwardExpedition(player, run.Definition.Id, run.Wave, run.Definition.RewardCoins, run.Definition.RewardXP)
		end
		notify(player, "Экспедиция завершена · +" .. run.Definition.RewardCoins .. " монет · +" .. run.Definition.RewardXP .. " XP")
		if remotes then
			remotes.ExpeditionFX:FireClient(player, { Type = "Completed", LocationId = run.Definition.Id, Wave = run.Wave, Coins = run.Definition.RewardCoins, XP = run.Definition.RewardXP })
		end
	end
	broadcast(run)
end

local function bossSlam(run, enemy)
	if not run.Active or enemy.Dead then
		return
	end
	local position = enemy.Root.Position
	local groundPosition = Vector3.new(position.X, run.Definition.Center.Y + 0.45, position.Z)
	local ring = visualPart(run.Model, "BossSlamTelegraph", Vector3.new(18, 0.25, 18), CFrame.new(groundPosition), Color3.fromRGB(255, 86, 102), Enum.Material.Neon, false, false)
	ring.Transparency = 0.25
	if remotes then
		remotes.CombatFX:FireAllClients({ Kind = "ExpeditionBossWarning", Position = position, Color = Color3.fromRGB(255, 86, 102) })
	end
	task.delay(1.15, function()
		if ring.Parent then
			ring:Destroy()
		end
		if not run.Active or enemy.Dead or not enemy.Model.Parent then
			return
		end
		for _, entry in pairs(run.Players) do
			local character = entry.Player.Character
			local humanoid = living(character)
			local root = rootOf(character)
			if humanoid and root and (root.Position - position).Magnitude <= 19 then
				local armor = tonumber(character:GetAttribute("Armor")) or 0
				local shield = tonumber(character:GetAttribute("DamageTakenMultiplier")) or 1
				character:SetAttribute("LastDamageSource", "Expedition")
				character:SetAttribute("LastDamageClock", os.clock())
				character:SetAttribute("LastAttackerName", run.Definition.EnemyName)
				character:SetAttribute("LastAttackerUserId", nil)
				humanoid:TakeDamage(35 * math.clamp(shield, 0.05, 1) * (1 - math.clamp(armor, 0, 0.65)))
			end
		end
		if remotes then
			remotes.CombatFX:FireAllClients({ Kind = "ExpeditionBossSlam", Position = position, Color = Color3.fromRGB(255, 113, 91) })
		end
	end)
end

local function nearestPlayer(run, position)
	local best
	local bestRoot
	local bestDistance = math.huge
	for _, entry in pairs(run.Players) do
		local character = entry.Player.Character
		local root = rootOf(character)
		if living(character) and root then
			local distance = (root.Position - position).Magnitude
			if distance < bestDistance then
				best = character
				bestRoot = root
				bestDistance = distance
			end
		end
	end
	return best, bestRoot, bestDistance
end

local function stepEnemies(run, now, deltaTime)
	for _, enemy in ipairs(run.Enemies) do
		if not enemy.Dead and living(enemy.Model) and enemy.Model.Parent then
			local target, targetRoot, distance = nearestPlayer(run, enemy.Root.Position)
			if target and targetRoot then
				local position = enemy.Root.Position
				local targetPosition = Vector3.new(targetRoot.Position.X, position.Y, targetRoot.Position.Z)
				if distance > (enemy.Boss and 17 or 14) then
					local direction = targetPosition - position
					if direction.Magnitude > 0.1 then
						local nextPosition = position + direction.Unit * math.min(direction.Magnitude, enemy.Speed * deltaTime)
						enemy.Model:PivotTo(CFrame.lookAt(nextPosition, targetPosition))
					end
				else
					enemy.Model:PivotTo(CFrame.lookAt(position, targetPosition))
					if now >= enemy.NextAttack then
						enemy.NextAttack = now + (enemy.Boss and 1.8 or 1.45)
						local humanoid = living(target)
						local armor = tonumber(target:GetAttribute("Armor")) or 0
						local shield = tonumber(target:GetAttribute("DamageTakenMultiplier")) or 1
					target:SetAttribute("LastDamageSource", "Expedition")
					target:SetAttribute("LastDamageClock", os.clock())
					target:SetAttribute("LastAttackerName", run.Definition.EnemyName)
						target:SetAttribute("LastAttackerUserId", nil)
						humanoid:TakeDamage(enemy.Damage * math.clamp(shield, 0.05, 1) * (1 - math.clamp(armor, 0, 0.65)))
						if remotes then
							remotes.CombatFX:FireAllClients({ Kind = "ExpeditionShot", Origin = enemy.Body.Position, Finish = targetRoot.Position, Color = run.Definition.Color })
						end
					end
				end
				if enemy.Boss and now >= enemy.NextSpecial then
					enemy.NextSpecial = now + 7
					bossSlam(run, enemy)
				end
			end
			if enemy.Tag then
				enemy.Tag.Text = (enemy.Boss and "BOSS · " or "") .. run.Definition.EnemyName .. " · " .. math.ceil(enemy.Humanoid.Health)
			end
		end
	end
end

local function destroyRun(run)
	run.Active = false
	if run.Model then
		run.Model:Destroy()
	end
	if runs[run.Definition.Id] == run then
		runs[run.Definition.Id] = nil
	end
end

local function leave(player, teleport)
	local run = playerRuns[player.UserId]
	if not run then
		return false
	end
	playerRuns[player.UserId] = nil
	local entry = run.Players[player.UserId]
	run.Players[player.UserId] = nil
	if run.Connections[player.UserId] then
		run.Connections[player.UserId]:Disconnect()
		run.Connections[player.UserId] = nil
	end
	player:SetAttribute("InExpedition", false)
	player:SetAttribute("ExpeditionId", "")
	player:SetAttribute("ExpeditionWave", 0)
	if teleport and player.Parent and player.Character and player.Character.Parent then
		player.Character:PivotTo(entry and entry.ReturnCFrame or returnCFrame(player))
	end
	if playerCount(run) == 0 then
		destroyRun(run)
	else
		broadcast(run)
	end
	sendSnapshot(player, nil)
	return true
end

function ExpeditionService.Enter(player, id)
	if phaseProvider() ~= "Battle" or not participantProvider(player) then
		notify(player, "Экспедиция доступна участнику во время Battle")
		return false
	end
	if playerRuns[player.UserId] then
		return false
	end
	local data = dataService and dataService.Get(player) or nil
	local selected = id or (data and data.SelectedExpedition) or player:GetAttribute("SelectedExpedition")
	local definition = ExpeditionCatalog.Get(selected)
	local level = data and Catalog.LevelForXP(data.XP) or player:GetAttribute("Level") or 1
	local wins = data and data.Wins or player:GetAttribute("Wins") or 0
	if not definition or not ExpeditionCatalog.IsUnlocked(selected, level, wins) then
		notify(player, "Локация закрыта · нужен уровень и победы")
		return false
	end
	local run = runs[selected]
	if run and (not run.Active or run.Completed or playerCount(run) >= 8) then
		notify(player, "Этот рейд завершён или заполнен · попробуй позже")
		return false
	end
	run = run or createRun(definition)
	run.Players[player.UserId] = { Player = player, ReturnCFrame = returnCFrame(player) }
	playerRuns[player.UserId] = run
	run.Connections[player.UserId] = player.CharacterAdded:Connect(function(character)
		task.defer(function()
			local current = playerRuns[player.UserId]
			if current and current.Active and player.Character == character and character.Parent then
				character:PivotTo(current.SpawnCFrame)
			end
		end)
	end)
	player:SetAttribute("InExpedition", true)
	player:SetAttribute("ExpeditionId", selected)
	player:SetAttribute("ExpeditionWave", run.Wave)
	if player.Character and player.Character.Parent then
		player.Character:PivotTo(run.SpawnCFrame)
	end
	notify(player, "PvE · " .. definition.Name .. " · волна начинается")
	broadcast(run)
	return true
end

function ExpeditionService.Train(player)
	if phaseProvider() ~= "Lobby" or player:GetAttribute("InMatch") == true or playerRuns[player.UserId] then
		notify(player, "Тренировка отряда доступна в Lobby")
		return false
	end
	local data = dataService and dataService.Get(player) or nil
	if not data then
		return false
	end
	local oldLevel = dataService.GetSquadLevel(player)
	if oldLevel >= 10 then
		notify(player, "Отряд уже достиг уровня 10")
		return false
	end
	local cost = 100 + oldLevel * 50
	if data.Coins < cost then
		notify(player, "Для тренировки нужно " .. cost .. " монет")
		return false
	end
	data.Coins = data.Coins - cost
	data.SquadXP = (data.SquadXP or 0) + 100
	dataService.Commit(player, true)
	local newLevel = dataService.GetSquadLevel(player)
	notify(player, newLevel > oldLevel and ("ОТРЯД · LEVEL " .. newLevel .. " · боты усилены в следующем матче") or ("Тренировка +100 Squad XP · следующий уровень " .. (newLevel + 1)))
	sendSnapshot(player, nil)
	return true
end

function ExpeditionService.HandleAction(player, action, value)
	local now = os.clock()
	if now - (requestClocks[player.UserId] or -math.huge) < 0.25 then
		return false
	end
	requestClocks[player.UserId] = now
	if action == "Select" then
		local definition = ExpeditionCatalog.Get(value)
		local data = dataService and dataService.Get(player) or nil
		local level = data and Catalog.LevelForXP(data.XP) or player:GetAttribute("Level") or 1
		local wins = data and data.Wins or player:GetAttribute("Wins") or 0
		if not definition or not ExpeditionCatalog.IsUnlocked(value, level, wins) then
			notify(player, "Сначала открой локацию уровнем и победами")
			return false
		end
		if dataService then
			dataService.SetExpedition(player, value)
		else
			player:SetAttribute("SelectedExpedition", value)
		end
		sendSnapshot(player, playerRuns[player.UserId])
		return true
	elseif action == "Train" then
		return ExpeditionService.Train(player)
	elseif action == "Enter" then
		return ExpeditionService.Enter(player, value)
	elseif action == "Exit" then
		return leave(player, true)
	elseif action == "Refresh" then
		sendSnapshot(player, playerRuns[player.UserId])
		return true
	end
	return false
end

function ExpeditionService.OnPlayerRemoving(player)
	leave(player, false)
	requestClocks[player.UserId] = nil
end

function ExpeditionService.Reset()
	local players = {}
	for userId, run in pairs(playerRuns) do
		local entry = run.Players[userId]
		if entry then
			table.insert(players, entry.Player)
		end
	end
	for _, player in ipairs(players) do
		leave(player, true)
	end
	for _, run in pairs(runs) do
		destroyRun(run)
	end
	playerRuns = {}
end

function ExpeditionService.SetProviders(phase, team, participant, onReward)
	phaseProvider = phase or phaseProvider
	teamProvider = team or teamProvider
	participantProvider = participant or participantProvider
	rewardHandler = onReward
end

function ExpeditionService.Init(dependencies)
	world = dependencies.World
	remotes = dependencies.Remotes
	state = dependencies.State
	dataService = dependencies.DataService
	folder = Instance.new("Folder")
	folder.Name = "Expeditions"
	folder.Parent = world.Root
	world.Expeditions = folder
end

function ExpeditionService.Step(deltaTime)
	if phaseProvider() ~= "Battle" then
		return
	end
	local now = os.clock()
	for _, run in pairs(runs) do
		if run.Active then
			if run.Completed and now >= run.DestroyAt then
				local members = {}
				for _, entry in pairs(run.Players) do
					table.insert(members, entry.Player)
				end
				for _, player in ipairs(members) do
					leave(player, true)
				end
			elseif not run.Completed then
				local alive = aliveEnemies(run)
				if alive == 0 then
					if run.Wave >= ExpeditionCatalog.MaxWaves then
						completeRun(run)
					elseif run.NextWaveAt == 0 then
						run.NextWaveAt = now + 2
					elseif now >= run.NextWaveAt then
						spawnWave(run)
					end
				end
				stepEnemies(run, now, deltaTime)
			end
			for _, crystal in ipairs(run.Animated) do
				if crystal.Part.Parent then
					crystal.Part.CFrame = crystal.Base * CFrame.Angles(0, now * 0.8 + crystal.Phase, 0)
				end
			end
			for userId in pairs(run.Players) do
				local player = Players:GetPlayerByUserId(userId)
				if player then
					player:SetAttribute("ExpeditionWave", run.Wave)
				end
			end
			if now >= run.NextSnapshot then
				run.NextSnapshot = now + 0.5
				broadcast(run)
			end
		end
	end
	if state then
		local count = 0
		for _ in pairs(runs) do count = count + 1 end
		state:SetAttribute("ActiveExpeditions", count)
	end
end

return ExpeditionService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="44">
          <Properties>
            <string name="Name">LeaderboardService</string>
            <string name="Source"><![CDATA[-- BLOCKSIEGE // Server-generated online Level/Coins ratings.
-- OrderedDataStore/global history is intentionally not faked: this board ranks
-- loaded online profiles and can be backed by a persistent service later.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("BlockSiege")
local Catalog = require(Shared:WaitForChild("Catalog"))

local LeaderboardService = {}
local DataService
local remotes
local state
local clock = 0
local signature = ""
local revision = 0

local function entryFor(player, data)
	return {
		UserId = player.UserId,
		Name = player.Name,
		DisplayName = player.DisplayName,
		Level = Catalog.LevelForXP(data.XP or 0),
		XP = data.XP or 0,
		Coins = data.Coins or 0,
		Wins = data.Wins or 0,
	}
end

local function copyTop(entries, valueKey)
	local result = {}
	for index = 1, math.min(10, #entries) do
		local source = entries[index]
		result[index] = {
			Rank = index,
			UserId = source.UserId,
			Name = source.Name,
			DisplayName = source.DisplayName,
			Value = source[valueKey],
			Level = source.Level,
			Coins = source.Coins,
			Wins = source.Wins,
		}
	end
	return result
end

function LeaderboardService.GetSnapshot()
	local entries = {}
	for _, player in ipairs(Players:GetPlayers()) do
		local data = DataService and DataService.Get(player) or nil
		if data then
			table.insert(entries, entryFor(player, data))
		end
	end
	local levels = { table.unpack(entries) }
	local coins = { table.unpack(entries) }
	table.sort(levels, function(a, b)
		if a.Level ~= b.Level then return a.Level > b.Level end
		if a.XP ~= b.XP then return a.XP > b.XP end
		if a.Coins ~= b.Coins then return a.Coins > b.Coins end
		return a.UserId < b.UserId
	end)
	table.sort(coins, function(a, b)
		if a.Coins ~= b.Coins then return a.Coins > b.Coins end
		if a.Level ~= b.Level then return a.Level > b.Level end
		if a.Wins ~= b.Wins then return a.Wins > b.Wins end
		return a.UserId < b.UserId
	end)
	return { Revision = revision, Level = copyTop(levels, "Level"), Coins = copyTop(coins, "Coins") }
end

local function snapshotSignature(snapshot)
	local pieces = {}
	for _, board in ipairs({ snapshot.Level, snapshot.Coins }) do
		for _, entry in ipairs(board) do
			table.insert(pieces, table.concat({ entry.UserId, entry.Value, entry.Level, entry.Coins, entry.Wins }, ":"))
		end
		table.insert(pieces, "|")
	end
	return table.concat(pieces, ";")
end

function LeaderboardService.Broadcast(force)
	if not remotes then
		return
	end
	local snapshot = LeaderboardService.GetSnapshot()
	local nextSignature = snapshotSignature(snapshot)
	if force or nextSignature ~= signature then
		signature = nextSignature
		revision = revision + 1
		snapshot.Revision = revision
		remotes.LeaderboardUpdate:FireAllClients(snapshot)
		if state then
			local levelTop = snapshot.Level[1]
			local coinTop = snapshot.Coins[1]
			state:SetAttribute("LevelLeader", levelTop and levelTop.DisplayName or "—")
			state:SetAttribute("CoinLeader", coinTop and coinTop.DisplayName or "—")
		end
	end
end

function LeaderboardService.Init(dependencies)
	DataService = dependencies.DataService
	remotes = dependencies.Remotes
	state = dependencies.State
	clock = 0
end

function LeaderboardService.Step(deltaTime)
	clock = clock + deltaTime
	if clock >= 2 then
		clock = 0
		LeaderboardService.Broadcast(false)
	end
end

return LeaderboardService
]]></string>
          </Properties>
        </Item>




        <Item class="ModuleScript" referent="11">
          <Properties>
            <string name="Name">BotService</string>
            <string name="Source"><![CDATA[-- Tactical bots: role-based construction, defense, assault, support and obstacle-aware pathing.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")
local Players = game:GetService("Players")
local Shared = ReplicatedStorage:WaitForChild("BlockSiege")
local Config = require(Shared:WaitForChild("Config"))
local Catalog = require(Shared:WaitForChild("Catalog"))

local pathfindingOk, PathfindingService = pcall(function()
	return game:GetService("PathfindingService")
end)
if not pathfindingOk then
	PathfindingService = nil
end

local BotService = {}
local world
local fortressService
local weaponService
local geodataService
local abilityService
local squadLevelProvider = function()
	return 1
end
local phaseProvider = function()
	return "Lobby"
end
local targetsProvider = function()
	return {}
end
local bots = {}
local active = false
local matchId = 0
local nextBotId = 0

local botWeapons = { "Carbine", "SMG", "Scatter", "Marksman", "Demolisher", "Vortex", "ThanosGauntlet", "TacticalKnife", "ShadowKnives", "PrismLance", "TeslaCarbine", "MeteorMaul", "VoidScythe" }
local roles = { "Assault", "Assault", "Support", "Defender", "Assault", "Support" }
-- Bots cross the expanded 640-stud arena decisively, while defenders retain
-- a little more restraint. Lane offsets are shared with WorldBuilder/Fortress.
local BOT_SPEEDS = { Assault = 30, Support = 27, Defender = 24 }
local BOT_LANES = Config.Objectives.Lanes
local botSkins = {
	{ Id = "Scout", Name = "SCOUT", Primary = Color3.fromRGB(66, 168, 164), Secondary = Color3.fromRGB(35, 74, 83), Accent = Color3.fromRGB(156, 255, 224), Head = Color3.fromRGB(224, 190, 145) },
	{ Id = "Heavy", Name = "HEAVY", Primary = Color3.fromRGB(128,  90, 76), Secondary = Color3.fromRGB(62, 53, 55), Accent = Color3.fromRGB(255, 190,  70), Head = Color3.fromRGB(193, 153, 119) },
	{ Id = "Medic", Name = "MEDIC", Primary = Color3.fromRGB(213, 231, 218), Secondary = Color3.fromRGB( 70, 130, 111), Accent = Color3.fromRGB( 90, 255, 164), Head = Color3.fromRGB(235, 198, 160) },
	{ Id = "Ranger", Name = "RANGER", Primary = Color3.fromRGB(104, 128, 77), Secondary = Color3.fromRGB(49, 65, 45), Accent = Color3.fromRGB(215, 194, 104), Head = Color3.fromRGB(204, 165, 126) },
	{ Id = "Engineer", Name = "ENGINEER", Primary = Color3.fromRGB(211, 139, 49), Secondary = Color3.fromRGB(83,  60, 42), Accent = Color3.fromRGB(255, 222,  90), Head = Color3.fromRGB(224, 190, 145) },
	{ Id = "Shadow", Name = "SHADOW", Primary = Color3.fromRGB(77, 66, 112), Secondary = Color3.fromRGB(32,  30, 52), Accent = Color3.fromRGB(201, 127, 255), Head = Color3.fromRGB(177, 143, 126) },
}

local BOT_TEXTURES = {
	Torso = "rbxassetid://9920517696",
	Backpack = "rbxassetid://9920517696",
	ChestPlate = "rbxassetid://9920574687",
	Helmet = "rbxassetid://9920574687",
	LeftShoulder = "rbxassetid://9920574687",
	RightShoulder = "rbxassetid://9920574687",
	HardHat = "rbxassetid://9920574687",
}

local function addBotTexture(part, name)
	local asset = BOT_TEXTURES[name]
	if not asset then
		return
	end
	local texture = Instance.new("Texture")
	texture.Name = "BotSurfaceTexture"
	texture.Texture = asset
	texture.Face = Enum.NormalId.Front
	texture.StudsPerTileU = 2
	texture.StudsPerTileV = 2
	texture.Transparency = 0.12
	texture.Parent = part
	part:SetAttribute("SurfaceTextured", true)
end

local function bodyPart(model, root, name, size, offset, color, jointParent, jointName, jointC0)
	local part = Instance.new("Part")
	part.Name = name
	part.Size = size
	part.CFrame = root.CFrame * CFrame.new(offset)
	part.Color = color
	part.Material = (name == "Torso" or name == "Backpack") and Enum.Material.Fabric or Enum.Material.SmoothPlastic
	part.Anchored = false
	part.CanCollide = name == "Torso" or name == "Left Leg" or name == "Right Leg"
	part.CanTouch = false
	part.CanQuery = true
	part.Massless = name ~= "Torso"
	part.Parent = model
	addBotTexture(part, name)

	-- Humanoid navigation expects a real character assembly, not a collection of
	-- welded props. C0 preserves the authored pose while Motor6D supplies the rig.
	local joint = Instance.new("Motor6D")
	joint.Name = jointName or (name .. "Joint")
	joint.Part0 = jointParent or root
	joint.Part1 = part
	joint.C0 = jointC0 or CFrame.new(offset)
	joint.C1 = CFrame.new()
	joint.Parent = part
	return part
end

local function addNameTag(head, entry)
	local gui = Instance.new("BillboardGui")
	gui.Name = "BotTag"
	gui.Size = UDim2.fromOffset(210, 54)
	gui.StudsOffset = Vector3.new(0, 2.2, 0)
	gui.AlwaysOnTop = true
	gui.MaxDistance = 150
	gui.Parent = head
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 0.65)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.GothamBold
	label.Text = string.format("%s BOT %02d", string.upper(entry.Team), entry.Slot)
	label.TextColor3 = Config.Teams[entry.Team].Color
	label.TextStrokeTransparency = 0.3
	label.TextScaled = true
	label.Parent = gui
	local role = Instance.new("TextLabel")
	role.Name = "Role"
	role.Position = UDim2.fromScale(0, 0.65)
	role.Size = UDim2.fromScale(1, 0.35)
	role.BackgroundTransparency = 1
	role.Font = Enum.Font.Gotham
	role.Text = (entry.Role == "Defender" and "DEFENSE" or (entry.Role == "Support" and "SUPPORT" or "ASSAULT")) .. " · " .. entry.Skin.Name
	role.TextColor3 = Color3.fromRGB(235, 240, 235)
	role.TextStrokeTransparency = 0.4
	role.TextScaled = true
	role.Parent = gui
end

local function resetPath(entry)
	entry.Path = nil
	entry.PathIndex = 1
	entry.PathGoal = nil
	entry.NavigationGoal = nil
	entry.NextPath = 0
end

local function spawnModel(entry)
	local spawn = world.TeamSpawns[entry.Team] * CFrame.new((entry.Slot - 3.5) * 3, 0, 0)
	-- TeamSpawns includes clearance for a player character. This custom R6 rig's
	-- feet sit 2.8 studs below its root, so start close to the spawn pad instead
	-- of dropping the assembly from the player spawn height.
	spawn = spawn * CFrame.new(0, -3.25, 0)
	local model = Instance.new("Model")
	model.Name = "Bot_" .. entry.Id
	model:SetAttribute("Team", entry.Team)
	model:SetAttribute("BotId", entry.Id)
	model:SetAttribute("IsBot", true)
	model:SetAttribute("Role", entry.Role)
	model:SetAttribute("SkinId", entry.Skin.Id)
	model:SetAttribute("Level", 1)
	model:SetAttribute("Armor", 0)
	model.Parent = world.Bots
	local root = Instance.new("Part")
	root.Name = "HumanoidRootPart"
	root.Size = Vector3.new(3, 4.5, 3)
	root.CFrame = spawn
	root.Transparency = 1
	root.Anchored = false
	root.CanCollide = false
	root.CanTouch = false
	root.CanQuery = false
	root.Parent = model
	model.PrimaryPart = root
	local teamColor = Config.Teams[entry.Team].Color
	local skin = entry.Skin
	local torso = bodyPart(model, root, "Torso", Vector3.new(3, 2.2, 1.8), Vector3.new(0, 0.3, 0), skin.Primary, root, "RootJoint", CFrame.new(0, 0.3, 0))
	bodyPart(model, root, "ChestPlate", Vector3.new(2.2, 1.1, 0.35), Vector3.new(0, 0.55, -1.05), skin.Accent)
	bodyPart(model, root, "TeamBand", Vector3.new(3.1, 0.35, 1.9), Vector3.new(0, 1.15, 0), teamColor)
	local head = bodyPart(model, root, "Head", Vector3.new(2.1, 1.8, 2.1), Vector3.new(0, 2.5, 0), skin.Head, torso, "Neck", CFrame.new(0, 2.2, 0))
	bodyPart(model, root, "Helmet", Vector3.new(2.35, 0.65, 2.35), Vector3.new(0, 3.45, 0), skin.Secondary)
	bodyPart(model, root, "Visor", Vector3.new(1.7, 0.35, 0.25), Vector3.new(0, 2.65, -1.1), skin.Accent)
	bodyPart(model, root, "Backpack", Vector3.new(1.8, 2, 0.7), Vector3.new(0, 0.45, 1.15), skin.Secondary)
	bodyPart(model, root, "Left Arm", Vector3.new(1, 2.4, 1.4), Vector3.new(-2, 0.3, 0), skin.Primary, torso, "Left Shoulder", CFrame.new(-2, 0, 0))
	bodyPart(model, root, "Right Arm", Vector3.new(1, 2.4, 1.4), Vector3.new(2, 0.3, 0), skin.Primary, torso, "Right Shoulder", CFrame.new(2, 0, 0))
	bodyPart(model, root, "Left Leg", Vector3.new(1.2, 2, 1.5), Vector3.new(-0.8, -1.8, 0), skin.Secondary, torso, "Left Hip", CFrame.new(-0.8, -2.1, 0))
	bodyPart(model, root, "Right Leg", Vector3.new(1.2, 2, 1.5), Vector3.new(0.8, -1.8, 0), skin.Secondary, torso, "Right Hip", CFrame.new(0.8, -2.1, 0))
	if skin.Id == "Heavy" then
		bodyPart(model, root, "LeftShoulder", Vector3.new(1.4, 0.7, 1.7), Vector3.new(-2, 1.35, 0), skin.Accent)
		bodyPart(model, root, "RightShoulder", Vector3.new(1.4, 0.7, 1.7), Vector3.new(2, 1.35, 0), skin.Accent)
	elseif skin.Id == "Medic" then
		bodyPart(model, root, "MedicCross", Vector3.new(0.35, 1.1, 0.15), Vector3.new(0, 0.55, -1.25), Color3.fromRGB(255, 90, 95))
		bodyPart(model, root, "MedicCross", Vector3.new(1.1, 0.35, 0.15), Vector3.new(0, 0.55, -1.25), Color3.fromRGB(255, 90, 95))
	elseif skin.Id == "Engineer" then
		bodyPart(model, root, "HardHat", Vector3.new(2.6, 0.35, 2.6), Vector3.new(0, 3.85, 0), Color3.fromRGB(255, 211, 65))
	end
	addNameTag(head, entry)
	local tacticalLight = Instance.new("SpotLight")
	tacticalLight.Name = "BlockSiegeTacticalLight"
	tacticalLight.Color = Color3.fromRGB(185, 220, 255)
	tacticalLight.Face = Enum.NormalId.Front
	tacticalLight.Angle = 64
	tacticalLight.Range = 26
	tacticalLight.Brightness = 0.8
	tacticalLight.Shadows = false
	tacticalLight.Enabled = phaseProvider() ~= "Build"
	tacticalLight.Parent = root

	-- Parent Humanoid only after the complete rig exists; otherwise it can die while
	-- the model is still being assembled and never receive MoveTo commands.
	local squadLevel = math.clamp(tonumber(entry.SquadLevel) or 1, 1, 10)
	local squadHealth = 120 + (squadLevel - 1) * 4
	local humanoid = Instance.new("Humanoid")
	humanoid.MaxHealth = squadHealth
	humanoid.Health = squadHealth
	humanoid.WalkSpeed = (BOT_SPEEDS[entry.Role] or 24) + math.min(2, (squadLevel - 1) * 0.25)
	humanoid.JumpPower = 50
	humanoid.HipHeight = 0
	humanoid.RigType = Enum.HumanoidRigType.R6
	humanoid.RequiresNeck = false
	humanoid.BreakJointsOnDeath = false
	humanoid.AutoRotate = true
	humanoid:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
	humanoid:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)
	humanoid.Parent = model
	humanoid:ChangeState(Enum.HumanoidStateType.Running)
	-- RootPart is read-only in current Roblox runtime. The correctly named
	-- HumanoidRootPart and Motor6D RootJoint let Humanoid resolve it automatically.
	model:SetAttribute("Rig", "Motor6D")
	model:SetAttribute("SquadLevel", squadLevel)
	-- Set ownership after every joint/part exists so the complete assembly stays
	-- server-simulated even when a player is standing next to the bot.
	pcall(function()
		root:SetNetworkOwner(nil)
	end)
	entry.Model = model
	entry.Humanoid = humanoid
	entry.LastPosition = root.Position
	entry.StuckTime = 0
	entry.LaneOffset = 0
	entry.NextJump = 0
	entry.Target = nil
	entry.LastHeal = 0
	entry.Retreating = false
	entry.NextRecover = 0
	entry.BattleStarted = nil
	entry.NextAbility = os.clock() + 2 + entry.Slot * 0.2
	resetPath(entry)
	if abilityService then
		entry.ClassId = abilityService.RegisterBot(model, entry.Team)
		local tag = head:FindFirstChild("BotTag")
		local roleLabel = tag and tag:FindFirstChild("Role")
		if roleLabel and entry.ClassId then
			roleLabel.Text = (entry.Role == "Defender" and "DEFENSE" or (entry.Role == "Support" and "SUPPORT" or "ASSAULT")) .. " · " .. string.upper(entry.ClassId)
		end
	end
	weaponService.EquipCharacter(model, entry.WeaponId)
	entry.Animations = {}
	for _, joint in ipairs(model:GetDescendants()) do
		if joint:IsA("Motor6D") and joint.Part1 then
			table.insert(entry.Animations, { Joint = joint, Name = joint.Part1.Name, C0 = joint.C0 })
		end
	end
	local spawnMatch = entry.MatchId
	humanoid.Died:Connect(function()
		resetPath(entry)
		task.delay(2, function()
			if entry.Model == model then
				model:Destroy()
			end
		end)
		task.delay(Config.RespawnDuration, function()
			if active and entry.MatchId == spawnMatch and matchId == spawnMatch and (phaseProvider() == "Battle" or phaseProvider() == "Build") then
				spawnModel(entry)
			end
		end)
	end)
	return model
end

local function addBot(team, slot)
	nextBotId = nextBotId + 1
	local entry = {
		Id = nextBotId,
		Team = team,
		Slot = slot,
		Role = roles[((slot - 1) % #roles) + 1],
		Skin = botSkins[((nextBotId - 1) % #botSkins) + 1],
		WeaponId = botWeapons[((nextBotId - 1) % #botWeapons) + 1],
		MatchId = matchId,
		SquadLevel = math.clamp(tonumber(squadLevelProvider(team)) or 1, 1, 10),
		Builds = 0,
		NextBuild = os.clock() + 1 + slot * 0.15,
		NextThink = 0,
	}
	bots[entry.Id] = entry
	spawnModel(entry)
	return entry
end

function BotService.Init(dependencies)
	world = dependencies.World
	fortressService = dependencies.FortressService
	weaponService = dependencies.WeaponService
	geodataService = dependencies.GeodataService
	abilityService = dependencies.AbilityService
	squadLevelProvider = dependencies.SquadLevelProvider or squadLevelProvider
end

function BotService.SetProviders(phase, targets)
	phaseProvider = phase
	targetsProvider = targets
end

function BotService.Start(newMatchId, participants)
	BotService.Stop()
	matchId = newMatchId
	active = true
	local humanCounts = { Blue = 0, Orange = 0 }
	for _, team in pairs(participants) do
		if humanCounts[team] then
			humanCounts[team] = humanCounts[team] + 1
		end
	end
	for _, team in ipairs(Config.TeamOrder) do
		local needed = Config.TeamSize - humanCounts[team]
		for index = 1, needed do
			addBot(team, humanCounts[team] + index)
		end
	end
end

function BotService.AddBot(team)
	if not active then
		return nil
	end
	local used = {}
	for _, entry in pairs(bots) do
		if entry.Team == team then
			used[entry.Slot] = true
		end
	end
	for slot = 1, Config.TeamSize do
		if not used[slot] then
			return addBot(team, slot)
		end
	end
	return nil
end

function BotService.Stop()
	active = false
	for _, entry in pairs(bots) do
		if entry.Model then
			entry.Model:Destroy()
		end
	end
	bots = {}
end

function BotService.Count(team)
	local count = 0
	for _, entry in pairs(bots) do
		if entry.Team == team and entry.Model and entry.Model.Parent then
			count = count + 1
		end
	end
	return count
end

function BotService.GetModels(team)
	local result = {}
	for _, entry in pairs(bots) do
		local humanoid = entry.Model and entry.Model:FindFirstChildOfClass("Humanoid")
		if entry.Team == team and entry.Model and entry.Model.Parent and humanoid and humanoid.Health > 0 then
			table.insert(result, entry.Model)
		end
	end
	return result
end

local function modelPosition(model)
	local root = model and model:FindFirstChild("HumanoidRootPart")
	return root and root.Position or nil
end

local function nearestEnemy(entry, position)
	local best
	local bestDistance = math.huge
	local bestScore = math.huge
	for _, model in ipairs(targetsProvider(entry.Team)) do
		local root = model and model:FindFirstChild("HumanoidRootPart")
		local humanoid = model and model:FindFirstChildOfClass("Humanoid")
		if root and humanoid and humanoid.Health > 0 then
			local distance = (root.Position - position).Magnitude
			-- Prefer a nearby threat, but switch to a wounded target when it is a better tactical choice.
			local healthRatio = humanoid.Health / math.max(1, humanoid.MaxHealth)
			local score = distance + healthRatio * 18
			if model == entry.Target then
				score = score - 8
			end
			if score < bestScore then
				best = model
				bestDistance = distance
				bestScore = score
			end
		end
	end
	return best, bestDistance
end

local function basePoint(team, localX, localZ)
	return (Config.BaseCFrame(team) * CFrame.new(localX or 0, 0, localZ or 16)).Position
end

local function laneForSlot(slot)
	return BOT_LANES[((slot - 1) % #BOT_LANES) + 1]
end

local function laneForEntry(entry)
	local index = (entry.Slot - 1 + (entry.LaneOffset or 0)) % #BOT_LANES
	return BOT_LANES[index + 1]
end

local function exitPoint(team, slot, lane)
	-- BaseCFrame looks at the enemy with -Z. The initial wall line is at -28;
	-- this point is beyond it, on a side lane with enough room for an R6 agent.
	return basePoint(team, lane or laneForSlot(slot), -54)
end

local function enemyAttackPoint(team)
	-- CorePedestal reaches local Z=-9; with an R6 agent radius the safe
	-- approach must be farther out than the heart itself. -17 leaves room for
	-- the whole rig while remaining close enough for a melee ray.
	return basePoint(Config.OtherTeam(team), 0, -17)
end

local function enemyAimPoint(team)
	-- Aim at the lower front of CoreHeart (front=-5), above the pedestal's
	-- top edge. The ray remains inside Tactical Knife's 14-stud range and still
	-- hits the heart after the pedestal has been destroyed.
	return basePoint(Config.OtherTeam(team), 0, -5) + Vector3.new(0, 2, 0)
end

local function insideOwnBase(entry, position)
	local localPosition = Config.BaseCFrame(entry.Team):PointToObjectSpace(position)
	return math.abs(localPosition.X) < 62 and localPosition.Z > -48 and localPosition.Z < 70
end

local function routeToDestination(entry, destination)
	-- Only use the exit leg when the tactical target is actually outside. A
	-- defender chasing an intruder inside its own base must not turn around.
	return insideOwnBase(entry, destination) and "Direct" or "Field"
end

local function computePath(entry, destination, now)
	if not PathfindingService or not entry.Model or not entry.Model.PrimaryPart then
		return nil
	end
	local ok, path = pcall(function()
		return PathfindingService:CreatePath({
			AgentRadius = 3,
			AgentHeight = 6,
			AgentCanJump = true,
			WaypointSpacing = 8,
			Costs = { Water = 20 },
		})
	end)
	if not ok or not path then
		return nil
	end
	local computed = pcall(function()
		path:ComputeAsync(entry.Model.PrimaryPart.Position, destination)
	end)
	if not computed then
		return nil
	end
	local gotWaypoints, waypoints = pcall(function()
		return path:GetWaypoints()
	end)
	if gotWaypoints and waypoints and #waypoints > 0 then
		return waypoints
	end
	return nil
end

local function jumpForObstacle(entry, root, humanoid, now)
	if type(Workspace.Raycast) ~= "function" then
		return
	end
	if now < (entry.NextJump or 0) then
		return
	end
	local origin = root.Position + Vector3.new(0, 0.5, 0)
	local direction = root.CFrame.LookVector
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { entry.Model }
	params.IgnoreWater = true
	local hit = Workspace:Raycast(origin, direction * 6, params)
	if hit and hit.Instance and hit.Instance.CanCollide ~= false then
		-- A jump is allowed only after a real collision/path obstacle, never merely because a bot is stuck.
		humanoid.Jump = true
		entry.NextJump = now + 1.5
	end
end

local function followDestination(entry, destination, now, route)
	local root = entry.Model and entry.Model:FindFirstChild("HumanoidRootPart")
	local humanoid = entry.Humanoid
	if not root or not humanoid then
		return
	end
	route = route or "Direct"
	local goalChanged = not entry.PathGoal or (entry.PathGoal - destination).Magnitude > 10
	local routeDestination = destination

	-- A direct MoveTo(CoreHeart.Position) is a reliable way to make a bot push
	-- against a wall forever: the requested endpoint is inside solid geometry.
	-- Use explicit tactical legs instead. The first leg always gets the bot out
	-- through a side lane; assaults then stage outside the enemy wall before
	-- approaching the attack point. No teleporting and no jump spam is involved.
	if route == "Assault" then
		if insideOwnBase(entry, root.Position) then
			routeDestination = exitPoint(entry.Team, entry.Slot, laneForEntry(entry))
		else
			local enemyTeam = Config.OtherTeam(entry.Team)
			local approach = basePoint(enemyTeam, laneForEntry(entry), -54)
			local enemyLocal = Config.BaseCFrame(enemyTeam):PointToObjectSpace(root.Position)
			if (root.Position - approach).Magnitude > 12 and enemyLocal.Z < -44 then
				routeDestination = approach
			end
		end
	elseif route == "Return" and not insideOwnBase(entry, root.Position) then
		local approach = exitPoint(entry.Team, entry.Slot, laneForEntry(entry))
		if (root.Position - approach).Magnitude > 12 then
			routeDestination = approach
		end
	elseif route == "Field" and insideOwnBase(entry, root.Position) then
		routeDestination = exitPoint(entry.Team, entry.Slot, laneForEntry(entry))
	end

	local navigationChanged = not entry.NavigationGoal or (entry.NavigationGoal - routeDestination).Magnitude > 6
	if goalChanged or navigationChanged or now >= (entry.NextPath or 0) then
		local pathDestination = routeDestination
		if geodataService then
			local avoidance = geodataService.GetAvoidancePoint(root.Position, routeDestination, entry.Slot)
			if avoidance and (avoidance - root.Position).Magnitude > 5 and (avoidance - routeDestination).Magnitude > 5 then
				pathDestination = avoidance
			end
		end
		entry.Path = computePath(entry, pathDestination, now)
		entry.PathIndex = 1
		entry.PathGoal = destination
		entry.NavigationGoal = routeDestination
		entry.NextPath = now + 1.8
	end
	local waypoints = entry.Path
	if waypoints and #waypoints > 0 then
		local waypoint = waypoints[entry.PathIndex]
		while waypoint and (waypoint.Position - root.Position).Magnitude < 4 do
			entry.PathIndex = entry.PathIndex + 1
			waypoint = waypoints[entry.PathIndex]
		end
		if waypoint then
			humanoid:MoveTo(waypoint.Position)
			if waypoint.Action == Enum.PathWaypointAction.Jump then
				if now >= (entry.NextJump or 0) then
					humanoid.Jump = true
					entry.NextJump = now + 1.5
				end
			else
				jumpForObstacle(entry, root, humanoid, now)
			end
			return
		end
	end
	humanoid:MoveTo(routeDestination)
	jumpForObstacle(entry, root, humanoid, now)
end

local function supportHeal(entry, now)
	if entry.Role ~= "Support" or now - (entry.LastHeal or 0) < 2 then
		return
	end
	local root = entry.Model and entry.Model:FindFirstChild("HumanoidRootPart")
	if not root then
		return
	end
	for _, ally in ipairs(BotService.GetModels(entry.Team)) do
		if ally ~= entry.Model then
			local allyRoot = ally:FindFirstChild("HumanoidRootPart")
			local humanoid = ally:FindFirstChildOfClass("Humanoid")
			if allyRoot and humanoid and humanoid.Health > 0 and humanoid.Health < humanoid.MaxHealth and (allyRoot.Position - root.Position).Magnitude < 24 then
				humanoid.Health = math.min(humanoid.MaxHealth, humanoid.Health + 8 + ((entry.SquadLevel or 1) - 1) * 0.5)
				entry.LastHeal = now
				return
			end
		end
	end
	for _, player in ipairs(Players:GetPlayers()) do
		if player:GetAttribute("Team") == entry.Team then
			local ally = player.Character
			local allyRoot = ally and ally:FindFirstChild("HumanoidRootPart")
			local humanoid = ally and ally:FindFirstChildOfClass("Humanoid")
			if allyRoot and humanoid and humanoid.Health > 0 and humanoid.Health < humanoid.MaxHealth and (allyRoot.Position - root.Position).Magnitude < 24 then
				humanoid.Health = math.min(humanoid.MaxHealth, humanoid.Health + 8 + ((entry.SquadLevel or 1) - 1) * 0.5)
				entry.LastHeal = now
				return
			end
		end
	end
end

local function battleThink(entry, now)
	local model = entry.Model
	local root = model and model:FindFirstChild("HumanoidRootPart")
	local humanoid = entry.Humanoid
	local weapon = Catalog.GetWeapon(entry.WeaponId)
	if not root or not humanoid or not weapon then
		return
	end
	local position = root.Position
	local ownCore = fortressService.GetCorePosition(entry.Team)
	local enemyCore = fortressService.GetCorePosition(Config.OtherTeam(entry.Team))
	local enemy, enemyDistance = nearestEnemy(entry, position)
	entry.Target = enemy
	entry.BattleStarted = entry.BattleStarted or now

	local healthRatio = humanoid.Health / math.max(1, humanoid.MaxHealth)
	if entry.Retreating then
		if healthRatio >= 0.68 then
			entry.Retreating = false
			resetPath(entry)
		end
	elseif healthRatio <= 0.28 then
		entry.Retreating = true
		resetPath(entry)
	end
	local retreating = entry.Retreating == true
	local destination = enemyAttackPoint(entry.Team)
	local route = "Assault"
	local targetPosition = enemyAimPoint(entry.Team)
	local shouldFire = true
	local action = "ATTACK CORE"

	if retreating then
		action = "RECOVER"
		destination = basePoint(entry.Team, laneForSlot(entry.Slot), 18)
		route = "Return"
		targetPosition = enemy and modelPosition(enemy) or enemyAimPoint(entry.Team)
		shouldFire = enemy ~= nil and enemyDistance < weapon.Range * 0.8
	elseif entry.Role == "Defender" then
		local threatDistance = enemy and (modelPosition(enemy) - ownCore).Magnitude or math.huge
		local joinedAssault = now - (entry.BattleStarted or now) >= 35
		if enemy and (threatDistance < 115 or enemyDistance < 60) then
			action = "ENGAGE"
			targetPosition = modelPosition(enemy) + Vector3.new(0, 1.5, 0)
			destination = targetPosition
			route = routeToDestination(entry, destination)
		elseif joinedAssault then
			-- Defense has a timed purpose; it is not permission to remain on the
			-- spawn pad for the entire round. A safe core releases the defender.
			action = "ATTACK CORE"
		else
			action = "FORWARD DEFENSE"
			destination = basePoint(entry.Team, laneForSlot(entry.Slot), -34)
			route = "Direct"
			targetPosition = enemyAimPoint(entry.Team)
			shouldFire = (enemyCore - position).Magnitude < weapon.Range * 0.8
		end
	elseif entry.Role == "Support" then
		if enemy and enemyDistance < 100 then
			action = "ENGAGE + SUPPORT"
			targetPosition = modelPosition(enemy) + Vector3.new(0, 1.5, 0)
			destination = targetPosition
			route = routeToDestination(entry, destination)
		else
			-- Support advances with the attack and heals on the way. Capture 67
			-- remains incidental; it must not cancel the team's core assault.
			action = "ATTACK + SUPPORT"
		end
	else
		if enemy and enemyDistance < 72 then
			action = "ENGAGE"
			targetPosition = modelPosition(enemy) + Vector3.new(0, 1.5, 0)
			destination = targetPosition
			route = routeToDestination(entry, destination)
		end
	end

	local distance = (targetPosition - position).Magnitude
	local destinationDistance = (destination - position).Magnitude
	local moving = distance > weapon.Range * 0.55
	if retreating or not shouldFire then
		moving = destinationDistance > 6
	end
	-- Range is never an excuse to keep firing from inside the spawn/base.
	if route == "Assault" and insideOwnBase(entry, position) and destinationDistance > 8 then
		moving = true
	end
	if moving then
		followDestination(entry, destination, now, route)
	else
		humanoid:MoveTo(position)
	end
	if shouldFire and distance <= weapon.Range * 0.95 then
		weaponService.FireBot(model, entry.WeaponId, targetPosition)
	end
	if abilityService and now >= (entry.NextAbility or 0) then
		entry.NextAbility = now + 2.8 + (entry.Slot % 3) * 0.3
		abilityService.UseBotAbility(model, targetPosition)
	end
	supportHeal(entry, now)

	-- A custom bot Humanoid has no default player CharacterHealth script. Limited
	-- recovery at its own base closes the old permanent-retreat state and sends
	-- the bot back once the 68% hysteresis threshold is reached.
	if retreating and insideOwnBase(entry, position) and now >= (entry.NextRecover or 0) then
		entry.NextRecover = now + 0.75
		humanoid.Health = math.min(humanoid.MaxHealth, humanoid.Health + 5)
	end

	model:SetAttribute("AIState", action)
	model:SetAttribute("AITarget", enemy and enemy.Name or "CORE")
	model:SetAttribute("AIDestination", destination)
	model:SetAttribute("AIShouldFire", shouldFire)
	if moving and entry.LastPosition and (position - entry.LastPosition).Magnitude < 0.35 and destinationDistance > 20 then
		entry.StuckTime = entry.StuckTime + 0.25
		if entry.StuckTime > 1.2 then
			entry.LaneOffset = (entry.LaneOffset or 0) + 1
			resetPath(entry)
			entry.StuckTime = 0
		end
	else
		entry.StuckTime = 0
	end
	model:SetAttribute("AIStuckTime", entry.StuckTime)
	entry.LastPosition = position
end

local function animateBot(entry, now)
	local root = entry.Model and entry.Model:FindFirstChild("HumanoidRootPart")
	if not root then
		return
	end
	local velocity = root.AssemblyLinearVelocity or Vector3.zero
	local speed = Vector3.new(velocity.X, 0, velocity.Z).Magnitude
	local stride = math.clamp(speed / 24, 0, 1)
	local cycle = now * (5 + stride * 4) + entry.Slot * 0.7
	for _, animation in ipairs(entry.Animations or {}) do
		if animation.Joint.Parent then
			local swing = 0
			if animation.Name == "Left Leg" or animation.Name == "Right Arm" then
				swing = math.sin(cycle) * 0.52 * stride
			elseif animation.Name == "Right Leg" or animation.Name == "Left Arm" then
				swing = -math.sin(cycle) * 0.52 * stride
			end
			if animation.Name == "Head" then
				animation.Joint.C0 = animation.C0 * CFrame.Angles(0, math.sin(now * 0.8 + entry.Slot) * 0.08, 0)
			else
				animation.Joint.C0 = animation.C0 * CFrame.Angles(swing, 0, 0)
			end
		end
	end
end

function BotService.Step(deltaTime)
	if not active then
		return
	end
	local phase = phaseProvider()
	local now = os.clock()
	for _, entry in pairs(bots) do
		local model = entry.Model
		local humanoid = model and model:FindFirstChildOfClass("Humanoid")
		local root = model and model:FindFirstChild("HumanoidRootPart")
		if model and model.Parent and humanoid and humanoid.Health > 0 and root then
			animateBot(entry, now)
			entry.Humanoid = humanoid
			-- Humanoid initialization and external slows must not silently restore
			-- the old 16–20 speeds; fast crossing is part of the bot role behavior.
			humanoid.WalkSpeed = (BOT_SPEEDS[entry.Role] or 24) + math.min(2, ((entry.SquadLevel or 1) - 1) * 0.25) + (tonumber(model:GetAttribute("AbilitySpeedBonus")) or 0)
			if phase == "Build" then
				if entry.Builds < Config.Arena.BotBuildsPerBot and now >= entry.NextBuild then
					local built = fortressService.BuildBot(entry.Team, entry.Slot, entry.Builds + 1)
					if built then
						entry.Builds = entry.Builds + 1
					end
					entry.NextBuild = now + 2.2
				end
				if entry.Builds < Config.Arena.BotBuildsPerBot then
					local pad = basePoint(entry.Team, (entry.Slot - 3.5) * 7, 20)
					followDestination(entry, pad, now, "Direct")
				elseif entry.Role == "Defender" then
					followDestination(entry, basePoint(entry.Team, laneForSlot(entry.Slot), 20), now, "Direct")
				else
					-- Construction is still protected, but finished attackers gather
					-- near the front instead of standing frozen on the spawn pad.
					followDestination(entry, basePoint(entry.Team, laneForSlot(entry.Slot), -18), now, "Direct")
				end
			elseif phase == "Battle" and now >= entry.NextThink then
				entry.NextThink = now + 0.25
				battleThink(entry, now)
			else
				humanoid:MoveTo(root.Position)
			end
		end
	end
end

return BotService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="12">
          <Properties>
            <string name="Name">CaptureService</string>
            <string name="Source"><![CDATA[-- Secondary capture objective: the fortress/core victory rule remains unchanged.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("BlockSiege")
local Config = require(Shared:WaitForChild("Config"))

local CaptureService = {}
local world
local state
local botService
local remotes
local phaseProvider = function()
	return "Lobby"
end
local owner = ""
local progress = 0
local progressTeam = ""
local contested = false
local published
local captureHandler

local function point()
	return world and world.CapturePoint
end

local function colorFor(team)
	return Config.Teams[team] and Config.Teams[team].Color or Color3.fromRGB(237, 190, 64)
end

local function publish()
	local signature = table.concat({ owner, progressTeam, tostring(math.floor(progress * 10)), tostring(contested) }, ":")
	if published == signature then
		return
	end
	published = signature
	if state then
		state:SetAttribute("Capture67Owner", owner)
		state:SetAttribute("Capture67Team", progressTeam)
		state:SetAttribute("Capture67Progress", math.floor(progress + 0.5))
		state:SetAttribute("Capture67Contested", contested)
		state:SetAttribute("Capture67Radius", 22)
	end
	local capture = point()
	if capture then
		local color = colorFor(owner ~= "" and owner or progressTeam)
		capture.Model:SetAttribute("Owner", owner)
		capture.Model:SetAttribute("Progress", math.floor(progress + 0.5))
		capture.Model:SetAttribute("Contested", contested)
		capture.Light.Color = color
		for _, item in ipairs(capture.Model:GetDescendants()) do
			if item:IsA("BasePart") and (item.Name == "CaptureCrystal" or item.Name == "CaptureGlow" or item.Name == "CaptureRing") then
				item.Color = color
			end
		end
	end
end

function CaptureService.Init(dependencies)
	world = dependencies.World
	state = dependencies.State
	botService = dependencies.BotService
	remotes = dependencies.Remotes
	CaptureService.Reset()
end

function CaptureService.SetPhaseProvider(provider)
	phaseProvider = provider
end

function CaptureService.SetCaptureHandler(handler)
	captureHandler = handler
end

function CaptureService.Reset()
	owner = ""
	progress = 0
	progressTeam = ""
	contested = false
	published = nil
	publish()
end

function CaptureService.GetPosition()
	local capture = point()
	return capture and capture.Root.Position or Vector3.zero
end

function CaptureService.GetOwner()
	return owner ~= "" and owner or nil
end

function CaptureService.GetProgress()
	return progress, progressTeam, contested
end

local function presence(team)
	local count = 0
	local position = CaptureService.GetPosition()
	if botService then
		for _, model in ipairs(botService.GetModels(team)) do
			local root = model:FindFirstChild("HumanoidRootPart")
			local humanoid = model:FindFirstChildOfClass("Humanoid")
			if root and humanoid and humanoid.Health > 0 and (root.Position - position).Magnitude <= 22 then
				count = count + 1
			end
		end
	end
	for _, player in ipairs(Players:GetPlayers()) do
		if player:GetAttribute("Team") == team and player:GetAttribute("InMatch") == true then
			local character = player.Character
			local root = character and character:FindFirstChild("HumanoidRootPart")
			local humanoid = character and character:FindFirstChildOfClass("Humanoid")
			if root and humanoid and humanoid.Health > 0 and (root.Position - position).Magnitude <= 22 then
				count = count + 1
			end
		end
	end
	return count
end

function CaptureService.Step(deltaTime)
	if phaseProvider() ~= "Battle" then
		return
	end
	local blue = presence("Blue")
	local orange = presence("Orange")
	contested = blue > 0 and orange > 0
	local presentTeam = blue > 0 and "Blue" or (orange > 0 and "Orange" or nil)
	local rate = 25 * deltaTime
	if not contested and presentTeam then
		if owner == presentTeam then
			progressTeam = presentTeam
			progress = 100
		else
			if progressTeam ~= presentTeam then
				if owner ~= "" or progress > 0 then
					progress = progress - rate
					if progress <= 0 then
						owner = ""
						progressTeam = presentTeam
						progress = 0
					end
				else
					progressTeam = presentTeam
					progress = 0
				end
			end
			if progressTeam == presentTeam then
				progress = math.min(100, progress + rate)
				if progress >= 100 and owner ~= presentTeam then
					owner = presentTeam
					progressTeam = presentTeam
					if remotes then
						remotes.CaptureFX:FireAllClients({ Kind = "Captured", Position = CaptureService.GetPosition(), Team = presentTeam })
					end
					if captureHandler then
						captureHandler(presentTeam)
					end
				end
			end
		end
	elseif not presentTeam and owner == "" then
		progress = math.max(0, progress - rate * 0.35)
	end
	publish()
end

return CaptureService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="13">
          <Properties>
            <string name="Name">CaseService</string>
            <string name="Source"><![CDATA[-- Игровые лутбоксы: серверный бросок, опубликованные шансы и pity без Robux.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("BlockSiege")
local Catalog = require(Shared:WaitForChild("Catalog"))

local CaseService = {}
local dataService
local remotes
local equipHandler
local random = Random.new()

local function chooseRarity(data)
	if data.LegendaryPity >= Catalog.Case.LegendaryPity - 1 then
		return "Legendary"
	end
	local roll = random:NextNumber(0, 100)
	if roll < 5 then
		return "Legendary"
	elseif roll < 35 then
		return "Rare"
	end
	return "Common"
end

local function open(player, currency)
	local data = dataService.Get(player)
	if not data then
		return nil, "Профиль ещё загружается"
	end
	if currency == "Coins" and data.Coins < Catalog.Case.CoinPrice then
		return nil, "Нужно 25 монет"
	end
	if currency == "Tokens" and data.CaseTokens < Catalog.Case.TokenPrice then
		return nil, "Нужен 1 жетон"
	end

	local rarity = chooseRarity(data)
	local pool = Catalog.Case.Pool[rarity]
	local weaponId = pool[random:NextInteger(1, #pool)]
	local weapon = Catalog.GetWeapon(weaponId)
	if currency == "Coins" then
		data.Coins = data.Coins - Catalog.Case.CoinPrice
	else
		data.CaseTokens = data.CaseTokens - Catalog.Case.TokenPrice
	end
	data.CasesOpened = data.CasesOpened + 1
	data.LegendaryPity = rarity == "Legendary" and 0 or data.LegendaryPity + 1
	local duplicate = data.OwnedWeapons[weaponId] == true
	local compensation = 0
	if duplicate then
		compensation = Catalog.Case.DuplicateCoins[rarity]
		data.Coins = data.Coins + compensation
	else
		data.OwnedWeapons[weaponId] = true
	end
	dataService.Commit(player, true)
	local result = {
		WeaponId = weaponId,
		Name = weapon.Name,
		Rarity = rarity,
		Duplicate = duplicate,
		Compensation = compensation,
		Coins = data.Coins,
		Tokens = data.CaseTokens,
		Pity = data.LegendaryPity,
	}
	remotes.CaseOpened:FireClient(player, result)
	return result
end

function CaseService.Init(dependencies)
	dataService = dependencies.DataService
	remotes = dependencies.Remotes
end

function CaseService.SetEquipHandler(handler)
	equipHandler = handler
end

function CaseService.OpenCoin(player)
	return open(player, "Coins")
end

function CaseService.OpenToken(player)
	return open(player, "Tokens")
end

function CaseService.HandleAction(player, action, value)
	local result, reason
	if action == "OpenCoin" then
		result, reason = CaseService.OpenCoin(player)
	elseif action == "OpenToken" then
		result, reason = CaseService.OpenToken(player)
	elseif action == "Equip" then
		local data = dataService.Get(player)
		local weapon = Catalog.GetWeapon(value)
		if not data then
			reason = "Профиль ещё загружается"
		elseif not weapon or not data.OwnedWeapons[value] then
			reason = "Это оружие ещё не открыто"
		else
			data.SelectedWeapon = value
			dataService.Commit(player, true)
			if equipHandler then
				equipHandler(player)
			end
			result = { WeaponId = value }
		end
	else
		reason = "Неизвестное действие"
	end
	if not result and reason then
		remotes.Notify:FireClient(player, reason)
	end
	return result, reason
end

return CaseService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="14">
          <Properties>
            <string name="Name">DataService</string>
            <string name="Source"><![CDATA[-- Профили, игровая валюта и инвентарь. В Studio по умолчанию используется память.
local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("BlockSiege")
local Config = require(Shared:WaitForChild("Config"))
local Catalog = require(Shared:WaitForChild("Catalog"))
local ExpeditionCatalog = require(Shared:WaitForChild("ExpeditionCatalog"))

local DataService = {}
local cache = {}
local loadTokens = {}
local loadFailures = {}
local store
local remotes
local autosaveClock = 0
local closing = false

local function defaults()
	return {
		Coins = 0,
		CaseTokens = Config.StartingCaseTokens,
		Wins = 0,
		Matches = 0,
		Kills = 0,
		StructureDamage = 0,
		XP = 0,
		CasesOpened = 0,
		LegendaryPity = 0,
		OwnedWeapons = { Carbine = true },
		SelectedWeapon = "Carbine",
		Upgrades = { Speed = 0, Health = 0, Armor = 0, Engineering = 0 },
		OwnedDefenses = {},
		OwnedCosmetics = {},
		SelectedCosmetics = { WeaponSkin = "Default", Aura = "Default", Trail = "Default" },
		ClaimedLevelRewards = {},
		LastDailyClaim = 0,
		ExpeditionWins = 0,
		ExpeditionBestWave = 0,
		SquadXP = 0,
		SelectedExpedition = "VerdantBastion",
	}
end

local function number(value, fallback, maximum)
	if type(value) ~= "number" or value ~= value or value == math.huge or value == -math.huge then
		return fallback
	end
	return math.clamp(value, 0, maximum or 1000000000)
end

local function weaponDictionary(value)
	local result = {}
	if type(value) == "table" then
		for id, owned in pairs(value) do
			if owned == true and Catalog.GetWeapon(id) then
				result[id] = true
			end
		end
	end
	result.Carbine = true
	return result
end

local function upgradeDictionary(value)
	local result = {}
	for _, id in ipairs(Catalog.UpgradeOrder) do
		local definition = Catalog.Upgrades[id]
		local level = type(value) == "table" and value[id] or 0
		result[id] = math.floor(number(level, 0, definition.MaxLevel))
	end
	return result
end

local function cosmeticDictionary(value)
	local result = {}
	if type(value) == "table" then
		for id, owned in pairs(value) do
			if owned == true and Catalog.GetCosmetic(id) then
				result[id] = true
			end
		end
	end
	return result
end

local function defenseDictionary(value)
	local result = {}
	if type(value) == "table" then
		for id, owned in pairs(value) do
			if owned == true and Catalog.GetDefense(id) then
				result[id] = true
			end
		end
	end
	return result
end

local function grantTrackReward(data, level, includeBaseCoins)
	local key = tostring(level)
	local reward = Catalog.GetLevelReward(level)
	if not reward or data.ClaimedLevelRewards[key] then
		return 0, nil
	end
	data.ClaimedLevelRewards[key] = true
	local coins = includeBaseCoins and (15 + level * 5) or 0
	coins = coins + (tonumber(reward.Coins) or 0)
	data.CaseTokens = math.min(99, (data.CaseTokens or 0) + (tonumber(reward.CaseTokens) or 0))
	if reward.Weapon then
		if data.OwnedWeapons[reward.Weapon] then
			coins = coins + 60
		else
			data.OwnedWeapons[reward.Weapon] = true
		end
	end
	if reward.Defense and not data.OwnedDefenses[reward.Defense] then
		data.OwnedDefenses[reward.Defense] = true
	end
	data.Coins = data.Coins + coins
	return coins, reward.Description
end

local function sanitize(value)
	local result = defaults()
	if type(value) ~= "table" then
		return result
	end
	for _, key in ipairs({ "Coins", "CaseTokens", "Wins", "Matches", "Kills", "StructureDamage", "XP", "CasesOpened", "ExpeditionWins", "ExpeditionBestWave", "SquadXP" }) do
		result[key] = math.floor(number(value[key], result[key]))
	end
	result.SelectedExpedition = ExpeditionCatalog.Get(value.SelectedExpedition) and value.SelectedExpedition or "VerdantBastion"
	result.LegendaryPity = math.floor(number(value.LegendaryPity, 0, Catalog.Case.LegendaryPity))
	result.LastDailyClaim = math.floor(number(value.LastDailyClaim, 0, 2000000000))
	result.OwnedWeapons = weaponDictionary(value.OwnedWeapons)
	result.Upgrades = upgradeDictionary(value.Upgrades)
	result.OwnedDefenses = defenseDictionary(value.OwnedDefenses)
	result.OwnedCosmetics = cosmeticDictionary(value.OwnedCosmetics)
	result.SelectedCosmetics = { WeaponSkin = "Default", Aura = "Default", Trail = "Default" }
	if type(value.SelectedCosmetics) == "table" then
		for slot, selected in pairs(value.SelectedCosmetics) do
			if (slot == "WeaponSkin" or slot == "Aura" or slot == "Trail") and Catalog.GetCosmetic(selected) and Catalog.GetCosmetic(selected).Slot == slot and result.OwnedCosmetics[selected] then
				result.SelectedCosmetics[slot] = selected
			end
		end
	end
	if type(value.ClaimedLevelRewards) == "table" then
		for level, claimed in pairs(value.ClaimedLevelRewards) do
			if claimed == true and Catalog.GetLevelReward(tonumber(level)) then
				result.ClaimedLevelRewards[tostring(level)] = true
			end
		end
	end
	result.SelectedWeapon = Catalog.GetWeapon(value.SelectedWeapon) and value.SelectedWeapon or "Carbine"
	if not result.OwnedWeapons[result.SelectedWeapon] then
		result.SelectedWeapon = "Carbine"
	end
	return result
end

local function ensureLeaderstats(player, profile)
	local stats = player:FindFirstChild("leaderstats")
	if not stats then
		stats = Instance.new("Folder")
		stats.Name = "leaderstats"
		stats.Parent = player
	end
	for _, name in ipairs({ "Wins", "Kills", "Coins" }) do
		if not stats:FindFirstChild(name) then
			local value = Instance.new("IntValue")
			value.Name = name
			value.Parent = stats
		end
	end
	if not stats:FindFirstChild("Level") then
		local value = Instance.new("IntValue")
		value.Name = "Level"
		value.Parent = stats
	end
	stats.Level.Value = Catalog.LevelForXP(profile.XP)
	return stats
end

local function apply(player)
	local data = cache[player.UserId]
	if not data then
		return
	end
	local stats = ensureLeaderstats(player, data)
	for _, name in ipairs({ "Wins", "Kills", "Coins" }) do
		stats[name].Value = data[name]
	end
	for _, key in ipairs({ "Coins", "CaseTokens", "Wins", "Matches", "Kills", "StructureDamage", "XP", "CasesOpened", "LegendaryPity", "SelectedWeapon", "ExpeditionWins", "ExpeditionBestWave", "SquadXP", "SelectedExpedition" }) do
		player:SetAttribute(key, data[key])
	end
	player:SetAttribute("SquadLevel", math.min(10, 1 + math.floor((data.SquadXP or 0) / 250)))
	player:SetAttribute("Level", Catalog.LevelForXP(data.XP))
	stats.Level.Value = Catalog.LevelForXP(data.XP)
	for id, level in pairs(data.Upgrades) do
		player:SetAttribute("Upgrade_" .. id, level)
	end
	for _, id in ipairs(Catalog.DefenseOrder) do
		player:SetAttribute("Defense_" .. id, data.OwnedDefenses[id] == true)
	end
	for _, slot in ipairs({ "WeaponSkin", "Aura", "Trail" }) do
		player:SetAttribute("Cosmetic_" .. slot, data.SelectedCosmetics[slot])
	end
	player:SetAttribute("LastDailyClaim", data.LastDailyClaim)
	player:SetAttribute("ProfileLoaded", true)
	if remotes and player.Parent then
		remotes.ProfileUpdate:FireClient(player, sanitize(data))
	end
end

function DataService.Init(dependencies)
	remotes = dependencies.Remotes
	local enabled = not RunService:IsStudio() or Config.PersistInStudio
	if enabled then
		local ok, result = pcall(function()
			return DataStoreService:GetDataStore(Config.DataStoreName)
		end)
		if ok then
			store = result
		end
	end
end

function DataService.Load(player)
	local userId = player.UserId
	if cache[userId] then
		apply(player)
		return cache[userId]
	end
	local token = {}
	loadTokens[userId] = token
	local stored
	if store then
		local ok, result = pcall(function()
			return store:GetAsync("Player_" .. userId)
		end)
		if ok then
			stored = result
			loadFailures[userId] = nil
		else
			loadFailures[userId] = true
			player:SetAttribute("DataStatus", "Память: ошибка загрузки")
		end
	end
	if loadTokens[userId] ~= token or not player.Parent then
		return nil
	end
	local profile = sanitize(stored)
	local currentLevel = Catalog.LevelForXP(profile.XP)
	for _, rewardLevel in ipairs(Catalog.LevelRewardOrder) do
		if rewardLevel <= currentLevel then
			grantTrackReward(profile, rewardLevel, false)
		end
	end
	cache[userId] = profile
	apply(player)
	return cache[userId]
end

function DataService.Get(player)
	return cache[player.UserId]
end

function DataService.GetSquadLevel(player)
	local data = DataService.Get(player)
	return data and math.min(10, 1 + math.floor((data.SquadXP or 0) / 250)) or 1
end

function DataService.GetSnapshot(player)
	local data = cache[player.UserId]
	return data and sanitize(data) or nil
end

function DataService.Commit(player, immediate)
	if not cache[player.UserId] then
		return
	end
	apply(player)
	if immediate then
		task.spawn(function()
			DataService.Save(player)
		end)
	end
end

function DataService.Save(player)
	local data = cache[player.UserId]
	if not data or not store then
		return true
	end
	if loadFailures[player.UserId] then
		return false
	end
	local snapshot = sanitize(data)
	return pcall(function()
		store:SetAsync("Player_" .. player.UserId, snapshot)
	end)
end

function DataService.SaveAndClear(player)
	local userId = player.UserId
	loadTokens[userId] = nil
	DataService.Save(player)
	cache[userId] = nil
	loadFailures[userId] = nil
end

function DataService.SaveAll()
	for _, player in ipairs(Players:GetPlayers()) do
		DataService.Save(player)
	end
end

function DataService.Step(deltaTime)
	autosaveClock = autosaveClock + deltaTime
	if autosaveClock < Config.AutosaveInterval then
		return
	end
	autosaveClock = 0
	for _, player in ipairs(Players:GetPlayers()) do
		task.spawn(function()
			DataService.Save(player)
		end)
	end
end

function DataService.SetExpedition(player, id)
	local data = cache[player.UserId]
	if not data or not ExpeditionCatalog.Get(id) then
		return false
	end
	data.SelectedExpedition = id
	DataService.Commit(player, true)
	return true
end

function DataService.AwardExpedition(player, locationId, wave, coins, xp)
	local data = cache[player.UserId]
	if not data then
		return nil
	end
	data.ExpeditionWins = (data.ExpeditionWins or 0) + 1
	data.ExpeditionBestWave = math.max(data.ExpeditionBestWave or 0, math.floor(tonumber(wave) or 0))
	data.SquadXP = (data.SquadXP or 0) + math.max(0, math.floor(tonumber(xp) or 0))
	local progress = DataService.Award(player, coins, xp, "PvE экспедиция · " .. tostring(locationId))
	DataService.Commit(player, true)
	return progress
end

function DataService.AddCoins(player, amount)
	local data = cache[player.UserId]
	if data then
		data.Coins = math.max(0, data.Coins + math.floor(amount))
		apply(player)
	end
end

function DataService.AddXP(player, amount)
	local data = cache[player.UserId]
	local gained = math.max(0, math.floor(tonumber(amount) or 0))
	if not data then
		return { XP = gained, PreviousLevel = 1, Level = 1, LeveledUp = false, Unlocks = {}, LevelCoins = 0 }
	end
	local previousLevel = Catalog.LevelForXP(data.XP)
	data.XP = data.XP + gained
	local level = Catalog.LevelForXP(data.XP)
	local levelCoins = 0
	local unlocks = {}
	for reachedLevel = previousLevel + 1, level do
		local baseCoins = 15 + reachedLevel * 5
		data.Coins = data.Coins + baseCoins
		levelCoins = levelCoins + baseCoins
		local trackCoins, description = grantTrackReward(data, reachedLevel, false)
		levelCoins = levelCoins + trackCoins
		table.insert(unlocks, {
			Level = reachedLevel,
			Text = description or string.format("+%d монет", baseCoins),
		})
	end
	apply(player)
	local result = {
		XP = gained,
		PreviousLevel = previousLevel,
		Level = level,
		LeveledUp = level > previousLevel,
		Unlocks = unlocks,
		LevelCoins = levelCoins,
	}
	if result.LeveledUp and remotes and remotes.ProgressionFX then
		remotes.ProgressionFX:FireClient(player, {
			Type = "LevelUp",
			Level = level,
			LevelCoins = levelCoins,
			Unlocks = unlocks,
		})
	end
	return result
end

function DataService.Award(player, coins, xp, reason)
	local data = cache[player.UserId]
	local coinReward = math.max(0, math.floor(tonumber(coins) or 0))
	local xpReward = math.max(0, math.floor(tonumber(xp) or 0))
	if data then
		data.Coins = data.Coins + coinReward
	end
	local progress = DataService.AddXP(player, xpReward)
	if data and remotes and remotes.ProgressionFX then
		remotes.ProgressionFX:FireClient(player, {
			Type = "Action",
			Coins = coinReward,
			XP = xpReward,
			Reason = tostring(reason or "Полезное действие"),
			Level = progress.Level,
		})
	end
	return progress
end

function DataService.AddKill(player, coins, xp, reason)
	local data = cache[player.UserId]
	if data then
		data.Kills = data.Kills + 1
		return DataService.Award(player, coins == nil and 2 or coins, xp == nil and 8 or xp, reason or "Противник выведен из боя")
	end
	return nil
end

function DataService.AddStructureDamage(player, amount)
	local data = cache[player.UserId]
	if data then
		data.StructureDamage = data.StructureDamage + math.max(0, math.floor(amount))
	end
end

function DataService.RecordMatch(player, won, draw)
	local data = cache[player.UserId]
	if not data then
		return nil
	end
	data.Matches = data.Matches + 1
	local coins = draw and 25 or (won and 40 or 15)
	local xp = draw and 75 or (won and 120 or 50)
	data.Coins = data.Coins + coins
	local token = false
	if won then
		data.Wins = data.Wins + 1
		if data.Wins % 2 == 0 then
			data.CaseTokens = data.CaseTokens + 1
			token = true
		end
	end
	local progress = DataService.AddXP(player, xp)
	DataService.Commit(player, true)
	return {
		Coins = coins,
		XP = xp,
		Token = token,
		LevelCoins = progress.LevelCoins,
		Level = progress.Level,
		LeveledUp = progress.LeveledUp,
		Unlocks = progress.Unlocks,
	}
end

game:BindToClose(function()
	if closing then
		return
	end
	closing = true
	DataService.SaveAll()
end)

return DataService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="15">
          <Properties>
            <string name="Name">FortressService</string>
            <string name="Source"><![CDATA[-- Разрушаемые крепости, строительная сетка и серверная проверка урона.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("BlockSiege")
local Config = require(Shared:WaitForChild("Config"))
local CombatModels = require(Shared:WaitForChild("CombatModels"))
local VisualModels = require(Shared:WaitForChild("VisualModels"))

local vector3Type = typeof(Vector3.new())
local FortressService = {}
local world
local remotes
local state
local phaseProvider = function()
	return "Lobby"
end
local coreHandler
local damageHandler
local entries = {}
local partIndex = {}
local cores = {}
local buildCounts = {}
local nextId = 0
local buildCapacityProvider = function()
	return Config.Arena.MaxBuildPerPlayer
end
local buildAccessProvider = function()
	return true
end
local targetsProvider = function()
	return {}
end

local STRUCTURE_TEXTURES = {
	[Enum.Material.Cobblestone] = { Asset = "rbxassetid://9438459300", Tile = 5, Transparency = 0.1 },
	[Enum.Material.WoodPlanks] = { Asset = "rbxassetid://9439658515", Tile = 4, Transparency = 0.08 },
	[Enum.Material.Metal] = { Asset = "rbxassetid://9920574687", Tile = 3, Transparency = 0.16 },
}

local function addStructureTextures(part, name, material)
	if name ~= "Root" and name ~= "CorePedestal" and name ~= "CorePylon" then
		return
	end
	local style = STRUCTURE_TEXTURES[material]
	if not style then
		return
	end
	for _, face in ipairs({ Enum.NormalId.Top, Enum.NormalId.Front }) do
		local texture = Instance.new("Texture")
		texture.Name = "StructureSurfaceTexture"
		texture.Texture = style.Asset
		texture.Face = face
		texture.StudsPerTileU = style.Tile
		texture.StudsPerTileV = style.Tile
		texture.Transparency = style.Transparency
		texture.Parent = part
	end
	part:SetAttribute("SurfaceTextured", true)
end

local function makeBlock(model, name, size, cframe, color, material, collide)
	local part = Instance.new("Part")
	part.Name = name
	part.Size = size
	part.CFrame = cframe
	part.Color = color
	part.Material = material or Enum.Material.Cobblestone
	part.Anchored = true
	part.CanCollide = collide ~= false
	part.CanTouch = false
	part.CanQuery = true
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Parent = model
	addStructureTextures(part, name, part.Material)
	return part
end

local function updateState(team)
	local core = cores[team]
	if core and state then
		state:SetAttribute(team .. "Core", math.max(0, math.ceil(core.Health)))
		state:SetAttribute(team .. "CoreMax", core.MaxHealth)
	end
end

local function registerEntry(model, team, kind, health)
	nextId = nextId + 1
	local entry = {
		Id = nextId,
		Model = model,
		Team = team,
		Kind = kind,
		Health = health,
		MaxHealth = health,
		Active = true,
		Parts = {},
	}
	model.Name = string.format("%s_%s_%03d", team, kind, nextId)
	model:SetAttribute("Team", team)
	model:SetAttribute("Kind", kind)
	model:SetAttribute("StructureId", nextId)
	model:SetAttribute("Health", health)
	model:SetAttribute("MaxHealth", health)
	for _, part in ipairs(model:GetDescendants()) do
		if part:IsA("BasePart") then
			part:SetAttribute("StructureId", nextId)
			part:SetAttribute("Team", team)
			part:SetAttribute("Kind", kind)
			partIndex[part] = entry
			table.insert(entry.Parts, part)
		end
	end
	entries[nextId] = entry
	return entry
end

local function createCore(team)
	local model = Instance.new("Model")
	model.Parent = world.Structures
	local teamColor = Config.Teams[team].Color
	local baseCFrame = Config.BaseCFrame(team)
	local heart = makeBlock(model, "CoreHeart", Vector3.new(10, 12, 10), baseCFrame * CFrame.new(0, 7, 0), teamColor, Enum.Material.Neon, true)
	heart.Shape = Enum.PartType.Ball
	model.PrimaryPart = heart
	makeBlock(model, "CorePedestal", Vector3.new(18, 2, 18), baseCFrame * CFrame.new(0, 1, 0), Config.Teams[team].Dark, Enum.Material.Cobblestone, true)
	for _, height in ipairs({ 2, 12 }) do
		makeBlock(model, "CoreBand", Vector3.new(12, 1, 12), baseCFrame * CFrame.new(0, height, 0), Color3.fromRGB(238, 188, 68), Enum.Material.Metal, false)
	end
	for _, side in ipairs({ -1, 1 }) do
		makeBlock(model, "CorePylon", Vector3.new(2, 16, 2), baseCFrame * CFrame.new(side * 8, 8, 0), Config.Teams[team].Dark, Enum.Material.Cobblestone, true)
	end
	for index, offset in ipairs({ Vector3.new(-7, 6, -7), Vector3.new(-7, 8, 7), Vector3.new(7, 8, -7), Vector3.new(7, 6, 7) }) do
		local orbital = makeBlock(model, "CoreOrbital", Vector3.new(2.4, 2.4, 2.4), baseCFrame * CFrame.new(offset) * CFrame.Angles(0, math.rad(index * 18), 0), teamColor, Enum.Material.Neon, false)
		orbital.Shape = Enum.PartType.Ball
		orbital.Transparency = 0.12
	end
	local coreLight = Instance.new("PointLight")
	coreLight.Name = "CoreGlow"
	coreLight.Color = teamColor
	coreLight.Brightness = 2.2
	coreLight.Range = 26
	coreLight.Shadows = true
	coreLight.Parent = heart
	local sparkles = Instance.new("Sparkles")
	sparkles.Name = "CoreSparkles"
	sparkles.SparkleColor = teamColor
	sparkles.Parent = heart
	heart.Transparency = 1
	for _, item in ipairs(model:GetDescendants()) do
		if item:IsA("BasePart") and (item.Name == "CorePedestal" or item.Name == "CoreBand" or item.Name == "CorePylon" or item.Name == "CoreOrbital") then
			item.Transparency = 1
		end
	end
	VisualModels.Core(model, heart.CFrame, teamColor)
	local entry = registerEntry(model, team, "Core", Config.Arena.CoreHealth)
	cores[team] = entry
	updateState(team)
	return entry
end

local function createStructure(team, kind, cframe)
	local definition = Config.BuildKinds[kind]
	if not definition then
		return nil
	end
	local model = Instance.new("Model")
	model.Parent = world.Structures
	local color = Config.Teams[team].Color
	local dark = Config.Teams[team].Dark
	local root = makeBlock(model, "Root", definition.Size, cframe, dark, definition.Trap and Enum.Material.Metal or (kind == "Barricade" and Enum.Material.WoodPlanks or Enum.Material.Cobblestone), true)
	model.PrimaryPart = root
	if kind == "LaneTower" then
		model:SetAttribute("Objective", "LaneTower")
		-- Keep the original collision/damage parts as invisible proxies. The
		-- visible tower is a sculpted mesh-style assembly, not a stack of cubes.
		root.Transparency = 1
		local oldBase = makeBlock(model, "TowerBase", Vector3.new(11, 1.2, 11), cframe * CFrame.new(0, -6.4, 0), dark, Enum.Material.Cobblestone, true)
		oldBase.Transparency = 1
		local oldBand = makeBlock(model, "TowerBand", Vector3.new(8.5, 0.7, 8.5), cframe * CFrame.new(0, 3.8, 0), color, Enum.Material.Metal, false)
		oldBand.Transparency = 1
		local oldHead = makeBlock(model, "TowerHead", Vector3.new(7, 3, 7), cframe * CFrame.new(0, 5.5, 0), color, Enum.Material.DiamondPlate, true)
		oldHead.Transparency = 1
		local barrel = makeBlock(model, "TowerBarrel", Vector3.new(8, 1.4, 1.4), cframe * CFrame.new(0, 5.5, -5) * CFrame.Angles(0, math.rad(90), 0), Color3.fromRGB(222, 238, 244), Enum.Material.Metal, false)
		barrel.Shape = Enum.PartType.Cylinder
		local eye = makeBlock(model, "TowerEye", Vector3.new(2.2, 0.65, 0.4), cframe * CFrame.new(0, 6, -3.6), Color3.fromRGB(255, 211, 99), Enum.Material.Neon, false)
		eye.Transparency = 1
		local glow = Instance.new("PointLight")
		glow.Name = "TowerGlow"
		glow.Color = color
		glow.Brightness = 1.4
		glow.Range = 16
		glow.Parent = eye
		local ground = cframe.Position - Vector3.new(0, 7, 0)
		VisualModels.Tower(model, "LaneTowerVisual", ground, 0.62, color)
	elseif definition.Trap then
		model:SetAttribute("IsTrap", true)
		model:SetAttribute("DefenseId", kind)
		if kind == "SpikeTrap" then
			for index = 1, 5 do
				local angle = math.rad(index * 72)
				local offset = Vector3.new(math.cos(angle) * 2.4, 1.8, math.sin(angle) * 2.4)
				makeBlock(model, "Spike", Vector3.new(1.1, 3.8, 1.1), cframe * CFrame.new(offset) * CFrame.Angles(0, angle, math.rad(18)), Color3.fromRGB(193, 205, 198), Enum.Material.Metal, true)
				makeBlock(model, "SpikeTip", Vector3.new(1.2, 0.45, 1.2), cframe * CFrame.new(offset + Vector3.new(0, 1.9, 0)), color, Enum.Material.Neon, false)
			end
		elseif kind == "ShockMine" then
			local core = makeBlock(model, "MineCore", Vector3.new(3.2, 2.2, 3.2), cframe * CFrame.new(0, 1.1, 0), Color3.fromRGB(75, 198, 255), Enum.Material.Neon, false)
			core.Shape = Enum.PartType.Ball
			makeBlock(model, "MineRing", Vector3.new(5.5, 0.35, 1), cframe * CFrame.new(0, 0.8, 0), color, Enum.Material.Metal, false)
			makeBlock(model, "MineRing", Vector3.new(1, 0.35, 5.5), cframe * CFrame.new(0, 0.8, 0), color, Enum.Material.Metal, false)
			local light = Instance.new("PointLight")
			light.Name = "MineGlow"
			light.Color = Color3.fromRGB(75, 198, 255)
			light.Brightness = 1.5
			light.Range = 10
			light.Parent = core
		elseif kind == "FlameTrap" then
			makeBlock(model, "FlameNozzle", Vector3.new(2, 2.4, 2), cframe * CFrame.new(0, 1.5, 0), Color3.fromRGB(238, 113, 48), Enum.Material.Metal, true)
			makeBlock(model, "FlameCore", Vector3.new(1.2, 2.8, 1.2), cframe * CFrame.new(0, 3.5, 0), Color3.fromRGB(255, 207, 70), Enum.Material.Neon, false)
		end
	else
		if kind == "Barricade" then
			root.Transparency = 1
			local oldBrace = makeBlock(model, "WoodBrace", Vector3.new(1, definition.Size.Y + 1, definition.Size.Z + 0.4), cframe * CFrame.new(0, 0, 0) * CFrame.Angles(0, 0, math.rad(28)), Color3.fromRGB(164, 111, 55), Enum.Material.WoodPlanks, true)
			oldBrace.Transparency = 1
			VisualModels.Barricade(model, cframe, color)
		else
			root.Transparency = 1
			local oldBand = makeBlock(model, "TeamBand", Vector3.new(definition.Size.X + 0.25, 0.8, definition.Size.Z + 0.25), cframe * CFrame.new(0, definition.Size.Y * 0.25, 0), color, Enum.Material.Metal, false)
			oldBand.Transparency = 1
			for _, side in ipairs({ -1, 0, 1 }) do
				local oldBattlement = makeBlock(model, "Battlement", Vector3.new(math.max(1.5, definition.Size.X / 4), 2, definition.Size.Z), cframe * CFrame.new(side * definition.Size.X * 0.32, definition.Size.Y / 2 + 1, 0), dark, Enum.Material.Cobblestone, true)
				oldBattlement.Transparency = 1
			end
			if kind == "Tower" then
				local towerVisual = VisualModels.Tower(model, "BuildTowerVisual", cframe.Position - Vector3.new(0, definition.Size.Y / 2, 0), 0.78, color)
				-- Body is an X-axis cylinder: retain its intrinsic Z=90 rotation.
				towerVisual:PivotTo(cframe * CFrame.new(0, -3.93, 0) * CFrame.Angles(0, 0, math.rad(90)))
			else
				VisualModels.Wall(model, cframe, color)
			end
		end
	end
	local entry = registerEntry(model, team, kind, definition.Health)
	entry.PlacementCFrame = cframe
	entry.PlacementLocked = kind == "Barricade"
	model:SetAttribute("PlacementLocked", entry.PlacementLocked)
	root:SetAttribute("PlacementLocked", entry.PlacementLocked)
	entry.IsTrap = definition.Trap == true
	entry.IsLaneTower = kind == "LaneTower"
	entry.ArmedAt = os.clock() + 1
	entry.NextTrigger = 0
	entry.NextAttack = os.clock() + 0.8
	CombatModels.RegisterStructureAnimation(entry)
	return entry
end

local function createLaneTower(team, lane, distance)
	local side = team == "Blue" and -1 or 1
	local zOffset = lane == 0 and 18 or (lane > 0 and -16 or 16)
	local position = Vector3.new(side * distance, 7, lane + zOffset)
	local facing = team == "Blue" and 1 or -1
	local towerCFrame = CFrame.lookAt(position, position + Vector3.new(facing, 0, 0))
	local entry = createStructure(team, "LaneTower", towerCFrame)
	if entry then
		entry.Lane = lane
		entry.Model:SetAttribute("Lane", lane)
		entry.Model:SetAttribute("AttackRange", Config.BuildKinds.LaneTower.AttackRange)
	end
	return entry
end

local function removeEntry(entry)
	if not entry.Active then
		return
	end
	entry.Active = false
	for _, part in ipairs(entry.Parts) do
		partIndex[part] = nil
	end
	entries[entry.Id] = nil
	if entry.Model then
		entry.Model:Destroy()
	end
end

function FortressService.Init(dependencies)
	world = dependencies.World
	remotes = dependencies.Remotes
	state = dependencies.State
end

function FortressService.SetPhaseProvider(provider)
	phaseProvider = provider
end

function FortressService.SetCoreHandler(handler)
	coreHandler = handler
end

function FortressService.SetDamageHandler(handler)
	damageHandler = handler
end

function FortressService.SetBuildCapacityProvider(provider)
	buildCapacityProvider = provider or function()
		return Config.Arena.MaxBuildPerPlayer
	end
end

function FortressService.SetBuildAccessProvider(provider)
	buildAccessProvider = provider or function()
		return true
	end
end

function FortressService.SetTargetsProvider(provider)
	targetsProvider = provider or function()
		return {}
	end
end

function FortressService.Clear()
	for _, entry in pairs(entries) do
		entry.Active = false
		if entry.Model then
			entry.Model:Destroy()
		end
	end
	entries = {}
	partIndex = {}
	cores = {}
	buildCounts = {}
end

function FortressService.Reset()
	FortressService.Clear()
	for _, team in ipairs(Config.TeamOrder) do
		createCore(team)
		local baseCFrame = Config.BaseCFrame(team)
		-- Two wall pairs leave a real central gate. The old -21/-7/7/21
		-- layout had only 2-stud slits, too narrow for the R6 pathfinding agent.
		for _, x in ipairs({ -35, -21, 21, 35 }) do
			createStructure(team, "Wall", baseCFrame * CFrame.new(x, 6, -28))
		end
		for _, side in ipairs({ -1, 1 }) do
			createStructure(team, "Barricade", baseCFrame * CFrame.new(side * 42, 2.5, 4) * CFrame.Angles(0, math.rad(90), 0))
		end
	end
	if Config.Objectives and Config.Objectives.LaneTowers then
		for _, team in ipairs(Config.TeamOrder) do
			for _, lane in ipairs(Config.Objectives.Lanes) do
				for _, distance in ipairs(Config.Objectives.TowerDistances) do
					createLaneTower(team, lane, distance)
				end
			end
		end
	end
	if state then
		state:SetAttribute("LaneTowerCount", Config.Objectives and (#Config.Objectives.Lanes * #Config.Objectives.TowerDistances * 2) or 0)
	end
end

local function validPosition(position)
	return typeof(position) == vector3Type and position.X == position.X and position.Y == position.Y and position.Z == position.Z
		and math.abs(position.X) < 10000 and math.abs(position.Y) < 10000 and math.abs(position.Z) < 10000
end

local function normalizeRotation(rotation)
	if type(rotation) ~= "number" or rotation ~= rotation or rotation == math.huge or rotation == -math.huge then
		return 0
	end
	local degrees = rotation % 360
	return math.floor(degrees / 90 + 0.5) % 4
end

function FortressService.GetRotationDegrees(rotation)
	return normalizeRotation(rotation) * 90
end

local function placement(team, kind, position, rotation)
	local definition = Config.BuildKinds[kind]
	if not definition or kind == "LaneTower" or not validPosition(position) then
		return nil, "Неверная позиция"
	end
	local baseCFrame = Config.BaseCFrame(team)
	local localPosition = baseCFrame:PointToObjectSpace(position)
	if math.abs(localPosition.X) > Config.Arena.BuildZoneSide or math.abs(localPosition.Z) > Config.Arena.BuildZoneForward then
		return nil, "Строить можно только на своей базе"
	end
	local grid = Config.Arena.BuildGrid
	local x = math.floor(localPosition.X / grid + 0.5) * grid
	local z = math.floor(localPosition.Z / grid + 0.5) * grid
	if Vector3.new(x, 0, z).Magnitude < 17 then
		return nil, "Оставьте место вокруг ядра"
	end
	if z > 25 and math.abs(x) < 18 then
		return nil, "Не блокируйте возрождение команды"
	end
	for _, entry in pairs(entries) do
		if entry.Active and entry.Team == team then
			local other = baseCFrame:PointToObjectSpace(entry.Model.PrimaryPart.Position)
			if math.abs(other.X - x) < 10 and math.abs(other.Z - z) < 10 then
				return nil, "Здесь уже есть постройка"
			end
		end
	end
	return baseCFrame * CFrame.new(x, definition.Size.Y / 2, z) * CFrame.Angles(0, math.rad(normalizeRotation(rotation) * 90), 0)
end

function FortressService.GetPlayerPlacement(player, team, kind, position, rotation)
	if phaseProvider() ~= "Build" then
		return nil, "Строительство уже закончено"
	end
	if not validPosition(position) then
		return nil, "Неверная позиция"
	end
	if not Config.Teams[team] then
		return nil, "Вы не участвуете в матче"
	end
	if not buildAccessProvider(player, kind) then
		return nil, "Сначала купите этот чертёж в магазине"
	end
	local count = buildCounts[player.UserId] or 0
	local capacity = buildCapacityProvider(player)
	if count >= capacity then
		return nil, "Лимит построек исчерпан"
	end
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not root or (root.Position - position).Magnitude > Config.Arena.MaxBuildDistance then
		return nil, "Подойдите ближе к месту постройки"
	end
	return placement(team, kind, position, rotation)
end

function FortressService.BuildPlayer(player, team, kind, position, rotation)
	local cframe, reason = FortressService.GetPlayerPlacement(player, team, kind, position, rotation)
	if not cframe then
		return false, reason
	end
	local entry = createStructure(team, kind, cframe)
	local count = (buildCounts[player.UserId] or 0) + 1
	buildCounts[player.UserId] = count
	local capacity = buildCapacityProvider(player)
	player:SetAttribute("BuildLimit", capacity)
	player:SetAttribute("BuildUsed", count)
	player:SetAttribute("BuildRemaining", math.max(0, capacity - count))
	remotes.BuildFX:FireAllClients({ Kind = "Build", Position = cframe.Position, Team = team })
	return true, entry
end

local botPads = {
	{ { -46, -44 }, { -46, -16 }, { -46, 20 } },
	{ { -30, -44 }, { -30, -16 }, { -30, 20 } },
	{ { 30, -44 }, { 30, -16 }, { 30, 20 } },
	{ { 46, -44 }, { 46, -16 }, { 46, 20 } },
	{ { -14, -44 }, { -30, 40 }, { -46, 40 } },
	{ { 14, -44 }, { 30, 40 }, { 46, 40 } },
}

function FortressService.BuildBot(team, slot, buildIndex)
	if phaseProvider() ~= "Build" then
		return false
	end
	local botSlot = botPads[((slot - 1) % #botPads) + 1]
	local pad = botSlot[buildIndex]
	if not pad then
		return false
	end
	local kind = buildIndex == 2 and "Barricade" or (buildIndex == 3 and "Tower" or "Wall")
	-- Try nearby tactical pads if a human or another bot already occupied the preferred one.
	local offsets = { { 0, 0 }, { 14, 0 }, { -14, 0 }, { 0, 14 }, { 0, -14 }, { 18, 12 }, { -18, 12 } }
	for _, offset in ipairs(offsets) do
		local position = (Config.BaseCFrame(team) * CFrame.new(pad[1] + offset[1], 0, pad[2] + offset[2])).Position
		local cframe = placement(team, kind, position)
		if cframe then
			createStructure(team, kind, cframe)
			return true
		end
	end
	return false
end

function FortressService.RepairStructures(team, position, radius, amount)
	if not Config.Teams[team] or not validPosition(position) then
		return 0
	end
	local repaired = 0
	local repairAmount = math.max(0, tonumber(amount) or 0)
	for _, entry in pairs(entries) do
		local root = entry.Active and entry.Team == team and entry.Model and entry.Model.PrimaryPart or nil
		if root and (root.Position - position).Magnitude <= radius then
			local before = tonumber(entry.Health) or 0
			local maximum = tonumber(entry.MaxHealth) or before
			entry.Health = math.min(maximum, before + repairAmount)
			entry.Model:SetAttribute("Health", entry.Health)
			repaired = repaired + entry.Health - before
			if entry.Kind == "Core" then
				updateState(team)
			end
		end
	end
	return repaired
end

function FortressService.DamagePart(part, amount, attackingTeam, player)
	if phaseProvider() ~= "Battle" or not part or not Config.Teams[attackingTeam] then
		return 0
	end
	local entry = partIndex[part]
	if not entry or not entry.Active or entry.Team == attackingTeam then
		return 0
	end
	local applied = math.min(entry.Health, math.max(0, amount))
	if applied <= 0 then
		return 0
	end
	entry.Health = entry.Health - applied
	entry.Model:SetAttribute("Health", entry.Health)
	if player and damageHandler then
		damageHandler(player, applied, entry.Kind, entry.Health <= 0)
	end
	remotes.CombatFX:FireAllClients({ Kind = "StructureHit", Position = part.Position, Team = entry.Team })
	if entry.Kind == "Core" then
		updateState(entry.Team)
	end
	local healthRatio = entry.Health / entry.MaxHealth
	if entry.Kind ~= "Core" and healthRatio < 0.66 then
		for _, structurePart in ipairs(entry.Parts) do
			if structurePart.Name == "Root" then
				structurePart.Color = healthRatio < 0.33 and Color3.fromRGB(63, 51, 46) or Color3.fromRGB(88, 82, 69)
			end
		end
	end
	if healthRatio < 0.35 and not entry.Model:FindFirstChild("DamageSmoke") then
		local smoke = Instance.new("Smoke")
		smoke.Name = "DamageSmoke"
		smoke.Color = Color3.fromRGB(74, 70, 64)
		smoke.Opacity = 0.22
		smoke.RiseVelocity = 2
		smoke.Size = 7
		smoke.Parent = entry.Model.PrimaryPart
	end
	if entry.Health <= 0 then
		local losingTeam = entry.Team
		local kind = entry.Kind
		local position = entry.Model.PrimaryPart and entry.Model.PrimaryPart.Position or part.Position
		removeEntry(entry)
		if kind == "Core" then
			cores[losingTeam] = nil
			if state then
				state:SetAttribute(losingTeam .. "Core", 0)
			end
			remotes.CombatFX:FireAllClients({ Kind = "CoreDestroyed", Position = position, Team = losingTeam })
			if coreHandler then
				coreHandler(losingTeam, attackingTeam)
			end
		else
			remotes.CombatFX:FireAllClients({ Kind = "StructureDestroyed", Position = position, Team = losingTeam })
		end
	end
	return applied
end

function FortressService.GetCorePosition(team)
	local core = cores[team]
	if core and core.Active and core.Model.PrimaryPart then
		return core.Model.PrimaryPart.Position
	end
	return Config.BasePosition(team) + Vector3.new(0, 7, 0)
end

function FortressService.GetCoreHealth(team)
	local core = cores[team]
	return core and core.Active and core.Health or 0
end

function FortressService.GetStructureCount(team)
	local count = 0
	for _, entry in pairs(entries) do
		if entry.Active and (not team or entry.Team == team) then
			count = count + 1
		end
	end
	return count
end

function FortressService.GetEntry(part)
	return partIndex[part]
end

function FortressService.GetEntries()
	local result = {}
	for _, entry in pairs(entries) do
		if entry.Active then
			table.insert(result, entry)
		end
	end
	return result
end

local function applyTrapDamage(model, amount)
	local humanoid = model and model:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.Health <= 0 then
		return false
	end
	local armor = tonumber(model:GetAttribute("Armor")) or 0
	local shield = tonumber(model:GetAttribute("DamageTakenMultiplier")) or 1
	humanoid:TakeDamage(amount * math.clamp(shield, 0.05, 1) * (1 - math.clamp(armor, 0, 0.65)))
	return true
end

local function towerAttack(entry, definition, root, now)
	if now < (entry.NextAttack or 0) then
		return
	end
	local best
	local bestRoot
	local bestDistance = definition.AttackRange
	for _, model in ipairs(targetsProvider(entry.Team)) do
		local targetRoot = model and model:FindFirstChild("HumanoidRootPart")
		local humanoid = model and model:FindFirstChildOfClass("Humanoid")
		if targetRoot and humanoid and humanoid.Health > 0 then
			local distance = (targetRoot.Position - root.Position).Magnitude
			if distance <= bestDistance then
				best = model
				bestRoot = targetRoot
				bestDistance = distance
			end
		end
	end
	if not best then
		entry.NextAttack = now + 0.25
		return
	end
	entry.NextAttack = now + definition.AttackCooldown
	local aimPosition = Vector3.new(bestRoot.Position.X, root.Position.Y, bestRoot.Position.Z)
	if (aimPosition - root.Position).Magnitude > 0.1 then
		entry.Model:PivotTo(CFrame.lookAt(root.Position, aimPosition))
	end
	applyTrapDamage(best, definition.AttackDamage)
	entry.Model:SetAttribute("TargetName", best.Name)
	local barrel = entry.Model:FindFirstChild("TowerBarrel")
	remotes.CombatFX:FireAllClients({
		Kind = "TowerShot",
		Origin = barrel and barrel.Position or root.Position + Vector3.new(0, 6, 0),
		Finish = bestRoot.Position,
		Position = bestRoot.Position,
		Team = entry.Team,
		Color = Config.Teams[entry.Team].Color,
	})
end

function FortressService.Step()
	local now = os.clock()
	-- Traps remain visually alive during Build; only damage is Battle-gated.
	for _, entry in pairs(entries) do
		if entry.Active and entry.PlacementLocked and entry.Model and entry.Model.PrimaryPart and entry.PlacementCFrame then
			local root = entry.Model.PrimaryPart
			if root.CFrame ~= entry.PlacementCFrame then
				entry.Model:PivotTo(entry.PlacementCFrame)
			end
		end
		if entry.Active and entry.IsTrap then
			entry.Model:SetAttribute("Triggered", (entry.TriggeredUntil or 0) > now)
			CombatModels.AnimateStructure(entry, now)
		end
	end
	if phaseProvider() ~= "Battle" then
		return
	end
	local destroyAfter = {}
	for _, entry in pairs(entries) do
		local definition = Config.BuildKinds[entry.Kind]
		local root = entry.Model and entry.Model.PrimaryPart
		if entry.Active and entry.IsLaneTower and definition and root then
			towerAttack(entry, definition, root, now)
		elseif entry.Active and entry.IsTrap and definition and root and now >= (entry.ArmedAt or 0) and now >= (entry.NextTrigger or 0) then
			local targets = targetsProvider(entry.Team)
			for _, model in ipairs(targets) do
				local targetRoot = model and model:FindFirstChild("HumanoidRootPart")
				local humanoid = model and model:FindFirstChildOfClass("Humanoid")
				if targetRoot and humanoid and humanoid.Health > 0 and (targetRoot.Position - root.Position).Magnitude <= definition.TriggerRadius then
					if definition.OneShot then
						for _, blastTarget in ipairs(targets) do
							local blastRoot = blastTarget and blastTarget:FindFirstChild("HumanoidRootPart")
							if blastRoot and (blastRoot.Position - root.Position).Magnitude <= (definition.BlastRadius or definition.TriggerRadius) then
								applyTrapDamage(blastTarget, definition.Damage)
							end
						end
						destroyAfter[entry] = true
					else
						applyTrapDamage(model, definition.Damage)
						entry.NextTrigger = now + definition.Cooldown
					end
					entry.TriggeredUntil = now + 0.35
					entry.Model:SetAttribute("Triggered", true)
					remotes.TrapFX:FireAllClients({ Kind = entry.Kind, Position = root.Position, Team = entry.Team })
					break
				end
			end
		end
	end
	for entry in pairs(destroyAfter) do
		removeEntry(entry)
	end
end

return FortressService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="16">
          <Properties>
            <string name="Name">GeodataService</string>
            <string name="Source"><![CDATA[-- Lightweight server geodata: static collision geometry + live fortress/trap obstacles.
-- PathfindingService remains the final navmesh solver; this map gives bots tactical obstacle context.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage:WaitForChild("BlockSiege"):WaitForChild("Config"))

local GeodataService = {}
local world
local fortressService
local state
local staticObstacles = {}
local obstacles = {}
local refreshClock = 0
local revision = 0

local ignoredNames = {
	ArenaDirt = true,
	ArenaGrass = true,
	CenterLane = true,
	SideLane = true,
	BlueBasePlatform = true,
	OrangeBasePlatform = true,
	BlueBaseGrass = true,
	OrangeBaseGrass = true,
	BlueSpawn = true,
	OrangeSpawn = true,
	ArenaBoundary = true,
}

local function addPart(list, part, source, team, kind)
	if not part or not part:IsA("BasePart") or part.CanCollide == false then
		return
	end
	table.insert(list, {
		Part = part,
		Position = part.Position,
		Size = part.Size,
		Source = source,
		Team = team,
		Kind = kind,
	})
end

local function collectStatic()
	staticObstacles = {}
	if not world or not world.Arena then
		return
	end
	for _, part in ipairs(world.Arena:GetDescendants()) do
		if part:IsA("BasePart") and not ignoredNames[part.Name] and not string.find(part.Name, "BasePlatform", 1, true) and not string.find(part.Name, "BaseGrass", 1, true) and not string.find(part.Name, "ExitStep", 1, true) then
			addPart(staticObstacles, part, "Static")
		end
	end
end

function GeodataService.Init(dependencies)
	world = dependencies.World
	fortressService = dependencies.FortressService
	state = dependencies.State
	collectStatic()
	GeodataService.Refresh()
end

function GeodataService.Refresh()
	obstacles = {}
	for _, obstacle in ipairs(staticObstacles) do
		table.insert(obstacles, obstacle)
	end
	if fortressService then
		for _, entry in ipairs(fortressService.GetEntries()) do
			for _, part in ipairs(entry.Parts) do
				addPart(obstacles, part, "Structure", entry.Team, entry.Kind)
			end
		end
	end
	revision = revision + 1
	if state then
		state:SetAttribute("GeodataObstacles", #obstacles)
		state:SetAttribute("GeodataRevision", revision)
	end
end

function GeodataService.Step(deltaTime)
	refreshClock = refreshClock + deltaTime
	if refreshClock >= 0.4 then
		refreshClock = 0
		GeodataService.Refresh()
	end
end

function GeodataService.GetObstacles()
	return obstacles
end

function GeodataService.GetObstacleCount()
	return #obstacles
end

function GeodataService.GetNearestObstacle(position, maximumDistance)
	local best
	local bestDistance = maximumDistance or math.huge
	for _, obstacle in ipairs(obstacles) do
		local radius = math.max(obstacle.Size.X, obstacle.Size.Z) * 0.5
		local distance = (obstacle.Position - position).Magnitude - radius
		if distance < bestDistance then
			best = obstacle
			bestDistance = distance
		end
	end
	return best, bestDistance
end

local function horizontal(vector)
	return Vector3.new(vector.X, 0, vector.Z)
end

-- Return a side waypoint when a registered obstacle intersects the direct route.
function GeodataService.GetAvoidancePoint(start, destination, side)
	local delta = horizontal(destination - start)
	local length = delta.Magnitude
	if length < 14 then
		return nil
	end
	local direction = delta.Unit
	local best
	local bestDistance = math.huge
	for _, obstacle in ipairs(obstacles) do
		local relative = horizontal(obstacle.Position - start)
		local projection = relative:Dot(direction)
		if projection > 4 and projection < length - 4 then
			local closest = start + direction * projection
			local lateral = horizontal(obstacle.Position - closest).Magnitude
			local radius = math.max(obstacle.Size.X, obstacle.Size.Z) * 0.5
			if lateral < radius + 4 and lateral < bestDistance and obstacle.Position.Y < start.Y + 14 then
				best = obstacle
				bestDistance = lateral
			end
		end
	end
	if not best then
		return nil
	end
	local radius = math.max(best.Size.X, best.Size.Z) * 0.5
	local sign = (side or 1) % 2 == 0 and 1 or -1
	local perpendicular = Vector3.new(-direction.Z, 0, direction.X) * sign
	local candidate = best.Position + perpendicular * (radius + 8)
	if math.abs(candidate.X) > Config.Arena.BotBoundsX or math.abs(candidate.Z) > Config.Arena.BotBoundsZ then
		candidate = best.Position - perpendicular * (radius + 8)
	end
	if math.abs(candidate.X) > Config.Arena.BotBoundsX or math.abs(candidate.Z) > Config.Arena.BotBoundsZ then
		return nil
	end
	return Vector3.new(candidate.X, destination.Y, candidate.Z)
end

return GeodataService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="17">
          <Properties>
            <string name="Name">MatchService</string>
            <string name="Source"><![CDATA[-- Очередь, команды 6x6, фазы Build/Battle/Results и возврат в лобби.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("BlockSiege")
local Config = require(Shared:WaitForChild("Config"))
local Catalog = require(Shared:WaitForChild("Catalog"))

local MatchService = {}
local world
local dataService
local fortressService
local weaponService
local botService
local progressionService
local captureService
local abilityService
local neutralService
local bonusService
local expeditionService
local remotes
local state
local phase = "Lobby"
local timer = 0
local intermission
local queued = {}
local participants = {}
local pendingSpawns = {}
local matchId = 0
local lastSecond = -1
local matchStats = {}
local regenClock = 0
local rewardMultiplierProvider = function() return 1 end

local function notify(player, text)
	if player and player.Parent then
		remotes.Notify:FireClient(player, text)
	end
end

local function queueCount()
	local count = 0
	for userId in pairs(queued) do
		if Players:GetPlayerByUserId(userId) then
			count = count + 1
		else
			queued[userId] = nil
		end
	end
	return count
end

local function participantCount()
	local count = 0
	for userId in pairs(participants) do
		if Players:GetPlayerByUserId(userId) then
			count = count + 1
		end
	end
	return count
end

local function updateCounts()
	local humans = { Blue = 0, Orange = 0 }
	for _, player in ipairs(Players:GetPlayers()) do
		local team = participants[player.UserId]
		if team then
			humans[team] = humans[team] + 1
		end
	end
	for _, team in ipairs(Config.TeamOrder) do
		state:SetAttribute(team .. "Humans", humans[team])
		state:SetAttribute(team .. "Bots", botService and botService.Count(team) or 0)
	end
	state:SetAttribute("QueueCount", queueCount())
end

local function updateClock(force)
	local second = math.max(0, math.ceil(timer))
	if force or second ~= lastSecond then
		lastSecond = second
		state:SetAttribute("Time", second)
	end
end

local function updateTacticalLights()
	local enabled = phase ~= "Build"
	for _, player in ipairs(Players:GetPlayers()) do
		local character = player.Character
		local root = character and character:FindFirstChild("HumanoidRootPart")
		local light = root and root:FindFirstChild("BlockSiegeTacticalLight")
		if light then
			light.Enabled = enabled
		end
	end
	if world and world.Bots then
		for _, model in ipairs(world.Bots:GetChildren()) do
			local root = model:FindFirstChild("HumanoidRootPart")
			local light = root and root:FindFirstChild("BlockSiegeTacticalLight")
			if light then
				light.Enabled = enabled
			end
		end
	end
end

local function setPhase(nextPhase, duration)
	phase = nextPhase
	timer = duration or 0
	state:SetAttribute("Phase", phase)
	updateClock(true)
	updateCounts()
	updateTacticalLights()
end

local function spawnPlayer(player, cframe)
	if player and player.Parent then
		pendingSpawns[player.UserId] = cframe
		player:LoadCharacter()
	end
end

local function teamSpawn(team)
	return world.TeamSpawns[team]
end

local function playerLevel(player)
	local data = dataService and dataService.Get(player)
	return data and Catalog.LevelForXP(data.XP) or tonumber(player:GetAttribute("Level")) or 1
end

local function statsFor(player)
	local stats = matchStats[player.UserId]
	if not stats then
		stats = { Builds = 0, Kills = 0, Structures = 0, Captures = 0, Coins = 0, XP = 0, LevelCoins = 0, Unlocks = {} }
		matchStats[player.UserId] = stats
	end
	return stats
end

local function publishStat(player, name, value)
	player:SetAttribute("Match" .. name, value)
end

local function recordProgress(player, progress)
	if not progress then
		return
	end
	local stats = statsFor(player)
	stats.LevelCoins = stats.LevelCoins + (progress.LevelCoins or 0)
	for _, unlock in ipairs(progress.Unlocks or {}) do
		table.insert(stats.Unlocks, unlock)
	end
end

local function currentRewardMultiplier()
	return math.clamp(tonumber(rewardMultiplierProvider()) or 1, 1, 2)
end

local function actionReward(player, coins, xp, reason)
	local multiplier = currentRewardMultiplier()
	local awardedCoins = math.floor((tonumber(coins) or 0) * multiplier + 0.5)
	local awardedXP = math.floor((tonumber(xp) or 0) * multiplier + 0.5)
	if multiplier > 1 then
		reason = tostring(reason or "Полезное действие") .. " · ×2 ИВЕНТ"
	end
	local stats = statsFor(player)
	stats.Coins = stats.Coins + awardedCoins
	stats.XP = stats.XP + awardedXP
	local progress = dataService.Award(player, awardedCoins, awardedXP, reason)
	recordProgress(player, progress)
	return progress
end

function MatchService.GetPhase()
	return phase
end

function MatchService.GetTeam(player)
	return participants[player.UserId]
end

function MatchService.IsParticipant(player)
	return participants[player.UserId] ~= nil
end

function MatchService.GetTargets(team)
	local enemy = Config.OtherTeam(team)
	local result = botService.GetModels(enemy)
	for _, player in ipairs(Players:GetPlayers()) do
		if participants[player.UserId] == enemy then
			local character = player.Character
			local humanoid = character and character:FindFirstChildOfClass("Humanoid")
			local root = character and character:FindFirstChild("HumanoidRootPart")
			if character and humanoid and humanoid.Health > 0 and root then
				table.insert(result, character)
			end
		end
	end
	return result
end

function MatchService.OnStructureDamage(player, amount, kind, destroyed)
	if phase ~= "Battle" or not MatchService.IsParticipant(player) then
		return
	end
	dataService.AddStructureDamage(player, amount)
	if destroyed and kind ~= "Core" then
		local rewards = {
			LaneTower = { 12, 30, "Башня линии уничтожена" },
			Tower = { 8, 20, "Вражеская башня уничтожена" },
			Wall = { 5, 12, "Проход в стене открыт" },
			Barricade = { 4, 10, "Баррикада уничтожена" },
			SpikeTrap = { 3, 8, "Ловушка обезврежена" },
			FrostMine = { 3, 8, "Мина обезврежена" },
		}
		local reward = rewards[kind] or { 3, 8, "Вражеское сооружение уничтожено" }
		local stats = statsFor(player)
		stats.Structures = stats.Structures + 1
		publishStat(player, "Structures", stats.Structures)
		actionReward(player, reward[1], reward[2], reward[3])
		if bonusService then
			bonusService.OnAction(player, "Structure")
		end
	end
end

function MatchService.OnKill(player, victim)
	if phase == "Battle" and MatchService.IsParticipant(player) then
		local multiplier = currentRewardMultiplier()
		local coins = math.floor(2 * multiplier + 0.5)
		local xp = math.floor(8 * multiplier + 0.5)
		local reason = multiplier > 1 and "Противник выведен из боя · ×2 ИВЕНТ" or "Противник выведен из боя"
		local progress = dataService.AddKill(player, coins, xp, reason)
		recordProgress(player, progress)
		local stats = statsFor(player)
		stats.Kills = stats.Kills + 1
		stats.Coins = stats.Coins + coins
		stats.XP = stats.XP + xp
		publishStat(player, "Kills", stats.Kills)
		if bonusService then
			bonusService.OnAction(player, "Kill")
		end
	end
end

function MatchService.OnActionReward(player, coins, xp, reason)
	if phase == "Battle" and MatchService.IsParticipant(player) then
		actionReward(player, coins, xp, reason)
	end
end

function MatchService.OnBonusReward(player, coins, xp, reason)
	if (phase == "Build" or phase == "Battle") and MatchService.IsParticipant(player) then
		actionReward(player, coins, xp, reason)
	end
end

function MatchService.OnCapture67(team)
	if phase ~= "Battle" or not Config.Teams[team] then
		return
	end
	for _, player in ipairs(Players:GetPlayers()) do
		if participants[player.UserId] == team then
			local stats = statsFor(player)
			stats.Captures = stats.Captures + 1
			publishStat(player, "Captures", stats.Captures)
			actionReward(player, 10, 25, "67 захвачена · команда получает +1 HP/s")
			if bonusService then
				bonusService.OnAction(player, "Capture")
			end
		end
	end
end

function MatchService.EndMatch(winner, reason)
	if phase ~= "Battle" then
		return
	end
	setPhase("Results", Config.ResultsDuration)
	-- Results should show the fortress, not live mines/projectiles or a frozen
	-- jungle encounter. The next match will draft fresh classes and camps.
	if abilityService then
		abilityService.Reset()
	end
	if neutralService then
		neutralService.Reset()
	end
	if expeditionService then
		expeditionService.Reset()
	end
	if bonusService then
		bonusService.EndMatch()
	end
	state:SetAttribute("Winner", winner or "")
	state:SetAttribute("Reason", reason or "Ядро уничтожено")
	for _, player in ipairs(Players:GetPlayers()) do
		local team = participants[player.UserId]
		if team then
			local draw = not winner or winner == ""
			local reward = dataService.RecordMatch(player, team == winner, draw)
			local stats = statsFor(player)
			remotes.Results:FireClient(player, {
				Winner = winner or "",
				Team = team,
				Reason = reason or "",
				Reward = reward,
				Stats = {
					Builds = stats.Builds,
					Kills = stats.Kills,
					Structures = stats.Structures,
					Captures = stats.Captures,
					Coins = stats.Coins,
					XP = stats.XP,
					LevelCoins = stats.LevelCoins,
					Unlocks = stats.Unlocks,
				},
			})
		end
	end
	updateCounts()
end

function MatchService.OnCoreDestroyed(losingTeam, attackingTeam)
	if Config.Teams[losingTeam] and Config.Teams[attackingTeam] and losingTeam ~= attackingTeam then
		MatchService.EndMatch(attackingTeam, "Ядро крепости " .. Config.Teams[losingTeam].Name .. " уничтожено")
	end
end

function MatchService.StartMatch()
	if phase ~= "Lobby" then
		return false
	end
	local players = {}
	for _, player in ipairs(Players:GetPlayers()) do
		if queued[player.UserId] then
			table.insert(players, player)
		end
	end
	if #players == 0 then
		return false
	end
	-- Snake/level-aware draft: high levels are distributed by total team power, not join order.
	table.sort(players, function(a, b)
		local levelA = playerLevel(a)
		local levelB = playerLevel(b)
		if levelA == levelB then
			return a.UserId < b.UserId
		end
		return levelA > levelB
	end)
	for index = #players, Config.TeamSize * 2 + 1, -1 do
		local overflow = table.remove(players, index)
		queued[overflow.UserId] = nil
		overflow:SetAttribute("Queued", false)
		notify(overflow, "Матч 6×6 уже заполнен · попробуйте следующий")
	end
	matchId = matchId + 1
	participants = {}
	matchStats = {}
	regenClock = 0
	local counts = { Blue = 0, Orange = 0 }
	local power = { Blue = 0, Orange = 0 }
	for _, player in ipairs(players) do
		local team
		if counts.Blue >= Config.TeamSize then
			team = "Orange"
		elseif counts.Orange >= Config.TeamSize then
			team = "Blue"
		elseif power.Blue == power.Orange then
			team = counts.Blue <= counts.Orange and "Blue" or "Orange"
		else
			team = power.Blue < power.Orange and "Blue" or "Orange"
		end
		local level = playerLevel(player)
		participants[player.UserId] = team
		counts[team] = counts[team] + 1
		power[team] = power[team] + level
		queued[player.UserId] = nil
		player:SetAttribute("Queued", false)
		player:SetAttribute("Team", team)
		player:SetAttribute("MatchLevel", level)
		player:SetAttribute("InMatch", true)
		statsFor(player)
		for _, name in ipairs({ "Builds", "Kills", "Structures", "Captures" }) do
			publishStat(player, name, 0)
		end
	end
	if abilityService then
		abilityService.StartMatch(matchId, participants)
	end
	if bonusService then
		bonusService.StartMatch(matchId, participants)
	end
	for _, player in ipairs(players) do
		local stats = progressionService and progressionService.GetStats(player) or nil
		local capacity = (stats and stats.BuildCapacity or Config.Arena.MaxBuildPerPlayer) + (abilityService and abilityService.GetBuildBonus(player) or 0)
		player:SetAttribute("BuildLimit", capacity)
		player:SetAttribute("BuildUsed", 0)
		player:SetAttribute("BuildRemaining", capacity)
	end
	state:SetAttribute("BluePower", power.Blue)
	state:SetAttribute("OrangePower", power.Orange)
	state:SetAttribute("MatchLevelDraft", true)
	intermission = nil
	if captureService then
		captureService.Reset()
	end
	fortressService.Reset()
	if neutralService then
		neutralService.StartMatch()
	end
	setPhase("Build", Config.BuildDuration)
	for _, player in ipairs(players) do
		spawnPlayer(player, teamSpawn(participants[player.UserId]))
		notify(player, "СТРОИТЕЛЬСТВО · укрепите свою крепость")
	end
	botService.Start(matchId, participants)
	updateCounts()
	return true
end

function MatchService.HandleLobbyAction(player, action)
	if phase ~= "Lobby" then
		notify(player, "Матч уже идёт · дождитесь возврата в лобби")
		return false
	end
	if not player:GetAttribute("ProfileLoaded") then
		notify(player, "Профиль загружается · секунду...")
		return false
	end
	if action == "QuickStart" then
		queued[player.UserId] = true
		player:SetAttribute("Queued", true)
		return MatchService.StartMatch()
	elseif action == "Queue" then
		if queued[player.UserId] then
			queued[player.UserId] = nil
			player:SetAttribute("Queued", false)
		else
			queued[player.UserId] = true
			player:SetAttribute("Queued", true)
			if not intermission then
				intermission = Config.IntermissionDuration
			end
		end
		if queueCount() == 0 then
			intermission = nil
			state:SetAttribute("Time", 0)
		else
			timer = intermission
			updateClock(true)
		end
		updateCounts()
		return true
	end
	return false
end

function MatchService.HandleBuild(player, kind, position, rotation)
	local team = participants[player.UserId]
	if phase ~= "Build" or not team then
		notify(player, "Строить можно только во время подготовки")
		return false
	end
	local success, reason = fortressService.BuildPlayer(player, team, kind, position, rotation)
	if not success then
		notify(player, reason)
		return false, reason
	end
	local stats = statsFor(player)
	stats.Builds = stats.Builds + 1
	publishStat(player, "Builds", stats.Builds)
	if stats.Builds == 1 then
		actionReward(player, 5, 15, "Первая постройка · крепость растёт")
	elseif stats.Builds == 3 then
		actionReward(player, 6, 14, "3 укрепления · базовая защита готова")
	else
		actionReward(player, 1, 4, "Укрепление установлено")
	end
	if bonusService then
		bonusService.OnAction(player, "Build")
	end
	return true, reason
end

function MatchService.HandleBuildPreview(player, kind, position, rotation, requestId)
	local team = participants[player.UserId]
	local cframe, reason = fortressService.GetPlayerPlacement(player, team, kind, position, rotation)
	local valid = cframe ~= nil
	remotes.BuildPreview:FireClient(player, {
		Kind = kind,
		RequestId = type(requestId) == "number" and requestId or nil,
		Rotation = fortressService.GetRotationDegrees(rotation),
		Valid = valid,
		Reason = reason or "Можно строить",
		Position = cframe and cframe.Position or position,
		CFrame = cframe,
		Team = team,
	})
	return valid, reason
end

local function onCharacter(player, character)
	local humanoid = character:WaitForChild("Humanoid")
	humanoid.JumpPower = 50
	if progressionService then
		progressionService.ApplyCharacter(player, character)
	else
		humanoid.WalkSpeed = 20
		humanoid.MaxHealth = 120
		humanoid.Health = 120
	end
	local team = participants[player.UserId]
	character:SetAttribute("Team", team or "")
	local root = character:WaitForChild("HumanoidRootPart")
	local oldLight = root:FindFirstChild("BlockSiegeTacticalLight")
	if oldLight then
		oldLight:Destroy()
	end
	local tacticalLight = Instance.new("SpotLight")
	tacticalLight.Name = "BlockSiegeTacticalLight"
	tacticalLight.Color = Color3.fromRGB(185, 220, 255)
	tacticalLight.Face = Enum.NormalId.Front
	tacticalLight.Angle = 68
	tacticalLight.Range = 34
	tacticalLight.Brightness = 1.15
	tacticalLight.Shadows = false
	tacticalLight.Enabled = phase ~= "Build"
	tacticalLight.Parent = root
	if abilityService then
		abilityService.ApplyCharacter(player, character)
	end
	weaponService.EquipPlayer(player)
	local spawn = pendingSpawns[player.UserId] or world.LobbySpawn
	task.defer(function()
		if character.Parent then
			character:PivotTo(spawn)
			-- Re-equip after the avatar finishes loading so R15 hands and the server
			-- weapon weld cannot be lost during character assembly or respawn.
			if player.Character == character then
				weaponService.EquipPlayer(player)
			end
		end
	end)
	local deathMatch = matchId
	humanoid.Died:Connect(function()
		local lastDamage = tonumber(character:GetAttribute("LastDamageClock")) or -math.huge
		local recentDamage = os.clock() - lastDamage <= 10
		local killerId = recentDamage and character:GetAttribute("LastAttackerUserId") or nil
		local killer = killerId and Players:GetPlayerByUserId(killerId) or nil
		if remotes.DeathFX then
			remotes.DeathFX:FireAllClients({
				VictimUserId = player.UserId,
				VictimName = player.DisplayName,
				KillerUserId = killerId,
				KillerName = recentDamage and (killer and killer.DisplayName or character:GetAttribute("LastAttackerName") or "") or "",
				Source = recentDamage and (character:GetAttribute("LastDamageSource") or "Unknown") or "Unknown",
				RespawnDuration = Config.RespawnDuration,
				InExpedition = player:GetAttribute("InExpedition") == true,
			})
		end
		if participants[player.UserId] and (phase == "Build" or phase == "Battle") then
			task.delay(Config.RespawnDuration, function()
				local currentTeam = participants[player.UserId]
				if currentTeam and matchId == deathMatch and (phase == "Build" or phase == "Battle") and player.Parent then
					spawnPlayer(player, teamSpawn(currentTeam))
				end
			end)
		end
	end)
end

function MatchService.OnPlayerAdded(player)
	player:SetAttribute("Queued", false)
	player:SetAttribute("Team", "")
	player:SetAttribute("InMatch", false)
	player:SetAttribute("ProfileLoaded", false)
	player:SetAttribute("BuildLimit", 0)
	player:SetAttribute("BuildUsed", 0)
	player:SetAttribute("BuildRemaining", 0)
	for _, name in ipairs({ "Builds", "Kills", "Structures", "Captures" }) do
		publishStat(player, name, 0)
	end
	player.CharacterAdded:Connect(function(character)
		onCharacter(player, character)
	end)
	spawnPlayer(player, world.LobbySpawn)
end

function MatchService.OnProfileLoaded(player)
	if player.Character then
		if progressionService then
			progressionService.ApplyCharacter(player, player.Character, player:GetAttribute("InMatch") == true)
		end
		if abilityService then
			abilityService.ApplyCharacter(player, player.Character)
		end
		weaponService.EquipPlayer(player)
	end
end

local function resetToLobby()
	botService.Stop()
	if abilityService then
		abilityService.Reset()
	end
	if neutralService then
		neutralService.Reset()
	end
	if expeditionService then
		expeditionService.Reset()
	end
	if bonusService then
		bonusService.Reset()
	end
	fortressService.Clear()
	if captureService then
		captureService.Reset()
	end
	participants = {}
	matchStats = {}
	queued = {}
	intermission = nil
	regenClock = 0
	for _, player in ipairs(Players:GetPlayers()) do
		player:SetAttribute("Team", "")
		player:SetAttribute("Queued", false)
		player:SetAttribute("InMatch", false)
		player:SetAttribute("BuildLimit", 0)
		player:SetAttribute("BuildUsed", 0)
		player:SetAttribute("BuildRemaining", 0)
		for _, name in ipairs({ "Builds", "Kills", "Structures", "Captures" }) do
			publishStat(player, name, 0)
		end
		spawnPlayer(player, world.LobbySpawn)
	end
	state:SetAttribute("Winner", "")
	state:SetAttribute("Reason", "")
	state:SetAttribute("BluePower", 0)
	state:SetAttribute("OrangePower", 0)
	state:SetAttribute("MatchLevelDraft", false)
	setPhase("Lobby", 0)
end

function MatchService.OnPlayerRemoving(player)
	local userId = player.UserId
	if weaponService and weaponService.OnPlayerRemoving then
		weaponService.OnPlayerRemoving(player)
	end
	queued[userId] = nil
	pendingSpawns[userId] = nil
	matchStats[userId] = nil
	local team = participants[userId]
	if abilityService then
		abilityService.OnPlayerRemoving(player)
	end
	if bonusService then
		bonusService.OnPlayerRemoving(player)
	end
	if team then
		participants[userId] = nil
		if participantCount() == 0 then
			matchId = matchId + 1
			resetToLobby()
			return
		elseif phase == "Build" or phase == "Battle" then
			botService.AddBot(team)
		end
	end
	updateCounts()
end

function MatchService.Init(dependencies)
	world = dependencies.World
	dataService = dependencies.DataService
	fortressService = dependencies.FortressService
	weaponService = dependencies.WeaponService
	botService = dependencies.BotService
	progressionService = dependencies.ProgressionService
	captureService = dependencies.CaptureService
	abilityService = dependencies.AbilityService
	neutralService = dependencies.NeutralService
	bonusService = dependencies.BonusService
	expeditionService = dependencies.ExpeditionService
	if dependencies.EventService then
		rewardMultiplierProvider = dependencies.EventService.GetRewardMultiplier
	end
	remotes = dependencies.Remotes
	state = dependencies.State
	fortressService.SetPhaseProvider(MatchService.GetPhase)
	fortressService.SetCoreHandler(MatchService.OnCoreDestroyed)
	fortressService.SetDamageHandler(MatchService.OnStructureDamage)
	fortressService.SetBuildCapacityProvider(function(player)
		local stats = progressionService and progressionService.GetStats(player)
		local baseCapacity = stats and stats.BuildCapacity or Config.Arena.MaxBuildPerPlayer
		return baseCapacity + (abilityService and abilityService.GetBuildBonus(player) or 0)
	end)
	fortressService.SetBuildAccessProvider(function(player, kind)
		return not progressionService or progressionService.CanBuildDefense(player, kind)
	end)
	fortressService.SetTargetsProvider(MatchService.GetTargets)
	weaponService.SetProviders(MatchService.GetPhase, MatchService.GetTeam, MatchService.OnKill)
	botService.SetProviders(MatchService.GetPhase, MatchService.GetTargets)
	if abilityService then
		abilityService.SetProviders(MatchService.GetPhase, MatchService.GetTeam, MatchService.GetTargets)
		abilityService.SetRewardHandler(MatchService.OnActionReward)
	end
	if neutralService then
		neutralService.SetPhaseProvider(MatchService.GetPhase)
		neutralService.SetRewardHandler(MatchService.OnActionReward)
	end
	if captureService then
		captureService.SetPhaseProvider(MatchService.GetPhase)
		captureService.SetCaptureHandler(MatchService.OnCapture67)
	end
	state:SetAttribute("Phase", "Lobby")
	state:SetAttribute("Time", 0)
	state:SetAttribute("Winner", "")
	state:SetAttribute("Reason", "")
	state:SetAttribute("BluePower", 0)
	state:SetAttribute("OrangePower", 0)
	state:SetAttribute("MatchLevelDraft", false)
	for _, team in ipairs(Config.TeamOrder) do
		state:SetAttribute(team .. "Core", 0)
		state:SetAttribute(team .. "CoreMax", Config.Arena.CoreHealth)
	end
	updateCounts()
end

function MatchService.Step(deltaTime)
	if bonusService then
		bonusService.Step(deltaTime)
	end
	if phase == "Lobby" then
		if intermission then
			if queueCount() == 0 then
				intermission = nil
				setPhase("Lobby", 0)
				return
			end
			intermission = math.max(0, intermission - deltaTime)
			timer = intermission
			updateClock()
			if intermission <= 0 then
				MatchService.StartMatch()
			end
		end
		return
	end
	if phase == "Battle" then
		regenClock = regenClock + deltaTime
		local ticks = math.floor(regenClock)
		if ticks > 0 then
			regenClock = regenClock - ticks
			local owner = captureService and captureService.GetOwner() or nil
			if owner then
				local function heal(model)
					local humanoid = model and model:FindFirstChildOfClass("Humanoid") or nil
					if humanoid and humanoid.Health > 0 then
						humanoid.Health = math.min(humanoid.MaxHealth, humanoid.Health + ticks)
					end
				end
				for _, player in ipairs(Players:GetPlayers()) do
					if participants[player.UserId] == owner then
						heal(player.Character)
					end
				end
				if botService then
					for _, model in ipairs(botService.GetModels(owner)) do
						heal(model)
					end
				end
			end
		end
	end
	timer = math.max(0, timer - deltaTime)
	updateClock()
	if timer > 0 then
		return
	end
	if phase == "Build" then
		setPhase("Battle", Config.BattleDuration)
		for _, player in ipairs(Players:GetPlayers()) do
			if participants[player.UserId] then
				-- Reassert the selected weapon and skin at the combat boundary.
				weaponService.EquipPlayer(player)
				notify(player, "ШТУРМ · уничтожьте вражеское ядро")
			end
		end
	elseif phase == "Battle" then
		local blue = fortressService.GetCoreHealth("Blue")
		local orange = fortressService.GetCoreHealth("Orange")
		if blue == orange then
			MatchService.EndMatch("", "Время вышло · ничья")
		else
			local winner = blue > orange and "Blue" or "Orange"
			MatchService.EndMatch(winner, "Время вышло · сохранено больше здоровья ядра")
		end
	elseif phase == "Results" then
		resetToLobby()
	end
end

return MatchService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="18">
          <Properties>
            <string name="Name">ProgressionService</string>
            <string name="Source"><![CDATA[-- Persistent character progression, lobby upgrades, daily rewards and cosmetic loadout.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("BlockSiege")
local Config = require(Shared:WaitForChild("Config"))
local Catalog = require(Shared:WaitForChild("Catalog"))

local ProgressionService = {}
local DataService
local weaponService
local remotes

local function notify(player, text, color)
	if remotes and player.Parent then
		remotes.Notify:FireClient(player, text, color)
	end
end

local function getLevel(data)
	return data and Catalog.LevelForXP(data.XP) or 1
end

function ProgressionService.Init(dependencies)
	DataService = dependencies.DataService
	weaponService = dependencies.WeaponService
	remotes = dependencies.Remotes
end

function ProgressionService.GetStats(player)
	local data = DataService and DataService.Get(player)
	local upgrades = data and data.Upgrades or {}
	local speed = upgrades.Speed or 0
	local health = upgrades.Health or 0
	local armor = upgrades.Armor or 0
	local engineering = upgrades.Engineering or 0
	return {
		Level = getLevel(data),
		Speed = 20 + speed,
		MaxHealth = 120 + health * 15,
		Armor = armor * 0.04,
		BuildCapacity = Config.Arena.MaxBuildPerPlayer + engineering * 2,
		SpeedLevel = speed,
		HealthLevel = health,
		ArmorLevel = armor,
		EngineeringLevel = engineering,
	}
end

local function removeNamed(parent, name)
	local child = parent and parent:FindFirstChild(name)
	if child then
		child:Destroy()
	end
end

function ProgressionService.ClearEffects(character)
	if not character then
		return
	end
	removeNamed(character, "BLOCKSIEGE_Aura")
	removeNamed(character, "BLOCKSIEGE_Trail")
	removeNamed(character, "BLOCKSIEGE_TrailAttachment0")
	removeNamed(character, "BLOCKSIEGE_TrailAttachment1")
	local root = character:FindFirstChild("HumanoidRootPart")
	if root then
		removeNamed(root, "BLOCKSIEGE_Aura")
		removeNamed(root, "BLOCKSIEGE_AuraLight")
		removeNamed(root, "BLOCKSIEGE_Trail")
		removeNamed(root, "BLOCKSIEGE_TrailAttachment0")
		removeNamed(root, "BLOCKSIEGE_TrailAttachment1")
	end
	local head = character:FindFirstChild("Head")
	if head then
		removeNamed(head, "BLOCKSIEGE_TrailAttachment0")
		removeNamed(head, "BLOCKSIEGE_TrailAttachment1")
	end
end

local function applyCosmetics(player, character)
	ProgressionService.ClearEffects(character)
	local data = DataService and DataService.Get(player)
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not data or not root then
		return
	end
	local selected = data.SelectedCosmetics or {}
	if selected.Aura and selected.Aura ~= "Default" and data.OwnedCosmetics[selected.Aura] then
		local phoenix = selected.Aura == "PhoenixAura"
		local aura = Instance.new("ParticleEmitter")
		aura.Name = "BLOCKSIEGE_Aura"
		aura.Rate = phoenix and 18 or 12
		aura.Lifetime = NumberRange.new(0.45, 0.9)
		aura.Speed = NumberRange.new(0.4, 1.2)
		aura.Size = NumberSequence.new(0.22, 0)
		aura.Color = phoenix and ColorSequence.new(Color3.fromRGB(255, 139, 67), Color3.fromRGB(255, 100, 180)) or ColorSequence.new(Color3.fromRGB(102, 220, 255), Color3.fromRGB(177, 82, 255))
		aura.LightEmission = 0.8
		aura.Texture = "rbxasset://textures/particles/sparkles_main.dds"
		aura.Parent = root
		local light = Instance.new("PointLight")
		light.Name = "BLOCKSIEGE_AuraLight"
		light.Color = phoenix and Color3.fromRGB(255, 128, 93) or Color3.fromRGB(133, 104, 255)
		light.Range = phoenix and 10 or 8
		light.Brightness = phoenix and 1.8 or 1.5
		light.Parent = root
	end
	if selected.Trail and selected.Trail ~= "Default" and data.OwnedCosmetics[selected.Trail] then
		local head = character:FindFirstChild("Head") or root
		local attachment0 = Instance.new("Attachment")
		attachment0.Name = "BLOCKSIEGE_TrailAttachment0"
		attachment0.Parent = root
		local attachment1 = Instance.new("Attachment")
		attachment1.Name = "BLOCKSIEGE_TrailAttachment1"
		attachment1.Position = Vector3.new(0, 1.5, 0)
		attachment1.Parent = head
		local trail = Instance.new("Trail")
		trail.Name = "BLOCKSIEGE_Trail"
		trail.Attachment0 = attachment0
		trail.Attachment1 = attachment1
		trail.Lifetime = 0.35
		trail.WidthScale = NumberSequence.new(0.55, 0)
		trail.Color = ColorSequence.new(Color3.fromRGB(255, 213, 82), Color3.fromRGB(255, 135, 45))
		trail.LightEmission = 0.65
		trail.Parent = root
	end
end

function ProgressionService.ApplyCharacter(player, character, preserveHealth)
	if not character then
		return
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not humanoid then
		return
	end
	local stats = ProgressionService.GetStats(player)
	local previousHealth = humanoid.Health
	humanoid.WalkSpeed = stats.Speed
	humanoid.MaxHealth = stats.MaxHealth
	humanoid.Health = preserveHealth and math.min(previousHealth, stats.MaxHealth) or stats.MaxHealth
	character:SetAttribute("Level", stats.Level)
	character:SetAttribute("MaxHP", stats.MaxHealth)
	character:SetAttribute("Armor", stats.Armor)
	character:SetAttribute("BuildCapacity", stats.BuildCapacity)
	player:SetAttribute("BuildCapacity", stats.BuildCapacity)
	player:SetAttribute("MaxHP", stats.MaxHealth)
	player:SetAttribute("Armor", stats.Armor)
	character:SetAttribute("SpeedBonus", stats.Speed - 20)
	applyCosmetics(player, character)
end

function ProgressionService.Refresh(player)
	if player.Character then
		ProgressionService.ApplyCharacter(player, player.Character, true)
	end
	if weaponService and player.Character then
		weaponService.EquipPlayer(player)
	end
	if DataService then
		DataService.Commit(player)
	end
end

function ProgressionService.Upgrade(player, id)
	local data = DataService and DataService.Get(player)
	local definition = Catalog.GetUpgrade(id)
	if not data or not definition then
		return false
	end
	if player:GetAttribute("InMatch") == true then
		notify(player, "Улучшения доступны в лобби", Color3.fromRGB(255, 180, 90))
		return false
	end
	local current = data.Upgrades[id] or 0
	if current >= definition.MaxLevel then
		notify(player, "Этот навык уже на максимуме", Color3.fromRGB(130, 220, 255))
		return false
	end
	local nextLevel = current + 1
	local requiredLevel = definition.RequiredLevels[nextLevel] or 1
	if getLevel(data) < requiredLevel then
		notify(player, "Нужен уровень " .. requiredLevel, Color3.fromRGB(255, 180, 90))
		return false
	end
	local cost = definition.Costs[nextLevel]
	if data.Coins < cost then
		notify(player, "Недостаточно монет: нужно " .. cost, Color3.fromRGB(255, 110, 100))
		return false
	end
	data.Coins = data.Coins - cost
	data.Upgrades[id] = nextLevel
	DataService.Commit(player, true)
	ProgressionService.Refresh(player)
	notify(player, definition.Name .. " · уровень " .. nextLevel, Color3.fromRGB(120, 255, 180))
	return true
end

function ProgressionService.ClaimDaily(player)
	local data = DataService and DataService.Get(player)
	if not data then
		return false
	end
	local now = os.time()
	local elapsed = now - (data.LastDailyClaim or 0)
	if elapsed < Config.DailyCooldown then
		local minutes = math.ceil((Config.DailyCooldown - elapsed) / 60)
		notify(player, "Ежедневный бонус через " .. minutes .. " мин", Color3.fromRGB(255, 190, 100))
		return false
	end
	local level = getLevel(data)
	local coins = 50 + level * 5
	data.Coins = data.Coins + coins
	data.CaseTokens = data.CaseTokens + 1
	DataService.AddXP(player, 20)
	data.LastDailyClaim = now
	DataService.Commit(player, true)
	notify(player, "Ежедневный бонус: +" .. coins .. " монет, +20 XP и жетон кейса", Color3.fromRGB(120, 255, 190))
	return true, { Coins = coins, XP = 20, CaseTokens = 1 }
end

function ProgressionService.CanBuildDefense(player, kind)
	local definition = Catalog.GetDefense(kind)
	if not definition then
		return true
	end
	local data = DataService and DataService.Get(player)
	return data ~= nil and data.OwnedDefenses[kind] == true
end

function ProgressionService.BuyDefense(player, id)
	local data = DataService and DataService.Get(player)
	local definition = Catalog.GetDefense(id)
	if not data or not definition then
		return false
	end
	if player:GetAttribute("InMatch") == true then
		notify(player, "Чертежи покупаются в лобби", Color3.fromRGB(255, 180, 90))
		return false
	end
	if data.OwnedDefenses[id] then
		notify(player, "Чертёж уже куплен", Color3.fromRGB(130, 220, 255))
		return false
	end
	if getLevel(data) < definition.RequiredLevel then
		notify(player, "Нужен уровень " .. definition.RequiredLevel, Color3.fromRGB(255, 180, 90))
		return false
	end
	if data.Coins < definition.Price then
		notify(player, "Недостаточно монет: нужно " .. definition.Price, Color3.fromRGB(255, 110, 100))
		return false
	end
	data.Coins = data.Coins - definition.Price
	data.OwnedDefenses[id] = true
	DataService.Commit(player, true)
	notify(player, "Чертёж куплен: " .. definition.Name, Color3.fromRGB(120, 255, 180))
	return true
end

function ProgressionService.EquipCosmetic(player, id)
	local data = DataService and DataService.Get(player)
	local cosmetic = Catalog.GetCosmetic(id)
	if not data or not cosmetic or not data.OwnedCosmetics[id] then
		return false
	end
	data.SelectedCosmetics[cosmetic.Slot] = id
	DataService.Commit(player, true)
	ProgressionService.Refresh(player)
	notify(player, "Экипировано: " .. cosmetic.Name, Color3.fromRGB(190, 150, 255))
	return true
end

function ProgressionService.HandleAction(player, action, value)
	if action == "Upgrade" then
		return ProgressionService.Upgrade(player, value)
	elseif action == "Daily" then
		return ProgressionService.ClaimDaily(player)
	elseif action == "BuyDefense" then
		return ProgressionService.BuyDefense(player, value)
	elseif action == "EquipCosmetic" then
		return ProgressionService.EquipCosmetic(player, value)
	elseif action == "Refresh" then
		ProgressionService.Refresh(player)
		return true
	end
	return false
end

return ProgressionService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="19">
          <Properties>
            <string name="Name">ShopService</string>
            <string name="Source"><![CDATA[-- Cosmetic-only Robux shop. Game Pass IDs are deliberately zero until configured by the owner.
local MarketplaceService = game:GetService("MarketplaceService")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("BlockSiege")
local Config = require(Shared:WaitForChild("Config"))
local Catalog = require(Shared:WaitForChild("Catalog"))

local ShopService = {}
local DataService
local ProgressionService
local remotes
local promptConnected = false

local function notify(player, text, color)
	if remotes and player.Parent then
		remotes.Notify:FireClient(player, text, color)
	end
end

local function grant(player, id)
	local data = DataService and DataService.Get(player)
	local cosmetic = Catalog.GetCosmetic(id)
	if not data or not cosmetic then
		return false
	end
	if not data.OwnedCosmetics[id] then
		data.OwnedCosmetics[id] = true
		data.SelectedCosmetics[cosmetic.Slot] = id
		DataService.Commit(player, true)
		ProgressionService.Refresh(player)
	end
	notify(player, "Получено: " .. cosmetic.Name, Color3.fromRGB(255, 215, 110))
	return true
end

function ShopService.GrantForTesting(player, id)
	if not RunService:IsStudio() or not Config.EnableStudioTestPurchases then
		return false
	end
	return grant(player, id)
end

function ShopService.Init(dependencies)
	DataService = dependencies.DataService
	ProgressionService = dependencies.ProgressionService
	remotes = dependencies.Remotes
	if not promptConnected then
		promptConnected = true
		MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, gamePassId, purchased)
			if not purchased then
				return
			end
			for _, id in ipairs(Catalog.CosmeticOrder) do
				local cosmetic = Catalog.Cosmetics[id]
				if cosmetic.GamePassId ~= 0 and cosmetic.GamePassId == gamePassId then
					grant(player, id)
					break
				end
			end
		end)
	end
end

function ShopService.Buy(player, id)
	local cosmetic = Catalog.GetCosmetic(id)
	local data = DataService and DataService.Get(player)
	if not cosmetic or not data then
		return false
	end
	if data.OwnedCosmetics[id] then
		return ProgressionService.EquipCosmetic(player, id)
	end
	if cosmetic.GamePassId == 0 then
		if RunService:IsStudio() and Config.EnableStudioTestPurchases then
			notify(player, "Studio TEST: выдача без Robux", Color3.fromRGB(255, 210, 100))
			return grant(player, id)
		end
		notify(player, "Game Pass ещё не настроен владельцем игры", Color3.fromRGB(255, 170, 100))
		return false
	end
	local owns = false
	local ok, result = pcall(function()
		return MarketplaceService:UserOwnsGamePassAsync(player.UserId, cosmetic.GamePassId)
	end)
	if ok then
		owns = result == true
	end
	if owns then
		return grant(player, id)
	end
	local prompted, promptError = pcall(function()
		MarketplaceService:PromptGamePassPurchase(player, cosmetic.GamePassId)
	end)
	if not prompted then
		notify(player, "Покупка недоступна: " .. tostring(promptError), Color3.fromRGB(255, 120, 110))
		return false
	end
	notify(player, "Открыто окно покупки " .. cosmetic.Name, Color3.fromRGB(255, 215, 110))
	return true
end

function ShopService.HandleAction(player, action, value)
	if action == "BuyCosmetic" then
		return ShopService.Buy(player, value)
	elseif action == "TestPurchase" then
		return ShopService.GrantForTesting(player, value)
	end
	return false
end

return ShopService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="20">
          <Properties>
            <string name="Name">WeaponService</string>
            <string name="Source"><![CDATA[-- Server-authoritative hitscan, magazines/reload, visible weapon models and
-- non-lethal friendly-fire filtering. Ability damage uses the same mitigation.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")
local Shared = ReplicatedStorage:WaitForChild("BlockSiege")
local Catalog = require(Shared:WaitForChild("Catalog"))
local WeaponModels = require(Shared:WaitForChild("WeaponModels"))

local vector3Type = typeof(Vector3.new())
local WeaponService = {}
local dataService
local fortressService
local remotes
local phaseProvider = function() return "Lobby" end
local teamProvider = function() return nil end
local killHandler
local lastShot = {}
local damageCredits = {}
local watched = {}
local ammo = {}
local reloads = {}
local random = Random.new()

local function validPosition(position)
	return typeof(position) == vector3Type and position.X == position.X and position.Y == position.Y and position.Z == position.Z
		and math.abs(position.X) < 10000 and math.abs(position.Y) < 10000 and math.abs(position.Z) < 10000
end

local function validTeam(team)
	return team == "Blue" or team == "Orange"
end

local function magazineFor(weapon)
	if weapon.Melee then
		return 0
	end
	local magazines = { Carbine = 24, SMG = 30, Scatter = 6, Marksman = 8, Demolisher = 12, Rail = 5, Vortex = 18, ThanosGauntlet = 3, PrismLance = 10, TeslaCarbine = 24 }
	return magazines[weapon.Id] or 20
end

local function reloadDurationFor(weapon)
	if weapon.Id == "Rail" or weapon.Id == "ThanosGauntlet" then
		return 2.4
	end
	if weapon.Id == "Scatter" then
		return 2.1
	end
	return 1.65
end

local function watchHumanoid(character, humanoid)
	if watched[humanoid] then
		return
	end
	watched[humanoid] = true
	humanoid.Died:Connect(function()
		local credit = damageCredits[humanoid]
		damageCredits[humanoid] = nil
		watched[humanoid] = nil
		if credit and credit.Player and os.clock() - credit.Clock <= 10 and killHandler and character:GetAttribute("IsExpeditionEnemy") ~= true then
			killHandler(credit.Player, character)
		end
	end)
end

local function syncPlayerWeapon(player, weapon)
	local character = player and player.Character
	local clip = player and ammo[player.UserId]
	if not character or not clip or not weapon then
		return
	end
	character:SetAttribute("Ammo", clip.Rounds)
	character:SetAttribute("Magazine", magazineFor(weapon))
	character:SetAttribute("Reloading", reloads[player.UserId] ~= nil)
	local reload = reloads[player.UserId]
	character:SetAttribute("ReloadDuration", reload and reload.Duration or reloadDurationFor(weapon))
end

local function sendWeaponAction(player, action, weapon, duration)
	if remotes and remotes.WeaponAction and player and player.Parent then
		remotes.WeaponAction:FireClient(player, { Action = action, WeaponId = weapon and weapon.Id or "", Duration = duration or 0 })
	end
end

local function startReload(player, weapon)
	if not player or not weapon or weapon.Melee or phaseProvider() ~= "Battle" then
		return false
	end
	local userId = player.UserId
	local clip = ammo[userId]
	local magazine = magazineFor(weapon)
	if not clip or clip.WeaponId ~= weapon.Id then
		clip = { WeaponId = weapon.Id, Rounds = magazine }
		ammo[userId] = clip
	end
	if reloads[userId] or clip.Rounds >= magazine then
		return false
	end
	local duration = reloadDurationFor(weapon)
	reloads[userId] = { EndsAt = os.clock() + duration, Duration = duration, WeaponId = weapon.Id }
	syncPlayerWeapon(player, weapon)
	sendWeaponAction(player, "ReloadStart", weapon, duration)
	return true
end

function WeaponService.Init(dependencies)
	dataService = dependencies.DataService
	fortressService = dependencies.FortressService
	remotes = dependencies.Remotes
end

function WeaponService.SetProviders(phase, team, onKill)
	phaseProvider = phase
	teamProvider = team
	killHandler = onKill
end

function WeaponService.GetPlayerWeapon(player)
	local data = dataService.Get(player)
	local selected = data and data.SelectedWeapon or "Carbine"
	if data and not data.OwnedWeapons[selected] then
		selected = "Carbine"
	end
	return Catalog.GetWeapon(selected) or Catalog.Weapons.Carbine
end

function WeaponService.EquipCharacter(character, weaponId, skinId)
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		watchHumanoid(character, humanoid)
	end
	return WeaponModels.Equip(character, weaponId, skinId)
end

function WeaponService.EquipPlayer(player)
	local character = player.Character
	if not character then
		return nil
	end
	local weapon = WeaponService.GetPlayerWeapon(player)
	local data = dataService.Get(player)
	local skin = data and data.SelectedCosmetics and data.SelectedCosmetics.WeaponSkin or "Default"
	local equipped = WeaponService.EquipCharacter(character, weapon.Id, skin)
	if equipped then
		ammo[player.UserId] = { WeaponId = weapon.Id, Rounds = magazineFor(weapon) }
		reloads[player.UserId] = nil
		syncPlayerWeapon(player, weapon)
		sendWeaponAction(player, "Equip", weapon, 0)
	end
	return equipped
end

local function applyDamage(victim, amount, attackingTeam, player, attackerName)
	local humanoid = victim and victim:FindFirstChildOfClass("Humanoid")
	if not victim or not humanoid or humanoid.Health <= 0 or not validTeam(attackingTeam) or victim:GetAttribute("Team") == attackingTeam then
		return 0
	end
	if type(amount) ~= "number" or amount ~= amount or amount <= 0 then
		return 0
	end
	local armor = tonumber(victim:GetAttribute("Armor")) or 0
	local shield = tonumber(victim:GetAttribute("DamageTakenMultiplier")) or 1
	local appliedDamage = amount * math.clamp(shield, 0.05, 1) * (1 - math.clamp(armor, 0, 0.65))
	damageCredits[humanoid] = { Player = player, Clock = os.clock() }
	victim:SetAttribute("LastDamageClock", os.clock())
	if player then
		victim:SetAttribute("LastAttackerUserId", player.UserId)
		victim:SetAttribute("LastAttackerName", player.DisplayName)
		victim:SetAttribute("LastDamageSource", "Player")
	else
		victim:SetAttribute("LastAttackerUserId", nil)
		victim:SetAttribute("LastAttackerName", tostring(attackerName or "BOT"))
		victim:SetAttribute("LastDamageSource", "Bot")
	end
	humanoid:TakeDamage(appliedDamage)
	return appliedDamage
end

-- Used by mines, bombs, slams and turrets. The server supplies the attacking
-- team; a client can never call this function directly.
function WeaponService.ApplyAbilityDamage(victim, amount, attackingTeam, player)
	if phaseProvider() ~= "Battle" then
		return 0
	end
	return applyDamage(victim, amount, attackingTeam, player)
end

local function fire(character, weapon, targetPosition, attackingTeam, player, key)
	if phaseProvider() ~= "Battle" or not character.Parent or not validTeam(attackingTeam) then
		return false
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local head = character:FindFirstChild("Head") or character:FindFirstChild("HumanoidRootPart")
	if not humanoid or humanoid.Health <= 0 or not head or not validPosition(targetPosition) then
		return false
	end
	local now = os.clock()
	if lastShot[key] and now - lastShot[key] < weapon.Cooldown then
		return false
	end
	local origin = head.Position
	local delta = targetPosition - origin
	if delta.Magnitude < 0.1 or delta.Magnitude > 1500 then
		return false
	end
	lastShot[key] = now
	local direction = delta.Unit
	local raycastParams = RaycastParams.new()
	raycastParams.FilterType = Enum.RaycastFilterType.Exclude
	raycastParams.IgnoreWater = true
	raycastParams.FilterDescendantsInstances = { character }
	local outgoing = tonumber(character:GetAttribute("DamageMultiplier")) or 1

	for _ = 1, weapon.Pellets do
		local jitter = Vector3.new(random:NextNumber(-1, 1), random:NextNumber(-1, 1), random:NextNumber(-1, 1)) * weapon.Spread
		local shotDirection = (direction + jitter).Unit
		local hit = Workspace:Raycast(origin, shotDirection * weapon.Range, raycastParams)
		local finish = origin + shotDirection * weapon.Range
		if hit then
			finish = hit.Position
			local victim = hit.Instance:FindFirstAncestorOfClass("Model")
			local victimHumanoid = victim and victim:FindFirstChildOfClass("Humanoid")
			if victimHumanoid and victimHumanoid.Health > 0 and victim ~= character then
				applyDamage(victim, weapon.Damage * outgoing, attackingTeam, player, character.Name)
			else
				fortressService.DamagePart(hit.Instance, weapon.Damage * outgoing * weapon.StructureMultiplier, attackingTeam, player)
			end
		end
		remotes.CombatFX:FireAllClients({
			Kind = "Shot",
			Origin = origin,
			Finish = finish,
			Color = weapon.Color,
			WeaponId = weapon.Id,
			Melee = weapon.Melee == true,
			AttackerUserId = player and player.UserId or nil,
		})
	end
	return true
end

function WeaponService.FirePlayer(player, targetPosition)
	local character = player.Character
	local team = teamProvider(player)
	local weapon = WeaponService.GetPlayerWeapon(player)
	if not character or not team or reloads[player.UserId] then
		return false
	end
	local clip = ammo[player.UserId]
	local magazine = magazineFor(weapon)
	if not weapon.Melee then
		if not clip or clip.WeaponId ~= weapon.Id then
			clip = { WeaponId = weapon.Id, Rounds = magazine }
			ammo[player.UserId] = clip
		end
		if clip.Rounds <= 0 then
			startReload(player, weapon)
			return false
		end
	end
	local success = fire(character, weapon, targetPosition, team, player, "Player_" .. player.UserId)
	if success and not weapon.Melee then
		clip.Rounds = math.max(0, clip.Rounds - 1)
		syncPlayerWeapon(player, weapon)
		if clip.Rounds <= 0 then
			startReload(player, weapon)
		end
	end
	return success
end

function WeaponService.RequestReload(player)
	local character = player.Character
	local team = teamProvider(player)
	if not character or not team then
		return false
	end
	return startReload(player, WeaponService.GetPlayerWeapon(player))
end

function WeaponService.FireBot(bot, weaponId, targetPosition)
	local weapon = Catalog.GetWeapon(weaponId) or Catalog.Weapons.Carbine
	local team = bot:GetAttribute("Team")
	local botId = bot:GetAttribute("BotId") or bot.Name
	return fire(bot, weapon, targetPosition, team, nil, "Bot_" .. tostring(botId))
end

function WeaponService.Step()
	local now = os.clock()
	for userId, reload in pairs(reloads) do
		local player = Players:GetPlayerByUserId(userId)
		if not player or phaseProvider() ~= "Battle" then
			reloads[userId] = nil
			if player then
				syncPlayerWeapon(player, WeaponService.GetPlayerWeapon(player))
			end
		elseif now >= reload.EndsAt then
			local weapon = WeaponService.GetPlayerWeapon(player)
			local clip = ammo[userId]
			if clip and clip.WeaponId == weapon.Id then
				clip.Rounds = magazineFor(weapon)
			end
			reloads[userId] = nil
			syncPlayerWeapon(player, weapon)
			sendWeaponAction(player, "ReloadEnd", weapon, 0)
		end
	end
end

function WeaponService.OnPlayerRemoving(player)
	ammo[player.UserId] = nil
	reloads[player.UserId] = nil
	lastShot["Player_" .. player.UserId] = nil
end

return WeaponService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="21">
          <Properties>
            <string name="Name">WorldBuilder</string>
            <string name="Source"><![CDATA[-- Симметричная sculpted-арена и свободное лобби с витриной оружия и лутбоксом.
local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

-- Roblox-owned Store models can be loaded without enabling arbitrary third-party
-- assets. The native/offline audit has no AssetService; procedural decor remains.
local assetServiceOk, AssetService = pcall(function()
	return game:GetService("AssetService")
end)
if not assetServiceOk then
	AssetService = nil
end

local Shared = ReplicatedStorage:WaitForChild("BlockSiege")
local Config = require(Shared:WaitForChild("Config"))
local Catalog = require(Shared:WaitForChild("Catalog"))
local WeaponModels = require(Shared:WaitForChild("WeaponModels"))
local VisualModels = require(Shared:WaitForChild("VisualModels"))

local WorldBuilder = {}
local buildSerial = 0
local C = {
	Grass = Color3.fromRGB(70, 126, 82),
	Dirt = Color3.fromRGB(96, 76, 65),
	Stone = Color3.fromRGB(151, 158, 159),
	StoneDark = Color3.fromRGB(66, 76, 84),
	Wood = Color3.fromRGB(137, 91, 56),
	Leaf = Color3.fromRGB(52, 126, 69),
	Sand = Color3.fromRGB(128, 118, 96),
	White = Color3.fromRGB(245, 244, 232),
	Gold = Color3.fromRGB(244, 188, 72),
}

-- Public Roblox material color maps add real tiled surface detail without a custom
-- model upload. The underlying Material/Color remains as a loading-safe fallback.
local SURFACE_TEXTURES = {
	[Enum.Material.Cobblestone] = { Asset = "rbxassetid://9438459300", Tile = 6, Transparency = 0.1 },
	[Enum.Material.WoodPlanks] = { Asset = "rbxassetid://9439658515", Tile = 4, Transparency = 0.08 },
	[Enum.Material.Snow] = { Asset = "rbxassetid://9439632387", Tile = 5, Transparency = 0.04 },
	[Enum.Material.Grass] = { Asset = "rbxassetid://9438956437", Tile = 7, Transparency = 0.12 },
	[Enum.Material.Ground] = { Asset = "rbxassetid://9439044431", Tile = 7, Transparency = 0.12 },
	[Enum.Material.Slate] = { Asset = "rbxassetid://9483106252", Tile = 6, Transparency = 0.12 },
	[Enum.Material.Sand] = { Asset = "rbxassetid://9439585561", Tile = 6, Transparency = 0.1 },
	[Enum.Material.Fabric] = { Asset = "rbxassetid://9920517696", Tile = 3, Transparency = 0.1 },
}

local function addSurfaceTextures(part, material, name)
	local style = SURFACE_TEXTURES[material]
	if not style then
		return
	end
	local largest = math.max(part.Size.X, part.Size.Y, part.Size.Z)
	if largest < 5 and name ~= "GiftBox" and name ~= "GiftLid" then
		return
	end
	for _, face in ipairs({ Enum.NormalId.Top, Enum.NormalId.Front }) do
		local texture = Instance.new("Texture")
		texture.Name = "SurfaceTexture"
		texture.Texture = style.Asset
		texture.Face = face
		texture.StudsPerTileU = style.Tile
		texture.StudsPerTileV = style.Tile
		texture.Transparency = style.Transparency
		texture.Parent = part
	end
	part:SetAttribute("SurfaceTextured", true)
end

local function makePart(parent, name, size, cframe, color, material, collide, className)
	local part = Instance.new(className or "Part")
	part.Name = name
	part.Size = size
	part.CFrame = cframe
	part.Color = color
	part.Material = material or Enum.Material.SmoothPlastic
	part.Anchored = true
	part.CanCollide = collide ~= false
	part.CanTouch = false
	part.CanQuery = true
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.Parent = parent
	addSurfaceTextures(part, part.Material, name)
	return part
end

local function billboard(parent, text, color, offset, size)
	local gui = Instance.new("BillboardGui")
	gui.Name = "WorldLabel"
	gui.Size = UDim2.fromOffset(260, 58)
	gui.StudsOffset = offset or Vector3.new(0, 5, 0)
	gui.AlwaysOnTop = true
	gui.MaxDistance = 180
	gui.Parent = parent
	local label = Instance.new("TextLabel")
	label.Size = size or UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.GothamBold
	label.Text = text
	label.TextColor3 = color
	label.TextStrokeTransparency = 0.35
	label.TextScaled = true
	label.Parent = gui
	return gui
end

local function prompt(parent, action, object)
	local proximity = Instance.new("ProximityPrompt")
	proximity.ActionText = action
	proximity.ObjectText = object
	proximity.HoldDuration = 0.25
	proximity.MaxActivationDistance = 14
	proximity.RequiresLineOfSight = false
	proximity.Parent = parent
	return proximity
end

local function buildTree(parent, position, scale)
	-- The old five-cube VoxelTree is intentionally gone. The trunk remains a
	-- small gameplay obstacle; the sculpted crown is non-interactive.
	return VisualModels.Tree(parent, position, scale, {
		Name = "FortressPine", Snow = true, Collide = true, Query = true,
	})
end

