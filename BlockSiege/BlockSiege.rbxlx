local function setGuideVisible(visible)
	guideVisible = visible
	guideToggle.Text = visible and "H · СКРЫТЬ ПОДСКАЗКИ" or "H · ПОКАЗАТЬ ПОМОЩЬ"
	coachFrame.Visible = visible
	bonusFrame.Visible = visible
	waypointGui.Enabled = visible
end

local function coreDirection(team)
	if team == "" then
		return "↑", 0, nil
	end
	local enemy = Config.OtherTeam(team)
	local target = Config.BaseCFrame(enemy).Position + Vector3.new(0, 12, 0)
	local camera = Workspace.CurrentCamera
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart") or nil
	local origin = root and root.Position or (camera and camera.CFrame.Position) or target
	local distance = (target - origin).Magnitude
	local arrow = "↑"
	if camera and (target - camera.CFrame.Position).Magnitude > 0.1 then
		local direction = camera.CFrame:VectorToObjectSpace((target - camera.CFrame.Position).Unit)
		local angle = math.atan2(direction.X, -direction.Z)
		local arrows = { "↑", "↗", "→", "↘", "↓", "↙", "←", "↖" }
		local index = math.floor((angle + math.pi / 8) / (math.pi / 4)) % 8 + 1
		arrow = arrows[index]
	end
	return arrow, math.floor(distance + 0.5), target
end

local function updateWaypoint(phase, team)
	local visible = guideVisible and phase == "Battle" and team ~= ""
	waypointGui.Enabled = visible
	if not visible then
		return
	end
	local arrow, distance, target = coreDirection(team)
	if target then
		waypointPart.Position = target
		waypointLabel.Text = string.format("%s  ВРАЖЕСКОЕ ЯДРО\n%d м · уничтожь для победы", arrow, distance)
		waypointLabel.TextColor3 = C[Config.OtherTeam(team)] or C.Orange
	end
end

local function updateBonusMissions(phase, team)
	bonusFrame.Visible = guideVisible and (phase == "Build" or phase == "Battle") and team ~= ""
	local completedCount = player:GetAttribute("BonusCompleted") or 0
	local collected = player:GetAttribute("BonusSupplyCollected") or 0
	bonusSummary.Text = string.format('<font color="#72E6B1"><b>Выполнено %d/3</b></font> · <font color="#FFD166">ящики: %d</font> · награда сразу', completedCount, collected)
	for index, row in ipairs(missionRows) do
		local definition = Catalog.GetBonusMission(player:GetAttribute("BonusMission" .. index .. "Id") or "")
		row.Frame.Visible = definition ~= nil
		if definition then
			local progress = math.min(definition.Target, player:GetAttribute("BonusMission" .. index .. "Progress") or 0)
			local completed = player:GetAttribute("BonusMission" .. index .. "Completed") == true
			row.Name.Text = rich((completed and "✓ " or "") .. definition.Name, completed and C.Green or C.Text)
			row.Name.TextColor3 = completed and C.Green or C.Text
			row.Hint.Text = escapeRich(definition.Hint)
			row.Progress.Text = completed and string.format('<font color="#72E6B1"><b>ГОТОВО</b></font>\n<font color="#FFD166"><b>+%d · %dXP</b></font>', definition.Coins, definition.XP) or string.format('<font color="#F5F8FF"><b>%d/%d</b></font>\n<font color="#FFD166">+%d · %dXP</font>', progress, definition.Target, definition.Coins, definition.XP)
			row.Progress.TextColor3 = completed and C.Green or C.Gold
			row.Frame.BackgroundColor3 = completed and Color3.fromRGB(25, 65, 55) or C.Panel
		end
	end
	local active = state:GetAttribute("SupplyActive") or 0
	local nextSupply = state:GetAttribute("SupplyNext") or 0
	if phase == "Build" then
		supplyLabel.Text = highlightControls("СНАБЖЕНИЕ · золотые ящики появятся в бою\n+15 монет · +30 XP · +25 HP")
	elseif active > 0 then
		supplyLabel.Text = highlightControls(string.format("ЯЩИКИ НА КАРТЕ: %d · иди к золотому лучу\n+15 монет · +30 XP · +25 HP", active))
	else
		supplyLabel.Text = highlightControls(string.format("ДО СНАБЖЕНИЯ: %d с\n+15 монет · +30 XP · +25 HP", nextSupply))
	end
end

local function updateCoach(phase, team, remaining, captureOwner)
	-- Lobby already has its own stats/next-step panel and progression dock.
	-- Keep combat coaching out of that layout instead of stacking two HUDs.
	coachFrame.Visible = guideVisible and (phase == "Build" or phase == "Battle")
	guideToggle.Visible = phase == "Build" or phase == "Battle"
	guideToggle.Text = guideVisible and "H · СКРЫТЬ ПОДСКАЗКИ" or "H · ПОКАЗАТЬ ПОМОЩЬ"
	if not coachFrame.Visible then
		return
	end
	local arrow, distance = coreDirection(team)
	local builds = player:GetAttribute("MatchBuilds") or 0
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid") or nil
	local root = character and character:FindFirstChild("HumanoidRootPart") or nil
	local ammo = character and character:GetAttribute("Ammo") or 0
	local magazine = character and character:GetAttribute("Magazine") or 0
	local reloading = character and character:GetAttribute("Reloading") == true
	local manual = os.clock() < coachManualUntil
	local hints = {}
	local title = "ПОДСКАЗКА"
	if phase == "Lobby" then
		title = "НАЧНИ ЗДЕСЬ · ЛОББИ"
		hints = {
			"Нажми БЫСТРЫЙ СТАРТ: пустые места заполнят боты, строго 6×6. Обе команды строят, победа — уничтожение вражеского ядра.",
			"Нажми L или подойди к GEAR: открой кейс за игровые монеты/жетон, затем нажми на оружие в инвентаре, чтобы экипировать его.",
			"DAILY даёт ежедневную награду. DEFENSE продаёт шипы, мины и огненную ловушку. FORGE улучшает HP, броню, скорость и лимит построек.",
			"Перед боем осмотри витрину: есть огнестрельное оружие, ножи и легендарная перчатка. В матче класс и способности F/G выдаются случайно.",
			"X открывает экспедиции и тренировку отряда, Y — серверные рейтинги Level/Coins. Войти в выбранный PvE рейд можно во время Battle.",
		}
		coachFooter.Text = "L — снаряжение · X/Y — рейды/рейтинг · H — помощь"
	elseif (phase == "Build" or phase == "Battle") and team == "" then
		title = "НАБЛЮДЕНИЕ · СЛЕДУЮЩИЙ МАТЧ"
		coachText.Text = "Ты не занимаешь слот в этом матче. Дождись результатов и возврата в лобби, затем нажми БЫСТРЫЙ СТАРТ или встань в очередь 6×6."
		coachFooter.Text = "H — скрыть/показать помощь"
	elseif phase == "Build" then
		title = builds < 3 and "ШАГ 1 · ЗАЩИТИ СВОЮ КРЕПОСТЬ" or "ЗАЩИТА ГОТОВА · ДО ШТУРМА " .. tostring(remaining) .. " С"
		hints = {
			"Выбери 1 СТЕНА, 2 БАРРИКАДА или 3 БАШНЯ. Наведи прицел внутрь своей базы: зелёная модель — точное место установки, красная — запрет.",
			"Q/R и видимые кнопки ↶ ↷ поворачивают на 90°. Нажми ПОСТАВИТЬ, B или ЛКМ только после зелёного серверного предпросмотра.",
			"Стены закрывают подходы, башни атакуют врагов. Купленные в DEFENSE ловушки выбираются клавишами 4–6. Каждая постройка даёт монеты и XP.",
			"Справа — 3 бонусных задания. Укрепитель засчитывает постройки уже сейчас. В бою появятся золотые ящики с монетами, XP и лечением.",
		}
		if not manual and ghostHasServerPreview and not previewValid then
			title = "КРАСНЫЙ КОНТУР · ИЗМЕНИ ПОЗИЦИЮ"
			coachText.Text = "Объект не установлен. Наведи прицел на свободную площадку внутри своей базы, отойди от других моделей и дождись зелёного контура."
		elseif not manual and builds == 0 then
			coachText.Text = hints[1]
		elseif not manual and builds < 3 then
			coachText.Text = string.format("Построено %d/3. Добавь стены у прохода и башню рядом с ядром. Точная позиция и угол видны до подтверждения — преждевременной установки нет.", builds)
		else
			coachText.Text = hints[(coachPage % #hints) + 1]
		end
		coachFooter.Text = "Q/R — поворот · B — поставить · H — помощь"
	elseif phase == "Battle" then
		title = "ШАГ 2 · УНИЧТОЖЬ ВРАЖЕСКОЕ ЯДРО"
		local abilityF = player:GetAttribute("Ability1Name") or "способность F"
		local abilityG = player:GetAttribute("Ability2Name") or "способность G"
		local supplies = state:GetAttribute("SupplyActive") or 0
		hints = {
			string.format("Следуй за стрелкой %s: до вражеского ядра %d м. ЛКМ — огонь, R — перезарядка. Сносить башни и стены тоже выгодно: за них есть награды.", arrow, distance),
			"Захвати 67: встань в центральный круг и удерживай его. Команда получает монеты, XP и +1 HP/s. Если точку оспаривают — сначала выбей противника.",
			string.format("Твой случайный класс: %s. F — %s; G — %s. Применяй способности по откату: задание Специалист награждает три использования.", player:GetAttribute("ClassName") or "класс назначается", abilityF, abilityG),
			"Золотой вертикальный луч отмечает снабжение. Подойди к ящику или нажми ProximityPrompt: +15 монет, +30 XP и +25 HP. Ящик исчезает через 30 секунд.",
			"Выполняй 3 задания справа: разрушения, 67, F/G, лагеря, убийства или постройки. Награда начисляется сразу и каждое задание выполняется один раз за матч.",
			"Необязательный PvE рейд: X — вход в выбранную локацию, 3 волны и босс. Можно выйти через X; основная цель команды — вражеское ядро.",
		}
		local ownCore = state:GetAttribute(team .. "Core") or 0
		local ownMaximum = math.max(1, state:GetAttribute(team .. "CoreMax") or 1)
		local near67 = root and (root.Position - Vector3.new(0, root.Position.Y, 0)).Magnitude < 32
		if not manual and (reloading or (magazine > 0 and humanoid and humanoid.Health > 0 and ammo == 0)) then
			title = "ПЕРЕЗАРЯДКА · НЕ СТОЙ ОТКРЫТО"
			coachText.Text = reloading and "Оружие перезаряжается. Укройся за стеной или используй F/G; после перезарядки продолжай штурм по стрелке." or "Магазин пуст — нажми R. Во время перезарядки используй укрытие и способности F/G."
		elseif not manual and ownCore / ownMaximum < 0.3 then
			title = "ТВОЯ КРЕПОСТЬ В ОПАСНОСТИ"
			coachText.Text = "У своего ядра осталось меньше 30% HP. Вернись по командной метке, устрани штурмующих и используй защитные способности — затем продолжи атаку."
		elseif not manual and near67 and captureOwner ~= team then
			title = "67 РЯДОМ · УДЕРЖИВАЙ КРУГ"
			coachText.Text = "Оставайся внутри центральной зоны. Захват даёт всей команде награду и +1 HP/s; враг в круге оспаривает прогресс."
		elseif not manual and supplies > 0 and (player:GetAttribute("BonusSupplyCollected") or 0) == 0 then
			title = "БОНУС НА КАРТЕ · ЗОЛОТОЙ ЛУЧ"
			coachText.Text = "Снабжение уже лежит на арене. Найди золотой ящик у светового столба и подойди вплотную: +15 монет, +30 XP, +25 HP."
		else
			coachText.Text = hints[(coachPage % #hints) + 1]
		end
		coachFooter.Text = string.format("%s ядро: %d м · F/G — класс · H — помощь", arrow, distance)
	end
	coachTitle.Text = rich(title, phase == "Battle" and C.Orange or C.Gold)
	if phase == "Lobby" then
		coachText.Text = hints[(coachPage % #hints) + 1]
	end
	coachText.Text = highlightControls(coachText.Text)
	coachFooter.Text = highlightControls(coachFooter.Text)
end

local function refreshInventory()
	for _, child in ipairs(inventory:GetChildren()) do
		if child:IsA("TextButton") then
			child:Destroy()
		end
	end
	if not profile then
		return
	end
	for _, weaponId in ipairs(Catalog.WeaponOrder) do
		if profile.OwnedWeapons[weaponId] then
			local weapon = Catalog.GetWeapon(weaponId)
			local selected = profile.SelectedWeapon == weaponId
			local row = button(inventory, (selected and "✓ " or "") .. weapon.Name .. " · " .. Catalog.RarityNames[weapon.Rarity], UDim2.new(1, -12, 0, 42), UDim2.new(), Catalog.RarityColors[weapon.Rarity])
			row.TextColor3 = Color3.fromRGB(24, 32, 32)
			row.Activated:Connect(function()
				remotes.CaseAction:FireServer("Equip", weaponId)
			end)
		end
	end
end

local function setBuildKind(kind)
	selectedBuild = kind
	activePreviewRequest = 0
	ghostHasServerPreview = false
	previewValid = false
	previewDirty = true
	previewCFrame = nil
	previewPosition = nil
	previewRotation = nil
	previewSentPosition = nil
	for id, object in pairs(buildButtons) do
		object.BackgroundColor3 = id == kind and C.Green or C.Panel
		object.TextColor3 = id == kind and Color3.fromRGB(24, 32, 32) or C.Text
	end
end
local function selectBuildKind(kind)
	if state:GetAttribute("Phase") == "Build" and (player:GetAttribute("BuildRemaining") or 0) <= 0 then
		local used = player:GetAttribute("BuildUsed") or 0
		local limit = player:GetAttribute("BuildLimit") or 0
		notify("Лимит строений: " .. tostring(used) .. "/" .. tostring(limit))
		return
	end
	local defense = Catalog.GetDefense(kind)
	if defense and player:GetAttribute("Defense_" .. kind) ~= true then
		notify(defense.Name .. ": купите чертёж у DEFENSE в лобби")
		return
	end
	setBuildKind(kind)
end
for id, object in pairs(buildButtons) do
	object.Activated:Connect(function()
		selectBuildKind(id)
	end)
end
setBuildKind("Wall")

local function syncGhostModel(cframe)
	if buildGhostModel and cframe then
		buildGhostModel:PivotTo(cframe * CFrame.new(buildGhostModelPivotOffset) * (ghostKind == "Tower" and CFrame.Angles(0, 0, math.rad(90)) or CFrame.new()))
	end
end

local function setGhostModelTransparency(transparency)
	if not buildGhostModel then
		return
	end
	for _, item in ipairs(buildGhostModel:GetDescendants()) do
		if item:IsA("BasePart") and item.Name ~= "VisualAnchor" then
			item.Transparency = transparency
		end
	end
end

local function clearBuildGhost()
	if buildGhost then
		buildGhost:Destroy()
	end
	if buildGhostModel then
		buildGhostModel:Destroy()
	end
	buildGhost = nil
	buildGhostModel = nil
	buildGhostModelPivotOffset = Vector3.zero
	buildGhostOutline = nil
	ghostKind = nil
	ghostHasServerPreview = false
	activePreviewRequest = 0
	previewAimPosition = nil
	previewSentPosition = nil
	previewCFrame = nil
	previewPosition = nil
	previewRotation = nil
	previewValid = false
	previewDirty = true
	placeButton.BackgroundColor3 = C.Green
	buildTitle.Text = "СТРОИТЕЛЬСТВО  ·  ТОЧНЫЙ ПРЕДПРОСМОТР"
	buildTitle.TextColor3 = C.Gold
end

local function ensureBuildGhost(kind)
	if buildGhost and ghostKind == kind then
		return
	end
	clearBuildGhost()
	local definition = Config.BuildKinds[kind]
	if not definition then
		return
	end
	ghostKind = kind
	buildGhost = new("Part", {
		Name = "ServerValidatedBuildGhost",
		Size = definition.Size,
		Color = Color3.fromRGB(255, 65, 65),
		Material = Enum.Material.Neon,
		Transparency = 0.38,
		Anchored = true,
		CanCollide = false,
		CanTouch = false,
		CanQuery = false,
	}, Workspace)
	buildGhostOutline = new("SelectionBox", {
		Name = "GhostOutline",
		Adornee = buildGhost,
		Color3 = Color3.fromRGB(255, 65, 65),
		LineThickness = 0.06,
		SurfaceTransparency = 0.7,
	}, buildGhost)
	local teamColor = C[player:GetAttribute("Team") or ""] or C.Gold
	if kind == "Barricade" then
		buildGhostModel = VisualModels.Barricade(Workspace, buildGhost.CFrame, teamColor)
	elseif kind == "Wall" then
		buildGhostModel = VisualModels.Wall(Workspace, buildGhost.CFrame, teamColor)
	elseif kind == "Tower" then
		buildGhostModelPivotOffset = Vector3.new(0, -3.93, 0)
		buildGhostModel = VisualModels.Tower(Workspace, "BuildGhostTower", (buildGhost.CFrame * CFrame.new(0, -9, 0)).Position, 0.78, teamColor)
	end
	if buildGhostModel then
		syncGhostModel(buildGhost.CFrame)
		setGhostModelTransparency(0.35)
		buildGhost.Transparency = 0.92
	end
end

local function updateResults()
	local winner = state:GetAttribute("Winner") or ""
	resultTitle.Text = rich(winner == "" and "НИЧЬЯ" or ((C[winner] and (winner == "Blue" and "СИНИЕ" or "ОРАНЖЕВЫЕ") or winner) .. " ПОБЕДИЛИ"), C[winner] or C.Gold)
	resultTitle.TextColor3 = C[winner] or C.Gold
	resultReason.Text = escapeRich(state:GetAttribute("Reason") or "")
	if lastResult and lastResult.Reward then
		local reward = lastResult.Reward
		local stats = lastResult.Stats or {}
		local totalLevelCoins = (reward.LevelCoins or 0) + (stats.LevelCoins or 0)
		local levelBonus = totalLevelCoins > 0 and string.format(" · УРОВЕНЬ %d! +%d монет", reward.Level, totalLevelCoins) or ""
		resultReward.Text = highlightControls(string.format("За матч: +%d монет · +%d XP%s%s", reward.Coins, reward.XP, reward.Token and " · +1 жетон" or "", levelBonus))
		resultStats.Text = string.format('<font color="#A9BED8">За действия:</font> <font color="#FFD166"><b>+%d монет</b></font> · <font color="#74DEFF"><b>+%d XP</b></font>\nПостройки <b>%d</b> · Бойцы <b>%d</b> · Сооружения <b>%d</b> · <font color="#FFD166"><b>67: %d</b></font>', stats.Coins or 0, stats.XP or 0, stats.Builds or 0, stats.Kills or 0, stats.Structures or 0, stats.Captures or 0)
		local unlocks = {}
		for _, unlock in ipairs(stats.Unlocks or {}) do
			table.insert(unlocks, "LV " .. tostring(unlock.Level) .. ": " .. tostring(unlock.Text))
		end
		for _, unlock in ipairs(reward.Unlocks or {}) do
			table.insert(unlocks, "LV " .. tostring(unlock.Level) .. ": " .. tostring(unlock.Text))
		end
		resultUnlock.Text = #unlocks > 0 and rich("ОТКРЫТО · " .. table.concat(unlocks, " · "), C.Gold) or escapeRich("Награды за действия начислены ещё до этого экрана.")
		local nextLevel, nextReward = Catalog.GetNextLevelReward(reward.Level or 1)
		resultNext.Text = nextReward and string.format('<font color="#C6A0FF"><b>ДАЛЬШЕ · LV %d</b></font><font color="#A9BED8">: %s</font>', nextLevel, escapeRich(nextReward.Description)) or escapeRich("Вся особая шкала открыта. Каждый следующий уровень даёт монеты.")
	else
		resultReward.Text = "Наблюдение за матчем"
		resultStats.Text = ""
		resultUnlock.Text = ""
		resultNext.Text = ""
	end
end

local function layoutHUD(phase)
	local camera = Workspace.CurrentCamera
	local screenWidth = camera and camera.ViewportSize.X or 1280
	local screenHeight = camera and camera.ViewportSize.Y or 720
	local compact = screenWidth < 700 or screenHeight < 680
	local sideWidth = math.clamp((screenWidth - 200) / 2, 100, 340)
	local centralGap = math.max(40, screenWidth - 32 - sideWidth * 2)
	coachFrame.Size = UDim2.new(0, sideWidth, 0, 136)
	bonusFrame.Size = UDim2.new(0, math.min(330, sideWidth), 0, compact and 240 or 258)
	local bonusY = compact and (phase == "Battle" and 248 or 190) or 324
	bonusFrame.Position = UDim2.new(1, -16, 0, bonusY)
	lobbyDock.Size = UDim2.new(0, math.min(280, sideWidth), 0, 174)
	if compact then
		buildDock.AnchorPoint = Vector2.new(0.5, 1)
		buildDock.Position = UDim2.new(0.5, 0, 1, -16)
		buildDock.Size = UDim2.new(0.9, 0, 0, 132)
		trapDock.AnchorPoint = Vector2.new(0.5, 1)
		trapDock.Position = UDim2.new(0.5, 0, 1, -154)
		trapDock.Size = UDim2.new(0.9, 0, 0, 44)
	else
		local dockWidth = math.min(600, math.max(360, screenWidth - sideWidth - 48))
		buildDock.AnchorPoint = Vector2.new(0, 1)
		buildDock.Position = UDim2.new(0, 16, 1, -16)
		buildDock.Size = UDim2.new(0, dockWidth, 0, 132)
		trapDock.AnchorPoint = Vector2.new(0, 1)
		trapDock.Position = UDim2.new(0, 16, 1, -154)
		trapDock.Size = UDim2.new(0, dockWidth, 0, 44)
	end
	if compact then
		supplyLabel.Position = UDim2.new(0, 12, 0, 201)
		supplyLabel.Size = UDim2.new(1, -24, 0, 35)
		captureFrame.Size = UDim2.new(0, math.min(350, centralGap), 0, 62)
	else
		supplyLabel.Position = UDim2.new(0, 12, 0, 207)
		supplyLabel.Size = UDim2.new(1, -24, 0, 43)
		captureFrame.Size = UDim2.new(0, math.min(350, centralGap), 0, 62)
	end
	local toastHeight = phase == "Build" and 62 or 78
	local compactToastWidth = math.clamp(centralGap - 24, 40, 300)
	if phase == "Results" then
		rewardToast.AnchorPoint = Vector2.new(0.5, 0)
		rewardToast.Position = UDim2.new(0.5, 0, 0, 118)
		rewardToast.Size = UDim2.new(0, math.max(280, math.min(420, screenWidth - 32)), 0, toastHeight)
		resultsPanel.Position = UDim2.new(0.5, 0, 0, math.max(367, screenHeight / 2))
	elseif phase == "Build" or phase == "Battle" then
		-- The center channel stays clear of the stacked weapon/mission column.
		rewardToast.AnchorPoint = Vector2.new(0.5, 0)
		rewardToast.Position = UDim2.new(0.5, 0, 0, phase == "Build" and 370 or 452)
		rewardToast.Size = UDim2.new(0, compactToastWidth, 0, toastHeight)
	else
		rewardToast.AnchorPoint = Vector2.new(1, 0)
		rewardToast.Position = UDim2.new(1, -16, 0, 452)
		rewardToast.Size = UDim2.new(0, math.min(330, sideWidth), 0, toastHeight)
	end
	if phase == "Build" then
		rewardTitle.Size = UDim2.new(1, -24, 0, 24)
		rewardTitle.Position = UDim2.new(0, 12, 0, 4)
		rewardDetail.Size = UDim2.new(1, -24, 0, 28)
		rewardDetail.Position = UDim2.new(0, 12, 0, 31)
	else
		rewardTitle.Size = UDim2.new(1, -24, 0, 29)
		rewardTitle.Position = UDim2.new(0, 12, 0, 8)
		rewardDetail.Size = UDim2.new(1, -24, 0, 33)
		rewardDetail.Position = UDim2.new(0, 12, 0, 39)
	end
	rewardTitle.TextSize = (sideWidth < 240 or phase == "Build") and 14 or 18
	rewardDetail.TextSize = (sideWidth < 240 or phase == "Build") and 12 or 15
	guideToggle.AnchorPoint = Vector2.new(0.5, 0)
	guideToggle.Position = UDim2.new(0.5, 0, 0, phase == "Battle" and 546 or 330)
	guideToggle.Size = UDim2.new(0, math.clamp(centralGap - 24, 40, 220), 0, 30)
	guideToggle.TextSize = centralGap < 180 and 10 or 12
	notifyLabel.AnchorPoint = Vector2.new(0.5, 0)
	notifyLabel.Position = UDim2.new(0.5, 0, 0, 182)
	notifyLabel.Size = UDim2.new(0, math.clamp(centralGap - 24, 40, 300), 0, 48)
	notifyLabel.TextSize = centralGap < 180 and 14 or 18
	local fireWidth = math.clamp(sideWidth, 80, 126)
	fireButton.Size = UDim2.new(0, fireWidth, 0, 70)
	fireButton.Position = UDim2.new(1, -(fireWidth + 16), 1, -104)
	weaponLabel.AnchorPoint = Vector2.new(0.5, 1)
	weaponLabel.Position = UDim2.new(0.5, 0, 1, -18)
	weaponLabel.Size = UDim2.new(0, math.clamp(centralGap - 24, 40, 350), 0, 38)
	weaponLabel.TextSize = centralGap < 180 and 11 or 16
end

local function refresh()
	local phase = state:GetAttribute("Phase") or "Lobby"
	layoutHUD(phase)
	local remaining = state:GetAttribute("Time") or 0
	local names = { Lobby = "ЛОББИ", Build = "СТРОИТЕЛЬСТВО", Battle = "ШТУРМ", Results = "РЕЗУЛЬТАТЫ" }
	local phaseColors = { Lobby = C.Green, Build = C.Gold, Battle = C.Orange, Results = C.Purple }
	phaseLabel.Text = rich(names[phase] or phase, phaseColors[phase] or C.Text)
	local seasonName = state:GetAttribute("SeasonName") or "NEW YEAR 2026"
	local seasonColor = state:GetAttribute("SeasonColor") or C.Gold
	seasonLabel.Text = rich("BLOCKSIEGE", C.Cyan) .. " " .. rich("// " .. tostring(seasonName), seasonColor)
	timeLabel.Text = remaining > 0 and rich(string.format("%02d:%02d", math.floor(remaining / 60), remaining % 60), C.Gold) or ""
	lobbyDock.Visible = phase == "Lobby"
	lobbyHint.Visible = phase == "Lobby" and (not Workspace.CurrentCamera or (Workspace.CurrentCamera.ViewportSize.X >= 700 and Workspace.CurrentCamera.ViewportSize.Y >= 680))
	buildDock.Visible = phase == "Build"
	trapDock.Visible = phase == "Build"
	captureFrame.Visible = phase == "Build" or phase == "Battle"
	if phase ~= "Build" and buildGhost then
		clearBuildGhost()
	end
	crosshair.Visible = phase == "Battle"
	weaponLabel.Visible = phase == "Battle"
	fireButton.Visible = phase == "Battle" and UserInputService.TouchEnabled
	resultsPanel.Visible = phase == "Results"
	coreFrame.Visible = phase ~= "Lobby"
	queueButton.Text = player:GetAttribute("Queued") and "ВЫЙТИ ИЗ ОЧЕРЕДИ" or "В ОЧЕРЕДЬ 6×6"
	local team = player:GetAttribute("Team") or ""
	teamLabel.Text = rich(team ~= "" and ((team == "Blue" and "СИНИЕ" or "ОРАНЖЕВЫЕ") .. " · Lv " .. tostring(player:GetAttribute("MatchLevel") or 1)) or "НАБЛЮДЕНИЕ", C[team] or C.Muted)
	teamLabel.TextColor3 = C[team] or C.Muted
	local buildLeft = player:GetAttribute("BuildRemaining") or 0
	local buildLimit = player:GetAttribute("BuildLimit") or player:GetAttribute("BuildCapacity") or Config.Arena.BuildCapacity
	local buildUsed = player:GetAttribute("BuildUsed") or math.max(0, buildLimit - buildLeft)
	buildRemaining.Text = string.format('<font color="#FFD166"><b>%d/%d</b></font><br><font color="#A9BED8">осталось %d</font>', buildUsed, buildLimit, buildLeft)
	placeButton.Active = buildLeft > 0
	placeButton.AutoButtonColor = buildLeft > 0
	local equippedWeapon = Catalog.GetWeapon(player:GetAttribute("SelectedWeapon") or "Carbine") or Catalog.Weapons.Carbine
	local weaponSkin = player:GetAttribute("Cosmetic_WeaponSkin")
	local weaponFinish = weaponSkin == "GoldenArsenal" and " · GOLD" or (weaponSkin == "CelestialArsenal" and " · CELESTIAL" or "")
	local character = player.Character
	local ammo = character and character:GetAttribute("Ammo")
	local magazine = character and character:GetAttribute("Magazine")
	local reloading = character and character:GetAttribute("Reloading") == true
	local ammoText = ""
	if phase == "Battle" and ammo ~= nil and magazine ~= nil and magazine > 0 then
		ammoText = reloading and " · ПЕРЕЗАРЯДКА" or (" · " .. tostring(ammo) .. "/" .. tostring(magazine) .. " · R")
	end
	weaponLabel.Text = '<font color="#A9BED8">ОРУЖИЕ:</font> ' .. rich(equippedWeapon.Name, weaponSkin and weaponSkin ~= "Default" and C.Gold or C.Text) .. rich(weaponFinish, weaponSkin == "CelestialArsenal" and C.Cyan or C.Gold) .. highlightControls(ammoText)
	balanceLabel.Text = string.format('<font color="#FFD166"><b>МОНЕТЫ %d</b></font>  ·  <font color="#74DEFF"><b>ЖЕТОНЫ %d</b></font>  ·  <font color="#C6A0FF">PITY %d/20</font>', player:GetAttribute("Coins") or 0, player:GetAttribute("CaseTokens") or 0, player:GetAttribute("LegendaryPity") or 0)
	for _, teamName in ipairs({ "Blue", "Orange" }) do
		local health = state:GetAttribute(teamName .. "Core") or 0
		local maximum = math.max(1, state:GetAttribute(teamName .. "CoreMax") or 1)
		coreFills[teamName].Size = UDim2.fromScale(math.clamp(health / maximum, 0, 1), 1)
		coreLabels[teamName].Text = rich(teamName == "Blue" and "СИНИЕ" or "ОРАНЖЕВЫЕ", C[teamName]) .. ' <font color="#F5F8FF"><b>· ' .. tostring(health) .. " HP</b></font>"
	end
	local captureOwner = state:GetAttribute("Capture67Owner") or ""
	local captureProgress = state:GetAttribute("Capture67Progress") or 0
	local captureContested = state:GetAttribute("Capture67Contested") == true
	local ownerText = captureOwner == "" and "НЕЙТРАЛЬНАЯ" or (captureOwner == team and "ВАША" or (captureOwner == "Blue" and "СИНИЕ" or "ОРАНЖЕВЫЕ"))
	local captureCopy = phase == "Build" and "В БОЮ: НАГРАДА + РЕГЕНЕРАЦИЯ" or (ownerText .. (captureContested and " · ОСПАРИВАЕТСЯ" or (captureOwner ~= "" and " · +1 HP/s" or "")))
	captureTitle.Text = rich("67", C.Gold) .. string.format(' <font color="#%s"><b>// %s</b></font>', hexColor(captureContested and C.Orange or (C[captureOwner] or C.Gold)), escapeRich(captureCopy))
	captureTitle.TextColor3 = captureContested and C.Orange or (C[captureOwner] or C.Gold)
	captureFill.BackgroundColor3 = C[captureOwner] or C.Gold
	captureFill.Size = UDim2.fromScale(math.clamp(captureProgress / 100, 0, 1), 1)
	updateBonusMissions(phase, team)
	updateCoach(phase, team, remaining, captureOwner)
	updateWaypoint(phase, team)
	if phase == "Results" then
		updateResults()
	end
end

guideToggle.Activated:Connect(function()
	setGuideVisible(not guideVisible)
	refresh()
end)
coachNext.Activated:Connect(function()
	coachPage = coachPage + 1
	coachManualUntil = os.clock() + 8
	refresh()
end)

queueButton.Activated:Connect(function()
	remotes.LobbyAction:FireServer("Queue")
end)
quickButton.Activated:Connect(function()
	remotes.LobbyAction:FireServer("QuickStart")
end)
caseButton.Activated:Connect(function()
	casePanel.Visible = not casePanel.Visible
end)
closeCase.Activated:Connect(function()
	casePanel.Visible = false
end)
openCoin.Activated:Connect(function()
	remotes.CaseAction:FireServer("OpenCoin")
end)
openToken.Activated:Connect(function()
	remotes.CaseAction:FireServer("OpenToken")
end)

local function aimPosition()
	if UserInputService.TouchEnabled and not UserInputService.MouseEnabled then
		local camera = Workspace.CurrentCamera
		return camera.CFrame.Position + camera.CFrame.LookVector * 180
	end
	return mouse.Hit.Position
end

local function buildPosition()
	-- Mouse.Hit can select an existing barricade or the preview itself. Use a
	-- filtered ray instead, so the destination does not jump between structures.
	local camera = Workspace.CurrentCamera
	local ok, result = pcall(function()
		local origin, direction
		if UserInputService.TouchEnabled and not UserInputService.MouseEnabled then
			origin = camera.CFrame.Position
			direction = camera.CFrame.LookVector * 48
		else
			local mouseLocation = UserInputService:GetMouseLocation()
			local ray = camera:ViewportPointToRay(mouseLocation.X, mouseLocation.Y)
			origin = ray.Origin
			direction = ray.Direction * 512
		end
		local params = RaycastParams.new()
		params.FilterType = Enum.RaycastFilterType.Exclude
		local ignored = { player.Character }
		if buildGhost then
			table.insert(ignored, buildGhost)
		end
		local world = Workspace:FindFirstChild("BlockSiegeWorld")
		local structures = world and world:FindFirstChild("Structures")
		if structures then
			table.insert(ignored, structures)
		end
		local bots = world and world:FindFirstChild("Bots")
		if bots then
			table.insert(ignored, bots)
		end
		params.FilterDescendantsInstances = ignored
		local hit = Workspace:Raycast(origin, direction, params)
		return hit and hit.Position or nil
	end)
	if ok and result then
		return result
	end
	-- Compatibility fallback for touch/Studio mocks and a camera over empty sky.
	if UserInputService.TouchEnabled and not UserInputService.MouseEnabled then
		return camera.CFrame.Position + camera.CFrame.LookVector * 32
	end
	return mouse.Hit.Position
end

local function rotateBuild(direction)
	local previousRotation = buildRotation
	buildRotation = (buildRotation + (direction or 1) * 90) % 360
	rotationReadout.Text = "СТОРОНА  ·  " .. tostring(buildRotation) .. "°"
	-- Rotation is an edit to the preview only. It never calls BuildRequest.
	-- Invalidate old responses while retaining the last visible destination.
	activePreviewRequest = 0
	ghostHasServerPreview = false
	previewValid = false
	previewRotation = nil
	previewDirty = true
	if buildGhost and previewCFrame then
		local delta = (buildRotation - previousRotation) % 360
		previewCFrame = previewCFrame * CFrame.Angles(0, math.rad(delta), 0)
		buildGhost.CFrame = previewCFrame
		syncGhostModel(previewCFrame)
		setGhostModelTransparency(0.58)
		buildGhost.Color = C.Gold
		buildGhost.Transparency = 0.58
	end
	buildTitle.Text = "СТОРОНА " .. tostring(buildRotation) .. "° · дождитесь зелёного preview"
	buildTitle.TextColor3 = C.Gold
end

rotateLeftButton.Activated:Connect(function()
	rotateBuild(-1)
end)
rotateRightButton.Activated:Connect(function()
	rotateBuild(1)
end)

local function requestBuild()
	if state:GetAttribute("Phase") ~= "Build" then
		return
	end
	if (player:GetAttribute("BuildRemaining") or 0) <= 0 then
		notify("Лимит строений исчерпан · " .. tostring(player:GetAttribute("BuildUsed") or 0) .. "/" .. tostring(player:GetAttribute("BuildLimit") or 0))
		return
	end
	-- Confirm exactly what the player sees. Never use a fresh mouse.Hit after
	-- the green preview has been shown, and never place while it is stale/red.
	if not buildGhost or not ghostHasServerPreview or not previewValid or not previewPosition then
		notify("Сначала выберите позицию и сторону · дождитесь зелёного preview")
		return
	end
	local kind = selectedBuild
	local position = previewPosition
	local rotation = previewRotation or buildRotation
	ghostHasServerPreview = false
	previewValid = false
	previewRotation = nil
	previewDirty = true
	activePreviewRequest = 0
	remotes.BuildRequest:FireServer(kind, position, rotation)
	buildTitle.Text = "ПОДТВЕРЖДЕНО · выберите следующую позицию"
	buildTitle.TextColor3 = C.Green
end

placeButton.Activated:Connect(requestBuild)

local firing = false
local nextFire = 0
local function fire()
	if os.clock() < nextFire then
		return
	end
	nextFire = os.clock() + 0.065
	remotes.FireRequest:FireServer(aimPosition())
end

UserInputService.InputBegan:Connect(function(input, processed)
	if processed then
		return
	end
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		if state:GetAttribute("Phase") == "Build" then
			requestBuild()
		elseif state:GetAttribute("Phase") == "Battle" then
			firing = true
			fire()
		end
	elseif input.KeyCode == Enum.KeyCode.One then
		selectBuildKind("Wall")
	elseif input.KeyCode == Enum.KeyCode.Two then
		selectBuildKind("Barricade")
	elseif input.KeyCode == Enum.KeyCode.Three then
		selectBuildKind("Tower")
	elseif input.KeyCode == Enum.KeyCode.Four or input.KeyCode == Enum.KeyCode.Five or input.KeyCode == Enum.KeyCode.Six then
		local index = input.KeyCode == Enum.KeyCode.Four and 1 or (input.KeyCode == Enum.KeyCode.Five and 2 or 3)
		selectBuildKind(Catalog.DefenseOrder[index])
	elseif input.KeyCode == Enum.KeyCode.R then
		if state:GetAttribute("Phase") == "Battle" then
			remotes.ReloadRequest:FireServer()
		else
			rotateBuild(1)
		end
	elseif input.KeyCode == Enum.KeyCode.Q then
		rotateBuild(-1)
	elseif input.KeyCode == Enum.KeyCode.B then
		requestBuild()
	elseif input.KeyCode == Enum.KeyCode.H then
		setGuideVisible(not guideVisible)
		refresh()
	elseif input.KeyCode == Enum.KeyCode.L then
		casePanel.Visible = not casePanel.Visible
	end
end)
UserInputService.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		firing = false
	end
end)
fireButton.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.Touch then
		firing = true
		fire()
	end
end)
fireButton.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.Touch then
		firing = false
	end
end)

RunService.RenderStepped:Connect(function()
	if firing and state:GetAttribute("Phase") == "Battle" then
		fire()
	end
	if state:GetAttribute("Phase") == "Build" then
		ensureBuildGhost(selectedBuild)
		if buildGhost then
			local ok, position = pcall(buildPosition)
			if ok and position then
				previewAimPosition = position
				if not previewSentPosition or (position - previewSentPosition).Magnitude > 0.75 then
					previewDirty = true
				end
				-- Only the very first preview uses a raw local CFrame. Afterwards
				-- the last server destination stays still until its replacement is valid.
				if not previewCFrame then
					previewCFrame = CFrame.new(position) * CFrame.Angles(0, math.rad(buildRotation), 0)
					buildGhost.CFrame = previewCFrame
					syncGhostModel(previewCFrame)
				end
				local now = os.clock()
				if now >= nextPreviewRequest and previewDirty then
					nextPreviewRequest = now + 0.18
					previewRequestId = previewRequestId + 1
					activePreviewRequest = previewRequestId
					previewSentPosition = position
					previewDirty = false
					ghostHasServerPreview = false
					previewValid = false
					buildTitle.Text = "ОПРЕДЕЛЯЕМ ПОЗИЦИЮ · сторона " .. tostring(buildRotation) .. "°"
					buildTitle.TextColor3 = C.Gold
					remotes.BuildPreviewRequest:FireServer(selectedBuild, position, buildRotation, activePreviewRequest)
				end
			end
		end
	end
end)

local function effect(position, color, size, lifetime)
	local part = new("Part", {
		Position = position, Size = Vector3.one * size, Color = color, Material = Enum.Material.Neon,
		Anchored = true, CanCollide = false, CanTouch = false, CanQuery = false, Transparency = 0.15,
	}, Workspace)
	if size >= 3 then
		local light = new("PointLight", { Color = color, Brightness = math.min(5, size / 3), Range = size * 2 }, part)
		TweenService:Create(light, TweenInfo.new(lifetime), { Brightness = 0 }):Play()
	end
	TweenService:Create(part, TweenInfo.new(lifetime), { Size = Vector3.one * size * 1.65, Transparency = 1 }):Play()
	Debris:AddItem(part, lifetime + 0.05)
end

local function burst(position, color, count, power)
	for _ = 1, count do
		local lifetime = 0.35 + math.random() * 0.35
		local direction = Vector3.new(math.random() - 0.5, math.random() * 0.8 + 0.2, math.random() - 0.5).Unit
		local part = new("Part", {
			Position = position, Size = Vector3.one * (0.4 + math.random() * 0.7), Color = color,
			Material = Enum.Material.Neon, Anchored = true, CanCollide = false, CanTouch = false, CanQuery = false, Transparency = 0.05,
		}, Workspace)
		TweenService:Create(part, TweenInfo.new(lifetime), {
			Position = position + direction * power * (0.6 + math.random() * 0.7), Size = Vector3.one * 0.05, Transparency = 1,
		}):Play()
		Debris:AddItem(part, lifetime + 0.05)
	end
end

remotes.CombatFX.OnClientEvent:Connect(function(payload)
	if payload.Melee == true or payload.Kind == "Melee" then
		local color = payload.Color or C.Gold
		effect(payload.Finish or payload.Position, color, 1.8, 0.12)
		burst(payload.Finish or payload.Position, color, 5, 3)
	elseif payload.Kind == "Shot" or payload.Kind == "TowerShot" or payload.Kind == "NeutralShot" or payload.Kind == "ExpeditionShot" then
		local distance = (payload.Finish - payload.Origin).Magnitude
		if distance > 0.1 then
			local width = payload.WeaponId == "Rail" and 0.3 or (payload.Kind == "Shot" and 0.12 or 0.18)
			local beam = new("Part", {
				Size = Vector3.new(width, width, distance), CFrame = CFrame.lookAt(payload.Origin:Lerp(payload.Finish, 0.5), payload.Finish),
				Color = payload.Color or C[payload.Team] or C.Gold, Material = Enum.Material.Neon, Anchored = true, CanCollide = false, CanTouch = false, CanQuery = false, Transparency = 0.08,
			}, Workspace)
			TweenService:Create(beam, TweenInfo.new(0.07), { Transparency = 1 }):Play()
			Debris:AddItem(beam, 0.08)
		end
	elseif payload.Kind == "CoreDestroyed" then
		local color = C[payload.Team] or C.Gold
		effect(payload.Position, color, 18, 0.8)
		burst(payload.Position, color, 28, 32)
	elseif payload.Kind == "StructureDestroyed" then
		local color = C[payload.Team] or C.Gold
		effect(payload.Position, color, 5, 0.35)
		burst(payload.Position, color, 10, 12)
	elseif payload.Kind == "NeutralDefeated" or payload.Kind == "ExpeditionDefeated" then
		local color = payload.Color or C.Green
		effect(payload.Position, color, payload.Kind == "ExpeditionDefeated" and 8 or 7, 0.45)
		burst(payload.Position, color, 16, 12)
	elseif payload.Kind == "ExpeditionBossWarning" then
		local color = payload.Color or C.Red
		effect(payload.Position, color, 12, 1.1)
		burst(payload.Position, color, 8, 8)
	elseif payload.Kind == "ExpeditionBossSlam" then
		local color = payload.Color or C.Red
		effect(payload.Position, color, 20, 0.65)
		burst(payload.Position, color, 28, 22)
	elseif payload.Position then
		effect(payload.Position, C[payload.Team] or C.Gold, 2.2, 0.14)
		burst(payload.Position, C[payload.Team] or C.Gold, 3, 4)
	end
end)
remotes.BuildFX.OnClientEvent:Connect(function(payload)
	local color = C[payload.Team] or C.Green
	effect(payload.Position, color, 3, 0.2)
	burst(payload.Position, color, 6, 5)
end)
remotes.TrapFX.OnClientEvent:Connect(function(payload)
	local color = payload.Kind == "FlameTrap" and Color3.fromRGB(255, 105, 35) or (payload.Kind == "ShockMine" and Color3.fromRGB(93, 190, 255) or Color3.fromRGB(255, 213, 92))
	local position = payload.Position
	if position then
		effect(position, color, payload.Kind == "ShockMine" and 5 or 3, 0.35)
		burst(position, color, 12, 8)
	end
end)
remotes.CaptureFX.OnClientEvent:Connect(function(payload)
	if payload.Position then
		local color = C[payload.Team] or C.Gold
		effect(payload.Position, color, 8, 0.5)
		burst(payload.Position, color, 18, 14)
	end
	if payload.Team then
		notify("67 ЗАХВАЧЕНА · +1 HP/s · " .. (payload.Team == "Blue" and "СИНИЕ" or "ОРАНЖЕВЫЕ"))
	end
end)
remotes.BonusFX.OnClientEvent:Connect(function(payload)
	if not payload.Position then
		return
	end
	local color = payload.Color or C.Gold
	effect(payload.Position, color, payload.Kind == "Supply" and 7 or 5, 0.5)
	burst(payload.Position, color, 18, 13)
	local anchor = new("Part", {
		Position = payload.Position + Vector3.new(0, 3, 0), Size = Vector3.one, Transparency = 1,
		Anchored = true, CanCollide = false, CanTouch = false, CanQuery = false, CastShadow = false,
	}, Workspace)
	local tag = new("BillboardGui", { Size = UDim2.fromOffset(250, 48), AlwaysOnTop = true, MaxDistance = 140 }, anchor)
	local label = text(tag, payload.Kind == "Supply" and "СНАБЖЕНИЕ СОБРАНО!" or "БОНУС ВЫПОЛНЕН!", UDim2.fromScale(1, 1), UDim2.new(), 20, color)
	label.Font = Enum.Font.GothamBold
	label.TextStrokeTransparency = 0.2
	TweenService:Create(anchor, TweenInfo.new(1.2), { Position = anchor.Position + Vector3.new(0, 6, 0) }):Play()
	TweenService:Create(label, TweenInfo.new(1.2), { TextTransparency = 1, TextStrokeTransparency = 1 }):Play()
	Debris:AddItem(anchor, 1.25)
end)
remotes.BuildPreview.OnClientEvent:Connect(function(payload)
	if payload.Kind ~= selectedBuild or (payload.Rotation or 0) ~= buildRotation or state:GetAttribute("Phase") ~= "Build" then
		return
	end
	-- A response from an older aim/rotation/kind must never move the ghost.
	if payload.RequestId ~= nil and payload.RequestId ~= activePreviewRequest then
		return
	end
	if payload.RequestId == nil and previewRequestId > 0 and activePreviewRequest == 0 then
		return
	end
	if previewAimPosition and previewSentPosition and (previewAimPosition - previewSentPosition).Magnitude > 1.25 then
		previewDirty = true
		return
	end
	ensureBuildGhost(payload.Kind)
	if not buildGhost then
		return
	end
	local nextCFrame = payload.CFrame
	if not nextCFrame and payload.Position then
		nextCFrame = CFrame.new(payload.Position) * CFrame.Angles(0, math.rad(payload.Rotation or buildRotation), 0)
	end
	if not nextCFrame then
		return
	end
	previewCFrame = nextCFrame
	previewPosition = nextCFrame.Position
	previewRotation = tonumber(payload.Rotation) or buildRotation
	previewValid = payload.Valid == true
	ghostHasServerPreview = true
	buildGhost.CFrame = nextCFrame
	syncGhostModel(nextCFrame)
	local color = previewValid and Color3.fromRGB(65, 255, 130) or Color3.fromRGB(255, 65, 65)
	buildGhost.Color = color
	buildGhost.Transparency = buildGhostModel and 0.92 or (previewValid and 0.42 or 0.28)
	buildGhost:SetAttribute("ServerValid", previewValid)
	buildGhost:SetAttribute("PreviewRequestId", activePreviewRequest)
	setGhostModelTransparency(previewValid and 0.35 or 0.52)
	if buildGhostOutline then
		buildGhostOutline.Color3 = color
	end
	placeButton.BackgroundColor3 = previewValid and C.Green or Color3.fromRGB(170, 65, 65)
	buildTitle.Text = previewValid and "ГОТОВО · сторона " .. tostring(buildRotation) .. "° · ПОСТАВИТЬ" or ("НЕЛЬЗЯ: " .. tostring(payload.Reason))
	buildTitle.TextColor3 = color
end)

remotes.Notify.OnClientEvent:Connect(notify)
remotes.ProgressionFX.OnClientEvent:Connect(queueReward)
remotes.CaseOpened.OnClientEvent:Connect(function(result)
	casePanel.Visible = true
	caseResult.Text = highlightControls((result.Duplicate and "ДУБЛИКАТ · " or "ПОЛУЧЕНО · ") .. tostring(result.Name) .. " · " .. tostring(Catalog.RarityNames[result.Rarity]) .. (result.Duplicate and " · +" .. tostring(result.Compensation) .. " монет" or ""))
	caseResult.TextColor3 = Catalog.RarityColors[result.Rarity]
end)
remotes.ProfileUpdate.OnClientEvent:Connect(function(data)
	profile = data
	refreshInventory()
end)
remotes.Results.OnClientEvent:Connect(function(result)
	lastResult = result
	updateResults()
end)
remotes.OpenPanel.OnClientEvent:Connect(function(name)
	if name == nil or name == "Cases" then
		casePanel.Visible = true
	end
end)
player.CharacterAdded:Connect(function(character)
	mouse.TargetFilter = character
end)
if player.Character then
	mouse.TargetFilter = player.Character
end
state:GetAttributeChangedSignal("Phase"):Connect(refresh)
task.spawn(function()
	while gui.Parent do
		refresh()
		task.wait(0.1)
	end
end)
refresh()
]]></string>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="39">
        <Properties>
          <string name="Name">EventClient</string>
          <string name="Source"><![CDATA[-- BLOCKSIEGE // LIVE-OPS HUD, RICH-TEXT ANNOUNCEMENTS + ADMIN PANEL
local Debris = game:GetService("Debris")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")

local player = Players.LocalPlayer
local Shared = ReplicatedStorage:WaitForChild("BlockSiege")
local EventCatalog = require(Shared:WaitForChild("EventCatalog"))
local SeasonCatalog = require(Shared:WaitForChild("SeasonCatalog"))
local remotes = Shared:WaitForChild("Remotes")
local state = Shared:WaitForChild("MatchState")

local C = {
	Background = Color3.fromRGB(10, 14, 29),
	Panel = Color3.fromRGB(29, 38, 65),
	Text = Color3.fromRGB(246, 249, 255),
	Muted = Color3.fromRGB(161, 179, 214),
	Gold = Color3.fromRGB(255, 205, 87),
	Pink = Color3.fromRGB(255, 100, 190),
	Cyan = Color3.fromRGB(76, 216, 255),
	Purple = Color3.fromRGB(168, 108, 255),
}

local function new(className, properties, parent)
	local object = Instance.new(className)
	for key, value in pairs(properties or {}) do
		object[key] = value
	end
	object.Parent = parent
	return object
end

local function corner(object, radius)
	return new("UICorner", { CornerRadius = UDim.new(0, radius or 8) }, object)
end

local function gradient(object, first, second, rotation)
	return new("UIGradient", { Color = ColorSequence.new(first, second), Rotation = rotation or 100 }, object)
end

local function label(parent, value, size, position, textSize, color)
	return new("TextLabel", {
		BackgroundTransparency = 1,
		Size = size,
		Position = position or UDim2.new(),
		Font = Enum.Font.Gotham,
		RichText = true,
		Text = value,
		TextColor3 = color or C.Text,
		TextSize = textSize or 15,
		TextWrapped = true,
	}, parent)
end

local function button(parent, value, size, position, color)
	local object = new("TextButton", {
		BackgroundColor3 = color or C.Panel,
		Size = size,
		Position = position or UDim2.new(),
		Font = Enum.Font.GothamBold,
		RichText = true,
		Text = value,
		TextColor3 = C.Text,
		TextSize = 14,
		AutoButtonColor = true,
	}, parent)
	corner(object, 7)
	new("UIStroke", { Color = C.Cyan, Thickness = 1, Transparency = 0.35 }, object)
	return object
end

local function escape(value)
	local escaped = tostring(value or ""):gsub("&", "&amp;"):gsub("<", "&lt;"):gsub(">", "&gt;"):gsub('"', "&quot;"):gsub("'", "&apos;")
	return escaped
end

local function hex(color)
	color = color or C.Gold
	return string.format("%02X%02X%02X", math.floor(color.R * 255 + 0.5), math.floor(color.G * 255 + 0.5), math.floor(color.B * 255 + 0.5))
end

local function colored(value, color)
	return string.format('<font color="#%s"><b>%s</b></font>', hex(color), escape(value))
end

local function formatTime(seconds)
	seconds = math.max(0, math.floor(tonumber(seconds) or 0))
	return string.format("%02d:%02d", math.floor(seconds / 60), seconds % 60)
end

local gui = new("ScreenGui", {
	Name = "BlockSiegeLiveOps",
	ResetOnSpawn = false,
	DisplayOrder = 8,
	ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
}, player:WaitForChild("PlayerGui"))

local eventBar = new("Frame", {
	AnchorPoint = Vector2.new(0.5, 0),
	Position = UDim2.new(0.5, 0, 0, 186),
		Size = UDim2.new(0.9, 0, 0, 72),
	BackgroundColor3 = C.Background,
	BackgroundTransparency = 0.04,
}, gui)
corner(eventBar, 10)
gradient(eventBar, Color3.fromRGB(48, 33, 75), Color3.fromRGB(10, 23, 42), 105)
local eventStroke = new("UIStroke", { Color = C.Purple, Thickness = 1.4, Transparency = 0.08 }, eventBar)
local eventAccent = new("Frame", { Size = UDim2.new(0, 5, 1, -12), Position = UDim2.new(0, 5, 0, 6), BackgroundColor3 = C.Purple, BorderSizePixel = 0 }, eventBar)
corner(eventAccent, 3)
local eventKicker = label(eventBar, "LIVE EVENT", UDim2.new(1, -122, 0, 14), UDim2.new(0, 17, 0, 4), 10, C.Muted)
eventKicker.Font = Enum.Font.GothamBold
local eventTitle = label(eventBar, "", UDim2.new(1, -122, 0, 26), UDim2.new(0, 17, 0, 18), 19, C.Text)
eventTitle.Font = Enum.Font.GothamBold
local eventDescription = label(eventBar, "", UDim2.new(1, -32, 0, 23), UDim2.new(0, 17, 0, 45), 11, C.Muted)
local eventTime = label(eventBar, "00:00", UDim2.new(0, 92, 0, 34), UDim2.new(1, -103, 0, 8), 23, C.Gold)
eventTime.Font = Enum.Font.GothamBlack
eventTime.TextXAlignment = Enum.TextXAlignment.Right

local eventButton = button(gui, "V · ИВЕНТЫ И РАСПИСАНИЕ", UDim2.new(0, 330, 0, 34), UDim2.new(0, 16, 0, 426), Color3.fromRGB(67, 44, 105))
eventButton.Name = "LiveEventsButton"
gradient(eventButton, Color3.fromRGB(151, 69, 190), Color3.fromRGB(41, 105, 150), 0)

local eventPanel = new("Frame", {
	AnchorPoint = Vector2.new(0.5, 0.5),
	Position = UDim2.fromScale(0.5, 0.52),
	Size = UDim2.new(0.92, 0, 0.8, 0),
	BackgroundColor3 = C.Background,
	Visible = false,
}, gui)
new("UISizeConstraint", { MinSize = Vector2.new(320, 400), MaxSize = Vector2.new(590, 590) }, eventPanel)
corner(eventPanel, 12)
gradient(eventPanel, Color3.fromRGB(39, 30, 67), Color3.fromRGB(9, 19, 35), 110)
new("UIStroke", { Color = C.Pink, Thickness = 1.6, Transparency = 0.12 }, eventPanel)
local panelTitle = label(eventPanel, '<font color="#FF66BE"><b>LIVEOPS</b></font> <font color="#66DFFF"><b>· ИВЕНТЫ</b></font>', UDim2.new(1, -72, 0, 36), UDim2.new(0, 16, 0, 9), 23, C.Text)
local panelSubtitle = label(eventPanel, "45 секунд события · новое UTC-окно каждые 4 минуты", UDim2.new(1, -210, 0, 24), UDim2.new(0, 16, 0, 45), 12, C.Muted)
local seasonTab = button(eventPanel, "ПРАЗДНИКИ", UDim2.new(0, 124, 0, 28), UDim2.new(1, -184, 0, 43), C.Purple)
local closeButton = button(eventPanel, "×", UDim2.new(0, 42, 0, 36), UDim2.new(1, -54, 0, 10), C.Panel)
local eventList = new("ScrollingFrame", {
	Position = UDim2.new(0, 16, 0, 73), Size = UDim2.new(1, -32, 1, -137),
	BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 4,
	CanvasSize = UDim2.new(0, 0, 0, #EventCatalog.Order * 91), ScrollBarImageColor3 = C.Pink,
}, eventPanel)
local seasonList = new("ScrollingFrame", {
	Position = UDim2.new(0, 16, 0, 73), Size = UDim2.new(1, -32, 1, -137),
	BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 4,
	CanvasSize = UDim2.new(0, 0, 0, #SeasonCatalog.Order * 77), ScrollBarImageColor3 = C.Purple, Visible = false,
}, eventPanel)
local seasonButtons = {}
for index, id in ipairs(SeasonCatalog.Order) do
	local definition = SeasonCatalog.Get(id)
	local row = new("Frame", { Size = UDim2.new(1, -8, 0, 70), Position = UDim2.new(0, 0, 0, (index - 1) * 77), BackgroundColor3 = C.Panel }, seasonList)
	corner(row, 8)
	local name = label(row, colored(definition.Name, definition.Color), UDim2.new(0.58, 0, 0, 23), UDim2.new(0, 12, 0, 5), 16, C.Text)
	name.Font = Enum.Font.GothamBold
	local description = label(row, escape(definition.Subtitle), UDim2.new(0.58, 0, 0, 35), UDim2.new(0, 12, 0, 30), 11, C.Muted)
	description.TextXAlignment = Enum.TextXAlignment.Left
	local apply = button(row, "ПРИМЕНИТЬ", UDim2.new(0.34, 0, 0, 36), UDim2.new(0.63, 0, 0, 17), definition.Color)
	apply.Activated:Connect(function()
		remotes.AdminSeasonRequest:FireServer(id)
	end)
	seasonButtons[id] = apply
end
local adminRows = {}
for index, id in ipairs(EventCatalog.Order) do
	local definition = EventCatalog.Get(id)
	local row = new("Frame", {
		Position = UDim2.new(0, 0, 0, (index - 1) * 91),
		Size = UDim2.new(1, -8, 0, 84),
		BackgroundColor3 = C.Panel,
		BackgroundTransparency = 0.08,
		BorderSizePixel = 0,
	}, eventList)
	corner(row, 9)
	local accent = new("Frame", { Size = UDim2.new(0, 4, 1, -12), Position = UDim2.new(0, 5, 0, 6), BackgroundColor3 = definition.Color, BorderSizePixel = 0 }, row)
	corner(accent, 2)
	local title = label(row, colored(definition.Name, definition.Color), UDim2.new(1, -26, 0, 23), UDim2.new(0, 15, 0, 5), 16, C.Text)
	title.TextXAlignment = Enum.TextXAlignment.Left
	local description = label(row, escape(definition.Description), UDim2.new(1, -150, 0, 47), UDim2.new(0, 15, 0, 30), 12, C.Muted)
	description.TextXAlignment = Enum.TextXAlignment.Left
	description.TextYAlignment = Enum.TextYAlignment.Top
	local start = button(row, "ЗАПУСТИТЬ", UDim2.new(0, 116, 0, 34), UDim2.new(1, -128, 0, 39), definition.Color)
	start.TextColor3 = Color3.fromRGB(20, 24, 35)
	start.Visible = false
	start.Activated:Connect(function()
		remotes.AdminEventRequest:FireServer("Start", id)
		eventPanel.Visible = false
	end)
	adminRows[id] = start
end
local stopButton = button(eventPanel, "ОСТАНОВИТЬ ИВЕНТ", UDim2.new(0, 190, 0, 36), UDim2.new(0, 16, 1, -49), Color3.fromRGB(150, 54, 85))
stopButton.Visible = false
stopButton.Activated:Connect(function()
	remotes.AdminEventRequest:FireServer("Stop")
end)
local panelStatus = label(eventPanel, "", UDim2.new(1, -230, 0, 39), UDim2.new(0, 218, 1, -51), 11, C.Muted)
panelStatus.TextXAlignment = Enum.TextXAlignment.Right

local announcement = new("CanvasGroup", {
	AnchorPoint = Vector2.new(0.5, 0.5),
	Position = UDim2.new(0.5, 0, 0.37, 0),
	Size = UDim2.new(0.92, 0, 0, 116),
	BackgroundColor3 = C.Background,
	BackgroundTransparency = 0.12,
	GroupTransparency = 1,
	Visible = false,
	ZIndex = 30,
}, gui)
corner(announcement, 13)
local announcementStroke = new("UIStroke", { Color = C.Pink, Thickness = 2.2, Transparency = 0.05 }, announcement)
local announcementTitle = label(announcement, "", UDim2.new(1, -24, 0, 35), UDim2.new(0, 12, 0, 8), 27, C.Gold)
announcementTitle.Font = Enum.Font.GothamBlack
announcementTitle.ZIndex = 31
local announcementText = label(announcement, "", UDim2.new(1, -28, 0, 63), UDim2.new(0, 14, 0, 45), 18, C.Text)
announcementText.Font = Enum.Font.GothamBold
announcementText.ZIndex = 31
local announcementVersion = 0

local function showAnnouncement(payload)
	announcementVersion = announcementVersion + 1
	local version = announcementVersion
	local color = payload.Color or C.Pink
	announcementStroke.Color = color
	announcementTitle.Text = colored(payload.Title or "LIVE EVENT", color)
	local subtitle = tostring(payload.Subtitle or "")
	local first, rest = subtitle:match("^([^\n]+)\n?(.*)$")
	announcementText.Text = colored(first or subtitle, color) .. (rest and rest ~= "" and ("\n<font color=\"#F4F7FF\">" .. escape(rest) .. "</font>") or "")
	if state:GetAttribute("Phase") == "Results" then
		return
	end
	announcement.Visible = true
	eventButton.Visible = false
	announcement.GroupTransparency = 0.15
	announcement.Position = UDim2.new(0.5, 0, 0, 233 + announcement.Size.Y.Offset / 2)
	TweenService:Create(announcement, TweenInfo.new(0.28, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { GroupTransparency = 0 }):Play()
	task.delay(tonumber(payload.Duration) or 3.5, function()
		if version ~= announcementVersion then
			return
		end
		local tween = TweenService:Create(announcement, TweenInfo.new(0.35), { GroupTransparency = 1 })
		tween:Play()
		tween.Completed:Wait()
		if version == announcementVersion then
			announcement.Visible = false
		end
	end)
end

local function effect(position, color, size, duration)
	if typeof(position) ~= typeof(Vector3.new()) then
		return
	end
	local part = new("Part", {
		Position = position + Vector3.new(0, 2, 0), Size = Vector3.one * size, Shape = Enum.PartType.Ball,
		Color = color, Material = Enum.Material.Neon, Anchored = true, CanCollide = false,
		CanTouch = false, CanQuery = false, CastShadow = false, Transparency = 0.15,
	}, Workspace)
	TweenService:Create(part, TweenInfo.new(duration), { Size = Vector3.one * size * 1.8, Transparency = 1 }):Play()
	Debris:AddItem(part, duration + 0.05)
end

local function burst(position, color, count)
	if typeof(position) ~= typeof(Vector3.new()) then
		return
	end
	for _ = 1, count do
		local lifetime = 0.4 + math.random() * 0.35
		local direction = Vector3.new(math.random() - 0.5, math.random() * 0.8 + 0.25, math.random() - 0.5).Unit
		local part = new("Part", {
			Position = position + Vector3.new(0, 2, 0), Size = Vector3.one * (0.35 + math.random() * 0.55),
			Color = color, Material = Enum.Material.Neon, Anchored = true, CanCollide = false,
			CanTouch = false, CanQuery = false, CastShadow = false,
		}, Workspace)
		TweenService:Create(part, TweenInfo.new(lifetime), { Position = part.Position + direction * 15, Transparency = 1, Size = Vector3.one * 0.05 }):Play()
		Debris:AddItem(part, lifetime + 0.05)
	end
end

remotes.EventFX.OnClientEvent:Connect(function(payload)
	if payload.Kind == "Announcement" then
		showAnnouncement(payload)
	elseif payload.Kind == "MeteorImpact" then
		effect(payload.Position, payload.Color or C.Purple, 11, 0.55)
		burst(payload.Position, payload.Color or C.Purple, 20)
	elseif payload.Kind == "RepairPulse" then
		effect(payload.Position, payload.Color or Color3.fromRGB(78, 239, 190), 8, 0.5)
		burst(payload.Position, payload.Color or Color3.fromRGB(78, 239, 190), 10)
	end
end)

local seasonMode = false
remotes.SeasonFX.OnClientEvent:Connect(function(payload)
	if seasonMode then
		panelSubtitle.Text = "Тема: " .. tostring(payload.Name or "СЕЗОН")
	end
	showAnnouncement({ Title = "СЕЗОН · " .. tostring(payload.Name or "ОБНОВЛЕНИЕ"), Subtitle = payload.Subtitle or "", Color = payload.Color or C.Cyan, Duration = 3.2 })
end)

local function setPanelMode(showSeasons)
	local isAdmin = player:GetAttribute("EventAdmin") == true
	seasonMode = showSeasons
	eventList.Visible = not showSeasons
	seasonList.Visible = showSeasons
	seasonTab.Text = showSeasons and "ИВЕНТЫ" or "ПРАЗДНИКИ"
	if showSeasons then
		stopButton.Visible = false
		panelSubtitle.Text = isAdmin and "Visual theme · admin" or ("Тема: " .. tostring(state:GetAttribute("SeasonName") or "НОВЫЙ ГОД"))
	else
		panelSubtitle.Text = isAdmin and "45 сек · server admin" or "45 сек · окно 4 мин"
	end
end
seasonTab.Activated:Connect(function()
	setPanelMode(not seasonMode)
end)

local function togglePanel()
	eventPanel.Visible = not eventPanel.Visible
	if eventPanel.Visible then
		announcement.Visible = false
	end
end
eventButton.Activated:Connect(togglePanel)
closeButton.Activated:Connect(function()
	eventPanel.Visible = false
end)
UserInputService.InputBegan:Connect(function(input, processed)
	if not processed and input.KeyCode == Enum.KeyCode.V then
		togglePanel()
	end
end)

local function layoutEvents(phase)
	local camera = Workspace.CurrentCamera
	local screenWidth = camera and camera.ViewportSize.X or 1280
	local screenHeight = camera and camera.ViewportSize.Y or 720
	local sideWidth = math.clamp((screenWidth - 200) / 2, 100, 340)
	local centralGap = math.max(40, screenWidth - 32 - sideWidth * 2)
	local narrow = screenWidth < 700 or screenHeight < 680
	eventBar.Size = UDim2.new(0, sideWidth, 0, 72)
	if phase == "Lobby" then
		-- The lobby dock occupies the upper-right; its lower-right bay is free.
		eventBar.AnchorPoint = Vector2.new(1, 0)
		eventBar.Position = UDim2.new(1, -16, 0, 374)
	else
		-- Below the 190..326 coach, never through the 67 capture banner.
		eventBar.AnchorPoint = Vector2.new(0, 0)
		eventBar.Position = UDim2.new(0, 16, 0, 340)
	end
	if narrow and phase == "Lobby" then
		eventButton.AnchorPoint = Vector2.new(0.5, 0)
		eventButton.Position = UDim2.new(0.5, 0, 0, 426)
		eventButton.Size = UDim2.new(0, math.clamp(centralGap - 24, 40, 330), 0, 34)
	elseif narrow and (phase == "Build" or phase == "Battle") then
		eventButton.AnchorPoint = Vector2.new(0.5, 0)
		eventButton.Position = UDim2.new(0.5, 0, 0, phase == "Battle" and 240 or 268)
		eventButton.Size = UDim2.new(0, math.clamp(centralGap - 24, 40, 330), 0, 34)
	else
		eventButton.AnchorPoint = Vector2.new(0, 0)
		eventButton.Position = UDim2.new(0, 16, 0, 426)
		eventButton.Size = UDim2.new(0, math.min(330, sideWidth), 0, 34)
	end
	eventButton.TextSize = sideWidth < 240 and 11 or 14
	local compact = sideWidth < 240
	local timerWidth = compact and 58 or 92
	eventKicker.Size = UDim2.new(1, -(timerWidth + 30), 0, 14)
	eventTitle.Size = UDim2.new(1, -(timerWidth + 30), 0, 26)
	eventDescription.Size = UDim2.new(1, -32, 0, 23)
	eventTime.Size = UDim2.new(0, timerWidth, 0, 34)
	eventTime.Position = UDim2.new(1, -(timerWidth + 11), 0, 8)
	eventKicker.TextSize = compact and 8 or 10
	eventTitle.TextSize = compact and 14 or 19
	eventDescription.TextSize = compact and 9 or 11
	eventTime.TextSize = compact and 18 or 23
	local announcementWidth = math.clamp(centralGap - 24, 40, 650)
	local announcementHeight = narrow and 58 or 90
	announcement.Size = UDim2.new(0, announcementWidth, 0, announcementHeight)
	announcement.Position = UDim2.new(0.5, 0, 0, 233 + announcementHeight / 2)
	announcementTitle.Size = UDim2.new(1, -24, 0, narrow and 20 or 30)
	announcementTitle.Position = UDim2.new(0, 12, 0, narrow and 3 or 4)
	announcementText.Size = UDim2.new(1, -28, 0, narrow and 28 or 48)
	announcementText.Position = UDim2.new(0, 14, 0, narrow and 25 or 36)
	announcementTitle.TextSize = narrow and 14 or (announcementWidth < 240 and 18 or 27)
	announcementText.TextSize = narrow and 10 or (announcementWidth < 240 and 12 or 18)
	return centralGap
end

local function refresh()
	local phase = state:GetAttribute("Phase") or "Lobby"
	local centralGap = layoutEvents(phase)
	local isAdmin = player:GetAttribute("EventAdmin") == true
	local active = state:GetAttribute("EventActive") == true
	local id = active and (state:GetAttribute("EventId") or "") or (state:GetAttribute("EventNextId") or "")
	local definition = EventCatalog.Get(id) or EventCatalog.GetForSlot(0)
	eventBar.Visible = phase ~= "Results"
	eventButton.Visible = phase ~= "Results" and not announcement.Visible
	if phase == "Results" then
		eventPanel.Visible = false
		announcement.Visible = false
	end
	local color = active and (state:GetAttribute("EventColor") or definition.Color) or definition.Color
	eventAccent.BackgroundColor3 = color
	eventStroke.Color = color
	eventTime.TextColor3 = color
	if active then
		eventKicker.Text = state:GetAttribute("EventManual") == true and '<font color="#FF72C3"><b>⚡ ADMIN ABUSE · LIVE</b></font>' or '<font color="#77E4FF"><b>LIVE · СЕРВЕРНЫЙ ИВЕНТ</b></font>'
		eventTitle.Text = colored(state:GetAttribute("EventName") or definition.Name, color)
		eventDescription.Text = escape(state:GetAttribute("EventDescription") or definition.Description)
		eventTime.Text = tostring(state:GetAttribute("EventTime") or 0) .. "с"
	else
		eventKicker.Text = '<font color="#B7A4FF"><b>СЛЕДУЮЩИЙ ИВЕНТ · UTC РАСПИСАНИЕ</b></font>'
		eventTitle.Text = colored(definition.Name, color)
		eventDescription.Text = escape(definition.Description)
		eventTime.Text = state:GetAttribute("EventScheduleWaiting") == true and "В БОЮ" or formatTime(state:GetAttribute("EventTime") or 0)
	end
	if centralGap < 180 then
		eventButton.Text = isAdmin and '<font color="#FF83CA"><b>V · ADMIN</b></font>' or '<font color="#8BE9FF"><b>V · LIVE</b></font>'
	else
		eventButton.Text = isAdmin and '<font color="#FF83CA"><b>V · ADMIN ABUSE / ИВЕНТЫ</b></font>' or '<font color="#8BE9FF"><b>V · ИВЕНТЫ И РАСПИСАНИЕ</b></font>'
	end
	for eventId, start in pairs(adminRows) do
		start.Visible = isAdmin
	end
	stopButton.Visible = isAdmin and active and not seasonMode
	for _, apply in pairs(seasonButtons) do
		apply.Visible = true
		apply.Active = isAdmin
		apply.AutoButtonColor = isAdmin
		apply.Text = isAdmin and "ПРИМЕНИТЬ" or "ADMIN ONLY"
	end
	if seasonMode then
		panelSubtitle.Text = isAdmin and "Visual theme · admin" or ("Тема: " .. tostring(state:GetAttribute("SeasonName") or "НОВЫЙ ГОД"))
		panelStatus.Text = isAdmin and "Только visual · server admin" or "Праздничные темы"
	else
		panelStatus.Text = isAdmin and "Battle · server admin" or "Общее расписание · награды"
	end
end

task.spawn(function()
	while gui.Parent do
		refresh()
		task.wait(0.1)
	end
end)
refresh()
]]></string>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="45">
        <Properties>
          <string name="Name">ExpeditionClient</string>
          <string name="Source"><![CDATA[-- BLOCKSIEGE // PvE expedition hub + server Level/Coins ratings.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")
local player = Players.LocalPlayer
local Shared = ReplicatedStorage:WaitForChild("BlockSiege")
local ExpeditionCatalog = require(Shared:WaitForChild("ExpeditionCatalog"))
local remotes = Shared:WaitForChild("Remotes")
local state = Shared:WaitForChild("MatchState")

local C = { Background = Color3.fromRGB(12, 20, 34), Panel = Color3.fromRGB(29, 45, 66), Text = Color3.fromRGB(245, 250, 255), Muted = Color3.fromRGB(169, 192, 214), Green = Color3.fromRGB(103, 229, 183), Gold = Color3.fromRGB(255, 211, 107), Cyan = Color3.fromRGB(116, 222, 255), Purple = Color3.fromRGB(198, 160, 255), Red = Color3.fromRGB(255, 121, 116) }
local function new(className, properties, parent)
	local object = Instance.new(className)
	for key, value in pairs(properties or {}) do object[key] = value end
	object.Parent = parent
	return object
end
local function corner(object, radius)
	return new("UICorner", { CornerRadius = UDim.new(0, radius or 8) }, object)
end
local function escape(value)
	local escaped = tostring(value or ""):gsub("&", "&amp;"):gsub("<", "&lt;"):gsub(">", "&gt;"):gsub('"', "&quot;"):gsub("'", "&apos;")
	return escaped
end
local function label(parent, value, size, position, textSize, color)
	return new("TextLabel", { BackgroundTransparency = 1, RichText = true, Text = value, Size = size, Position = position or UDim2.new(), Font = Enum.Font.Gotham, TextWrapped = true, TextSize = textSize or 15, TextColor3 = color or C.Text }, parent)
end
local function button(parent, value, size, position, color)
	local object = new("TextButton", { BackgroundColor3 = color or C.Panel, Size = size, Position = position or UDim2.new(), Font = Enum.Font.GothamBold, RichText = true, Text = value, TextColor3 = C.Text, TextSize = 14, AutoButtonColor = true }, parent)
	corner(object, 7)
	new("UIStroke", { Color = C.Cyan, Thickness = 1, Transparency = 0.35 }, object)
	return object
end
local gui = new("ScreenGui", { Name = "BlockSiegeExpeditionUI", ResetOnSpawn = false, DisplayOrder = 9, ZIndexBehavior = Enum.ZIndexBehavior.Sibling }, player:WaitForChild("PlayerGui"))
local hubButton = button(gui, "X · PVE / РЕЙТИНГ", UDim2.new(0, 300, 0, 34), UDim2.new(0.5, 0, 0, 118), Color3.fromRGB(40, 115, 105))
hubButton.AnchorPoint = Vector2.new(0.5, 0)
local panel = new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0.52, 0), Size = UDim2.new(0.92, 0, 0.8, 0), BackgroundColor3 = C.Background, Visible = false, Active = true }, gui)
new("UISizeConstraint", { MinSize = Vector2.new(320, 390), MaxSize = Vector2.new(640, 630) }, panel)
corner(panel, 12)
new("UIStroke", { Color = C.Green, Thickness = 1.6, Transparency = 0.1 }, panel)
local title = label(panel, '<font color="#67E5B7"><b>PVE // EXPEDITIONS</b></font>', UDim2.new(1, -130, 0, 36), UDim2.new(0, 16, 0, 9), 22, C.Text)
local closeButton = button(panel, "×", UDim2.new(0, 42, 0, 36), UDim2.new(1, -54, 0, 10), C.Panel)
local expeditionTab = button(panel, "ЭКСПЕДИЦИИ", UDim2.new(0, 148, 0, 30), UDim2.new(0, 16, 0, 51), C.Green)
local ratingTab = button(panel, "РЕЙТИНГИ", UDim2.new(0, 120, 0, 30), UDim2.new(0, 174, 0, 51), C.Panel)
local expeditionFrame = new("Frame", { Size = UDim2.new(1, -32, 1, -145), Position = UDim2.new(0, 16, 0, 91), BackgroundTransparency = 1 }, panel)
local ratingFrame = new("Frame", { Size = UDim2.new(1, -32, 1, -145), Position = UDim2.new(0, 16, 0, 91), BackgroundTransparency = 1, Visible = false }, panel)
local locationList = new("ScrollingFrame", { Size = UDim2.new(1, 0, 1, -105), BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 5, CanvasSize = UDim2.new(0, 0, 0, #ExpeditionCatalog.Order * 101) }, expeditionFrame)
new("UIListLayout", { Padding = UDim.new(0, 7), SortOrder = Enum.SortOrder.LayoutOrder }, locationList)
local rows = {}
for index, id in ipairs(ExpeditionCatalog.Order) do
	local definition = ExpeditionCatalog.Get(id)
	local row = new("Frame", { Size = UDim2.new(1, -8, 0, 94), BackgroundColor3 = C.Panel, LayoutOrder = index }, locationList)
	corner(row, 8)
	local name = label(row, escape(definition.Name), UDim2.new(0.58, 0, 0, 24), UDim2.new(0, 10, 0, 6), 17, definition.Color)
	name.Font = Enum.Font.GothamBold
	local description = label(row, escape(definition.Subtitle), UDim2.new(0.58, 0, 0, 30), UDim2.new(0, 10, 0, 31), 12, C.Muted)
	description.TextXAlignment = Enum.TextXAlignment.Left
	local requirement = label(row, "", UDim2.new(0.58, 0, 0, 22), UDim2.new(0, 10, 0, 65), 11, C.Gold)
	local action = button(row, "", UDim2.new(0.32, 0, 0, 56), UDim2.new(0.65, 0, 0, 19), definition.Color)
	action.Activated:Connect(function()
		if state:GetAttribute("Phase") == "Battle" then
			remotes.ExpeditionAction:FireServer("Enter", id)
		else
			remotes.ExpeditionAction:FireServer("Select", id)
		end
	end)
	rows[id] = { Action = action, Requirement = requirement }
end
local trainButton = button(expeditionFrame, "ТРЕНИРОВКА ОТРЯДА", UDim2.new(1, 0, 0, 34), UDim2.new(0, 0, 1, -96), C.Purple)
trainButton.Activated:Connect(function() remotes.ExpeditionAction:FireServer("Train") end)
local status = label(expeditionFrame, "", UDim2.new(0.68, 0, 0, 48), UDim2.new(0, 0, 1, -57), 13, C.Cyan)
status.TextXAlignment = Enum.TextXAlignment.Left
local exitButton = button(expeditionFrame, "ВЫЙТИ ИЗ РЕЙДА", UDim2.new(0.29, 0, 0, 38), UDim2.new(0.7, 0, 1, -52), C.Red)
exitButton.Visible = false
exitButton.Activated:Connect(function() remotes.ExpeditionAction:FireServer("Exit") end)

local levelBoard = new("ScrollingFrame", { Position = UDim2.new(0, 0, 0, 30), Size = UDim2.new(0.49, 0, 1, -65), BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 4, CanvasSize = UDim2.new(0, 0, 0, 370) }, ratingFrame)
local coinBoard = new("ScrollingFrame", { Position = UDim2.new(0.51, 0, 0, 30), Size = UDim2.new(0.49, 0, 1, -65), BackgroundTransparency = 1, BorderSizePixel = 0, ScrollBarThickness = 4, CanvasSize = UDim2.new(0, 0, 0, 370) }, ratingFrame)
label(ratingFrame, '<font color="#74DEFF"><b>TOP LEVEL</b></font>', UDim2.new(0.49, 0, 0, 24), UDim2.new(), 16, C.Cyan)
label(ratingFrame, '<font color="#FFD36F"><b>TOP COINS</b></font>', UDim2.new(0.49, 0, 0, 24), UDim2.new(0.51, 0, 0, 0), 16, C.Gold)
local boardRows = { Level = {}, Coins = {} }
for boardName, board in pairs({ Level = levelBoard, Coins = coinBoard }) do
	for index = 1, 10 do
		local row = label(board, "", UDim2.new(1, -5, 0, 34), UDim2.new(0, 0, 0, (index - 1) * 37), 12, C.Text)
		row.TextXAlignment = Enum.TextXAlignment.Left
		boardRows[boardName][index] = row
	end
end
label(ratingFrame, "Online server snapshot · не глобальный OrderedDataStore", UDim2.new(1, 0, 0, 25), UDim2.new(0, 0, 1, -28), 11, C.Muted)

local activeTab = "Expeditions"
local currentSnapshot
local leaderboard = { Level = {}, Coins = {} }
local selectedId = player:GetAttribute("SelectedExpedition") or "VerdantBastion"
local function showPanel(tab)
	local phase = state:GetAttribute("Phase")
	if phase ~= "Lobby" and phase ~= "Battle" then return end
	activeTab = tab or activeTab
	panel.Visible = true
	expeditionFrame.Visible = activeTab == "Expeditions"
	ratingFrame.Visible = activeTab == "Ratings"
	expeditionTab.BackgroundColor3 = activeTab == "Expeditions" and C.Green or C.Panel
	ratingTab.BackgroundColor3 = activeTab == "Ratings" and C.Green or C.Panel
	title.Text = activeTab == "Ratings" and '<font color="#FFD36F"><b>LOBBY // RATINGS</b></font>' or '<font color="#67E5B7"><b>PVE // EXPEDITIONS</b></font>'
end
local function renderRatings()
	for _, boardName in ipairs({ "Level", "Coins" }) do
		for index = 1, 10 do
			local entry = leaderboard[boardName] and leaderboard[boardName][index]
			boardRows[boardName][index].Text = entry and string.format('<font color="#FFD36F"><b>#%d</b></font> %s\n<font color="#74DEFF">%s</font>', index, escape(entry.DisplayName or entry.Name), tostring(entry.Value)) or string.format('<font color="#6E829E">#%d · —</font>', index)
		end
	end
end
local function refresh()
	local phase = state:GetAttribute("Phase") or "Lobby"
	local camera = Workspace.CurrentCamera
	local width = camera and camera.ViewportSize.X or 1280
	local side = math.clamp((width - 200) / 2, 100, 340)
	local gap = math.max(40, width - 32 - side * 2)
	hubButton.Size = UDim2.new(0, math.clamp(gap - 24, 40, 330), 0, 34)
	hubButton.Text = gap < 180 and "X · PVE" or "X · PVE / РЕЙТИНГ"
	hubButton.TextSize = gap < 180 and 10 or 14
	hubButton.Visible = phase == "Lobby"
	trainButton.Visible = phase == "Lobby" and not (currentSnapshot and currentSnapshot.InExpedition)
	local squadLevel = player:GetAttribute("SquadLevel") or 1
	trainButton.Text = squadLevel >= 10 and "ОТРЯД · MAX LEVEL" or string.format("ТРЕНИРОВКА +100 XP · %d МОНЕТ", 100 + squadLevel * 50)
	trainButton.Active = squadLevel < 10
	if phase ~= "Lobby" and phase ~= "Battle" then panel.Visible = false end
	local level = player:GetAttribute("Level") or 1
	local wins = player:GetAttribute("Wins") or 0
	for id, row in pairs(rows) do
		local definition = ExpeditionCatalog.Get(id)
		local unlocked = ExpeditionCatalog.IsUnlocked(id, level, wins)
		row.Requirement.Text = unlocked and string.format('<font color="#72E6B1">LV %d · WINS %d · 3 WAVES + BOSS</font>', definition.RequiredLevel, definition.RequiredWins) or string.format('<font color="#FF8C83">LOCKED · LV %d · WINS %d</font>', definition.RequiredLevel, definition.RequiredWins)
		row.Action.Active = unlocked
		row.Action.AutoButtonColor = unlocked
		row.Action.BackgroundColor3 = unlocked and definition.Color or C.Panel
		row.Action.Text = not unlocked and "LOCKED" or (phase == "Battle" and "ВОЙТИ" or (selectedId == id and "ВЫБРАНО" or "ВЫБРАТЬ"))
	end
	if currentSnapshot and currentSnapshot.InExpedition then
		status.Text = string.format('<font color="#74DEFF"><b>%s</b></font> · WAVE %d/%d · ENEMIES %d · PLAYERS %d', escape(currentSnapshot.LocationId), currentSnapshot.Wave or 0, currentSnapshot.MaxWaves or 3, currentSnapshot.Enemies or 0, currentSnapshot.Players or 0)
		exitButton.Visible = true
	else
		status.Text = string.format('<font color="#A9C0D6">Выбрано: %s · Squad LV %d · Best wave %d</font>', escape(selectedId), player:GetAttribute("SquadLevel") or 1, player:GetAttribute("ExpeditionBestWave") or 0)
		exitButton.Visible = false
	end
end

hubButton.Activated:Connect(function() showPanel("Expeditions") end)
closeButton.Activated:Connect(function() panel.Visible = false end)
expeditionTab.Activated:Connect(function() showPanel("Expeditions") end)
ratingTab.Activated:Connect(function() showPanel("Ratings") end)
UserInputService.InputBegan:Connect(function(input, processed)
	if processed then return end
	if input.KeyCode == Enum.KeyCode.X then
		if panel.Visible then panel.Visible = false else showPanel("Expeditions") end
	elseif input.KeyCode == Enum.KeyCode.Y then
		showPanel("Ratings")
	end
end)
remotes.OpenPanel.OnClientEvent:Connect(function(name)
	if name == "Expeditions" then showPanel("Expeditions") elseif name == "Ratings" then showPanel("Ratings") end
end)
remotes.ExpeditionFX.OnClientEvent:Connect(function(payload)
	if payload.Type == "Snapshot" then
		local wasIn = currentSnapshot and currentSnapshot.InExpedition
		currentSnapshot = payload.InExpedition and payload or nil
		if payload.LocationId then selectedId = payload.LocationId end
		if payload.InExpedition and not wasIn then showPanel("Expeditions") end
		refresh()
	end
end)
remotes.LeaderboardUpdate.OnClientEvent:Connect(function(payload)
	leaderboard = payload
	renderRatings()
end)
state:GetAttributeChangedSignal("Phase"):Connect(refresh)
local refreshClock = 0
RunService.RenderStepped:Connect(function(deltaTime)
	refreshClock = refreshClock + deltaTime
	if refreshClock >= 0.2 then
		refreshClock = 0
		refresh()
	end
end)
renderRatings()
refresh()
]]></string>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="46">
        <Properties>
          <string name="Name">DeathClient</string>
          <string name="Source"><![CDATA[-- BLOCKSIEGE // Server-sourced death card and compact kill feed.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local player = Players.LocalPlayer
local Shared = ReplicatedStorage:WaitForChild("BlockSiege")
local remotes = Shared:WaitForChild("Remotes")
local state = Shared:WaitForChild("MatchState")

local C = { Background = Color3.fromRGB(16, 20, 35), Red = Color3.fromRGB(255, 111, 116), Gold = Color3.fromRGB(255, 213, 111), Text = Color3.fromRGB(246, 249, 255), Muted = Color3.fromRGB(174, 191, 216) }
local function new(className, properties, parent)
	local object = Instance.new(className)
	for key, value in pairs(properties or {}) do object[key] = value end
	object.Parent = parent
	return object
end
local function escape(value)
	local escaped = tostring(value or ""):gsub("&", "&amp;"):gsub("<", "&lt;"):gsub(">", "&gt;"):gsub('"', "&quot;"):gsub("'", "&apos;")
	return escaped
end
local function label(parent, textValue, size, position, textSize, color)
	return new("TextLabel", { BackgroundTransparency = 1, RichText = true, Text = textValue, Size = size, Position = position or UDim2.new(), Font = Enum.Font.GothamBold, TextWrapped = true, TextSize = textSize or 16, TextColor3 = color or C.Text }, parent)
end
local gui = new("ScreenGui", { Name = "BlockSiegeDeathUI", ResetOnSpawn = false, DisplayOrder = 14, ZIndexBehavior = Enum.ZIndexBehavior.Sibling }, player:WaitForChild("PlayerGui"))
local card = new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0.43, 0), Size = UDim2.new(0, 380, 0, 132), BackgroundColor3 = C.Background, BackgroundTransparency = 0.04, Visible = false, ZIndex = 20 }, gui)
new("UICorner", { CornerRadius = UDim.new(0, 12) }, card)
new("UIStroke", { Color = C.Red, Thickness = 2, Transparency = 0.08 }, card)
local title = label(card, '<font color="#FF6F74"><b>ВЫ ВЫБЫЛИ ИЗ БОЯ</b></font>', UDim2.new(1, -28, 0, 32), UDim2.new(0, 14, 0, 10), 22, C.Red)
title.ZIndex = 21
local detail = label(card, "", UDim2.new(1, -28, 0, 43), UDim2.new(0, 14, 0, 47), 15, C.Text)
detail.ZIndex = 21
local timer = label(card, "", UDim2.new(1, -28, 0, 25), UDim2.new(0, 14, 0, 98), 14, C.Gold)
timer.ZIndex = 21
local feed = label(gui, "", UDim2.new(0, 330, 0, 52), UDim2.new(0, 16, 0, 112), 12, C.Muted)
feed.TextXAlignment = Enum.TextXAlignment.Left
feed.Visible = false
local version = 0
local deathEnds = 0
local feedVersion = 0

local function sourceText(payload)
	if payload.Source == "Expedition" then
		return "PVЕ СТРАЖ · " .. (payload.KillerName ~= "" and payload.KillerName or "экспедиция")
	end
	if payload.KillerName and payload.KillerName ~= "" then
		return "Источник: " .. payload.KillerName
	end
	return "Источник не указан · сервер не присваивает случайный kill"
end

remotes.DeathFX.OnClientEvent:Connect(function(payload)
	if payload.VictimUserId == player.UserId then
		version = version + 1
		local current = version
		deathEnds = os.clock() + math.max(2, tonumber(payload.RespawnDuration) or 4)
		title.Text = payload.InExpedition and '<font color="#C6A0FF"><b>PVЕ · ВЫ ПАЛИ В РЕЙДЕ</b></font>' or '<font color="#FF6F74"><b>ВЫ ВЫБЫЛИ ИЗ БОЯ</b></font>'
		detail.Text = escape(sourceText(payload))
		card.Visible = true
		task.delay(math.max(2, tonumber(payload.RespawnDuration) or 4) + 0.25, function()
			if current == version then card.Visible = false end
		end)
	elseif state:GetAttribute("Phase") == "Battle" then
		feedVersion = feedVersion + 1
		local current = feedVersion
		local killerName = payload.KillerName
		local killer = (type(killerName) == "string" and killerName ~= "") and killerName or (payload.Source == "Expedition" and "PVЕ" or "UNKNOWN")
		feed.Text = string.format('<font color="#FFD36F"><b>%s</b></font>  →  <font color="#AEBFD8">%s</font>', escape(killer), escape(payload.VictimName))
		feed.Visible = true
		task.delay(3.5, function()
			if current == feedVersion then feed.Visible = false end
		end)
	end
end)

state:GetAttributeChangedSignal("Phase"):Connect(function()
	local phase = state:GetAttribute("Phase")
	if phase == "Lobby" or phase == "Results" then
		version = version + 1
		feedVersion = feedVersion + 1
		card.Visible = false
		feed.Visible = false
	end
end)
RunService.RenderStepped:Connect(function()
	if card.Visible then
		timer.Text = "ВОЗВРАЩЕНИЕ ЧЕРЕЗ  " .. string.format("%.1f", math.max(0, deathEnds - os.clock())) .. " s"
	end
	local camera = Workspace.CurrentCamera
	if camera then
		card.Size = UDim2.new(0, math.min(380, math.max(280, camera.ViewportSize.X - 32)), 0, 132)
		feed.Size = UDim2.new(0, math.min(330, math.max(220, camera.ViewportSize.X - 32)), 0, 52)
	end
end)
]]></string>
        </Properties>
      </Item>



      <Item class="LocalScript" referent="27">
        <Properties>
          <string name="Name">LobbyClient</string>
          <string name="Source"><![CDATA[-- Lobby progression HUD and NPC panels: upgrades, daily rewards, coin defenses and cosmetic-only Robux shop.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")

local player = Players.LocalPlayer
local Shared = ReplicatedStorage:WaitForChild("BlockSiege")
local Config = require(Shared:WaitForChild("Config"))
local Catalog = require(Shared:WaitForChild("Catalog"))
local remotes = Shared:WaitForChild("Remotes")
local state = Shared:WaitForChild("MatchState")

local C = {
	Background = Color3.fromRGB(20, 28, 48),
	Panel = Color3.fromRGB(36, 49, 76),
	Text = Color3.fromRGB(248, 250, 255),
	Muted = Color3.fromRGB(177, 192, 216),
	Gold = Color3.fromRGB(255, 197, 68),
	Green = Color3.fromRGB(75, 211, 137),
	Cyan = Color3.fromRGB(80, 202, 255),
	Purple = Color3.fromRGB(195, 117, 255),
	Red = Color3.fromRGB(255, 110, 100),
}

local function new(className, properties, parent)
	local object = Instance.new(className)
	for key, value in pairs(properties or {}) do
		object[key] = value
	end
	object.Parent = parent
	return object
end

local function corner(object, radius)
	return new("UICorner", { CornerRadius = UDim.new(0, radius or 6) }, object)
end

local function escapeRich(value)
	local escaped = tostring(value or ""):gsub("&", "&amp;"):gsub("<", "&lt;"):gsub(">", "&gt;"):gsub('"', "&quot;"):gsub("'", "&apos;")
	return escaped
end

local function hexColor(color)
	color = color or C.Text
	return string.format("%02X%02X%02X", math.floor(color.R * 255 + 0.5), math.floor(color.G * 255 + 0.5), math.floor(color.B * 255 + 0.5))
end

local function rich(value, color)
	return string.format('<font color="#%s"><b>%s</b></font>', hexColor(color), escapeRich(value))
end

local function highlight(value)
	local formatted = escapeRich(value)
	formatted = formatted:gsub("6×6", '<font color="#62DFFF"><b>6×6</b></font>')
	formatted = formatted:gsub("75", '<font color="#FFD166"><b>75</b></font>')
	formatted = formatted:gsub("(%+%d+)", '<font color="#72E6B1"><b>%1</b></font>')
	formatted = formatted:gsub("БЫСТРЫЙ СТАРТ", '<font color="#72E6B1"><b>БЫСТРЫЙ СТАРТ</b></font>')
	return formatted
end

local function label(parent, value, size, position, textSize, color)
	return new("TextLabel", {
		BackgroundTransparency = 1,
		Size = size,
		Position = position or UDim2.new(),
		Font = Enum.Font.Gotham,
		RichText = true,
		Text = value,
		TextColor3 = color or C.Text,
		TextSize = textSize or 17,
		TextWrapped = true,
	}, parent)
end

local function button(parent, value, size, position, color)
	local object = new("TextButton", {
		BackgroundColor3 = color or C.Panel,
		Size = size,
		Position = position or UDim2.new(),
		Font = Enum.Font.GothamBold,
		RichText = true,
		Text = value,
		TextColor3 = C.Text,
		TextSize = 16,
		AutoButtonColor = true,
	}, parent)
	corner(object)
	new("UIStroke", { Color = Color3.fromRGB(91, 108, 101), Thickness = 1 }, object)
	return object
end

local gui = new("ScreenGui", {
	Name = "BlockSiegeLobbyUI",
	ResetOnSpawn = false,
	IgnoreGuiInset = false,
	ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
}, player:WaitForChild("PlayerGui"))

local statsPanel = new("Frame", {
	Position = UDim2.new(0, 16, 0, 112),
	Size = UDim2.new(0, 330, 0, 148),
	BackgroundColor3 = C.Background,
	BackgroundTransparency = 0.04,
}, gui)
corner(statsPanel, 10)
new("UIStroke", { Color = Color3.fromRGB(79, 104, 148), Thickness = 1 }, statsPanel)
local levelLabel = label(statsPanel, "УРОВЕНЬ 1", UDim2.new(0.48, 0, 0, 29), UDim2.new(0, 12, 0, 7), 21, C.Gold)
levelLabel.Font = Enum.Font.GothamBold
local xpLabel = label(statsPanel, "0 / 80 XP", UDim2.new(0.48, -12, 0, 25), UDim2.new(0.5, 0, 0, 10), 14, C.Muted)
xpLabel.TextXAlignment = Enum.TextXAlignment.Right
local xpTrack = new("Frame", { Position = UDim2.new(0, 12, 0, 40), Size = UDim2.new(1, -24, 0, 10), BackgroundColor3 = C.Panel }, statsPanel)
corner(xpTrack, 5)
local xpFill = new("Frame", { Size = UDim2.fromScale(0, 1), BackgroundColor3 = C.Gold }, xpTrack)
corner(xpFill, 5)
local statsLabel = label(statsPanel, "HP 120/120 · ARMOR 0%", UDim2.new(1, -24, 0, 24), UDim2.new(0, 12, 0, 59), 15, C.Text)
local speedLabel = label(statsPanel, "SPEED 20 · BUILDS 14", UDim2.new(1, -24, 0, 23), UDim2.new(0, 12, 0, 85), 14, C.Cyan)
local coinsLabel = label(statsPanel, "МОНЕТЫ 0 · ЖЕТОНЫ 0", UDim2.new(1, -24, 0, 25), UDim2.new(0, 12, 0, 113), 14, C.Gold)

local guidePanel = new("Frame", {
	Position = UDim2.new(0, 16, 0, 270),
	Size = UDim2.new(0, 330, 0, 148),
	BackgroundColor3 = C.Background,
	BackgroundTransparency = 0.04,
}, gui)
corner(guidePanel, 10)
new("UIStroke", { Color = C.Green, Thickness = 1 }, guidePanel)
local guideTitle = label(guidePanel, "ТВОЙ СЛЕДУЮЩИЙ ШАГ", UDim2.new(1, -24, 0, 26), UDim2.new(0, 12, 0, 8), 15, C.Green)
guideTitle.Font = Enum.Font.GothamBold
local guideText = label(guidePanel, "Нажми БЫСТРЫЙ СТАРТ — пустые места займут боты.", UDim2.new(1, -24, 0, 55), UDim2.new(0, 12, 0, 38), 15, C.Text)
guideText.TextXAlignment = Enum.TextXAlignment.Left
local nextRewardLabel = label(guidePanel, "LV 2 · RAPID SMG + 50 монет + жетон", UDim2.new(1, -24, 0, 42), UDim2.new(0, 12, 0, 99), 14, C.Gold)
nextRewardLabel.TextXAlignment = Enum.TextXAlignment.Left

local lobbyDock = new("Frame", {
	AnchorPoint = Vector2.new(1, 0),
	Position = UDim2.new(1, -16, 0, 122),
	Size = UDim2.new(0, 300, 0, 249),
	BackgroundTransparency = 1,
}, gui)
local rewardsButton = button(lobbyDock, "★  НАГРАДЫ УРОВНЕЙ  [J]", UDim2.new(1, 0, 0, 42), UDim2.new(), C.Green)
rewardsButton.TextColor3 = Color3.fromRGB(16, 40, 31)
local upgradeButton = button(lobbyDock, "КУЗНИЦА · УЛУЧШЕНИЯ  [U]", UDim2.new(1, 0, 0, 42), UDim2.new(0, 0, 0, 49), C.Cyan)
upgradeButton.TextColor3 = Color3.fromRGB(22, 37, 40)
local dailyButton = button(lobbyDock, "ПОДАРОК · ЕЖЕДНЕВНЫЙ БОНУС", UDim2.new(1, 0, 0, 42), UDim2.new(0, 0, 0, 98), C.Gold)
dailyButton.TextColor3 = Color3.fromRGB(35, 32, 22)
local shopButton = button(lobbyDock, "КОСМЕТИКА · МАГАЗИН  [K]", UDim2.new(1, 0, 0, 42), UDim2.new(0, 0, 0, 147), C.Purple)
local defenseButton = button(lobbyDock, "ОБОРОНА · ЛОВУШКИ / МИНЫ", UDim2.new(1, 0, 0, 42), UDim2.new(0, 0, 0, 196), Color3.fromRGB(232, 126, 64))

local panel = new("Frame", {
	AnchorPoint = Vector2.new(0.5, 0.5),
	Position = UDim2.fromScale(0.5, 0.53),
	Size = UDim2.new(0.92, 0, 0.82, 0),
	BackgroundColor3 = C.Background,
	Visible = false,
}, gui)
corner(panel, 8)
new("UIStroke", { Color = Color3.fromRGB(107, 130, 121), Thickness = 2 }, panel)
new("UISizeConstraint", { MinSize = Vector2.new(310, 350), MaxSize = Vector2.new(650, 660) }, panel)
local panelTitle = label(panel, "FORGE", UDim2.new(1, -70, 0, 42), UDim2.new(0, 16, 0, 8), 24, C.Gold)
local closeButton = button(panel, "×", UDim2.new(0, 42, 0, 38), UDim2.new(1, -52, 0, 8), C.Panel)
local panelHint = label(panel, "", UDim2.new(1, -32, 0, 35), UDim2.new(0, 16, 0, 51), 15, C.Muted)

local upgradeFrame = new("Frame", { Size = UDim2.new(1, -32, 1, -100), Position = UDim2.new(0, 16, 0, 91), BackgroundTransparency = 1, Visible = false }, panel)
local dailyFrame = new("Frame", { Size = UDim2.new(1, -32, 1, -100), Position = UDim2.new(0, 16, 0, 91), BackgroundTransparency = 1, Visible = false }, panel)
local shopFrame = new("ScrollingFrame", { Size = UDim2.new(1, -32, 1, -100), Position = UDim2.new(0, 16, 0, 91), BackgroundTransparency = 1, Visible = false, BorderSizePixel = 0, ScrollBarThickness = 5, CanvasSize = UDim2.new(0, 0, 0, #Catalog.CosmeticOrder * 106) }, panel)
local defenseFrame = new("Frame", { Size = UDim2.new(1, -32, 1, -100), Position = UDim2.new(0, 16, 0, 91), BackgroundTransparency = 1, Visible = false }, panel)
local rewardsFrame = new("Frame", { Size = UDim2.new(1, -32, 1, -100), Position = UDim2.new(0, 16, 0, 91), BackgroundTransparency = 1, Visible = false }, panel)

local rewardRows = {}
local rewardList = new("ScrollingFrame", {
	Size = UDim2.fromScale(1, 1),
	BackgroundTransparency = 1,
	BorderSizePixel = 0,
	CanvasSize = UDim2.new(0, 0, 0, #Catalog.LevelRewardOrder * 68),
	ScrollBarThickness = 5,
	ScrollBarImageColor3 = C.Cyan,
}, rewardsFrame)
new("UIListLayout", { Padding = UDim.new(0, 7), SortOrder = Enum.SortOrder.LayoutOrder }, rewardList)
for index, rewardLevel in ipairs(Catalog.LevelRewardOrder) do
	local reward = Catalog.LevelRewards[rewardLevel]
	local row = new("Frame", { Size = UDim2.new(1, -8, 0, 60), BackgroundColor3 = C.Panel, LayoutOrder = index }, rewardList)
	corner(row, 8)
	local badge = label(row, "LV " .. rewardLevel, UDim2.new(0, 66, 1, 0), UDim2.new(0, 8, 0, 0), 18, C.Gold)
	badge.Font = Enum.Font.GothamBold
	local description = label(row, escapeRich(reward.Description), UDim2.new(1, -176, 1, -8), UDim2.new(0, 79, 0, 4), 14, C.Text)
	description.TextXAlignment = Enum.TextXAlignment.Left
	local status = label(row, "ЗАКРЫТО", UDim2.new(0, 92, 1, 0), UDim2.new(1, -98, 0, 0), 12, C.Muted)
	status.Font = Enum.Font.GothamBold
	rewardRows[rewardLevel] = { Row = row, Status = status }
end

local upgradeRows = {}
for index, id in ipairs(Catalog.UpgradeOrder) do
	local definition = Catalog.Upgrades[id]
	local row = new("Frame", { Size = UDim2.new(1, 0, 0, 76), Position = UDim2.new(0, 0, 0, (index - 1) * 83), BackgroundColor3 = C.Panel }, upgradeFrame)
	corner(row)
	label(row, rich(definition.Name, C.Cyan), UDim2.new(0.55, 0, 0, 24), UDim2.new(0, 10, 0, 6), 18, C.Cyan)
	local description = label(row, definition.Description, UDim2.new(0.58, 0, 0, 38), UDim2.new(0, 10, 0, 30), 13, C.Muted)
	description.TextXAlignment = Enum.TextXAlignment.Left
	local action = button(row, "", UDim2.new(0.36, 0, 0, 56), UDim2.new(0.62, 0, 0, 10), C.Green)
	action.Activated:Connect(function()
		remotes.ProgressionAction:FireServer("Upgrade", id)
	end)
	upgradeRows[id] = { Action = action }
end

label(dailyFrame, "ПОДАРОК ЗА ВХОД", UDim2.new(1, 0, 0, 44), UDim2.new(), 28, C.Gold)
label(dailyFrame, "Монеты, XP и жетон кейса. Чем выше уровень, тем больше монет.\nКейсы по-прежнему открываются только за игровую валюту.", UDim2.new(1, 0, 0, 92), UDim2.new(0, 0, 0, 58), 18, C.Text)
local dailyStatus = label(dailyFrame, "", UDim2.new(1, 0, 0, 48), UDim2.new(0, 0, 0, 166), 19, C.Cyan)
local dailyClaim = button(dailyFrame, "ПОЛУЧИТЬ БОНУС", UDim2.new(1, 0, 0, 58), UDim2.new(0, 0, 0, 235), C.Green)
dailyClaim.Activated:Connect(function()
	remotes.ProgressionAction:FireServer("Daily")
end)
label(dailyFrame, "Сервер проверяет cooldown и сохраняет награду в профиле.", UDim2.new(1, 0, 0, 50), UDim2.new(0, 0, 0, 315), 15, C.Muted)

local shopRows = {}
for index, id in ipairs(Catalog.CosmeticOrder) do
	local definition = Catalog.Cosmetics[id]
	local row = new("Frame", { Size = UDim2.new(1, 0, 0, 98), Position = UDim2.new(0, 0, 0, (index - 1) * 106), BackgroundColor3 = C.Panel }, shopFrame)
	corner(row)
	label(row, rich(definition.Name, C.Purple), UDim2.new(0.58, 0, 0, 26), UDim2.new(0, 10, 0, 6), 18, C.Purple)
	local description = label(row, definition.Description, UDim2.new(0.58, 0, 0, 54), UDim2.new(0, 10, 0, 34), 13, C.Muted)
	description.TextXAlignment = Enum.TextXAlignment.Left
	local action = button(row, "", UDim2.new(0.36, 0, 0, 70), UDim2.new(0.62, 0, 0, 14), C.Purple)
	action.Activated:Connect(function()
		remotes.ShopAction:FireServer("BuyCosmetic", id)
	end)
	shopRows[id] = { Action = action }
end

local defenseRows = {}
for index, id in ipairs(Catalog.DefenseOrder) do
	local definition = Catalog.Defenses[id]
	local row = new("Frame", { Size = UDim2.new(1, 0, 0, 98), Position = UDim2.new(0, 0, 0, (index - 1) * 106), BackgroundColor3 = C.Panel }, defenseFrame)
	corner(row)
	label(row, rich(definition.Name, Color3.fromRGB(255, 151, 82)), UDim2.new(0.58, 0, 0, 26), UDim2.new(0, 10, 0, 6), 18, Color3.fromRGB(255, 151, 82))
	local description = label(row, definition.Description, UDim2.new(0.58, 0, 0, 54), UDim2.new(0, 10, 0, 34), 13, C.Muted)
	description.TextXAlignment = Enum.TextXAlignment.Left
	local action = button(row, "", UDim2.new(0.36, 0, 0, 70), UDim2.new(0.62, 0, 0, 14), Color3.fromRGB(211, 111, 57))
	action.Activated:Connect(function()
		remotes.ProgressionAction:FireServer("BuyDefense", id)
	end)
	defenseRows[id] = { Action = action }
end

local profile
local activePanel
local function refreshPanels()
	if profile then
		for id, row in pairs(upgradeRows) do
			local definition = Catalog.Upgrades[id]
			local level = profile.Upgrades and profile.Upgrades[id] or 0
			if level >= definition.MaxLevel then
				row.Action.Text = "MAX · " .. level .. "/" .. definition.MaxLevel
				row.Action.BackgroundColor3 = C.Panel
			else
				local cost = definition.Costs[level + 1]
				local required = definition.RequiredLevels[level + 1] or 1
				row.Action.Text = string.format("%d/%d · %d монет\nLv %d+", level, definition.MaxLevel, cost, required)
				row.Action.BackgroundColor3 = C.Green
			end
		end
		for id, row in pairs(shopRows) do
			local definition = Catalog.Cosmetics[id]
			local owned = profile.OwnedCosmetics and profile.OwnedCosmetics[id]
			local equipped = profile.SelectedCosmetics and profile.SelectedCosmetics[definition.Slot] == id
			if equipped then
				row.Action.Text = "ЭКИПИРОВАНО"
				row.Action.BackgroundColor3 = C.Green
			elseif owned then
				row.Action.Text = "ЭКИПИРОВАТЬ"
				row.Action.BackgroundColor3 = C.Cyan
			else
				local testPrefix = RunService:IsStudio() and Config.EnableStudioTestPurchases and "TEST · " or ""
				row.Action.Text = string.format("%s%d R$\nКУПИТЬ", testPrefix, definition.RobuxPrice)
				row.Action.BackgroundColor3 = C.Purple
			end
		end
		for id, row in pairs(defenseRows) do
			local definition = Catalog.Defenses[id]
			local owned = profile.OwnedDefenses and profile.OwnedDefenses[id]
			if owned then
				row.Action.Text = "ЧЕРТЁЖ КУПЛЕН"
				row.Action.BackgroundColor3 = C.Green
			else
				row.Action.Text = string.format("%d монет\nLv %d+", definition.Price, definition.RequiredLevel)
				row.Action.BackgroundColor3 = Color3.fromRGB(211, 111, 57)
			end
		end
		local currentLevel = Catalog.LevelForXP(profile.XP or 0)
		local nextLevel = Catalog.GetNextLevelReward(currentLevel)
		for rewardLevel, row in pairs(rewardRows) do
			local claimed = profile.ClaimedLevelRewards and (profile.ClaimedLevelRewards[tostring(rewardLevel)] or profile.ClaimedLevelRewards[rewardLevel])
			if claimed then
				row.Status.Text = "ПОЛУЧЕНО"
				row.Status.TextColor3 = C.Green
				row.Row.BackgroundColor3 = C.Panel
			elseif rewardLevel == nextLevel then
				row.Status.Text = "СЛЕДУЮЩАЯ"
				row.Status.TextColor3 = C.Gold
				row.Row.BackgroundColor3 = Color3.fromRGB(57, 66, 79)
			elseif rewardLevel <= currentLevel then
				row.Status.Text = "ОТКРЫТО"
				row.Status.TextColor3 = C.Green
			else
				row.Status.Text = "ЗАКРЫТО"
				row.Status.TextColor3 = C.Muted
				row.Row.BackgroundColor3 = C.Panel
			end
		end
		local elapsed = os.time() - (profile.LastDailyClaim or 0)
		if elapsed >= Config.DailyCooldown then
			dailyStatus.Text = highlight("БОНУС ГОТОВ · +" .. tostring(50 + (profile.XP and Catalog.LevelForXP(profile.XP) or 1) * 5) .. " монет")
			dailyClaim.Text = "ПОЛУЧИТЬ БОНУС"
			dailyClaim.BackgroundColor3 = C.Green
		else
			local seconds = Config.DailyCooldown - elapsed
			dailyStatus.Text = rich(string.format("Следующий бонус через %02d:%02d", math.floor(seconds / 3600), math.floor(seconds / 60) % 60), C.Cyan)
			dailyClaim.Text = "БОНУС УЖЕ ПОЛУЧЕН"
			dailyClaim.BackgroundColor3 = C.Panel
		end
	end
end

local function showPanel(name)
	activePanel = name
	panel.Visible = name ~= nil
	upgradeFrame.Visible = name == "Upgrades"
	dailyFrame.Visible = name == "Daily"
	shopFrame.Visible = name == "Shop"
	defenseFrame.Visible = name == "Defense"
	rewardsFrame.Visible = name == "Rewards"
	if name == "Rewards" then
		panelTitle.Text = rich("ПУТЬ НАГРАД // УРОВНИ 2–10", C.Gold)
		panelHint.Text = highlight("За каждый уровень — монеты. Золотая строка — ближайшая разблокировка.")
	elseif name == "Upgrades" then
		panelTitle.Text = rich("FORGE // УЛУЧШЕНИЯ ПЕРСОНАЖА", C.Cyan)
		panelHint.Text = highlight("Монеты и уровни открывают реальные бонусы. Улучшения доступны в лобби.")
	elseif name == "Daily" then
		panelTitle.Text = rich("DAILY // ЕЖЕДНЕВНАЯ НАГРАДА", C.Gold)
		panelHint.Text = highlight("Забирайте подарок у светящегося NPC или здесь.")
	elseif name == "Shop" then
		panelTitle.Text = rich("ROBUX // КОСМЕТИЧЕСКИЙ МАГАЗИН", C.Purple)
		panelHint.Text = highlight("Только внешний вид: никаких преимуществ в уроне, HP, скорости или matchmaking.")
	elseif name == "Defense" then
		panelTitle.Text = rich("DEFENSE // ЛОВУШКИ И МИНЫ", Color3.fromRGB(255, 151, 82))
		panelHint.Text = highlight("Чертежи покупаются за монеты. В бою выбирайте ловушку клавишами 4 / 5 / 6.")
	end
	refreshPanels()
	if name then
		remotes.ProgressionAction:FireServer("Refresh")
	end
end

rewardsButton.Activated:Connect(function() showPanel("Rewards") end)
upgradeButton.Activated:Connect(function() showPanel("Upgrades") end)
dailyButton.Activated:Connect(function() showPanel("Daily") end)
shopButton.Activated:Connect(function() showPanel("Shop") end)
defenseButton.Activated:Connect(function() showPanel("Defense") end)
closeButton.Activated:Connect(function() showPanel(nil) end)
remotes.OpenPanel.OnClientEvent:Connect(function(name)
	if name == "Rewards" or name == "Upgrades" or name == "Daily" or name == "Shop" or name == "Defense" then
		showPanel(name)
	end
end)
remotes.ProfileUpdate.OnClientEvent:Connect(function(data)
	profile = data
	refreshPanels()
end)

local function refreshStats()
	local xp = player:GetAttribute("XP") or (profile and profile.XP) or 0
	local level, currentXP, requiredXP = Catalog.LevelProgress(xp)
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local health = humanoid and math.ceil(humanoid.Health) or 0
	local maximum = humanoid and math.ceil(humanoid.MaxHealth) or 120
	local armor = (character and character:GetAttribute("Armor")) or (player:GetAttribute("Upgrade_Armor") or 0) * 0.04
	local speed = humanoid and humanoid.WalkSpeed or (20 + (player:GetAttribute("Upgrade_Speed") or 0))
	local phase = state:GetAttribute("Phase") or "Lobby"
	local builds = phase == "Lobby" and (player:GetAttribute("BuildCapacity") or Config.Arena.MaxBuildPerPlayer) or (player:GetAttribute("BuildRemaining") or 0)
	local camera = Workspace.CurrentCamera
	local screenWidth = camera and camera.ViewportSize.X or 1280
	local sideWidth = math.clamp((screenWidth - 200) / 2, 100, 340)
	statsPanel.Size = UDim2.new(0, math.min(330, sideWidth), 0, 148)
	guidePanel.Size = UDim2.new(0, math.min(330, sideWidth), 0, 148)
	lobbyDock.Size = UDim2.new(0, math.min(300, sideWidth), 0, 249)
	levelLabel.Text = rich("УРОВЕНЬ " .. tostring(level), C.Gold)
	xpLabel.Text = string.format('<font color="#74DEFF"><b>%d / %d XP</b></font>', currentXP, requiredXP)
	xpFill.Size = UDim2.fromScale(math.clamp(currentXP / math.max(1, requiredXP), 0, 1), 1)
	statsLabel.Text = string.format('<font color="#FF8E83"><b>HP %d/%d</b></font> · <font color="#C6A0FF">БРОНЯ %d%%</font>', health, maximum, math.floor(armor * 100 + 0.5))
	speedLabel.Text = string.format('<font color="#74DEFF">СКОРОСТЬ <b>%d</b></font> · <font color="#FFD166">ПОСТРОЙКИ <b>%d</b></font>', math.floor(speed + 0.5), builds)
	coinsLabel.Text = string.format('<font color="#FFD166"><b>МОНЕТЫ %d</b></font> · <font color="#74DEFF"><b>ЖЕТОНЫ %d</b></font>', player:GetAttribute("Coins") or 0, player:GetAttribute("CaseTokens") or 0)
	local nextLevel, nextReward = Catalog.GetNextLevelReward(level)
	if nextReward then
		nextRewardLabel.Text = string.format('<font color="#C6A0FF"><b>СЛЕДУЮЩАЯ · LV %d</b></font><font color="#FFD166">: %s</font>', nextLevel, escapeRich(nextReward.Description))
	else
		nextRewardLabel.Text = highlight("Особые награды открыты · дальше монеты за каждый уровень")
	end
	if player:GetAttribute("Queued") then
		guideTitle.Text = "МЕСТО ЗАБРОНИРОВАНО"
		guideText.Text = "Команда собирается. Далее: 75 секунд на 3 укрепления, затем штурм вражеского ядра."
	elseif (player:GetAttribute("Matches") or 0) > 0 and (player:GetAttribute("CaseTokens") or 0) > 0 then
		guideTitle.Text = "НАГРАДА ЖДЁТ · ОТКРОЙ КЕЙС [L]"
		guideText.Text = "Потрать жетон в лутбоксе, экипируй предмет в инвентаре — и возвращайся в бой за следующим уровнем."
	else
		guideTitle.Text = "ТВОЙ СЛЕДУЮЩИЙ ШАГ"
		guideText.Text = "Нажми БЫСТРЫЙ СТАРТ — пустые места в двух командах 6×6 займут боты."
	end
	guideTitle.Text = rich(guideTitle.Text, C.Green)
	guideText.Text = highlight(guideText.Text)
	statsPanel.Visible = phase == "Lobby"
	guidePanel.Visible = phase == "Lobby"
	lobbyDock.Visible = phase == "Lobby"
	if phase ~= "Lobby" and panel.Visible then
		showPanel(nil)
	end
end

UserInputService.InputBegan:Connect(function(input, processed)
	if processed then
		return
	end
	if input.KeyCode == Enum.KeyCode.J then
		if activePanel == "Rewards" then showPanel(nil) else showPanel("Rewards") end
	elseif input.KeyCode == Enum.KeyCode.U then
		if activePanel == "Upgrades" then showPanel(nil) else showPanel("Upgrades") end
	elseif input.KeyCode == Enum.KeyCode.K then
		if activePanel == "Shop" then showPanel(nil) else showPanel("Shop") end
	end
end)

RunService.RenderStepped:Connect(function()
	refreshStats()
end)
refreshStats()
]]></string>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="28">
        <Properties>
          <string name="Name">WeaponViewClient</string>
          <string name="Source"><![CDATA[-- BLOCKSIEGE: one equipped weapon in the world, one clean arsenal preview in UI.
-- The ViewportFrame owns its camera and WorldModel; it never adds a second weapon
-- to Workspace or draws a camera-following duplicate over the character.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local player = Players.LocalPlayer
local Shared = ReplicatedStorage:WaitForChild("BlockSiege")
local Catalog = require(Shared:WaitForChild("Catalog"))
local WeaponModels = require(Shared:WaitForChild("WeaponModels"))
local state = Shared:WaitForChild("MatchState")
local remotes = Shared:FindFirstChild("Remotes")
local animatedWeapon
local animatedWelds = {}
local equipStarted = 0
local recoilUntil = 0
local reloadStarted = 0
local wasReloading = false

local C = {
	Background = Color3.fromRGB(17, 24, 32),
	Panel = Color3.fromRGB(28, 39, 49),
	Text = Color3.fromRGB(244, 246, 239),
	Muted = Color3.fromRGB(164, 184, 193),
	Gold = Color3.fromRGB(255, 199, 76),
	Cyan = Color3.fromRGB(100, 224, 255),
	Build = Color3.fromRGB(112, 219, 176),
	Battle = Color3.fromRGB(255, 142, 87),
}

local function new(className, properties, parent)
	local object = Instance.new(className)
	for key, value in pairs(properties or {}) do
		object[key] = value
	end
	object.Parent = parent
	return object
end

local function corner(object, radius)
	return new("UICorner", { CornerRadius = UDim.new(0, radius or 7) }, object)
end

local function label(parent, name, value, size, position, textSize, color)
	return new("TextLabel", {
		Name = name,
		BackgroundTransparency = 1,
		Size = size,
		Position = position or UDim2.new(),
		Font = Enum.Font.GothamBold,
		Text = value,
		TextColor3 = color or C.Text,
		TextSize = textSize or 16,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Center,
	}, parent)
end

local gui = new("ScreenGui", {
	Name = "BlockSiegeWeaponPreview",
	ResetOnSpawn = false,
	IgnoreGuiInset = false,
	DisplayOrder = 3,
	ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
}, player:WaitForChild("PlayerGui"))

local panel = new("Frame", {
	Name = "WeaponPreviewPanel",
	AnchorPoint = Vector2.new(1, 0),
	Position = UDim2.new(1, -18, 0, 118),
	Size = UDim2.new(0.27, 0, 0, 196),
	BackgroundColor3 = C.Background,
	BackgroundTransparency = 0.03,
	BorderSizePixel = 0,
	ClipsDescendants = true,
	Visible = false,
}, gui)
corner(panel, 9)
local panelStroke = new("UIStroke", {
	Name = "RarityBorder",
	Color = C.Cyan,
	Thickness = 1.5,
	Transparency = 0.12,
}, panel)
new("UIGradient", {
	Rotation = 115,
	Color = ColorSequence.new(Color3.fromRGB(42, 61, 72), C.Background),
}, panel)
new("UISizeConstraint", {
	MinSize = Vector2.new(40, 40),
	MaxSize = Vector2.new(350, 270),
}, panel)

local previewHeader = label(panel, "PreviewHeader", "ARSENAL // 3D LOADOUT", UDim2.new(1, -104, 0, 22), UDim2.new(0, 13, 0, 8), 12, C.Muted)
local phaseLabel = label(panel, "PreviewPhase", "BUILD", UDim2.new(0, 78, 0, 22), UDim2.new(1, -91, 0, 8), 11, C.Build)
phaseLabel.TextXAlignment = Enum.TextXAlignment.Right
local accentBar = new("Frame", {
	Name = "AccentBar",
	Position = UDim2.new(0, 12, 0, 33),
	Size = UDim2.new(1, -24, 0, 2),
	BackgroundColor3 = C.Cyan,
	BorderSizePixel = 0,
}, panel)

local viewport = new("ViewportFrame", {
	Name = "WeaponViewport",
	Position = UDim2.new(0, 10, 0, 42),
	Size = UDim2.new(1, -20, 1, -104),
	BackgroundColor3 = Color3.fromRGB(12, 20, 29),
	BackgroundTransparency = 0.08,
	BorderSizePixel = 0,
	ClipsDescendants = true,
	Ambient = Color3.fromRGB(105, 119, 133),
	LightColor = Color3.fromRGB(255, 242, 218),
	LightDirection = Vector3.new(-0.65, -1, -0.8),
	ImageTransparency = 0,
}, panel)
corner(viewport, 6)
new("UIStroke", { Color = Color3.fromRGB(65, 91, 105), Thickness = 1, Transparency = 0.15 }, viewport)

local worldModel = new("WorldModel", { Name = "WeaponWorld" }, viewport)
local previewCamera = new("Camera", {
	Name = "WeaponPreviewCamera",
	CameraType = Enum.CameraType.Scriptable,
	FieldOfView = 38,
}, viewport)
viewport.CurrentCamera = previewCamera

local weaponName = label(panel, "WeaponName", "", UDim2.new(1, -28, 0, 27), UDim2.new(0, 14, 1, -62), 17, C.Text)
weaponName.Font = Enum.Font.GothamBlack
local rarityLabel = label(panel, "WeaponRarity", "", UDim2.new(0.56, -14, 0, 22), UDim2.new(0, 14, 1, -34), 11, C.Cyan)
local skinLabel = label(panel, "WeaponSkin", "", UDim2.new(0.44, -14, 0, 22), UDim2.new(0.56, 0, 1, -34), 10, C.Gold)
skinLabel.TextXAlignment = Enum.TextXAlignment.Right

local viewModel
local viewKey
local modelCenter = Vector3.zero
local modelDistance = 16
local modelReady = false
local lastPhase
local lastViewportX = 0
local lastViewportY = 0

local function clearViewmodel()
	if viewModel then
		viewModel:Destroy()
	end
	viewModel = nil
	viewKey = nil
	modelReady = false
	modelCenter = Vector3.zero
end

local function prepareParts(model)
	for _, part in ipairs(model:GetDescendants()) do
		if part:IsA("BasePart") then
			part.Anchored = true
			part.CanCollide = false
			part.CanTouch = false
			part.CanQuery = false
			part.CastShadow = false
			part.Transparency = 0
			part.LocalTransparencyModifier = 0
		end
	end
end

local function frameModel(model)
	-- Normalize only the local preview; server-side weapon scale and hit detection are untouched.
	model:PivotTo(CFrame.new())
	local _, initialSize = model:GetBoundingBox()
	local initialLargest = math.max(initialSize.X, initialSize.Y, initialSize.Z)
	if initialLargest > 0.01 and type(model.ScaleTo) == "function" then
		model:ScaleTo(8 / initialLargest)
	end
	model:PivotTo(CFrame.new())
	local bounds, size = model:GetBoundingBox()
	modelCenter = bounds.Position
	local largest = math.max(size.X, size.Y, size.Z, 1)
	local halfFov = math.rad(previewCamera.FieldOfView * 0.5)
	modelDistance = math.max(9, largest * 0.78 / math.tan(halfFov))
	previewCamera.Focus = CFrame.new()
	previewCamera.CFrame = CFrame.lookAt(Vector3.new(0, 1.7, modelDistance), Vector3.zero)
	modelReady = true
end

local function ensureViewmodel()
	local weaponId = player:GetAttribute("SelectedWeapon") or "Carbine"
	local weapon = Catalog.GetWeapon(weaponId) or Catalog.Weapons.Carbine
	local skin = player:GetAttribute("Cosmetic_WeaponSkin") or "Default"
	local key = weapon.Id .. ":" .. tostring(skin)
	if viewModel and viewKey == key and modelReady then
		return
	end
	clearViewmodel()

	local model = WeaponModels.Build(weapon.Id)
	model.Name = "LocalWeaponViewModel"
	model:SetAttribute("Viewmodel", true)
	model:SetAttribute("PreviewWeaponId", weapon.Id)
	WeaponModels.ApplySkin(model, skin)
	prepareParts(model)
	model.Parent = worldModel
	viewModel = model
	viewKey = key
	frameModel(model)
end

local function refreshLabels(phase)
	local weapon = Catalog.GetWeapon(player:GetAttribute("SelectedWeapon") or "Carbine") or Catalog.Weapons.Carbine
	local skin = player:GetAttribute("Cosmetic_WeaponSkin") or "Default"
	local rarityColor = Catalog.RarityColors[weapon.Rarity] or C.Cyan
	weaponName.Text = weapon.Name
	rarityLabel.Text = Catalog.RarityNames[weapon.Rarity] or string.upper(weapon.Rarity)
	rarityLabel.TextColor3 = rarityColor
	skinLabel.Text = skin == "GoldenArsenal" and "GOLDEN ARSENAL" or (skin == "CelestialArsenal" and "CELESTIAL LEGENDARY" or "STANDARD ISSUE")
	skinLabel.TextColor3 = skin == "GoldenArsenal" and C.Gold or (skin == "CelestialArsenal" and C.Cyan or C.Muted)
	phaseLabel.Text = phase == "Build" and "BUILD" or "BATTLE"
	phaseLabel.TextColor3 = phase == "Build" and C.Build or C.Battle
	panelStroke.Color = rarityColor
	accentBar.BackgroundColor3 = rarityColor
end

local function updateLayout(phase)
	local camera = Workspace.CurrentCamera
	local screen = camera and camera.ViewportSize or Vector2.new(1280, 720)
	local compact = screen.X < 700 or screen.Y < 680
	local sideWidth = math.clamp((screen.X - 200) / 2, 100, 340)
	panel.AnchorPoint = Vector2.new(1, 0)
	panel.Position = UDim2.new(1, -16, 0, 118)
	if compact then
		panel.Size = UDim2.fromOffset(sideWidth, phase == "Build" and 62 or 120)
		previewHeader.Visible = phase ~= "Build"
		previewHeader.Size = UDim2.new(1, -12, 0, 18)
		previewHeader.Position = UDim2.new(0, 6, 0, 4)
		previewHeader.TextSize = sideWidth < 240 and 8 or 10
		phaseLabel.Visible = false
		accentBar.Visible = false
		rarityLabel.Visible = false
		skinLabel.Visible = false
		weaponName.Visible = phase ~= "Build"
		if phase == "Build" then
			viewport.Position = UDim2.new(0, 4, 0, 4)
			viewport.Size = UDim2.new(1, -8, 1, -8)
		else
			viewport.Position = UDim2.new(0, 6, 0, 26)
			viewport.Size = UDim2.new(1, -12, 0, 58)
			weaponName.Size = UDim2.new(1, -12, 0, 20)
			weaponName.Position = UDim2.new(0, 6, 0, 94)
			weaponName.TextSize = sideWidth < 240 and 9 or 11
		end
	else
		panel.Size = UDim2.new(0.27, 0, 0, 196)
		previewHeader.Visible = true
		previewHeader.Size = UDim2.new(1, -104, 0, 22)
		previewHeader.Position = UDim2.new(0, 13, 0, 8)
		previewHeader.TextSize = 12
		phaseLabel.Visible = true
		accentBar.Visible = true
		rarityLabel.Visible = true
		skinLabel.Visible = true
		weaponName.Visible = true
		viewport.Position = UDim2.new(0, 10, 0, 42)
		viewport.Size = UDim2.new(1, -20, 1, -104)
		weaponName.Size = UDim2.new(1, -28, 0, 27)
		weaponName.Position = UDim2.new(0, 14, 1, -62)
		weaponName.TextSize = 17
	end
	lastViewportX = screen.X
	lastViewportY = screen.Y
end

local function cacheWorldWeapon()
	local character = player.Character
	local equipped = character and character:FindFirstChild("EquippedWeapon") or nil
	if equipped == animatedWeapon then
		return character, equipped
	end
	animatedWeapon = equipped
	animatedWelds = {}
	equipStarted = os.clock()
	wasReloading = false
	if equipped then
		for _, item in ipairs(equipped:GetDescendants()) do
			if item.Name == "WeaponWeld" and item.ClassName == "Weld" then
				table.insert(animatedWelds, { Weld = item, C0 = item.C0 })
			end
		end
	end
	return character, equipped
end

local function animateWorldWeapon(clock, phase)
	local character, equipped = cacheWorldWeapon()
	local active = equipped ~= nil and (phase == "Build" or phase == "Battle")
	local action = CFrame.new()
	if active then
		-- Small hand-held bob; this changes only the existing Weld.C0 values.
		action = CFrame.new(math.sin(clock * 1.7) * 0.025, math.sin(clock * 2.3) * 0.035, 0)
		local equipAlpha = math.clamp((clock - equipStarted) / 0.28, 0, 1)
		if equipAlpha < 1 then
			action = action * CFrame.new(0, -(1 - equipAlpha) * 0.8, 0) * CFrame.Angles(0, 0, math.rad(-35 * (1 - equipAlpha)))
		end
		if clock < recoilUntil then
			local kick = math.clamp((recoilUntil - clock) / 0.12, 0, 1)
			action = action * CFrame.new(0, 0, kick * 0.22) * CFrame.Angles(math.rad(-10 * kick), 0, 0)
		end
		local reloading = character:GetAttribute("Reloading") == true
		if reloading and not wasReloading then
			reloadStarted = clock
		end
		wasReloading = reloading
		if reloading then
			local duration = math.max(0.2, tonumber(character:GetAttribute("ReloadDuration")) or 1.65)
			local progress = math.clamp((clock - reloadStarted) / duration, 0, 1)
			local arc = math.sin(progress * math.pi)
			action = action * CFrame.new(0, -arc * 0.45, arc * 0.15) * CFrame.Angles(math.rad(arc * 55), 0, math.rad(-30 * arc))
		end
	else
		wasReloading = false
	end
	for _, record in ipairs(animatedWelds) do
		if record.Weld.Parent then
			record.Weld.C0 = active and action * record.C0 or record.C0
		end
	end
end

if remotes then
	local combat = remotes:FindFirstChild("CombatFX")
	if combat then
		combat.OnClientEvent:Connect(function(payload)
			if payload.AttackerUserId == player.UserId and payload.Kind == "Shot" then
				recoilUntil = os.clock() + 0.12
			end
		end)
	end
	local weaponAction = remotes:FindFirstChild("WeaponAction")
	if weaponAction then
		weaponAction.OnClientEvent:Connect(function(payload)
			if payload.Action == "ReloadStart" then
				reloadStarted = os.clock()
			elseif payload.Action == "Equip" then
				equipStarted = os.clock()
			end
		end)
	end
end

RunService.RenderStepped:Connect(function()
	local clock = os.clock()
	local phase = state:GetAttribute("Phase") or "Lobby"
	animateWorldWeapon(clock, phase)
	local visible = phase == "Build" or phase == "Battle"
	panel.Visible = visible
	if not visible then
		if viewModel then
			clearViewmodel()
		end
		lastPhase = phase
		return
	end

	-- Do not gate this UI on a character or Workspace.CurrentCamera. During respawn the
	-- loadout must remain visible, and the viewport has its own scriptable camera.
	ensureViewmodel()
	refreshLabels(phase)
	local camera = Workspace.CurrentCamera
	local viewportSize = camera and camera.ViewportSize or Vector2.new(1280, 720)
	if phase ~= lastPhase or viewportSize.X ~= lastViewportX or viewportSize.Y ~= lastViewportY then
		updateLayout(phase)
		lastPhase = phase
	end
	if viewModel and modelReady then
		local yaw = 78 + math.sin(clock * 0.65) * 9
		local pitch = -7 + math.sin(clock * 0.9) * 2
		local roll = -3 + math.cos(clock * 0.55) * 1.5
		local rotation = CFrame.Angles(math.rad(pitch), math.rad(yaw), math.rad(roll))
		viewModel:PivotTo(rotation * CFrame.new(-modelCenter))
		previewCamera.CFrame = CFrame.lookAt(Vector3.new(0, 1.7 + math.sin(clock * 0.8) * 0.12, modelDistance), Vector3.zero)
	end

end)

player:GetAttributeChangedSignal("SelectedWeapon"):Connect(clearViewmodel)
player:GetAttributeChangedSignal("Cosmetic_WeaponSkin"):Connect(clearViewmodel)
updateLayout()
]]></string>
        </Properties>
      </Item>
<Item class="LocalScript" referent="34">
        <Properties>
          <string name="Name">AbilityClient</string>
          <string name="Source"><![CDATA[-- BLOCKSIEGE // CLASS HUD + ABILITY FX
local Debris = game:GetService("Debris")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")

local player = Players.LocalPlayer
local mouse = player:GetMouse()
local Shared = ReplicatedStorage:WaitForChild("BlockSiege")
local AbilityCatalog = require(Shared:WaitForChild("AbilityCatalog"))
local remotes = Shared:WaitForChild("Remotes")
local state = Shared:WaitForChild("MatchState")

local C = {
	Background = Color3.fromRGB(12, 20, 32),
	Panel = Color3.fromRGB(27, 42, 59),
	Text = Color3.fromRGB(239, 247, 255),
	Muted = Color3.fromRGB(157, 180, 198),
	Gold = Color3.fromRGB(255, 211, 107),
}

local function new(className, properties, parent)
	local object = Instance.new(className)
	for key, value in pairs(properties or {}) do
		object[key] = value
	end
	object.Parent = parent
	return object
end

local function corner(object, radius)
	return new("UICorner", { CornerRadius = UDim.new(0, radius or 8) }, object)
end

local function label(parent, textValue, size, position, textSize, color)
	return new("TextLabel", {
		BackgroundTransparency = 1,
		Size = size,
		Position = position or UDim2.new(),
		Font = Enum.Font.Gotham,
		Text = textValue,
		TextColor3 = color or C.Text,
		TextSize = textSize or 14,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Center,
	}, parent)
end

local gui = new("ScreenGui", {
	Name = "BlockSiegeAbilities",
	ResetOnSpawn = false,
	DisplayOrder = 5,
	ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
}, player:WaitForChild("PlayerGui"))
local panel = new("Frame", {
	Name = "ClassPanel",
	AnchorPoint = Vector2.new(0, 1),
	Position = UDim2.new(0, 18, 1, -18),
	Size = UDim2.fromOffset(310, 198),
	BackgroundColor3 = C.Background,
	BackgroundTransparency = 0.04,
	BorderSizePixel = 0,
	Visible = false,
}, gui)
corner(panel, 10)
new("UIStroke", { Color = Color3.fromRGB(78, 111, 137), Thickness = 1.2, Transparency = 0.1 }, panel)
new("UIGradient", { Rotation = 110, Color = ColorSequence.new(Color3.fromRGB(35, 57, 76), C.Background) }, panel)

local classLabel = label(panel, "CLASS // DRAFT", UDim2.new(1, -24, 0, 25), UDim2.new(0, 12, 0, 8), 18, C.Gold)
classLabel.Font = Enum.Font.GothamBlack
local roleLabel = label(panel, "", UDim2.new(1, -24, 0, 18), UDim2.new(0, 12, 0, 33), 11, C.Muted)
roleLabel.Font = Enum.Font.GothamBold
local description = label(panel, "", UDim2.new(1, -24, 0, 29), UDim2.new(0, 12, 0, 51), 11, C.Muted)
local buttons = {}
for slot = 1, 2 do
	local button = new("TextButton", {
		Name = "Ability" .. slot,
		Position = UDim2.new(0, 12 + (slot - 1) * 147, 0, 86),
		Size = UDim2.fromOffset(137, 66),
		BackgroundColor3 = C.Panel,
		BorderSizePixel = 0,
		Font = Enum.Font.GothamBold,
		Text = "",
		TextColor3 = C.Text,
		TextSize = 13,
		TextWrapped = true,
		AutoButtonColor = true,
	}, panel)
	corner(button, 8)
	new("UIStroke", { Color = C.Gold, Thickness = 1, Transparency = 0.35 }, button)
	buttons[slot] = button
end
local hint = label(panel, "F / G · цель под прицелом · серверный cooldown", UDim2.new(1, -24, 0, 17), UDim2.new(0, 12, 1, -39), 10, C.Muted)
local reloadButton = new("TextButton", {
	Name = "ReloadButton",
	AnchorPoint = Vector2.new(1, 1),
	Position = UDim2.new(1, -12, 1, -8),
	Size = UDim2.fromOffset(100, 24),
	BackgroundColor3 = C.Panel,
	BorderSizePixel = 0,
	Font = Enum.Font.GothamBold,
	Text = "R · RELOAD",
	TextColor3 = C.Gold,
	TextSize = 10,
}, panel)
corner(reloadButton, 5)

local function aimPosition()
	if UserInputService.TouchEnabled and not UserInputService.MouseEnabled then
		local camera = Workspace.CurrentCamera
		if camera then
			return camera.CFrame.Position + camera.CFrame.LookVector * 100
		end
	end
	local ok, position = pcall(function()
		return mouse.Hit.Position
	end)
	if ok and position then
		return position
	end
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	return root and root.Position + root.CFrame.LookVector * 50 or Vector3.zero
end

local function useAbility(slot)
	if state:GetAttribute("Phase") == "Battle" then
		remotes.AbilityRequest:FireServer(slot, aimPosition())
	end
end
for slot = 1, 2 do
	buttons[slot].Activated:Connect(function()
		useAbility(slot)
	end)
end
reloadButton.Activated:Connect(function()
	if state:GetAttribute("Phase") == "Battle" then
		remotes.ReloadRequest:FireServer()
	end
end)
UserInputService.InputBegan:Connect(function(input, processed)
	if processed or state:GetAttribute("Phase") ~= "Battle" then
		return
	end
	if input.KeyCode == Enum.KeyCode.F then
		useAbility(1)
	elseif input.KeyCode == Enum.KeyCode.G then
		useAbility(2)
	end
end)

local function layout(phase)
	local camera = Workspace.CurrentCamera
	local screen = camera and camera.ViewportSize or Vector2.new(1280, 720)
	local sideWidth = math.clamp((screen.X - 200) / 2, 100, 340)
	local panelWidth = math.min(310, sideWidth)
	if phase == "Build" then
		panel.AnchorPoint = Vector2.new(0, 0)
		panel.Position = UDim2.new(0, 16, 0, 118)
		panel.Size = UDim2.fromOffset(panelWidth, 64)
		classLabel.Size = UDim2.new(1, -16, 0, 25)
		classLabel.Position = UDim2.new(0, 8, 0, 4)
		classLabel.TextSize = panelWidth < 240 and 11 or 15
		roleLabel.Size = UDim2.new(1, -16, 0, 18)
		roleLabel.Position = UDim2.new(0, 8, 0, 34)
		roleLabel.TextSize = panelWidth < 240 and 8 or 10
		description.Visible = false
		hint.Visible = false
		reloadButton.Visible = false
		for _, button in ipairs(buttons) do
			button.Visible = false
		end
		return
	end
	panel.AnchorPoint = Vector2.new(0, 1)
	panel.Position = UDim2.new(0, 16, 1, -18)
	panel.Size = UDim2.fromOffset(panelWidth, 198)
	classLabel.Size = UDim2.new(1, -24, 0, 25)
	classLabel.Position = UDim2.new(0, 12, 0, 8)
	classLabel.TextSize = panelWidth < 240 and 12 or 18
	roleLabel.Size = UDim2.new(1, -24, 0, 18)
	roleLabel.Position = UDim2.new(0, 12, 0, 33)
	roleLabel.TextSize = panelWidth < 240 and 9 or 11
	description.Visible = panelWidth >= 240
	description.Size = UDim2.new(1, -24, 0, 29)
	description.Position = UDim2.new(0, 12, 0, 51)
	description.TextSize = 11
	hint.Visible = true
	reloadButton.Visible = phase == "Battle"
	if panelWidth < 240 then
		for slot, button in ipairs(buttons) do
			button.Visible = true
			button.Size = UDim2.fromOffset(panelWidth - 24, 42)
			button.Position = UDim2.new(0, 12, 0, 56 + (slot - 1) * 46)
			button.TextSize = 10
		end
		hint.Size = UDim2.new(1, -24, 0, 14)
		hint.Position = UDim2.new(0, 12, 0, 146)
		hint.TextSize = 8
		reloadButton.Size = UDim2.fromOffset(math.max(60, panelWidth - 24), 24)
		reloadButton.TextSize = 8
	else
		local buttonWidth = (panelWidth - 36) / 2
		for slot, button in ipairs(buttons) do
			button.Visible = true
			button.Size = UDim2.fromOffset(buttonWidth, 66)
			button.Position = UDim2.new(0, 12 + (slot - 1) * (buttonWidth + 12), 0, 86)
			button.TextSize = panelWidth < 280 and 11 or 13
		end
		hint.Size = UDim2.new(1, -24, 0, 17)
		hint.Position = UDim2.new(0, 12, 1, -39)
		hint.TextSize = 10
		reloadButton.Size = UDim2.fromOffset(100, 24)
		reloadButton.TextSize = 10
	end
end

local function refresh()
	local phase = state:GetAttribute("Phase") or "Lobby"
	layout(phase)
	local classId = player:GetAttribute("ClassId") or ""
	local definition = AbilityCatalog.GetClass(classId)
	panel.Visible = (phase == "Build" or phase == "Battle") and definition ~= nil
	if not definition then
		return
	end
	classLabel.Text = "CLASS // " .. (player:GetAttribute("ClassName") or definition.Name)
	classLabel.TextColor3 = definition.Color
	roleLabel.Text = definition.Role .. " · " .. (phase == "Build" and "СЛУЧАЙНЫЙ КЛАСС НА МАТЧ" or "F / G · СПОСОБНОСТИ")
	description.Text = player:GetAttribute("ClassDescription") or definition.Description
	for slot = 1, 2 do
		local ability = AbilityCatalog.GetAbilityForSlot(classId, slot)
		local remaining = tonumber(player:GetAttribute("Ability" .. slot .. "Remaining")) or 0
		local shortName = player:GetAttribute("Ability" .. slot .. "ShortName") or (ability and ability.ShortName) or "ABILITY"
		local status = phase == "Build" and "BATTLE ONLY" or (remaining > 0 and string.format("%.1f s", remaining) or "READY")
		buttons[slot].Text = string.format("[%s] %s\n%s", ability and ability.Hotkey or (slot == 1 and "F" or "G"), shortName, status)
		buttons[slot].BackgroundColor3 = remaining > 0 and C.Panel or definition.Color
		buttons[slot].TextColor3 = remaining > 0 and C.Muted or Color3.fromRGB(12, 25, 35)
		buttons[slot].Active = phase == "Battle" and remaining <= 0
	end
	local character = player.Character
	local reloading = character and character:GetAttribute("Reloading") == true
	reloadButton.Text = reloading and "RELOADING..." or "R · RELOAD"
	reloadButton.Visible = phase == "Battle"
	hint.Text = phase == "Build" and "Класс закреплён до конца матча · способности откроются в бою" or "F / G · цель под прицелом · серверный cooldown"
end

local fxFolder = Workspace:FindFirstChild("BlockSiegeAbilityFX")
if not fxFolder then
	fxFolder = new("Folder", { Name = "BlockSiegeAbilityFX" }, Workspace)
end

local function effect(position, color, size, duration, ball)
	if not position then
		return
	end
	local object = new("Part", {
		Position = position,
		Size = Vector3.one * (size or 4),
		Color = color or C.Gold,
		Material = Enum.Material.Neon,
		Anchored = true,
		CanCollide = false,
		CanTouch = false,
		CanQuery = false,
		Transparency = 0.2,
	}, fxFolder)
	if ball then
		object.Shape = Enum.PartType.Ball
	end
	local light = new("PointLight", { Color = object.Color, Brightness = 2, Range = math.max(8, (size or 4) * 2) }, object)
	TweenService:Create(light, TweenInfo.new(duration or 0.35), { Brightness = 0 }):Play()
	TweenService:Create(object, TweenInfo.new(duration or 0.35), { Size = Vector3.one * (size or 4) * 1.35, Transparency = 1 }):Play()
	Debris:AddItem(object, (duration or 0.35) + 0.05)
end

local function burst(position, color, count, power)
	if not position then
		return
	end
	for _ = 1, count or 8 do
		local lifetime = 0.3 + math.random() * 0.35
		local direction = Vector3.new(math.random() - 0.5, math.random() * 0.8 + 0.2, math.random() - 0.5).Unit
		local object = new("Part", {
			Position = position,
			Size = Vector3.one * (0.35 + math.random() * 0.5),
			Color = color or C.Gold,
			Material = Enum.Material.Neon,
			Anchored = true,
			CanCollide = false,
			CanTouch = false,
			CanQuery = false,
		}, fxFolder)
		TweenService:Create(object, TweenInfo.new(lifetime), { Position = position + direction * (power or 8), Transparency = 1, Size = Vector3.one * 0.05 }):Play()
		Debris:AddItem(object, lifetime + 0.05)
	end
end

remotes.AbilityFX.OnClientEvent:Connect(function(payload)
	if payload.Kind == "Cooldown" then
		return
	end
	local color = payload.Color or C.Gold
	if payload.Kind == "TurretShot" and payload.Origin and payload.Finish then
		local distance = (payload.Finish - payload.Origin).Magnitude
		if distance > 0.1 then
			local beam = new("Part", {
				Size = Vector3.new(0.18, 0.18, distance),
				CFrame = CFrame.lookAt(payload.Origin:Lerp(payload.Finish, 0.5), payload.Finish),
				Color = color,
				Material = Enum.Material.Neon,
				Anchored = true,
				CanCollide = false,
				CanTouch = false,
				CanQuery = false,
				Transparency = 0.05,
			}, fxFolder)
			TweenService:Create(beam, TweenInfo.new(0.1), { Transparency = 1 }):Play()
			Debris:AddItem(beam, 0.12)
		end
		return
	end
	local large = payload.Kind == "BombImpact" or payload.Kind == "MineExplode" or payload.Kind == "Slam"
	local size = payload.Radius and math.min(payload.Radius, 18) or (large and 9 or 4)
	effect(payload.Position or payload.Origin, color, size, large and 0.55 or 0.35, payload.Kind == "Shield" or payload.Kind == "Overdrive" or large)
	if large or payload.Kind == "Heal" or payload.Kind == "Repair" then
		burst(payload.Position or payload.Origin, color, large and 18 or 10, large and 16 or 8)
	end
end)

state:GetAttributeChangedSignal("Phase"):Connect(refresh)
player:GetAttributeChangedSignal("ClassId"):Connect(refresh)
local refreshClock = 0
RunService.RenderStepped:Connect(function(deltaTime)
	refreshClock = refreshClock + deltaTime
	if refreshClock >= 0.08 then
		refreshClock = 0
		refresh()
	end
end)
refresh()
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="Workspace" referent="29">
    <Properties>
      <string name="Name">Workspace</string>
      <bool name="NeedsPivotMigration">false</bool>
    </Properties>
  </Item>
</roblox>