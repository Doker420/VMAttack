local CREATOR_STORE_VISUAL_CHILDREN = {
	SpecialMesh = true,
	BlockMesh = true,
	CylinderMesh = true,
	Decal = true,
	Texture = true,
	SurfaceAppearance = true,
}
local CREATOR_STORE_SKIP_PARTS = { SpawnLocation = true, Seat = true, VehicleSeat = true }
local CREATOR_STORE_GAMEPLAY_ATTRIBUTES = {
	"BaseGeometry", "CaptureGeometry", "Team", "StructureId", "Kind", "IsTrap", "DefenseId", "Rig", "CaptureRadius",
}
local CREATOR_STORE_MAX_SOURCE_PARTS = 120
local CREATOR_STORE_MAX_TOTAL_PARTS = 1100

local function clearCreatorStoreGameplayAttributes(instance)
	local ok, attributes = pcall(function()
		return instance:GetAttributes()
	end)
	if ok and attributes then
		for attribute in pairs(attributes) do
			instance:SetAttribute(attribute, nil)
		end
		return
	end
	for _, attribute in ipairs(CREATOR_STORE_GAMEPLAY_ATTRIBUTES) do
		instance:SetAttribute(attribute, nil)
	end
end

local function sanitizeCreatorStoreModel(source, definition)
	local sourcePartCount = 0
	for _, descendant in ipairs(source:GetDescendants()) do
		if descendant:IsA("BasePart") and not CREATOR_STORE_SKIP_PARTS[descendant.ClassName] then
			sourcePartCount = sourcePartCount + 1
		end
	end
	if sourcePartCount == 0 or sourcePartCount > CREATOR_STORE_MAX_SOURCE_PARTS then
		return nil, "empty or over the geometry budget"
	end

	local clean = Instance.new("Model")
	clean.Name = "Store_" .. definition.Key
	clearCreatorStoreGameplayAttributes(clean)
	clean:SetAttribute("HolidayDecor", true)
	clean:SetAttribute("StoreDecor", true)
	clean:SetAttribute("CreatorStoreAssetId", definition.Id)
	clean:SetAttribute("CreatorStoreCredit", definition.Credit or "Roblox Creator Store")
	clean:SetAttribute("StoreShadows", definition.Shadows == true)
	local createdCount = 0
	for _, descendant in ipairs(source:GetDescendants()) do
		if descendant:IsA("BasePart") and not CREATOR_STORE_SKIP_PARTS[descendant.ClassName] then
			local cloneOk, copy = pcall(function()
				return descendant:Clone()
			end)
			if cloneOk and copy then
				-- Keep only visual children. Scripts, Humanoids, GUI, sounds,
				-- prompts, constraints and particles never enter the clean model.
				for _, child in ipairs(copy:GetChildren()) do
					if not CREATOR_STORE_VISUAL_CHILDREN[child.ClassName] then
						child:Destroy()
					else
						clearCreatorStoreGameplayAttributes(child)
					end
				end
				copy.Name = "Store_" .. descendant.Name
				copy.Anchored = true
				copy.CanCollide = false
				copy.CanTouch = false
				copy.CanQuery = false
				copy.CastShadow = definition.Shadows == true
				clearCreatorStoreGameplayAttributes(copy)
				copy:SetAttribute("HolidayDecor", true)
				copy:SetAttribute("StoreDecor", true)
				copy:SetAttribute("CreatorStoreAssetId", definition.Id)
				copy:SetAttribute("CreatorStoreCredit", definition.Credit or "Roblox Creator Store")
				copy:SetAttribute("SourcePartName", descendant.Name)
				copy.Parent = clean
				createdCount = createdCount + 1
			end
		end
	end
	if createdCount == 0 then
		clean:Destroy()
		return nil, "no cloneable visual parts"
	end
	clean:SetAttribute("StorePartCount", createdCount)
	return clean
end

local function placeCreatorStoreModel(template, definition, placement, parent)
	local model = template:Clone()
	if not model then
		return false, "model clone failed"
	end
	local ok, err = pcall(function()
		local _, size = model:GetBoundingBox()
		local basis = placement.Fit == "Height" and size.Y or math.max(size.X, size.Y, size.Z)
		if basis <= 0.01 then
			error("invalid model bounds")
		end
		model:ScaleTo(placement.Size / basis)
		model:PivotTo(CFrame.new(placement.Position) * (placement.Rotation or CFrame.new()))
		local bounds, scaledSize = model:GetBoundingBox()
		local target = placement.Position
		if placement.Ground ~= false then
			target = target + Vector3.new(0, scaledSize.Y * 0.5, 0)
		end
		model:PivotTo(model:GetPivot() + (target - bounds.Position))
		model.Parent = parent
	end)
	if not ok then
		model:Destroy()
		return false, err
	end
	return true
end

local function loadCreatorStoreDecorations(root, lobby, arena, winterDecor, serial)
	if not AssetService then
		return
	end
	local parents = { Lobby = lobby, Arena = arena }
	local winterKeys = { ChristmasTree = true, Snowman = true, Wreath = true, Present = true, Ornaments = true }
	local totalParts = 0
	local loadedModels = 0
	local function isCurrent()
		return serial == buildSerial and root.Parent == Workspace
	end
	for _, definition in ipairs(CREATOR_STORE_ASSETS) do
		if not isCurrent() then
			return
		end
		local loadOk, source = pcall(function()
			return AssetService:LoadAssetAsync(definition.Id)
		end)
		if loadOk and source then
			local sanitizeOk, template, sanitizeErr = pcall(sanitizeCreatorStoreModel, source, definition)
			source:Destroy()
			if sanitizeOk and template then
				for _, placement in ipairs(definition.Placements) do
					if not isCurrent() then
						template:Destroy()
						return
					end
					local partCount = template:GetAttribute("StorePartCount") or 0
					if totalParts + partCount <= CREATOR_STORE_MAX_TOTAL_PARTS then
						local placeOk, placed, placeErr = pcall(placeCreatorStoreModel, template, definition, placement, winterKeys[definition.Key] and winterDecor or parents[placement.Parent])
						if placeOk and placed then
							totalParts = totalParts + partCount
							loadedModels = loadedModels + 1
						else
							warn("[BLOCKSIEGE] Store decor placement skipped:", definition.Title, tostring(placeErr or placed))
						end
					end
				end
				template:Destroy()
			else
				warn("[BLOCKSIEGE] Store decor rejected:", definition.Title, tostring(sanitizeErr or template))
			end
		else
			warn("[BLOCKSIEGE] Store decor unavailable; procedural fallback kept:", definition.Title, tostring(source))
		end
	end
	if loadedModels > 0 then
		print(string.format("[BLOCKSIEGE] Creator Store decor: %d models, %d static parts", loadedModels, totalParts))
	end
end

local function buildGift(parent, position, scale, color)
	local model = Instance.new("Model")
	model.Name = "HolidayGift"
	model:SetAttribute("HolidayDecor", true)
	model.Parent = parent
	local box = decorPart(model, "GiftBox", Vector3.new(3.4, 2.7, 3.4) * scale, CFrame.new(position + Vector3.new(0, 1.35 * scale, 0)), color or HOLIDAY.Red, Enum.Material.Fabric)
	model.PrimaryPart = box
	decorPart(model, "GiftLid", Vector3.new(3.65, 0.42, 3.65) * scale, CFrame.new(position + Vector3.new(0, 2.82 * scale, 0)), color or HOLIDAY.Red, Enum.Material.Fabric)
	decorPart(model, "GiftRibbon", Vector3.new(0.46, 2.95, 3.55) * scale, CFrame.new(position + Vector3.new(0, 1.5 * scale, 0)), HOLIDAY.Gold, Enum.Material.Metal)
	decorPart(model, "GiftRibbon", Vector3.new(3.55, 2.95, 0.46) * scale, CFrame.new(position + Vector3.new(0, 1.5 * scale, 0)), HOLIDAY.Gold, Enum.Material.Metal)
	for _, side in ipairs({ -1, 1 }) do
		decorPart(model, "GiftBow", Vector3.new(1.5, 0.38, 0.58) * scale, CFrame.new(position + Vector3.new(side * 0.62 * scale, 3.35 * scale, 0)) * CFrame.Angles(0, 0, side * math.rad(28)), HOLIDAY.Gold, Enum.Material.Metal)
	end
	return model
end

local function buildChristmasTree(parent, position, scale)
	return VisualModels.ChristmasTree(parent, position, scale)
end

local function buildSnowman(parent, position, scale)
	local model = Instance.new("Model")
	model.Name = "HolidaySnowman"
	model:SetAttribute("HolidayDecor", true)
	model.Parent = parent
	local function snowball(name, diameter, y)
		local part = decorPart(model, name, Vector3.new(diameter, diameter, diameter) * scale, CFrame.new(position + Vector3.new(0, y * scale, 0)), HOLIDAY.Snow, Enum.Material.Snow)
		part.Shape = Enum.PartType.Ball
		return part
	end
	snowball("SnowmanBody", 3.5, 1.75)
	snowball("SnowmanMiddle", 2.65, 4.05)
	snowball("SnowmanHead", 1.95, 6.15)
	for _, y in ipairs({ 3.55, 4.25 }) do
		local button = decorPart(model, "CoalButton", Vector3.new(0.25, 0.25, 0.25) * scale, CFrame.new(position + Vector3.new(0, y * scale, -1.27 * scale)), HOLIDAY.Ink, Enum.Material.SmoothPlastic)
		button.Shape = Enum.PartType.Ball
	end
	for _, side in ipairs({ -1, 1 }) do
		local eye = decorPart(model, "CoalEye", Vector3.new(0.22, 0.22, 0.22) * scale, CFrame.new(position + Vector3.new(side * 0.36 * scale, 6.42 * scale, -0.86 * scale)), HOLIDAY.Ink, Enum.Material.SmoothPlastic)
		eye.Shape = Enum.PartType.Ball
		decorPart(model, "SnowmanArm", Vector3.new(2.2, 0.22, 0.22) * scale, CFrame.new(position + Vector3.new(side * 2.1 * scale, 4.1 * scale, 0)) * CFrame.Angles(0, 0, side * math.rad(22)), C.Wood, Enum.Material.WoodPlanks)
	end
	decorPart(model, "CarrotNose", Vector3.new(0.28, 0.28, 0.85) * scale, CFrame.new(position + Vector3.new(0, 6.1 * scale, -1.12 * scale)), Color3.fromRGB(255, 133, 48), Enum.Material.SmoothPlastic)
	decorPart(model, "Scarf", Vector3.new(2.25, 0.42, 2.25) * scale, CFrame.new(position + Vector3.new(0, 5.12 * scale, 0)), HOLIDAY.Red, Enum.Material.Fabric)
	decorPart(model, "ScarfTail", Vector3.new(0.48, 1.55, 0.25) * scale, CFrame.new(position + Vector3.new(0.72 * scale, 4.35 * scale, -1.05 * scale)), HOLIDAY.Red, Enum.Material.Fabric)
	decorPart(model, "HatBrim", Vector3.new(2.5, 0.3, 2.5) * scale, CFrame.new(position + Vector3.new(0, 7.2 * scale, 0)), HOLIDAY.Ink, Enum.Material.Fabric)
	decorPart(model, "Hat", Vector3.new(1.55, 1.35, 1.55) * scale, CFrame.new(position + Vector3.new(0, 7.85 * scale, 0)), HOLIDAY.Ink, Enum.Material.Fabric)
	decorPart(model, "HatBand", Vector3.new(1.62, 0.25, 1.62) * scale, CFrame.new(position + Vector3.new(0, 7.55 * scale, 0)), HOLIDAY.Red, Enum.Material.Fabric)
	return model
end

local function buildSnowflake(parent, position, scale)
	local model = Instance.new("Model")
	model.Name = "HolidaySnowflake"
	model:SetAttribute("HolidayDecor", true)
	model.Parent = parent
	for index = 0, 2 do
		decorPart(model, "SnowflakeRay", Vector3.new(0.22, 4, 0.22) * scale, CFrame.new(position) * CFrame.Angles(0, 0, math.rad(index * 60)), HOLIDAY.Ice, Enum.Material.Neon)
	end
	local center = decorPart(model, "SnowflakeCenter", Vector3.new(0.5, 0.5, 0.5) * scale, CFrame.new(position), HOLIDAY.Snow, Enum.Material.Neon)
	center.Shape = Enum.PartType.Ball
	return model
end

local function buildGarland(parent, startPoint, endPoint, sag, segments)
	local previous = startPoint
	for index = 0, segments do
		local alpha = index / segments
		local point = startPoint:Lerp(endPoint, alpha) - Vector3.new(0, math.sin(alpha * math.pi) * (sag or 2), 0)
		if index > 0 then
			local delta = point - previous
			if delta.Magnitude > 0.05 then
				decorPart(parent, "GarlandCable", Vector3.new(0.14, 0.14, delta.Magnitude), CFrame.lookAt((previous + point) * 0.5, point), HOLIDAY.Pine, Enum.Material.Metal)
			end
		end
		local colors = { HOLIDAY.Red, HOLIDAY.Gold, HOLIDAY.Ice, HOLIDAY.Green }
		local bulb = decorPart(parent, "GarlandBulb", Vector3.new(0.58, 0.58, 0.58), CFrame.new(point - Vector3.new(0, 0.25, 0)), colors[(index % #colors) + 1], Enum.Material.Neon)
		bulb.Shape = Enum.PartType.Ball
		if index % 4 == 0 then
			holidayGlow(bulb, bulb.Color, 7, 0.7)
		end
		previous = point
	end
end

local function buildSnowEmitter(parent, position, size, rate)
	local anchor = decorPart(parent, "SnowfallEmitter", size, CFrame.new(position), HOLIDAY.Snow, Enum.Material.SmoothPlastic)
	anchor.Transparency = 1
	local snow = Instance.new("ParticleEmitter")
	snow.Name = "HolidaySnowfall"
	snow.Rate = rate or 12
	snow.Lifetime = NumberRange.new(4, 7)
	snow.Speed = NumberRange.new(1, 2)
	snow.Acceleration = Vector3.new(0, -1.5, 0)
	snow.EmissionDirection = Enum.NormalId.Bottom
	snow.SpreadAngle = Vector2.new(35, 35)
	snow.RotSpeed = NumberRange.new(-35, 35)
	snow.Size = NumberSequence.new(0.18)
	snow.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.15), NumberSequenceKeypoint.new(1, 0.75) })
	snow.Color = ColorSequence.new(HOLIDAY.Snow)
	snow.LightEmission = 0.15
	snow.Parent = anchor
	return snow
end

local function buildFestiveArch(parent, position)
	local model = Instance.new("Model")
	model.Name = "HolidayArch"
	model:SetAttribute("HolidayDecor", true)
	model.Parent = parent
	for _, side in ipairs({ -1, 1 }) do
		decorPart(model, "ArchPillar", Vector3.new(2.2, 13, 2.2), CFrame.new(position + Vector3.new(side * 27, 6.5, 0)), HOLIDAY.Red, Enum.Material.Fabric)
		for _, y in ipairs({ 2, 10.5 }) do
			decorPart(model, "ArchBand", Vector3.new(2.5, 0.45, 2.5), CFrame.new(position + Vector3.new(side * 27, y, 0)), HOLIDAY.Gold, Enum.Material.Metal)
		end
	end
	decorPart(model, "ArchBeam", Vector3.new(58, 2.2, 2.2), CFrame.new(position + Vector3.new(0, 13, 0)), HOLIDAY.Green, Enum.Material.Fabric)
	decorPart(model, "ArchSnow", Vector3.new(58.5, 0.4, 2.5), CFrame.new(position + Vector3.new(0, 14.25, 0)), HOLIDAY.Snow, Enum.Material.Snow)
	local sign = decorPart(model, "ArchSign", Vector3.new(1, 1, 1), CFrame.new(position + Vector3.new(0, 11.5, -1.3)), HOLIDAY.Snow, Enum.Material.SmoothPlastic)
	sign.Transparency = 1
	billboard(sign, "С НОВЫМ ГОДОМ // 2026", HOLIDAY.Gold, Vector3.zero, UDim2.fromScale(1, 1))
	return model
end

local function decorateLobby(lobby)
	buildFestiveArch(lobby, Vector3.new(0, 44.5, 385))
	for _, entry in ipairs({
		{ Vector3.new(-58, 44.58, 372), Vector3.new(18, 0.16, 9) }, { Vector3.new(58, 44.58, 372), Vector3.new(18, 0.16, 9) },
		{ Vector3.new(-62, 44.58, 286), Vector3.new(14, 0.16, 8) }, { Vector3.new(62, 44.58, 286), Vector3.new(14, 0.16, 8) },
	}) do
		decorPart(lobby, "LobbySnowPatch", entry[2], CFrame.new(entry[1]), HOLIDAY.Snow, Enum.Material.Snow)
	end
	decorPart(lobby, "LootboxSnowCap", Vector3.new(9.2, 0.34, 9.2), CFrame.new(0, 51.65, 318), HOLIDAY.Snow, Enum.Material.Snow)
	buildChristmasTree(lobby, Vector3.new(-24, 44.5, 350), 0.72)
	for _, entry in ipairs({
		{ Vector3.new(-8, 44.5, 347), 0.8, HOLIDAY.Red }, { Vector3.new(8, 44.5, 347), 0.75, HOLIDAY.Green },
		{ Vector3.new(-8, 44.5, 318), 0.65, HOLIDAY.Green }, { Vector3.new(8, 44.5, 318), 0.7, HOLIDAY.Red },
	}) do
		buildGift(lobby, entry[1], entry[2], entry[3])
	end
	buildSnowman(lobby, Vector3.new(-68, 44.5, 350), 0.9)
	buildSnowman(lobby, Vector3.new(68, 44.5, 350), 0.9)
	buildGarland(lobby, Vector3.new(-78, 60, 268), Vector3.new(78, 60, 268), 3, 16)
	buildGarland(lobby, Vector3.new(-78, 60, 392), Vector3.new(78, 60, 392), 3, 16)
	buildGarland(lobby, Vector3.new(-81, 60, 275), Vector3.new(-81, 60, 385), 2, 12)
	buildGarland(lobby, Vector3.new(81, 60, 275), Vector3.new(81, 60, 385), 2, 12)
	for _, position in ipairs({
		Vector3.new(-81, 55, 300), Vector3.new(-81, 55, 360), Vector3.new(81, 55, 300), Vector3.new(81, 55, 360),
		Vector3.new(-48, 57, 391), Vector3.new(48, 57, 391),
	}) do
		buildSnowflake(lobby, position, 1.1)
	end
	buildSnowEmitter(lobby, Vector3.new(0, 76, 330), Vector3.new(150, 1, 110), 18)
end

local function decorateArena(arena)
	for _, entry in ipairs({
		{ Vector3.new(-120, 0.08, -62), Vector3.new(19, 0.16, 9) }, { Vector3.new(120, 0.08, 62), Vector3.new(19, 0.16, 9) },
		{ Vector3.new(-76, 0.08, 42), Vector3.new(13, 0.16, 8) }, { Vector3.new(76, 0.08, -42), Vector3.new(13, 0.16, 8) },
		{ Vector3.new(0, 0.08, -72), Vector3.new(22, 0.16, 7) }, { Vector3.new(0, 0.08, 72), Vector3.new(22, 0.16, 7) },
	}) do
		decorPart(arena, "SnowPatch", entry[2], CFrame.new(entry[1]), HOLIDAY.Snow, Enum.Material.Snow)
	end
	buildChristmasTree(arena, Vector3.new(-116, 0, 80), 0.55)
	buildChristmasTree(arena, Vector3.new(116, 0, -80), 0.55)
	buildSnowman(arena, Vector3.new(-125, 0, -74), 0.85)
	buildSnowman(arena, Vector3.new(125, 0, 74), 0.85)
	buildGift(arena, Vector3.new(-28, 0, -76), 0.8, HOLIDAY.Red)
	buildGift(arena, Vector3.new(28, 0, 76), 0.8, HOLIDAY.Green)
	buildGift(arena, Vector3.new(-100, 0, 70), 0.65, HOLIDAY.Green)
	buildGift(arena, Vector3.new(100, 0, -70), 0.65, HOLIDAY.Red)
	-- Seasonal props stay at the edges; combat lanes keep a clean silhouette.
	buildSnowEmitter(arena, Vector3.new(0, 28, 0), Vector3.new(390, 1, 170), 6)
end

local function buildSculptedTerrain()
	-- Overlapping smooth-terrain lobes form an irregular ridge silhouette rather
	-- than a row of identical spheres. Every ridge remains outside combat bounds.
	local ok, terrain = pcall(function()
		return Workspace.Terrain
	end)
	if not ok or not terrain then
		return
	end
	pcall(function()
		local ridges = {
			{ Vector3.new(-390, -24, -142), 42 }, { Vector3.new(390, -24, 142), 42 },
			{ Vector3.new(-390, -22, 142), 38 }, { Vector3.new(390, -22, -142), 38 },
			{ Vector3.new(-180, -24, -245), 40 }, { Vector3.new(180, -24, 245), 40 },
			{ Vector3.new(0, -28, -255), 46 }, { Vector3.new(0, -28, 255), 46 },
			{ Vector3.new(-395, -25, 0), 44 }, { Vector3.new(395, -25, 0), 44 },
		}
		for ridgeIndex, ridge in ipairs(ridges) do
			local center, radius = ridge[1], ridge[2]
			for lobe = 1, 3 do
				local angle = ridgeIndex * 1.37 + lobe * 2.1
				local offset = Vector3.new(math.cos(angle) * radius * 0.32, (lobe - 1) * 4, math.sin(angle) * radius * 0.32)
				terrain:FillBall(center + offset, radius * (1 - (lobe - 1) * 0.13), Enum.Material.Rock)
			end
			if ridgeIndex % 3 ~= 0 then
				terrain:FillBall(center + Vector3.new(0, radius * 0.36, 0), radius * 0.64, Enum.Material.Snow)
			end
		end
		local clouds = terrain:FindFirstChild("BlockSiegeClouds")
		if not clouds then
			clouds = Instance.new("Clouds")
			clouds.Name = "BlockSiegeClouds"
			clouds.Parent = terrain
		end
		clouds.Cover = 0.46
		clouds.Density = 0.38
		clouds.Color = Color3.fromRGB(91, 111, 143)
	end)
end

local function buildGate(parent, prefix, baseCFrame, width, height, accent)
	return VisualModels.Gate(parent, prefix, baseCFrame, width, height, accent, { Holiday = true, CastShadow = true })
end

local function buildCitadelTower(parent, prefix, position, accent)
	return VisualModels.Tower(parent, prefix, position, 0.72, accent, { Holiday = true, CastShadow = true })
end

local function buildBaseArchitecture(arena, team, baseCFrame, accent)
	-- Keep all three original gate coordinates: BaseCFrame faces the enemy,
	-- so using a different world-space offset for Orange would move the gate.
	local facade = baseCFrame * CFrame.new(0, 0, 50)
	local gatePrefixes = { team .. "FrostGate", team .. "RearGate", team .. "InnerGate" }
	buildGate(arena, gatePrefixes[1], facade, 32, 15, accent)
	buildGate(arena, gatePrefixes[2], baseCFrame * CFrame.new(0, 0, -52), 64, 12, STYLE.Navy)
	buildGate(arena, gatePrefixes[3], baseCFrame * CFrame.new(0, 0, -28), 32, 11, accent)
	local function tagBase(root)
		root:SetAttribute("BaseGeometry", true)
		root:SetAttribute("Team", team)
		for _, descendant in ipairs(root:GetDescendants()) do
			if descendant:IsA("BasePart") then
				descendant:SetAttribute("BaseGeometry", true)
				descendant:SetAttribute("Team", team)
			end
		end
	end
	for _, prefix in ipairs(gatePrefixes) do
		for _, descendant in ipairs(arena:GetDescendants()) do
			if descendant:IsA("BasePart") and string.sub(descendant.Name, 1, #prefix) == prefix then
				descendant:SetAttribute("BaseGeometry", true)
				descendant:SetAttribute("Team", team)
			end
		end
	end
	for _, side in ipairs({ -1, 1 }) do
		local towerPosition = (facade * CFrame.new(side * 22, 0, 0)).Position
		local tower = VisualModels.Tower(arena, "BasePillar" .. team .. tostring(side), towerPosition, 0.78, accent, { Holiday = true, CastShadow = true })
		tagBase(tower)
		local banner = decorPart(arena, "BaseBanner" .. team, Vector3.new(5.5, 2.8, 0.25), facade * CFrame.new(side * 10, 10, -2), accent, Enum.Material.Fabric)
		banner:SetAttribute("BaseGeometry", true)
		banner:SetAttribute("Team", team)
	end
	for _, side in ipairs({ -1, 1 }) do
		local column = VisualModels.Column(arena, (baseCFrame * CFrame.new(side * 30, 0, -15)).Position, 9, accent, { Holiday = true, CastShadow = true })
		column.Name = "BasePillar" .. team .. "Courtyard" .. tostring(side)
		tagBase(column)
	end
	local lane = decorPart(arena, team .. "GateLane", Vector3.new(8, 0.12, 68), baseCFrame * CFrame.new(0, 0.55, 3), STYLE.Navy, Enum.Material.Metal)
	lane:SetAttribute("BaseGeometry", true)
	lane:SetAttribute("Team", team)
	for _, side in ipairs({ -1, 1 }) do
		local edge = decorPart(arena, team .. "GateLaneEdge", Vector3.new(0.35, 0.14, 68), baseCFrame * CFrame.new(side * 4.2, 0.62, 3), accent, Enum.Material.Neon)
		edge:SetAttribute("BaseGeometry", true)
		edge:SetAttribute("Team", team)
	end
	local inlay = decorPart(arena, team .. "CourtyardInlay", Vector3.new(70, 0.12, 2), baseCFrame * CFrame.new(0, 0.48, 0), accent, Enum.Material.Metal)
	inlay:SetAttribute("BaseGeometry", true)
	inlay:SetAttribute("Team", team)
end

local function buildLobbyArchitecture(lobby)
	-- A vaulted winter hall: round columns, curved ribs and warm fireplaces,
	-- rather than a corridor made from rectangular roof blocks.
	buildGate(lobby, "LobbyEntry", CFrame.new(0, 44.5, 252), 46, 14, STYLE.Navy)
	for _, x in ipairs({ -82, 82 }) do
		for _, z in ipairs({ 270, 305, 350, 395 }) do
			VisualModels.Column(lobby, Vector3.new(x, 44.5, z), 17, STYLE.Gold, { Holiday = true, CastShadow = true })
		end
	end
	for _, z in ipairs({ 278, 318, 358, 398 }) do
		buildGate(lobby, "HallVault", CFrame.new(0, 44.5, z), 176, 19, STYLE.Gold)
	end
	VisualModels.Fireplace(lobby, Vector3.new(-65, 44.5, 330), 1.15, { Holiday = true, CastShadow = true })
	VisualModels.Fireplace(lobby, Vector3.new(65, 44.5, 330), 1.15, { Holiday = true, CastShadow = true })
	for _, side in ipairs({ -1, 1 }) do
		for _, z in ipairs({ 300, 340, 380 }) do
			decorPart(lobby, "WindowGlass", Vector3.new(0.5, 10, 18), CFrame.new(side * 101, 51, z), STYLE.Ice, Enum.Material.Glass).Transparency = 0.28
			decorPart(lobby, "WindowTop", Vector3.new(1, 0.7, 19), CFrame.new(side * 101, 56.2, z), STYLE.Navy, Enum.Material.Metal)
			decorPart(lobby, "WindowMullion", Vector3.new(1, 10, 0.6), CFrame.new(side * 101, 51, z), STYLE.Navy, Enum.Material.Metal)
		end
	end
	for _, side in ipairs({ -1, 1 }) do
		decorPart(lobby, "HallAxisGold", Vector3.new(0.35, 0.14, 145), CFrame.new(side * 2, 44.6, 330), STYLE.Gold, Enum.Material.Metal)
	end
	for _, entry in ipairs({
		{ Vector3.new(-48, 44.6, 344), STYLE.Blue }, { Vector3.new(48, 44.6, 344), STYLE.Gold },
		{ Vector3.new(-48, 44.6, 300), STYLE.Warm }, { Vector3.new(48, 44.6, 300), Color3.fromRGB(178, 125, 224) },
	}) do
		decorPart(lobby, "ShopRug", Vector3.new(20, 0.12, 16), CFrame.new(entry[1]), entry[2], Enum.Material.Fabric)
	end
	local galleryBackdrop = decorPart(lobby, "GalleryBackdrop", Vector3.new(150, 12, 1.2), CFrame.new(0, 51, 250), STYLE.Navy, Enum.Material.Slate)
	galleryBackdrop.Transparency = 0.12
	decorPart(lobby, "GalleryCrown", Vector3.new(172, 0.55, 1), CFrame.new(0, 56.2, 250), STYLE.Gold, Enum.Material.Metal)
	decorPart(lobby, "HallAxis", Vector3.new(2, 0.12, 145), CFrame.new(0, 44.58, 330), STYLE.Navy, Enum.Material.Metal)
	local signAnchor = decorPart(lobby, "BlockSiegeSign", Vector3.new(1, 1, 1), CFrame.new(0, 65, 330), C.White, Enum.Material.SmoothPlastic)
	signAnchor.Transparency = 1
	billboard(signAnchor, "BLOCKSIEGE  //  6×6", STYLE.Gold, Vector3.zero, UDim2.fromOffset(440, 70))
	for _, z in ipairs({ 280, 320, 360, 400 }) do
		local lamp = decorPart(lobby, "HallLight", Vector3.new(2, 2, 2), CFrame.new(0, 62, z), STYLE.Warm, Enum.Material.Neon)
		lamp.Shape = Enum.PartType.Ball
		holidayGlow(lamp, STYLE.Warm, 24, 1.35)
	end
end

local function buildArenaArchitecture(arena)
	local routeWarmth = Color3.fromRGB(255, 205, 139)
	for _, lane in ipairs(Config.Objectives.Lanes) do
		local inward = lane == 0 and 15 or (lane > 0 and -11 or 11)
		for _, x in ipairs({ -170, -85, 85, 170 }) do
			buildRouteLight(arena, Vector3.new(x, 0, lane + inward), routeWarmth, 8.5)
		end
	end
	for _, side in ipairs({ -1, 1 }) do
		local canal = decorPart(arena, "FrozenCanal", Vector3.new(420, 0.12, 7), CFrame.new(0, 0.08, side * 84), STYLE.Ice, Enum.Material.Ice)
		canal.Transparency = 0.18
		for _, x in ipairs({ -100, 0, 100 }) do
			VisualModels.Bridge(arena, Vector3.new(x, 0.05, side * 84), 20, 13, STYLE.Gold, { Name = "CanalBridge", Holiday = true, CastShadow = true })
		end
		for _, x in ipairs({ -72, 72 }) do
			buildGate(arena, "LaneGate", CFrame.new(x, 0, side * 62) * CFrame.Angles(0, math.rad(90), 0), 18, 9, STYLE.Navy)
		end
	end
	for _, z in ipairs({ -11, 11, -69, -55, 55, 69 }) do
		decorPart(arena, "LaneBorder", Vector3.new(300, 0.12, 0.8), CFrame.new(0, 0.38, z), STYLE.Gold, Enum.Material.Metal)
	end
	-- A round inlaid plaza keeps the 67 objective readable from every lane.
	for index = 0, 7 do
		local angle = math.rad(index * 45)
		local tile = decorPart(arena, "CapturePlazaTile", Vector3.new(0.28, 5.5, 2.8), CFrame.new(math.cos(angle) * 19, 0.25, math.sin(angle) * 19) * CFrame.Angles(0, -angle, math.rad(90)), index % 2 == 0 and STYLE.Ivory or STYLE.Navy, Enum.Material.Cobblestone)
		tile.Shape = Enum.PartType.Cylinder
	end
	for _, position in ipairs({
		Vector3.new(-45, 0, -35), Vector3.new(45, 0, 35), Vector3.new(-45, 0, 35), Vector3.new(45, 0, -35),
	}) do
		VisualModels.Rock(arena, position, 1.15, { Snow = true })
	end
	for _, side in ipairs({ -1, 1 }) do
		for _, forward in ipairs({ -1, 1 }) do
			buildCitadelTower(arena, "PerimeterTower", Vector3.new(side * 244, 0, forward * 94), STYLE.Navy)
		end
	end
	-- Sculpted outcrops close the horizon without adding invisible maze walls.
	for _, position in ipairs({
		Vector3.new(-285, 0, -128), Vector3.new(285, 0, 128), Vector3.new(-285, 0, 128), Vector3.new(285, 0, -128),
	}) do
		VisualModels.Rock(arena, position, 2.2, { Snow = true })
	end
end

local function buildBase(arena, structures, team)
	local color = Config.Teams[team].Color
	local base = Config.BasePosition(team)
	local baseCFrame = Config.BaseCFrame(team)
	local presentation = Config.Presentation
	local platform = makePart(arena, team .. "BasePlatform", Vector3.new(presentation.BaseWidth, 4, presentation.BaseDepth), CFrame.new(base.X, 2, 0), STYLE.IvoryDark, Enum.Material.Cobblestone, true)
	platform:SetAttribute("Team", team)
	makePart(arena, team .. "BaseGrass", Vector3.new(presentation.BaseWidth - 6, 0.5, presentation.BaseDepth - 6), CFrame.new(base.X, 4.15, 0), C.Grass, Enum.Material.Grass, true)
	-- The courtyard is raised above the field. Broad, shallow steps give
	-- Humanoid navigation a real walkable descent instead of a 4.4-stud cliff.
	for _, laneX in ipairs(Config.Objectives.Lanes) do
		for step = 1, 5 do
			local top = 4.4 * (1 - step / 5)
			local height = 0.88
			local centerY = top - height / 2
			local stepPart = makePart(arena, team .. "ExitStep", Vector3.new(10, height, 4), baseCFrame * CFrame.new(laneX, centerY - base.Y, -62 - step * 4), STYLE.IvoryDark, Enum.Material.Cobblestone, true)
			stepPart:SetAttribute("BotWalkway", true)
		end
	end
	for _, side in ipairs({ -1, 1 }) do
		for _, forward in ipairs({ -42, 42 }) do
			local towerCFrame = baseCFrame * CFrame.new(side * 44, 5, forward)
			local groundPosition = (towerCFrame * CFrame.new(0, -5, 0)).Position
			local tower = VisualModels.Tower(arena, team .. "CornerTower", groundPosition, 0.55, color, { Holiday = true, CastShadow = true })
			tower:SetAttribute("BaseGeometry", true)
			tower:SetAttribute("Team", team)
			for _, descendant in ipairs(tower:GetDescendants()) do
				if descendant:IsA("BasePart") then
					descendant:SetAttribute("BaseGeometry", true)
					descendant:SetAttribute("Team", team)
				end
			end
			-- Preserve the old navigation/weapon obstacle without rendering a cube.
			local proxy = makePart(arena, team .. "CornerTowerCollision", Vector3.new(8, 10, 8), towerCFrame, C.StoneDark, Enum.Material.Cobblestone, true)
			proxy.Transparency = 1
			proxy.CanQuery = true
			proxy:SetAttribute("BaseGeometry", true)
			proxy:SetAttribute("Team", team)
		end
	end
	buildBaseArchitecture(arena, team, baseCFrame, color)
	local marker = makePart(arena, team .. "BaseMarker", Vector3.new(1, 1, 1), CFrame.new(base + Vector3.new(0, 25, 0)), color, Enum.Material.SmoothPlastic, false)
	marker.Transparency = 1
	marker.CanQuery = false
	billboard(marker, Config.Teams[team].Name .. " // КРЕПОСТЬ", color, Vector3.zero, UDim2.fromScale(1, 1))
	local spawnCFrame = baseCFrame * CFrame.new(0, 4, 34)
	local spawn = makePart(arena, team .. "Spawn", Vector3.new(12, 1, 12), spawnCFrame, color, Enum.Material.Neon, false, "SpawnLocation")
	spawn.Neutral = true
	spawn.CanQuery = false
	-- Tags let the local visibility controller hide only the opposing base during Build.
	for _, part in ipairs(arena:GetChildren()) do
		if part:IsA("BasePart") and string.sub(part.Name, 1, #team) == team then
			part:SetAttribute("Team", team)
			part:SetAttribute("BaseGeometry", true)
		end
	end
	return spawnCFrame + Vector3.new(0, 3, 0)
end

local function buildNpc(parent, name, position, color, title, action, description)
	local model = Instance.new("Model")
	model.Name = "NPC_" .. name
	model.Parent = parent
	local root = makePart(model, "Root", Vector3.new(3.2, 4.5, 2.2), CFrame.new(position + Vector3.new(0, 2.5, 0)), color, Enum.Material.SmoothPlastic, true)
	model.PrimaryPart = root
	makePart(model, "Head", Vector3.new(2.5, 2.2, 2.5), CFrame.new(position + Vector3.new(0, 6, 0)), Color3.fromRGB(224, 190, 145), Enum.Material.SmoothPlastic, true)
	makePart(model, "Hat", Vector3.new(3, 0.65, 3), CFrame.new(position + Vector3.new(0, 7.35, 0)), C.StoneDark, Enum.Material.Fabric, true)
	for _, side in ipairs({ -1, 1 }) do
		makePart(model, "Arm", Vector3.new(0.85, 3.2, 1), CFrame.new(position + Vector3.new(side * 2.1, 2.6, 0)), color, Enum.Material.SmoothPlastic, true)
		makePart(model, "Leg", Vector3.new(1.1, 2.2, 1.2), CFrame.new(position + Vector3.new(side * 0.75, -0.9, 0)), C.StoneDark, Enum.Material.SmoothPlastic, true)
	end
	local ring = makePart(model, "NeonRing", Vector3.new(6, 0.25, 6), CFrame.new(position + Vector3.new(0, 0.15, 0)), color, Enum.Material.Neon, false)
	ring.CanQuery = false
	local light = Instance.new("PointLight")
	light.Name = "NPCGlow"
	light.Color = color
	light.Brightness = 1.6
	light.Range = 16
	light.Parent = root
	local sparkles = Instance.new("Sparkles")
	sparkles.Name = "NPCSparkles"
	sparkles.SparkleColor = color
	sparkles.Parent = root
	billboard(root, title .. "\n" .. description, color, Vector3.new(0, 5.5, 0), UDim2.fromScale(1, 1))
	return prompt(root, action, description)
end

local function buildLobby(lobby, winterDecor)
	local presentation = Config.Presentation
	local lobbyWidth = presentation.LobbyWidth
	local lobbyDepth = presentation.LobbyDepth
	makePart(lobby, "LobbyStone", Vector3.new(lobbyWidth, 8, lobbyDepth), CFrame.new(0, 36, 330), STYLE.Navy, Enum.Material.Cobblestone, true)
	makePart(lobby, "LobbyDirt", Vector3.new(lobbyWidth - 4, 5, lobbyDepth - 4), CFrame.new(0, 41, 330), C.Dirt, Enum.Material.Ground, true)
	makePart(lobby, "LobbyGrass", Vector3.new(lobbyWidth - 6, 1, lobbyDepth - 6), CFrame.new(0, 44, 330), C.Grass, Enum.Material.Grass, true)
	local spawnCFrame = CFrame.lookAt(Vector3.new(0, 48, 365), Vector3.new(0, 48, 330))
	local spawn = makePart(lobby, "LobbySpawn", Vector3.new(12, 1, 12), spawnCFrame, C.White, Enum.Material.Neon, false, "SpawnLocation")
	spawn.Neutral = true
	spawn.CanQuery = false

	-- Continuous safety walls follow the new hall footprint, including its corners.
	local halfWidth = lobbyWidth / 2
	local halfDepth = lobbyDepth / 2
	for _, side in ipairs({ -1, 1 }) do
		makePart(lobby, "LobbySafetyWall", Vector3.new(1.5, 18, lobbyDepth - 4), CFrame.new(side * (halfWidth - 3), 53, 330), Color3.fromRGB(135, 190, 210), Enum.Material.Glass, true).Transparency = 0.72
		makePart(lobby, "LobbyFenceRail", Vector3.new(1.2, 1, lobbyDepth - 4), CFrame.new(side * (halfWidth - 3.5), 48, 330), STYLE.Gold, Enum.Material.Metal, true)
		local sidePostCount = math.floor((lobbyDepth - 8) / 15.5)
		for index = 0, sidePostCount do
			local z = 330 - (lobbyDepth - 8) / 2 + index * 15.5
			makePart(lobby, "LobbyFencePost", Vector3.new(2, 7, 2), CFrame.new(side * (halfWidth - 3.5), 47.5, z), STYLE.Navy, Enum.Material.Cobblestone, true)
		end
	end
	for _, side in ipairs({ -1, 1 }) do
		makePart(lobby, "LobbySafetyWall", Vector3.new(lobbyWidth - 4, 18, 1.5), CFrame.new(0, 53, 330 + side * (halfDepth - 2)), Color3.fromRGB(135, 190, 210), Enum.Material.Glass, true).Transparency = 0.72
		makePart(lobby, "LobbyFenceRail", Vector3.new(lobbyWidth - 4, 1, 1.2), CFrame.new(0, 48, 330 + side * (halfDepth - 2.5)), STYLE.Gold, Enum.Material.Metal, true)
		local frontPostCount = math.floor((lobbyWidth - 8) / 15.5)
		for index = 0, frontPostCount do
			local x = -(lobbyWidth - 8) / 2 + index * 15.5
			makePart(lobby, "LobbyFencePost", Vector3.new(2, 7, 2), CFrame.new(x, 47.5, 330 + side * (halfDepth - 2.5)), STYLE.Navy, Enum.Material.Cobblestone, true)
		end
	end

	local crate = makePart(lobby, "LobbyLootbox", Vector3.new(9, 7, 9), CFrame.new(0, 48, 318), C.Gold, Enum.Material.Metal, true)
	local crateLight = Instance.new("PointLight")
	crateLight.Color = C.Gold
	crateLight.Brightness = 1.2
	crateLight.Range = 18
	crateLight.Parent = crate
	makePart(lobby, "LootboxBand", Vector3.new(9.5, 1.2, 9.5), CFrame.new(0, 49, 318), C.StoneDark, Enum.Material.Metal, true)
	billboard(crate, "GEAR // ЛУТБОКС", C.Gold)
	local lootPrompt = prompt(crate, "ОТКРЫТЬ", "Игровые кейсы · шансы 65 / 30 / 5")

	local board = makePart(lobby, "StartBoard", Vector3.new(18, 12, 1.5), CFrame.new(-30, 51, 318), C.StoneDark, Enum.Material.WoodPlanks, true)
	billboard(board, "BLOCK // БОЙ 6×6", C.White, Vector3.new(0, 0, 0))
	local startPrompt = prompt(board, "В БОЙ", "Быстрый старт · боты заполняют команды")

	local displayColumns = math.max(1, math.ceil(#Catalog.WeaponOrder / 2))
	for index, weaponId in ipairs(Catalog.WeaponOrder) do
		local row = math.floor((index - 1) / displayColumns)
		local column = (index - 1) % displayColumns
		local x = (column - (displayColumns - 1) / 2) * 24
		local z = 292 - row * 16
		local pedestal = makePart(lobby, "WeaponPedestal", Vector3.new(10, 3, 10), CFrame.new(x, 46, z), C.Stone, Enum.Material.Cobblestone, true)
		holidayGlow(pedestal, Color3.fromRGB(255, 224, 177), 10, 0.65)
		local weapon = WeaponModels.Build(weaponId)
		weapon.Name = "Display_" .. weaponId
		weapon.Parent = lobby
		weapon:PivotTo(CFrame.new(x, 50, z) * CFrame.Angles(0, math.rad(90), 0))
		for _, item in ipairs(weapon:GetDescendants()) do
			if item:IsA("BasePart") then
				item.Anchored = true
			end
		end
		local labelAnchor = makePart(lobby, "WeaponLabelAnchor", Vector3.new(1, 1, 1), CFrame.new(x, 52, z), C.White, Enum.Material.SmoothPlastic, false)
		labelAnchor.Transparency = 1
		labelAnchor.CanQuery = false
		local definition = Catalog.GetWeapon(weaponId)
		billboard(labelAnchor, definition.Name, Catalog.RarityColors[definition.Rarity], Vector3.zero)
	end

	local upgradePrompt = buildNpc(lobby, "UpgradeForge", Vector3.new(-48, 44.5, 344), Color3.fromRGB(88, 220, 255), "FORGE // УЛУЧШЕНИЯ", "УЛУЧШИТЬ", "HP · броня · скорость · постройки")
	local dailyPrompt = buildNpc(lobby, "DailyBonus", Vector3.new(48, 44.5, 344), Color3.fromRGB(255, 211, 78), "DAILY // БОНУС", "ПОЛУЧИТЬ", "Монеты · XP · жетон кейса")
	local shopPrompt = buildNpc(lobby, "CosmeticShop", Vector3.new(48, 44.5, 300), Color3.fromRGB(195, 117, 255), "ROBUX // КОСМЕТИКА", "МАГАЗИН", "Только внешний вид · без pay-to-win")
	local defensePrompt = buildNpc(lobby, "DefenseWorkshop", Vector3.new(-48, 44.5, 300), Color3.fromRGB(255, 133, 71), "DEFENSE // ЛОВУШКИ", "КУПИТЬ ЧЕРТЁЖ", "Шипы · мины · огнемёт за монеты")
	local expeditionPrompt = buildNpc(lobby, "ExpeditionHub", Vector3.new(0, 44.5, 370), Color3.fromRGB(103, 229, 183), "PVE // ЭКСПЕДИЦИИ", "ВЫБРАТЬ РЕЙД", "Уровни · волны · боссы · рейтинг")
	local upgradePad = makePart(lobby, "UpgradePad", Vector3.new(16, 0.35, 12), CFrame.new(-48, 44.8, 344), Color3.fromRGB(40, 120, 145), Enum.Material.Metal, false)
	upgradePad.CanQuery = false
	local dailyPad = makePart(lobby, "DailyPad", Vector3.new(16, 0.35, 12), CFrame.new(48, 44.8, 344), Color3.fromRGB(150, 110, 35), Enum.Material.Metal, false)
	dailyPad.CanQuery = false
	local shopPad = makePart(lobby, "ShopPad", Vector3.new(16, 0.35, 12), CFrame.new(48, 44.8, 300), Color3.fromRGB(105, 55, 145), Enum.Material.Metal, false)
	shopPad.CanQuery = false
	local defensePad = makePart(lobby, "DefensePad", Vector3.new(16, 0.35, 12), CFrame.new(-48, 44.8, 300), Color3.fromRGB(150, 65, 35), Enum.Material.Metal, false)
	defensePad.CanQuery = false
	local expeditionPad = makePart(lobby, "ExpeditionPad", Vector3.new(18, 0.35, 12), CFrame.new(0, 44.8, 370), Color3.fromRGB(40, 135, 105), Enum.Material.Metal, false)
	expeditionPad.CanQuery = false

	for _, position in ipairs({ Vector3.new(-70, 44.5, 370), Vector3.new(70, 44.5, 370), Vector3.new(-70, 44.5, 280), Vector3.new(70, 44.5, 280) }) do
		buildChristmasTree(winterDecor, position, 0.55)
	end
	decorateLobby(winterDecor)
	buildLobbyArchitecture(lobby)
	return spawnCFrame, lootPrompt, startPrompt, upgradePrompt, dailyPrompt, shopPrompt, defensePrompt, expeditionPrompt
end

local function buildDotaFrontier(arena)
	local campSpots = {}
	for _, lane in ipairs(Config.Objectives.Lanes) do
		local laneName = lane < 0 and "TOP LANE" or (lane > 0 and "BOTTOM LANE" or "MID LANE // 67")
		for _, edge in ipairs({ -1, 1 }) do
			decorPart(arena, "FrontierLaneBorder", Vector3.new(510, 0.12, 0.8), CFrame.new(0, 0.42, lane + edge * 10), STYLE.Gold, Enum.Material.Metal)
		end
		local marker = makePart(arena, "LaneLabelAnchor", Vector3.new(1, 1, 1), CFrame.new(0, 8, lane), C.White, Enum.Material.SmoothPlastic, false)
		marker.Transparency = 1
		marker.CanQuery = false
		billboard(marker, laneName, STYLE.Gold, Vector3.zero, UDim2.fromOffset(250, 42))
	end
	local river = decorPart(arena, "FrozenRiver", Vector3.new(18, 0.16, 340), CFrame.new(0, 0.06, 0), STYLE.Ice, Enum.Material.Ice)
	river.Transparency = 0.25
	for _, lane in ipairs(Config.Objectives.Lanes) do
		VisualModels.Bridge(arena, Vector3.new(0, 0.05, lane), 30, 24, STYLE.Gold, { Holiday = true })
	end
	for _, x in ipairs({ -170, -85, 85, 170 }) do
		for _, side in ipairs({ -1, 1 }) do
			local path = makePart(arena, "JunglePath", Vector3.new(10, 0.25, 86), CFrame.new(x, 0.16, side * 56), C.Dirt, Enum.Material.Ground, false)
			path.CanQuery = false
			for _, offset in ipairs({ Vector3.new(-9, 0, -28), Vector3.new(9, 0, 28) }) do
				buildTree(arena, Vector3.new(x, 0, side * 56) + offset, 0.62)
			end
		end
	end
	for _, team in ipairs(Config.TeamOrder) do
		local side = team == "Blue" and -1 or 1
		for _, lane in ipairs(Config.Objectives.Lanes) do
			for _, distance in ipairs(Config.Objectives.TowerDistances) do
				local zOffset = lane == 0 and 18 or (lane > 0 and -16 or 16)
				local pad = makePart(arena, "LaneTowerPad", Vector3.new(13, 0.25, 13), CFrame.new(side * distance, 0.18, lane + zOffset), Config.Teams[team].Dark, Enum.Material.Cobblestone, false)
				pad:SetAttribute("Team", team)
				pad:SetAttribute("BaseGeometry", true)
				pad.CanQuery = false
			end
		end
	end
	for _, camp in ipairs(Config.Objectives.NeutralCamps) do
		local campModel = Instance.new("Model")
		campModel.Name = "NeutralCamp_" .. camp.Id
		campModel.Parent = arena
		local pad = makePart(campModel, "NeutralCampPad", Vector3.new(28, 0.3, 24), CFrame.new(camp.Position + Vector3.new(0, 0.15, 0)), C.StoneDark, Enum.Material.Cobblestone, false)
		pad.CanQuery = false
		for _, offset in ipairs({ Vector3.new(-17, 0, -11), Vector3.new(17, 0, 11), Vector3.new(-17, 0, 11) }) do
			buildTree(campModel, camp.Position + offset, 0.62)
		end
		local campRock = makePart(campModel, "CampRock", Vector3.new(5, 4, 5), CFrame.new(camp.Position + Vector3.new(10, 2, -7)), C.Stone, Enum.Material.Slate, true)
		campRock.Transparency = 1
		campRock.CanQuery = true
		VisualModels.Rock(campModel, camp.Position + Vector3.new(10, 0, -7), 0.82, { Snow = true })
		local marker = makePart(campModel, "CampLabelAnchor", Vector3.new(1, 1, 1), CFrame.new(camp.Position + Vector3.new(0, 9, 0)), C.White, Enum.Material.SmoothPlastic, false)
		marker.Transparency = 1
		marker.CanQuery = false
		billboard(marker, "NEUTRAL CAMP // " .. string.upper(camp.Id), Color3.fromRGB(194, 223, 191), Vector3.zero, UDim2.fromOffset(230, 36))
		table.insert(campSpots, { Id = camp.Id, Position = camp.Position, Model = campModel })
	end
	return campSpots
end

local function buildCapturePoint(parent)
	local model = Instance.new("Model")
	model.Name = "Capture67"
	model.Parent = parent
	local base = makePart(model, "CaptureBase", Vector3.new(28, 0.8, 28), CFrame.new(0, 0.4, 0), C.StoneDark, Enum.Material.Cobblestone, true)
	base:SetAttribute("CaptureGeometry", true)
	local crystal = makePart(model, "CaptureCrystal", Vector3.new(7, 10, 7), CFrame.new(0, 6, 0) * CFrame.Angles(0, math.rad(45), 0), Color3.fromRGB(237, 190, 64), Enum.Material.DiamondPlate, true)
	model.PrimaryPart = crystal
	for _, side in ipairs({ -1, 1 }) do
		for _, forward in ipairs({ -1, 1 }) do
			makePart(model, "CapturePylon", Vector3.new(2.2, 7, 2.2), CFrame.new(side * 11, 3.5, forward * 11), C.Stone, Enum.Material.Metal, true)
			makePart(model, "CaptureGlow", Vector3.new(2.5, 0.6, 2.5), CFrame.new(side * 11, 7.2, forward * 11), Color3.fromRGB(237, 190, 64), Enum.Material.Neon, false)
		end
	end
	for index = 1, 4 do
		local angle = math.rad(index * 90)
		makePart(model, "CaptureRing", Vector3.new(8, 0.3, 1), CFrame.new(math.cos(angle) * 9, 1.1, math.sin(angle) * 9) * CFrame.Angles(0, -angle, 0), Color3.fromRGB(237, 190, 64), Enum.Material.Neon, false)
	end
	local light = Instance.new("PointLight")
	light.Name = "CaptureLight"
	light.Color = Color3.fromRGB(237, 190, 64)
	light.Brightness = 2.5
	light.Range = 30
	light.Parent = crystal
	local sparkles = Instance.new("Sparkles")
	sparkles.Name = "CaptureSparkles"
	sparkles.SparkleColor = Color3.fromRGB(237, 190, 64)
	sparkles.Parent = crystal
	-- Preserve the gameplay anchors, but render a detailed crystal assembly.
	base.Transparency = 1
	crystal.Transparency = 1
	for _, item in ipairs(model:GetDescendants()) do
		if item:IsA("BasePart") and (item.Name == "CapturePylon" or item.Name == "CaptureGlow" or item.Name == "CaptureRing") then
			item.Transparency = 1
		end
	end
	VisualModels.Capture(model, crystal.CFrame, Color3.fromRGB(237, 190, 64))
	local gui = billboard(crystal, "67", Color3.fromRGB(255, 222, 105), Vector3.new(0, 8, 0), UDim2.fromScale(1, 1))
	gui.Name = "Capture67Label"
	gui.Size = UDim2.fromOffset(250, 140)
	local label = gui:FindFirstChild("TextLabel")
	label.TextStrokeTransparency = 0.05
	local subtitleAnchor = makePart(model, "CaptureSubtitleAnchor", Vector3.new(1, 1, 1), CFrame.new(0, 2, 0), C.White, Enum.Material.SmoothPlastic, false)
	subtitleAnchor.Transparency = 1
	subtitleAnchor.CanQuery = false
	billboard(subtitleAnchor, "CAPTURE // КОНТРОЛЬ", C.White, Vector3.new(0, 4, 0), UDim2.fromScale(1, 1))
	model:SetAttribute("CaptureRadius", 22)
	return { Model = model, Root = crystal, Label = label, Light = light }
end

function WorldBuilder.Build()
	buildSerial = buildSerial + 1
	local serial = buildSerial
	local old = Workspace:FindFirstChild("BlockSiegeWorld")
	if old then
		old:Destroy()
	end
	local root = Instance.new("Folder")
	root.Name = "BlockSiegeWorld"
	root.Parent = Workspace
	local arena = Instance.new("Folder")
	arena.Name = "Arena"
	arena.Parent = root
	local structures = Instance.new("Folder")
	structures.Name = "Structures"
	structures.Parent = root
	local bots = Instance.new("Folder")
	bots.Name = "Bots"
	bots.Parent = root
	local neutrals = Instance.new("Folder")
	neutrals.Name = "Neutrals"
	neutrals.Parent = root
	local lobby = Instance.new("Folder")
	lobby.Name = "Lobby"
	lobby.Parent = root
	local winterDecor = Instance.new("Folder")
	winterDecor.Name = "WinterDecor"
	winterDecor.Parent = root

	local presentation = Config.Presentation
	makePart(arena, "ArenaDirt", Vector3.new(presentation.ArenaWidth, 8, presentation.ArenaDepth), CFrame.new(0, -6, 0), C.Dirt, Enum.Material.Ground, true)
	makePart(arena, "ArenaGrass", Vector3.new(presentation.ArenaWidth, 2, presentation.ArenaDepth), CFrame.new(0, -1, 0), C.Grass, Enum.Material.Grass, true)
	makePart(arena, "CenterLane", Vector3.new(510, 0.35, 22), CFrame.new(0, 0.15, 0), C.Sand, Enum.Material.Ground, true)
	for _, z in ipairs(Config.Objectives.Lanes) do
		if z ~= 0 then
			makePart(arena, "SideLane", Vector3.new(540, 0.3, 16), CFrame.new(0, 0.12, z), C.Sand, Enum.Material.Ground, true)
		end
		for x = -240, 240, 24 do
			decorPart(arena, "LaneInlay", Vector3.new(8, 0.07, 0.32), CFrame.new(x, 0.38, z), Color3.fromRGB(202, 188, 153), Enum.Material.Metal)
		end
	end
	for index = 0, 31 do
		local x = -310 + index * 20
		local height = 8 + (index * 5 % 7)
		for _, side in ipairs({ -1, 1 }) do
			makePart(arena, "CliffDirt", Vector3.new(20, height, 6), CFrame.new(x, -10 - height / 2, side * presentation.ArenaEdgeZ), C.Dirt, Enum.Material.Ground, true)
			makePart(arena, "CliffStone", Vector3.new(18, 3, 6.5), CFrame.new(x, -12, side * presentation.ArenaEdgeZ), STYLE.Navy, Enum.Material.Slate, true)
		end
	end
	for _, side in ipairs({ -1, 1 }) do
		local zWall = makePart(arena, "ArenaBoundary", Vector3.new(presentation.ArenaWidth, 20, 2), CFrame.new(0, 8, side * presentation.ArenaEdgeZ), STYLE.Navy, Enum.Material.Slate, true)
		zWall.CanQuery = false
		decorPart(arena, "ArenaBoundarySnow", Vector3.new(presentation.ArenaWidth, 0.5, 2.5), CFrame.new(0, 18.25, side * presentation.ArenaEdgeZ), HOLIDAY.Snow, Enum.Material.Snow)
		local xWall = makePart(arena, "ArenaBoundary", Vector3.new(2, 20, presentation.ArenaDepth), CFrame.new(side * presentation.ArenaEdgeX, 8, 0), STYLE.Navy, Enum.Material.Slate, true)
		xWall.CanQuery = false
		decorPart(arena, "ArenaBoundarySnow", Vector3.new(2.5, 0.5, presentation.ArenaDepth), CFrame.new(side * presentation.ArenaEdgeX, 18.25, 0), HOLIDAY.Snow, Enum.Material.Snow)
	end
	-- The terrain/cloud system and tiled ground materials carry the horizon and
	-- surface detail. Avoid scatter made from tiny cubes across the combat view.
	local teamSpawns = {}
	for _, team in ipairs(Config.TeamOrder) do
		teamSpawns[team] = buildBase(arena, structures, team)
	end

	for _, position in ipairs({
		Vector3.new(-70, 0, -72), Vector3.new(-35, 0, 73), Vector3.new(35, 0, -73), Vector3.new(70, 0, 72),
		Vector3.new(-10, 0, -78), Vector3.new(10, 0, 78), Vector3.new(-90, 0, 62), Vector3.new(90, 0, -62),
	}) do
		buildTree(arena, position, 0.85)
	end
	for _, entry in ipairs({
		{ Vector3.new(-45, 3, -35), Vector3.new(12, 6, 8) },
		{ Vector3.new(45, 3, 35), Vector3.new(12, 6, 8) },
		{ Vector3.new(-45, 3, 35), Vector3.new(12, 6, 8) },
		{ Vector3.new(45, 3, -35), Vector3.new(12, 6, 8) },
	}) do
		local cover = makePart(arena, "StoneCover", entry[2], CFrame.new(entry[1]), C.Stone, Enum.Material.Cobblestone, true)
		cover.Transparency = 1
		cover.CanQuery = true
	end
	decorateArena(winterDecor)
	buildArenaArchitecture(arena)
	local neutralCamps = buildDotaFrontier(arena)

	local capturePoint = buildCapturePoint(arena)
	local lobbySpawn, lootPrompt, startPrompt, upgradePrompt, dailyPrompt, shopPrompt, defensePrompt, expeditionPrompt = buildLobby(lobby, winterDecor)
	buildSculptedTerrain()
	pcall(function()
		Lighting.Technology = Enum.Technology.Future
	end)
	Lighting.Brightness = 2.2
	Lighting.ClockTime = 21.45
	Lighting.EnvironmentDiffuseScale = 0.34
	Lighting.EnvironmentSpecularScale = 0.68
	Lighting.GlobalShadows = true
	Lighting.OutdoorAmbient = Color3.fromRGB(48, 62, 88)
	Lighting.ColorShift_Top = Color3.fromRGB(121, 155, 205)
	Lighting.ExposureCompensation = 0.3
	local function ensureEffect(className, name)
		local effect = Lighting:FindFirstChild(name)
		if not effect then
			effect = Instance.new(className)
			effect.Name = name
			effect.Parent = Lighting
		end
		return effect
	end
	local atmosphere = ensureEffect("Atmosphere", "BlockSiegeAtmosphere")
	atmosphere.Density = 0.16
	atmosphere.Haze = 0.12
	atmosphere.Color = Color3.fromRGB(105, 130, 165)
	atmosphere.Decay = Color3.fromRGB(37, 49, 72)
	atmosphere.Glare = 0.12
	local colorCorrection = ensureEffect("ColorCorrectionEffect", "BlockSiegeColor")
	colorCorrection.Saturation = 0.06
	colorCorrection.Contrast = 0.12
	local bloom = ensureEffect("BloomEffect", "BlockSiegeBloom")
	bloom.Intensity = 0.42
	bloom.Size = 24
	bloom.Threshold = 0.85
	local rays = ensureEffect("SunRaysEffect", "BlockSiegeSun")
	rays.Intensity = 0

	if AssetService and task and task.spawn then
		task.spawn(function()
			loadCreatorStoreDecorations(root, lobby, arena, winterDecor, serial)
		end)
	end

	return {
		Root = root,
		Arena = arena,
		Structures = structures,
		Bots = bots,
		Neutrals = neutrals,
		NeutralCamps = neutralCamps,
		Lobby = lobby,
		WinterDecor = winterDecor,
		LobbySpawn = lobbySpawn,
		TeamSpawns = teamSpawns,
		LootPrompt = lootPrompt,
		StartPrompt = startPrompt,
		UpgradePrompt = upgradePrompt,
		DailyPrompt = dailyPrompt,
		ShopPrompt = shopPrompt,
		DefensePrompt = defensePrompt,
		ExpeditionPrompt = expeditionPrompt,
		CapturePoint = capturePoint,
	}
end

return WorldBuilder
]]></string>
          </Properties>
        </Item>
<Item class="ModuleScript" referent="32">
          <Properties>
            <string name="Name">AbilityService</string>
            <string name="Source"><![CDATA[-- BLOCKSIEGE // SERVER-AUTHORITATIVE CLASS ABILITIES
-- Random class draft, cooldowns, deployables, healing, buffs and ability damage.
-- Clients only request F/G and render replicated models/FX.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")
local Shared = ReplicatedStorage:WaitForChild("BlockSiege")
local Config = require(Shared:WaitForChild("Config"))
local AbilityCatalog = require(Shared:WaitForChild("AbilityCatalog"))
local CombatModels = require(Shared:WaitForChild("CombatModels"))

local vector3Type = typeof(Vector3.new())
local AbilityService = {}
local world
local remotes
local state
local fortressService
local botService
local weaponService
local objectFolder
local phaseProvider = function() return "Lobby" end
local teamProvider = function() return nil end
local targetsProvider = function() return {} end
local random = Random.new()
local playerClasses = {}
local modelClasses = {}
local teamDecks = {}
local teamDeckCursor = { Blue = 0, Orange = 0 }
local cooldowns = {}
local effects = {}
local projectiles = {}
local mines = {}
local turrets = {}
local drones = {}
local banners = {}
local cooldownClock = 0
local stateClock = 0
local classCleanupClock = 0
local rewardHandler

local function validPosition(position)
	return typeof(position) == vector3Type and position.X == position.X and position.Y == position.Y and position.Z == position.Z
		and math.abs(position.X) < 10000 and math.abs(position.Y) < 10000 and math.abs(position.Z) < 10000
end

local function rootOf(model)
	return model and (model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart) or nil
end

local function living(model)
	local humanoid = model and model:FindFirstChildOfClass("Humanoid")
	local root = rootOf(model)
	return model and model.Parent and humanoid and humanoid.Health > 0 and root and humanoid or nil
end

local function notify(player, text)
	if remotes and remotes.Notify and player and player.Parent then
		remotes.Notify:FireClient(player, text)
	end
end

local function emit(payload)
	if remotes and remotes.AbilityFX then
		remotes.AbilityFX:FireAllClients(payload)
	end
end

local function getClassForModel(model)
	return modelClasses[model] or (model and model:GetAttribute("ClassId")) or nil
end

local function getClassForPlayer(player)
	return playerClasses[player.UserId] or player:GetAttribute("ClassId") or nil
end

local function updateCooldownAttributes(owner)
	local clock = os.clock()
	local ownerCooldowns = cooldowns[owner]
	for slot = 1, 2 do
		local remaining = ownerCooldowns and math.max(0, (ownerCooldowns[slot] or 0) - clock) or 0
		remaining = math.ceil(remaining * 10) / 10
		if owner:GetAttribute("Ability" .. slot .. "Remaining") ~= remaining then
			owner:SetAttribute("Ability" .. slot .. "Remaining", remaining)
		end
	end
end

local function publishPlayerClass(player, classId)
	local definition = AbilityCatalog.GetClass(classId)
	if not definition then
		return
	end
	playerClasses[player.UserId] = classId
	player:SetAttribute("ClassId", classId)
	player:SetAttribute("ClassName", definition.Name)
	player:SetAttribute("ClassRole", definition.Role)
	player:SetAttribute("ClassDescription", definition.Description)
	player:SetAttribute("ClassColor", definition.Color)
	player:SetAttribute("ClassBuildBonus", definition.BuildBonus or 0)
	for slot = 1, 2 do
		local ability = AbilityCatalog.GetAbilityForSlot(classId, slot)
		player:SetAttribute("Ability" .. slot .. "Id", ability.Id)
		player:SetAttribute("Ability" .. slot .. "Name", ability.Name)
		player:SetAttribute("Ability" .. slot .. "ShortName", ability.ShortName)
		player:SetAttribute("Ability" .. slot .. "Description", ability.Description)
		player:SetAttribute("Ability" .. slot .. "Cooldown", ability.Cooldown)
		player:SetAttribute("Ability" .. slot .. "Hotkey", ability.Hotkey)
	end
	cooldowns[player] = { 0, 0 }
	updateCooldownAttributes(player)
end

local function clearPlayerClass(player)
	playerClasses[player.UserId] = nil
	cooldowns[player] = nil
	for _, attribute in ipairs({ "ClassId", "ClassName", "ClassRole", "ClassDescription", "Ability1Id", "Ability1Name", "Ability1ShortName", "Ability1Description", "Ability2Id", "Ability2Name", "Ability2ShortName", "Ability2Description", "Ability1Hotkey", "Ability2Hotkey" }) do
		player:SetAttribute(attribute, "")
	end
	player:SetAttribute("ClassColor", nil)
	player:SetAttribute("ClassBuildBonus", 0)
	player:SetAttribute("Ability1Cooldown", 0)
	player:SetAttribute("Ability2Cooldown", 0)
	player:SetAttribute("Ability1Remaining", 0)
	player:SetAttribute("Ability2Remaining", 0)
end

local function refreshEffects(model)
	if not model then
		return
	end
	local clock = os.clock()
	local effect = effects[model]
	local damage = tonumber(model:GetAttribute("ClassDamageMultiplier")) or 1
	local taken = 1
	local speed = tonumber(model:GetAttribute("ClassSpeedBonus")) or 0
	if effect then
		if effect.ShieldUntil and clock < effect.ShieldUntil then
			taken = math.min(taken, effect.ShieldMultiplier or 1)
		end
		if effect.OverdriveUntil and clock < effect.OverdriveUntil then
			damage = damage * (effect.OverdriveMultiplier or 1)
		end
		if effect.RallyUntil and clock < effect.RallyUntil then
			damage = damage * (effect.RallyDamage or 1)
			speed = speed + (effect.RallySpeed or 0)
		end
	end
	model:SetAttribute("DamageMultiplier", damage)
	model:SetAttribute("DamageTakenMultiplier", taken)
	model:SetAttribute("AbilitySpeedBonus", speed)
	model:SetAttribute("Shielded", taken < 0.999)
	local humanoid = model:FindFirstChildOfClass("Humanoid")
	if humanoid then
		local baseSpeed = tonumber(model:GetAttribute("BaseWalkSpeed")) or humanoid.WalkSpeed
		local desiredSpeed = baseSpeed + speed
		if math.abs(humanoid.WalkSpeed - desiredSpeed) > 0.01 then
			humanoid.WalkSpeed = desiredSpeed
		end
	end
end

local function applyClassToModel(model, classId)
	local definition = AbilityCatalog.GetClass(classId)
	if not model or not definition then
		return nil
	end
	modelClasses[model] = classId
	model:SetAttribute("ClassId", classId)
	model:SetAttribute("ClassName", definition.Name)
	model:SetAttribute("ClassRole", definition.Role)
	model:SetAttribute("ClassColor", definition.Color)
	model:SetAttribute("ClassDamageMultiplier", definition.DamageMultiplier or 1)
	model:SetAttribute("ClassSpeedBonus", definition.SpeedBonus or 0)
	local humanoid = model:FindFirstChildOfClass("Humanoid")
	if humanoid and model:GetAttribute("ClassPassiveApplied") ~= true then
		humanoid.MaxHealth = humanoid.MaxHealth + (definition.MaxHealthBonus or 0)
		humanoid.Health = math.min(humanoid.MaxHealth, humanoid.Health + (definition.MaxHealthBonus or 0))
		local armor = tonumber(model:GetAttribute("Armor")) or 0
		model:SetAttribute("Armor", armor + (definition.ArmorBonus or 0))
		model:SetAttribute("BaseWalkSpeed", humanoid.WalkSpeed)
		model:SetAttribute("ClassPassiveApplied", true)
	end
	cooldowns[model] = cooldowns[model] or { 0, 0 }
	refreshEffects(model)
	updateCooldownAttributes(model)
	return classId
end

local function shuffledDeck()
	local deck = {}
	for _, classId in ipairs(AbilityCatalog.ClassOrder) do
		table.insert(deck, classId)
	end
	-- The sixth slot is random, while the first five guarantee role variety.
	table.insert(deck, AbilityCatalog.ClassOrder[random:NextInteger(1, #AbilityCatalog.ClassOrder)])
	for index = #deck, 2, -1 do
		local other = random:NextInteger(1, index)
		deck[index], deck[other] = deck[other], deck[index]
	end
	return deck
end

local function nextClass(team)
	if not teamDecks[team] then
		teamDecks[team] = shuffledDeck()
		teamDeckCursor[team] = 0
	end
	local cursor = (teamDeckCursor[team] or 0) + 1
	teamDeckCursor[team] = cursor
	return teamDecks[team][cursor] or AbilityCatalog.ClassOrder[random:NextInteger(1, #AbilityCatalog.ClassOrder)]
end

local function ensureObjectFolder()
	if objectFolder and objectFolder.Parent then
		return objectFolder
	end
	objectFolder = Instance.new("Folder")
	objectFolder.Name = "AbilityObjects"
	objectFolder.Parent = world and world.Root or Workspace
	return objectFolder
end

local function parentUtility(object, team, abilityId, owner)
	object.Parent = ensureObjectFolder()
	object:SetAttribute("Team", team)
	object:SetAttribute("AbilityId", abilityId)
	if owner then
		object:SetAttribute("OwnerUserId", owner.UserId)
	end
	return object
end

local function groundTarget(character, position, range)
	local root = rootOf(character)
	if not root then
		return nil
	end
	local origin = root.Position
	local target = validPosition(position) and position or origin
	local delta = target - origin
	if range and delta.Magnitude > range then
		target = origin + delta.Unit * range
	end
	local edgeX = (Config.Presentation and Config.Presentation.ArenaEdgeX or 300) - 8
	local edgeZ = (Config.Presentation and Config.Presentation.ArenaEdgeZ or 160) - 8
	return Vector3.new(math.clamp(target.X, -edgeX, edgeX), 0.8, math.clamp(target.Z, -edgeZ, edgeZ))
end

local function allies(team)
	local result = {}
	if botService then
		for _, model in ipairs(botService.GetModels(team)) do
			if living(model) then
				table.insert(result, model)
			end
		end
	end
	for _, player in ipairs(Players:GetPlayers()) do
		local playerTeam = teamProvider(player) or player:GetAttribute("Team")
		if playerTeam == team and player:GetAttribute("InMatch") ~= false and living(player.Character) then
			table.insert(result, player.Character)
		end
	end
	return result
end

local function enemies(team)
	local result = {}
	for _, model in ipairs(targetsProvider(team)) do
		if living(model) then
			table.insert(result, model)
		end
	end
	return result
end

local function healAround(team, center, radius, amount)
	local healed = 0
	for _, model in ipairs(allies(team)) do
		local root = rootOf(model)
		local humanoid = living(model)
		if root and humanoid and (root.Position - center).Magnitude <= radius then
			local before = humanoid.Health
			humanoid.Health = math.min(humanoid.MaxHealth, humanoid.Health + amount)
			if humanoid.Health > before then
				healed = healed + 1
			end
		end
	end
	return healed
end

local function damageAround(team, center, radius, amount, sourcePlayer, sourceModel)
	local damageMultiplier = sourceModel and tonumber(sourceModel:GetAttribute("DamageMultiplier")) or 1
	local hits = 0
	for _, model in ipairs(enemies(team)) do
		local root = rootOf(model)
		if root and (root.Position - center).Magnitude <= radius then
			if weaponService and weaponService.ApplyAbilityDamage then
				weaponService.ApplyAbilityDamage(model, amount * damageMultiplier, team, sourcePlayer)
			else
				local humanoid = living(model)
				if humanoid then
					local armor = tonumber(model:GetAttribute("Armor")) or 0
					local shield = tonumber(model:GetAttribute("DamageTakenMultiplier")) or 1
					humanoid:TakeDamage(amount * damageMultiplier * shield * (1 - math.clamp(armor, 0, 0.65)))
				end
			end
			hits = hits + 1
		end
	end
	return hits
end

local function nearestEnemy(team, position, range)
	local best
	local bestDistance = range or math.huge
	for _, model in ipairs(enemies(team)) do
		local root = rootOf(model)
		if root then
			local distance = (root.Position - position).Magnitude
			if distance <= bestDistance then
				best = model
				bestDistance = distance
			end
		end
	end
	return best, bestDistance
end

local function effectFor(model)
	local effect = effects[model]
	if not effect then
		effect = {}
		effects[model] = effect
	end
	return effect
end

local function applyRally(buffModel, untilTime, ability)
	local effect = effectFor(buffModel)
	effect.RallyUntil = math.max(effect.RallyUntil or 0, untilTime)
	effect.RallyDamage = ability.DamageMultiplier or 1.2
	effect.RallySpeed = ability.SpeedBonus or 5
	refreshEffects(buffModel)
end

local function rallyAllies(team, center, radius, untilTime, ability)
	for _, model in ipairs(allies(team)) do
		local root = rootOf(model)
		if root and (root.Position - center).Magnitude <= radius then
			applyRally(model, untilTime, ability)
		end
	end
end

local function execute(character, team, ability, target, player)
	local root = rootOf(character)
	if not root or not living(character) then
		return false
	end
	local now = os.clock()
	local center = target or root.Position
	if ability.Kind == "Heal" then
		healAround(team, center, ability.Radius, ability.Amount)
		emit({ Kind = "Heal", AbilityId = ability.Id, Position = center, Radius = ability.Radius, Team = team, Color = ability.Color })
	elseif ability.Kind == "Drone" then
		if #drones >= 12 then
			return false
		end
		local object = parentUtility(CombatModels.BuildDrone(Config.Teams[team].Color), team, ability.Id, player)
		object:PivotTo(CFrame.new(root.Position + Vector3.new(0, 5, 0)))
		table.insert(drones, { Model = object, Owner = character, Team = team, Until = now + ability.Duration, Radius = ability.Radius, Heal = ability.HealPerSecond, NextHeal = now })
		emit({ Kind = "DroneLaunch", AbilityId = ability.Id, Position = root.Position, Team = team, Color = ability.Color, Duration = ability.Duration })
	elseif ability.Kind == "Shield" then
		local effect = effectFor(character)
		effect.ShieldUntil = math.max(effect.ShieldUntil or 0, now + ability.Duration)
		effect.ShieldMultiplier = ability.DamageTakenMultiplier or 0.42
		refreshEffects(character)
		emit({ Kind = "Shield", AbilityId = ability.Id, Position = root.Position, Origin = root.Position, Team = team, Color = ability.Color, Duration = ability.Duration, Radius = 6 })
	elseif ability.Kind == "Slam" then
		damageAround(team, center, ability.Radius, ability.Amount, player, character)
		emit({ Kind = "Slam", AbilityId = ability.Id, Position = center, Radius = ability.Radius, Team = team, Color = ability.Color })
	elseif ability.Kind == "Overdrive" then
		local effect = effectFor(character)
		effect.OverdriveUntil = math.max(effect.OverdriveUntil or 0, now + ability.Duration)
		effect.OverdriveMultiplier = ability.DamageMultiplier or 1.45
		refreshEffects(character)
		emit({ Kind = "Overdrive", AbilityId = ability.Id, Position = root.Position, Origin = root.Position, Team = team, Color = ability.Color, Duration = ability.Duration, Radius = 5 })
	elseif ability.Kind == "Bomb" then
		if #projectiles >= 24 then
			return false
		end
		local object = parentUtility(CombatModels.BuildBomb(Config.Teams[team].Color), team, ability.Id, player)
		local start = root.Position + Vector3.new(0, 2, 0)
		object:PivotTo(CFrame.new(start))
		table.insert(projectiles, { Model = object, Team = team, Source = character, Player = player, Start = start, Target = center, Born = now, Duration = ability.FlightTime or 0.85, Radius = ability.Radius, Amount = ability.Amount, AbilityId = ability.Id })
		emit({ Kind = "BombLaunch", AbilityId = ability.Id, Position = start, Origin = start, Finish = center, Team = team, Color = ability.Color })
	elseif ability.Kind == "Rally" then
		if #banners >= 24 then
			return false
		end
		local object = parentUtility(CombatModels.BuildBanner(Config.Teams[team].Color), team, ability.Id, player)
		object:PivotTo(CFrame.new(center))
		local banner = { Model = object, Team = team, Position = center, Radius = ability.Radius, Until = now + ability.Duration, Ability = ability, NextBuff = now }
		table.insert(banners, banner)
		rallyAllies(team, center, ability.Radius, now + ability.Duration, ability)
		emit({ Kind = "Rally", AbilityId = ability.Id, Position = center, Radius = ability.Radius, Team = team, Color = ability.Color, Duration = ability.Duration })
	elseif ability.Kind == "Repair" then
		healAround(team, center, ability.Radius, ability.Amount)
		if fortressService and fortressService.RepairStructures then
			fortressService.RepairStructures(team, center, ability.Radius, ability.StructureAmount)
		end
		emit({ Kind = "Repair", AbilityId = ability.Id, Position = center, Radius = ability.Radius, Team = team, Color = ability.Color })
	elseif ability.Kind == "Minefield" then
		if #mines + ability.Count > 72 then
			return false
		end
		local offsets = { Vector3.new(-4, 0, 0), Vector3.new(4, 0, 0), Vector3.new(0, 0, 4) }
		for index = 1, ability.Count do
			local object = parentUtility(CombatModels.BuildMine(Config.Teams[team].Color), team, ability.Id, player)
			local position = center + offsets[((index - 1) % #offsets) + 1]
			object:PivotTo(CFrame.new(position))
			object:SetAttribute("Armed", false)
			table.insert(mines, { Model = object, Team = team, Source = character, Player = player, Position = position, ArmAt = now + 1, Until = now + ability.Duration, Radius = ability.Radius, TriggerRadius = ability.TriggerRadius, Amount = ability.Amount, NextCheck = now, AbilityId = ability.Id })
		end
		emit({ Kind = "Minefield", AbilityId = ability.Id, Position = center, Radius = 8, Team = team, Color = ability.Color })
	elseif ability.Kind == "Turret" then
		if #turrets >= 24 then
			return false
		end
		local object = parentUtility(CombatModels.BuildTurret(Config.Teams[team].Color), team, ability.Id, player)
		object:PivotTo(CFrame.new(center))
		table.insert(turrets, { Model = object, Team = team, Source = character, Player = player, Position = center, Until = now + ability.Duration, NextShot = now + 0.6, Range = ability.AttackRange, Amount = ability.Amount, ShotCooldown = ability.ShotCooldown, AbilityId = ability.Id })
		emit({ Kind = "TurretDeploy", AbilityId = ability.Id, Position = center, Team = team, Color = ability.Color, Duration = ability.Duration })
	else
		return false
	end
	return true
end

local function useAbility(owner, character, team, slot, targetPosition, player)
	if phaseProvider() ~= "Battle" then
		return false, "Способности доступны в фазе ШТУРМ"
	end
	local humanoid = living(character)
	if not humanoid then
		return false, "Персонаж не готов"
	end
	local classId = getClassForModel(character) or (player and getClassForPlayer(player))
	local ability = AbilityCatalog.GetAbilityForSlot(classId, slot)
	if not ability then
		return false, "Класс ещё не назначен"
	end
	local ownerCooldowns = cooldowns[owner]
	local now = os.clock()
	if ownerCooldowns and (ownerCooldowns[slot] or 0) > now then
		return false, "Способность перезаряжается"
	end
	local target = groundTarget(character, targetPosition, ability.Range)
	if not target then
		return false, "Нет цели"
	end
	if not execute(character, team, ability, target, player) then
		return false, "Достигнут лимит активных объектов"
	end
	cooldowns[owner] = cooldowns[owner] or { 0, 0 }
	cooldowns[owner][slot] = now + ability.Cooldown
	updateCooldownAttributes(owner)
	if player and remotes and remotes.AbilityState then
		remotes.AbilityState:FireClient(player, { Slot = slot, Cooldown = ability.Cooldown, AbilityId = ability.Id })
	end
	emit({ Kind = "Cooldown", AbilityId = ability.Id, Position = rootOf(character).Position, Team = team, Color = ability.Color })
	return true
end

function AbilityService.Init(dependencies)
	world = dependencies.World
	remotes = dependencies.Remotes
	state = dependencies.State
	fortressService = dependencies.FortressService
	botService = dependencies.BotService
	weaponService = dependencies.WeaponService
	ensureObjectFolder()
end

function AbilityService.SetProviders(phase, team, targets)
	phaseProvider = phase or phaseProvider
	teamProvider = team or teamProvider
	targetsProvider = targets or targetsProvider
end

function AbilityService.SetRewardHandler(handler)
	rewardHandler = handler
end

function AbilityService.StartMatch(matchId, participants)
	AbilityService.Reset()
	teamDecks = { Blue = shuffledDeck(), Orange = shuffledDeck() }
	teamDeckCursor = { Blue = 0, Orange = 0 }
	for _, player in ipairs(Players:GetPlayers()) do
		local team = participants[player.UserId]
		if team then
			publishPlayerClass(player, nextClass(team))
		end
	end
	if state then
		state:SetAttribute("ClassDraftMatch", matchId)
		state:SetAttribute("ClassDraftEnabled", true)
	end
end

function AbilityService.RegisterBot(model, team)
	return applyClassToModel(model, nextClass(team))
end

function AbilityService.ApplyCharacter(player, character)
	local classId = getClassForPlayer(player)
	if classId then
		playerClasses[player.UserId] = classId
		applyClassToModel(character, classId)
		-- A respawn starts with fresh ability cooldowns only at match start;
		-- cooldowns remain bound to the player, not to the new character.
		cooldowns[player] = cooldowns[player] or { 0, 0 }
		updateCooldownAttributes(player)
	end
end

function AbilityService.UsePlayerAbility(player, slot, targetPosition)
	if slot ~= 1 and slot ~= 2 then
		return false
	end
	local team = teamProvider(player) or player:GetAttribute("Team")
	if not Config.Teams[team] then
		return false, "Вы не участвуете в матче"
	end
	local classId = getClassForPlayer(player)
	if not classId then
		notify(player, "Класс будет назначен при старте матча")
		return false
	end
	local character = player.Character
	if character and not modelClasses[character] then
		applyClassToModel(character, classId)
	end
	local success, reason = useAbility(player, character, team, slot, targetPosition, player)
	if success and rewardHandler then
		local ability = AbilityCatalog.GetAbilityForSlot(classId, slot)
		rewardHandler(player, 1, 4, "Способность · " .. tostring(ability and ability.ShortName or "F/G"))
	end
	if not success and reason and reason ~= "Способность перезаряжается" then
		notify(player, reason)
	end
	return success, reason
end

function AbilityService.UseBotAbility(model, targetPosition)
	if not living(model) then
		return false
	end
	local classId = getClassForModel(model)
	local humanoid = model:FindFirstChildOfClass("Humanoid")
	-- Attribute stores the NEXT slot directly. The old encoded cursor made
	-- every other think retry the same cooldown before trying its partner.
	local cursor = tonumber(model:GetAttribute("AbilityCursor")) or 1
	if cursor ~= 1 and cursor ~= 2 then
		cursor = 1
	end
	if classId == "Medic" and humanoid.Health / math.max(1, humanoid.MaxHealth) < 0.8 then
		cursor = 1
	elseif classId == "Tank" and humanoid.Health / math.max(1, humanoid.MaxHealth) < 0.65 then
		cursor = 1
	end
	local function targetForSlot(slot)
		if classId == "Medic" and slot == 1 then
			return rootOf(model).Position
		elseif classId == "Buffer" then
			return slot == 2 and fortressService.GetCorePosition(model:GetAttribute("Team")) or rootOf(model).Position
		elseif classId == "Engineer" and slot == 2 then
			return rootOf(model).Position
		end
		return targetPosition
	end
	local success = useAbility(model, model, model:GetAttribute("Team"), cursor, targetForSlot(cursor), nil)
	if not success then
		cursor = cursor % 2 + 1
		success = useAbility(model, model, model:GetAttribute("Team"), cursor, targetForSlot(cursor), nil)
	end
	if success then
		model:SetAttribute("AbilityCursor", cursor % 2 + 1)
	end
	return success
end

function AbilityService.GetPlayerClass(player)
	return getClassForPlayer(player)
end

function AbilityService.GetBuildBonus(player)
	local classId = getClassForPlayer(player)
	local definition = AbilityCatalog.GetClass(classId)
	return definition and definition.BuildBonus or 0
end

function AbilityService.GetObjectCounts()
	return { Projectiles = #projectiles, Mines = #mines, Turrets = #turrets, Drones = #drones, Banners = #banners }
end

local function destroyRecord(record)
	if record and record.Model then
		record.Model:Destroy()
	end
end

local function explodeProjectile(projectile)
	damageAround(projectile.Team, projectile.Target, projectile.Radius, projectile.Amount, projectile.Player, projectile.Source)
	emit({ Kind = "BombImpact", AbilityId = projectile.AbilityId, Position = projectile.Target, Radius = projectile.Radius, Team = projectile.Team, Color = AbilityCatalog.GetAbility(projectile.AbilityId).Color })
end

local function explodeMine(mine)
	damageAround(mine.Team, mine.Position, mine.Radius, mine.Amount, mine.Player, mine.Source)
	emit({ Kind = "MineExplode", AbilityId = mine.AbilityId, Position = mine.Position, Radius = mine.Radius, Team = mine.Team, Color = AbilityCatalog.GetAbility(mine.AbilityId).Color })
end

function AbilityService.Step(deltaTime)
	local now = os.clock()
	for model, effect in pairs(effects) do
		if not model.Parent then
			effects[model] = nil
			modelClasses[model] = nil
			cooldowns[model] = nil
		else
			local expired = (not effect.ShieldUntil or effect.ShieldUntil <= now)
				and (not effect.OverdriveUntil or effect.OverdriveUntil <= now)
				and (not effect.RallyUntil or effect.RallyUntil <= now)
			refreshEffects(model)
			if expired then
				effects[model] = nil
			end
		end
	end

	if phaseProvider() == "Battle" then
		for index = #projectiles, 1, -1 do
			local projectile = projectiles[index]
			local alpha = (now - projectile.Born) / projectile.Duration
			if alpha >= 1 or not projectile.Model.Parent then
				if projectile.Model.Parent then
					explodeProjectile(projectile)
				end
				destroyRecord(projectile)
				table.remove(projectiles, index)
			else
				local position = projectile.Start:Lerp(projectile.Target, alpha) + Vector3.new(0, math.sin(alpha * math.pi) * 18, 0)
				projectile.Model:PivotTo(CFrame.new(position) * CFrame.Angles(now * 3, now * 4, 0))
				CombatModels.AnimateUtility(projectile.Model, now, true)
			end
		end
		for index = #mines, 1, -1 do
			local mine = mines[index]
			if now >= mine.Until or not mine.Model.Parent then
				destroyRecord(mine)
				table.remove(mines, index)
			else
				local armed = now >= mine.ArmAt
				mine.Model:SetAttribute("Armed", armed)
				CombatModels.AnimateUtility(mine.Model, now, armed)
				if armed and now >= mine.NextCheck then
					mine.NextCheck = now + 0.12
					local target = nearestEnemy(mine.Team, mine.Position, mine.TriggerRadius)
					if target then
						explodeMine(mine)
						destroyRecord(mine)
						table.remove(mines, index)
					end
				end
			end
		end
		for index = #turrets, 1, -1 do
			local turret = turrets[index]
			if now >= turret.Until or not turret.Model.Parent then
				destroyRecord(turret)
				table.remove(turrets, index)
			else
				local target = nearestEnemy(turret.Team, turret.Position, turret.Range)
				if target then
					local targetRoot = rootOf(target)
					local head = turret.Model:FindFirstChild("TurretHead")
					local headRoot = head and head.PrimaryPart
					if head and headRoot and targetRoot then
						head:PivotTo(CFrame.lookAt(headRoot.Position, targetRoot.Position))
					end
					if now >= turret.NextShot then
						turret.NextShot = now + turret.ShotCooldown
						if weaponService and weaponService.ApplyAbilityDamage then
							weaponService.ApplyAbilityDamage(target, turret.Amount, turret.Team, turret.Player)
						end
						local origin = headRoot and headRoot.Position or turret.Position
						emit({ Kind = "TurretShot", AbilityId = turret.AbilityId, Origin = origin, Finish = targetRoot.Position, Position = targetRoot.Position, Team = turret.Team, Color = Color3.fromRGB(255, 209, 99) })
					end
				end
			end
		end
		for index = #drones, 1, -1 do
			local drone = drones[index]
			local ownerRoot = rootOf(drone.Owner)
			if now >= drone.Until or not living(drone.Owner) or not drone.Model.Parent then
				destroyRecord(drone)
				table.remove(drones, index)
			else
				local position = ownerRoot.Position + Vector3.new(math.sin(now * 2) * 2, 5 + math.sin(now * 4) * 0.5, math.cos(now * 2) * 2)
				drone.Model:PivotTo(CFrame.new(position) * CFrame.Angles(0, now * 2, 0))
				CombatModels.AnimateUtility(drone.Model, now, true)
				if now >= drone.NextHeal then
					drone.NextHeal = now + 1
					healAround(drone.Team, position, drone.Radius, drone.Heal)
					emit({ Kind = "DroneHeal", AbilityId = "GuardianDrone", Position = position, Radius = drone.Radius, Team = drone.Team, Color = Color3.fromRGB(93, 239, 174) })
				end
			end
		end
		for index = #banners, 1, -1 do
			local banner = banners[index]
			if now >= banner.Until or not banner.Model.Parent then
				destroyRecord(banner)
				table.remove(banners, index)
			else
				CombatModels.AnimateBanner(banner.Model, now)
				if now >= banner.NextBuff then
					banner.NextBuff = now + 0.3
					rallyAllies(banner.Team, banner.Position, banner.Radius, now + 0.45, banner.Ability)
				end
			end
		end
	end

	classCleanupClock = classCleanupClock + deltaTime
	if classCleanupClock >= 1 then
		classCleanupClock = 0
		for model in pairs(modelClasses) do
			if not model.Parent then
				modelClasses[model] = nil
				cooldowns[model] = nil
				effects[model] = nil
			end
		end
	end

	cooldownClock = cooldownClock + deltaTime
	if cooldownClock >= 0.1 then
		cooldownClock = 0
		for _, player in ipairs(Players:GetPlayers()) do
			if playerClasses[player.UserId] then
				updateCooldownAttributes(player)
			end
		end
		if botService then
			for _, team in ipairs(Config.TeamOrder) do
				for _, model in ipairs(botService.GetModels(team)) do
					updateCooldownAttributes(model)
				end
			end
		end
	end
	stateClock = stateClock + deltaTime
	if stateClock >= 0.25 and state then
		stateClock = 0
		state:SetAttribute("ActiveAbilityMines", #mines)
		state:SetAttribute("ActiveAbilityTurrets", #turrets)
		state:SetAttribute("ActiveAbilityProjectiles", #projectiles)
		state:SetAttribute("ActiveAbilityDrones", #drones)
	end
end

function AbilityService.Reset()
	for _, list in ipairs({ projectiles, mines, turrets, drones, banners }) do
		for _, record in ipairs(list) do
			destroyRecord(record)
		end
		for index = #list, 1, -1 do
			table.remove(list, index)
		end
	end
	playerClasses = {}
	modelClasses = {}
	cooldowns = {}
	effects = {}
	teamDecks = {}
	teamDeckCursor = { Blue = 0, Orange = 0 }
	classCleanupClock = 0
	cooldownClock = 0
	stateClock = 0
	for _, player in ipairs(Players:GetPlayers()) do
		clearPlayerClass(player)
	end
	if state then
		state:SetAttribute("ClassDraftEnabled", false)
		state:SetAttribute("ActiveAbilityMines", 0)
		state:SetAttribute("ActiveAbilityTurrets", 0)
		state:SetAttribute("ActiveAbilityProjectiles", 0)
		state:SetAttribute("ActiveAbilityDrones", 0)
	end
end

function AbilityService.OnPlayerRemoving(player)
	playerClasses[player.UserId] = nil
	cooldowns[player] = nil
end

return AbilityService
]]></string>
          </Properties>
        </Item>
<Item class="ModuleScript" referent="33">
          <Properties>
            <string name="Name">NeutralService</string>
            <string name="Source"><![CDATA[-- BLOCKSIEGE // JUNGLE NEUTRAL CAMPS
-- Small server-side PvE encounters between the three lanes. Neutrals never
-- replace the 6v6 team fill and cannot destroy a fortress core by themselves.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("BlockSiege")
local Config = require(Shared:WaitForChild("Config"))

local NeutralService = {}
local world
local remotes
local dataService
local rewardHandler
local bonusService
local botService
local state
local phaseProvider = function() return "Lobby" end
local camps = {}
local defeated = 0
local animationClock = 0

local colors = {
	Color3.fromRGB(143, 190, 157),
	Color3.fromRGB(177, 153, 205),
	Color3.fromRGB(205, 175, 112),
}

local function rootOf(model)
	return model and (model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart) or nil
end

local function living(model)
	local root = rootOf(model)
	local humanoid = model and model:FindFirstChildOfClass("Humanoid")
	return root and humanoid and humanoid.Health > 0 and humanoid or nil
end

local function makePart(parent, name, size, cframe, color, material, collide)
	local object = Instance.new("Part")
	object.Name = name
	object.Size = size
	object.CFrame = cframe
	object.Color = color
	object.Material = material or Enum.Material.Slate
	object.Anchored = true
	object.CanCollide = collide == true
	object.CanTouch = false
	object.CanQuery = true
	object.Parent = parent
	return object
end

local function addTag(head, campId, humanoid)
	local gui = Instance.new("BillboardGui")
	gui.Name = "NeutralTag"
	gui.Size = UDim2.fromOffset(210, 48)
	gui.StudsOffset = Vector3.new(0, 3, 0)
	gui.AlwaysOnTop = true
	gui.MaxDistance = 100
	gui.Parent = head
	local text = Instance.new("TextLabel")
	text.Name = "Health"
	text.Size = UDim2.fromScale(1, 1)
	text.BackgroundTransparency = 1
	text.Font = Enum.Font.GothamBold
	text.TextScaled = true
	text.TextColor3 = Color3.fromRGB(221, 242, 213)
	text.TextStrokeTransparency = 0.25
	text.Text = "NEUTRAL // " .. string.upper(campId) .. " · " .. math.ceil(humanoid.Health)
	text.Parent = gui
	return text
end

local function combatants()
	local result = {}
	if botService then
		for _, team in ipairs(Config.TeamOrder) do
			for _, model in ipairs(botService.GetModels(team)) do
				if living(model) then
					table.insert(result, model)
				end
			end
		end
	end
	for _, player in ipairs(Players:GetPlayers()) do
		if player:GetAttribute("InMatch") == true and living(player.Character) then
			table.insert(result, player.Character)
		end
	end
	return result
end

local function neutralDeath(record, model)
	local attackerId = model:GetAttribute("LastAttackerUserId")
	local player = attackerId and Players:GetPlayerByUserId(attackerId) or nil
	if player then
		if rewardHandler then
			rewardHandler(player, 8, 18, "Нейтральный лагерь очищен")
		elseif dataService then
			dataService.Award(player, 8, 18, "Нейтральный лагерь очищен")
		end
		if bonusService then
			bonusService.OnAction(player, "Camp")
		end
	end
	defeated = defeated + 1
	record.RespawnAt = os.clock() + (Config.Objectives.NeutralRespawn or 45)
	record.Humanoid = nil
	if state then
		state:SetAttribute("NeutralDefeated", defeated)
	end
	if remotes and remotes.CombatFX then
		remotes.CombatFX:FireAllClients({ Kind = "NeutralDefeated", Position = record.Position + Vector3.new(0, 3, 0), Team = "Neutral", Color = Color3.fromRGB(170, 220, 160) })
	end
	task.delay(1, function()
		if record.Model == model then
			model:Destroy()
		end
	end)
end

local function spawnCamp(definition)
	local model = Instance.new("Model")
	model.Name = "NeutralGuardian_" .. definition.Id
	model:SetAttribute("Team", "Neutral")
	model:SetAttribute("IsNeutral", true)
	model:SetAttribute("NeutralCamp", definition.Id)
	model:SetAttribute("Armor", 0.05)
	model.Parent = world.Neutrals
	local color = colors[(#camps % #colors) + 1]
	local root = makePart(model, "HumanoidRootPart", Vector3.new(3, 3, 3), CFrame.new(definition.Position + Vector3.new(0, 3, 0)), color, Enum.Material.Slate, false)
	root.Transparency = 1
	root.CanQuery = false
	model.PrimaryPart = root
	-- Guardians are combat targets, not invisible navmesh walls. Keeping their
	-- bodies non-colliding prevents a jungle camp from trapping a lane bot; the
	-- parts remain queryable so hitscan and LastAttackerUserId still work.
	local body = makePart(model, "Body", Vector3.new(4.2, 4.5, 3.8), root.CFrame * CFrame.new(0, 0.5, 0), color, Enum.Material.DiamondPlate, false)
	local head = makePart(model, "Head", Vector3.new(2.7, 2.2, 2.7), root.CFrame * CFrame.new(0, 3.4, 0), Color3.fromRGB(45, 65, 65), Enum.Material.Slate, false)
	makePart(model, "NeutralEye", Vector3.new(1.4, 0.35, 0.25), root.CFrame * CFrame.new(0, 3.5, -1.4), Color3.fromRGB(221, 255, 159), Enum.Material.Neon, false)
	for _, side in ipairs({ -1, 1 }) do
		makePart(model, "Horn", Vector3.new(0.55, 2.2, 0.55), root.CFrame * CFrame.new(side * 1.1, 5, 0) * CFrame.Angles(0, 0, math.rad(side * 20)), Color3.fromRGB(222, 213, 173), Enum.Material.Cobblestone, false)
	end
	local crystal = makePart(model, "NeutralCrystal", Vector3.new(1.1, 2.4, 1.1), root.CFrame * CFrame.new(0, 1, 2.2), color, Enum.Material.Neon, false)
	local glow = Instance.new("PointLight")
	glow.Name = "NeutralGlow"
	glow.Color = color
	glow.Brightness = 1.2
	glow.Range = 10
	glow.Parent = crystal
	local humanoid = Instance.new("Humanoid")
	humanoid.MaxHealth = 220
	humanoid.Health = 220
	humanoid.WalkSpeed = 0
	humanoid.RequiresNeck = false
	humanoid.BreakJointsOnDeath = false
	humanoid.Parent = model
	local record = { Id = definition.Id, Position = definition.Position, Model = model, Humanoid = humanoid, Root = root, Body = body, Crystal = crystal, CrystalCFrame = crystal.CFrame, NextAttack = os.clock() + 1, RespawnAt = 0 }
	record.Tag = addTag(head, definition.Id, humanoid)
	humanoid.Died:Connect(function()
		neutralDeath(record, model)
	end)
	return record
end

function NeutralService.Init(dependencies)
	world = dependencies.World
	remotes = dependencies.Remotes
	dataService = dependencies.DataService
	bonusService = dependencies.BonusService
	botService = dependencies.BotService
	state = dependencies.State
	if not world.Neutrals then
		local folder = Instance.new("Folder")
		folder.Name = "Neutrals"
		folder.Parent = world.Root
		world.Neutrals = folder
	end
end

function NeutralService.SetPhaseProvider(provider)
	phaseProvider = provider or phaseProvider
end

function NeutralService.SetRewardHandler(handler)
	rewardHandler = handler
end

function NeutralService.StartMatch()
	NeutralService.Reset()
	for _, definition in ipairs(Config.Objectives.NeutralCamps) do
		table.insert(camps, spawnCamp(definition))
	end
	if state then
		state:SetAttribute("NeutralCampCount", #camps)
		state:SetAttribute("NeutralDefeated", 0)
	end
end

function NeutralService.Reset()
	for _, record in ipairs(camps) do
		if record.Model then
			record.Model:Destroy()
		end
	end
	camps = {}
	defeated = 0
	if state then
		state:SetAttribute("NeutralCampCount", 0)
		state:SetAttribute("NeutralGuardiansAlive", 0)
		state:SetAttribute("NeutralDefeated", 0)
	end
end

function NeutralService.Step(deltaTime)
	if phaseProvider() ~= "Battle" then
		return
	end
	local now = os.clock()
	local alive = 0
	animationClock = animationClock + deltaTime
	for index, record in ipairs(camps) do
		local humanoid = record.Humanoid
		if humanoid and humanoid.Health > 0 and record.Model.Parent then
			alive = alive + 1
			record.Crystal.CFrame = record.CrystalCFrame * CFrame.Angles(0, now * 1.5, 0)
			local glow = record.Crystal:FindFirstChild("NeutralGlow")
			if glow then
				glow.Brightness = 1.1 + math.sin(now * 4) * 0.35
			end
			if record.Tag then
				record.Tag.Text = "NEUTRAL // " .. string.upper(record.Id) .. " · " .. math.ceil(humanoid.Health)
			end
			if now >= record.NextAttack then
				local nearest
				local nearestRoot
				local nearestDistance = 22
				for _, target in ipairs(combatants()) do
					local targetRoot = rootOf(target)
					if targetRoot then
						local distance = (targetRoot.Position - record.Root.Position).Magnitude
						if distance <= nearestDistance then
							nearest = target
							nearestRoot = targetRoot
							nearestDistance = distance
						end
					end
				end
				if nearest then
					record.NextAttack = now + 1.6
					record.Model:PivotTo(CFrame.lookAt(record.Root.Position, Vector3.new(nearestRoot.Position.X, record.Root.Position.Y, nearestRoot.Position.Z)))
					local targetHumanoid = living(nearest)
					local armor = tonumber(nearest:GetAttribute("Armor")) or 0
					local shield = tonumber(nearest:GetAttribute("DamageTakenMultiplier")) or 1
					targetHumanoid:TakeDamage(10 * math.clamp(shield, 0.05, 1) * (1 - math.clamp(armor, 0, 0.65)))
					if remotes and remotes.CombatFX then
						remotes.CombatFX:FireAllClients({ Kind = "NeutralShot", Origin = record.Body.Position, Finish = nearestRoot.Position, Position = nearestRoot.Position, Team = "Neutral", Color = Color3.fromRGB(170, 220, 160) })
					end
				else
					record.NextAttack = now + 0.4
				end
			end
		elseif record.RespawnAt > 0 and now >= record.RespawnAt then
			if record.Model then
				record.Model:Destroy()
			end
			camps[index] = spawnCamp({ Id = record.Id, Position = record.Position })
		end
	end
	if state then
		state:SetAttribute("NeutralGuardiansAlive", alive)
	end
end

function NeutralService.GetCampCount()
	return #camps
end

return NeutralService
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="22">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="23">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="LocalScript" referent="24">
        <Properties>
          <string name="Name">AudioClient</string>
          <string name="Source"><![CDATA[-- Локальная музыка фаз, SFX и mute. Asset ID настраиваются в Config.Audio.
local Debris = game:GetService("Debris")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local SoundService = game:GetService("SoundService")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")

local player = Players.LocalPlayer
local Shared = ReplicatedStorage:WaitForChild("BlockSiege")
local Config = require(Shared:WaitForChild("Config"))
local remotes = Shared:WaitForChild("Remotes")
local state = Shared:WaitForChild("MatchState")
local audioFolder = Instance.new("Folder")
audioFolder.Name = "BlockSiegeAudio"
audioFolder.Parent = player:WaitForChild("PlayerGui")

local enabled = Config.Audio.DefaultEnabled
local currentMusic
local currentTheme
local desiredTheme = "Lobby"

local gui = Instance.new("ScreenGui")
gui.Name = "BlockSiegeAudioUI"
gui.ResetOnSpawn = false
gui.Parent = player.PlayerGui
local muteButton = Instance.new("TextButton")
muteButton.AnchorPoint = Vector2.new(1, 0)
muteButton.Position = UDim2.new(1, -18, 0, 122)
muteButton.Size = UDim2.new(0, 46, 0, 42)
muteButton.BackgroundColor3 = Color3.fromRGB(38, 49, 48)
muteButton.TextColor3 = Color3.fromRGB(240, 241, 217)
muteButton.Font = Enum.Font.Code
muteButton.TextSize = 24
muteButton.Parent = gui
local corner = Instance.new("UICorner")
corner.CornerRadius = UDim.new(0, 6)
corner.Parent = muteButton

local function fadeAndDestroy(sound)
	if not sound then
		return
	end
	local fade = TweenService:Create(sound, TweenInfo.new(Config.Audio.FadeDuration), { Volume = 0 })
	fade:Play()
	task.delay(Config.Audio.FadeDuration + 0.05, function()
		if sound.Parent then
			sound:Stop()
			sound:Destroy()
		end
	end)
end

local function updateButton()
	muteButton.Text = enabled and "♪" or "×"
end

local function updateMusic()
	local phase = state:GetAttribute("Phase") or "Lobby"
	desiredTheme = phase == "Build" and "Build" or (phase == "Battle" and "Battle" or "Lobby")
	if desiredTheme == currentTheme then
		return
	end
	currentTheme = desiredTheme
	local previous = currentMusic
	currentMusic = nil
	fadeAndDestroy(previous)
	if not enabled then
		return
	end
	local assetId = Config.Audio[currentTheme .. "MusicId"] or 0
	if assetId <= 0 then
		return
	end
	local sound = Instance.new("Sound")
	sound.Name = currentTheme .. "Music"
	sound.SoundId = string.format("rbxassetid://%.0f", assetId)
	sound.Looped = true
	sound.Volume = 0
	sound.Parent = audioFolder
	currentMusic = sound
	SoundService:PlayLocalSound(sound)
	TweenService:Create(sound, TweenInfo.new(Config.Audio.FadeDuration), { Volume = Config.Audio.MusicVolume }):Play()
end

local function playSfx(name, volume, playbackSpeed)
	if not enabled then
		return
	end
	local assetId = Config.Audio[name .. "SfxId"] or 0
	if assetId <= 0 then
		return
	end
	local sound = Instance.new("Sound")
	sound.Name = name .. "SFX"
	sound.SoundId = string.format("rbxassetid://%.0f", assetId)
	sound.Volume = (volume or 1) * Config.Audio.SFXVolume
	sound.PlaybackSpeed = playbackSpeed or 1
	sound.Parent = audioFolder
	SoundService:PlayLocalSound(sound)
	Debris:AddItem(sound, 4)
end

local function toggleAudio()
	enabled = not enabled
	updateButton()
	if not enabled then
		local previous = currentMusic
		currentMusic = nil
		currentTheme = nil
		fadeAndDestroy(previous)
	else
		currentTheme = nil
		updateMusic()
	end
end

muteButton.Activated:Connect(toggleAudio)
UserInputService.InputBegan:Connect(function(input, processed)
	if input.KeyCode == Enum.KeyCode.N and not processed then
		toggleAudio()
	elseif processed and (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) then
		playSfx("UIClick", 0.35, 1)
	end
end)

remotes.CombatFX.OnClientEvent:Connect(function(payload)
	if payload.Melee == true or payload.Kind == "Melee" then
		playSfx("Hit", 0.58, 1.18)
	elseif payload.Kind == "Shot" then
		local heavy = payload.WeaponId == "Rail" or payload.WeaponId == "Demolisher" or payload.WeaponId == "Marksman" or payload.WeaponId == "ThanosGauntlet" or payload.WeaponId == "PrismLance"
		local pitch = 1
		if payload.WeaponId == "SMG" or payload.WeaponId == "TeslaCarbine" then
			pitch = 1.16
		elseif payload.WeaponId == "Scatter" then
			pitch = 0.86
		elseif payload.WeaponId == "Rail" or payload.WeaponId == "ThanosGauntlet" or payload.WeaponId == "PrismLance" then
			pitch = 0.78
		end
		playSfx(heavy and "HeavyShot" or "Shot", heavy and 0.7 or 0.42, pitch)
	elseif payload.Kind == "StructureHit" then
		playSfx("Hit", 0.32, 0.95 + math.random() * 0.1)
	elseif payload.Kind == "StructureDestroyed" then
		playSfx("Destroy", 0.72, 0.94 + math.random() * 0.12)
	elseif payload.Kind == "CoreDestroyed" then
		playSfx("CoreDestroyed", 1, 1)
	elseif payload.Kind == "ExpeditionShot" then
		playSfx("Shot", 0.36, 0.82)
	elseif payload.Kind == "ExpeditionDefeated" then
		playSfx("Destroy", 0.58, 1.08)
	elseif payload.Kind == "ExpeditionBossWarning" then
		playSfx("HeavyShot", 0.62, 0.68)
	elseif payload.Kind == "ExpeditionBossSlam" then
		playSfx("CoreDestroyed", 0.82, 0.76)
	end
end)
remotes.BuildFX.OnClientEvent:Connect(function()
	playSfx("Build", 0.55, 0.96 + math.random() * 0.08)
end)
remotes.TrapFX.OnClientEvent:Connect(function(payload)
	playSfx(payload.Kind == "ShockMine" and "Destroy" or "Hit", 0.62, payload.Kind == "FlameTrap" and 0.82 or 1.08)
end)
remotes.CaptureFX.OnClientEvent:Connect(function()
	playSfx("CaseOpened", 0.72, 1.12)
end)
remotes.CaseOpened.OnClientEvent:Connect(function()
	playSfx("CaseOpened", 0.8, 1)
end)
remotes.SeasonFX.OnClientEvent:Connect(function()
	playSfx("CaseOpened", 0.5, 1.18)
end)
remotes.ExpeditionFX.OnClientEvent:Connect(function(payload)
	if payload.Type == "Completed" then
		playSfx("Victory", 0.8, 1.06)
	end
end)
remotes.DeathFX.OnClientEvent:Connect(function(payload)
	if payload.VictimUserId == player.UserId then
		playSfx(Config.Audio.DeathSfxId > 0 and "Death" or "Defeat", 0.85, 0.92)
	end
end)
remotes.Results.OnClientEvent:Connect(function(result)
	if result.Winner == "" then
		playSfx("CaseOpened", 0.55, 0.9)
	elseif result.Winner == result.Team then
		playSfx("Victory", 0.9, 1)
	else
		playSfx("Defeat", 0.8, 1)
	end
end)
state:GetAttributeChangedSignal("Phase"):Connect(updateMusic)
updateButton()
updateMusic()
]]></string>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="25">
        <Properties>
          <string name="Name">BaseVisibilityClient</string>
          <string name="Source"><![CDATA[-- Client-side fog of war: the opposing fortress is hidden only during the Build phase.
-- This is presentation-only; server geometry, navigation and victory rules stay authoritative.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local player = Players.LocalPlayer
local Shared = ReplicatedStorage:WaitForChild("BlockSiege")
local Config = require(Shared:WaitForChild("Config"))
local state = Shared:WaitForChild("MatchState")
local world = Workspace:WaitForChild("BlockSiegeWorld")
local structures = world:WaitForChild("Structures")

local originals = {}
local nextRefresh = 0
local effectClasses = {
	BillboardGui = true,
	SurfaceGui = true,
	PointLight = true,
	SpotLight = true,
	SurfaceLight = true,
	Sparkles = true,
	ParticleEmitter = true,
	Smoke = true,
	Fire = true,
	Trail = true,
	Beam = true,
	Highlight = true,
}
local textureClasses = { Texture = true, Decal = true }

local function remember(part)
	local record = originals[part]
	if not record then
		record = { Transparency = part.LocalTransparencyModifier, CastShadow = part.CastShadow, Effects = {} }
		originals[part] = record
	end
	for _, item in ipairs(part:GetDescendants()) do
		if textureClasses[item.ClassName] and not record.Effects[item] then
			record.Effects[item] = { Transparency = item.Transparency }
		elseif effectClasses[item.ClassName] and not record.Effects[item] then
			record.Effects[item] = { Enabled = item.Enabled }
		end
	end
	return record
end

local function hidePart(part)
	local record = remember(part)
	part.LocalTransparencyModifier = 1
	part.CastShadow = false
	for item, effect in pairs(record.Effects) do
		if item.Parent then
			if effect.Transparency ~= nil then
				item.Transparency = 1
			elseif effect.Enabled ~= nil then
				item.Enabled = false
			end
		end
	end
end

local function showPart(part)
	local record = originals[part]
	if not record then
		return
	end
	part.LocalTransparencyModifier = record.Transparency
	part.CastShadow = record.CastShadow
	for item, effect in pairs(record.Effects) do
		if item.Parent then
			if effect.Transparency ~= nil then
				item.Transparency = effect.Transparency
			elseif effect.Enabled ~= nil then
				item.Enabled = effect.Enabled
			end
		end
	end
	originals[part] = nil
end

local function isVisibilityControlled(part)
	if part:GetAttribute("BaseGeometry") == true then
		return true
	end
	local current = part.Parent
	while current and current ~= world do
		if current == structures then
			return true
		end
		current = current.Parent
	end
	return false
end

local function refresh()
	local phase = state:GetAttribute("Phase") or "Lobby"
	local team = player:GetAttribute("Team") or ""
	local enemy = team == "Blue" and "Orange" or (team == "Orange" and "Blue" or nil)
	local hideEnemy = Config.Arena.HideEnemyBaseDuringBuild and phase == "Build" and enemy ~= nil
	for _, part in ipairs(world:GetDescendants()) do
		if part:IsA("BasePart") and isVisibilityControlled(part) then
			if hideEnemy and part:GetAttribute("Team") == enemy then
				hidePart(part)
			else
				showPart(part)
			end
		end
	end
	for part in pairs(originals) do
		if not part.Parent then
			originals[part] = nil
		end
	end
end

state:GetAttributeChangedSignal("Phase"):Connect(refresh)
player:GetAttributeChangedSignal("Team"):Connect(refresh)
RunService.RenderStepped:Connect(function()
	local now = os.clock()
	if now >= nextRefresh then
		nextRefresh = now + 0.3
		refresh()
	end
end)
refresh()
]]></string>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="26">
        <Properties>
          <string name="Name">Client</string>
          <string name="Source"><![CDATA[-- BLOCKSIEGE: HUD, строительство, огонь, инвентарь и игровые кейсы.
local Debris = game:GetService("Debris")
