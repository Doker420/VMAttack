# Copy this file to .env at the repository root. Never commit .env.

# Application
# ENV_FILE=.env
PORT=4173
WEB_APP_URL=https://app.goago.club
CORS_ORIGIN=https://app.goago.club
DEMO_MODE=true
RETENTION_INTERVAL_MS=86400000

# Public profile and referral defaults
TELEGRAM_BOT_USERNAME=poslaniya_robot
VK_GROUP_ID=poslaniya_demo
VK_API_VERSION=5.199
DEFAULT_RECIPIENT_SLUG=anya
DEMO_RECIPIENT_ID=demo_recipient
DEMO_RECIPIENT_NAME=Аня

# Runtime storage; paths are relative to the repository root
DB_DRIVER=sqlite
SQLITE_FILE=data/dev.sqlite
DATA_FILE=data/store.json
DAILY_RU_FILE=content/daily/ru.txt
DAILY_EN_FILE=content/daily/en.txt

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_MODE=polling
TELEGRAM_USE_START_BANNER=true
TELEGRAM_START_BANNER_FILE=web/assets/start-banner.png
TELEGRAM_ADMIN_IDS=
TELEGRAM_WEBHOOK_SECRET=
# Group chats: set false to disable group handling. Empty allowlist permits all groups.
TELEGRAM_GROUPS_ENABLED=true
TELEGRAM_GROUP_CHAT_IDS=
# Telegram sticker file_ids (get one by forwarding a sticker to a helper bot/API log).
# The generic ID is a fallback; specific values override it.
TELEGRAM_STICKER_ID=
TELEGRAM_RECEIVED_STICKER_ID=
TELEGRAM_SENT_STICKER_ID=

# VK Callback API
VK_GROUP_TOKEN=
VK_CONFIRMATION_TOKEN=

# Payments and balance top-ups (all amounts are RUB)
# YooMoney: receiver wallet is enough to generate a card payment page.
# Never put the notification secret or OAuth token in the repository.
YUMONEY_RECEIVER=4100118715887132
YUMONEY_PAYMENT_URL=
YUMONEY_NOTIFICATION_SECRET=
YUMONEY_TOKEN=
YUMONEY_WEBHOOK_SECRET=
# CryptoBot API: https://pay.crypt.bot/api
CRYPTOBOT_API_TOKEN=
CRYPTOBOT_API_URL=https://pay.crypt.bot/api
CRYPTOBOT_WEBHOOK_SECRET=
# xRocket adapter: set the invoice-create endpoint from your xRocket merchant account.
XROCKET_API_TOKEN=
XROCKET_CREATE_INVOICE_URL=
XROCKET_WEBHOOK_SECRET=
# SBP is manual: show these details to the payer, then a Telegram admin checks the receipt.
SBP_PAYMENT_DETAILS=
TELEGRAM_SBP_ADMIN_TEXT=

# CloudPayments server-side callbacks (legacy compatibility)
CLOUDPAYMENTS_PUBLIC_ID=
CLOUDPAYMENTS_API_SECRET=
